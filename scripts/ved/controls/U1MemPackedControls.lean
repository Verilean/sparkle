/-
U1 measurement controls for the route `u1_mem_packed` and its probe (MEASUREMENT ONLY, never for main).

Run (after `kjob lake build Tools.VedWriteChecked Tools.VedMemEntry Tools.VedStrictAudit Sparkle`):
  timeout 900 python3 -I scratch/rss_guard.py 10485760 kjob lake env lean scripts/ved/controls/U1MemPackedControls.lean
The file elaborates without error iff every control holds; each prints `VED U1CTL <id> PASS`.
It is generated by scripts/ved/controls/gen_u1mem_controls.py: the probe below is MEM_PROBE_DEF of
scripts/ved/u1_gen.py, verbatim (a Python test checks that); the controls run THAT probe.

  M0  a memory-in-a-loop declaration with a product result through `#ved_write_checked mem_packed`: the
      probe ACCEPTS: THM theorem, TYPE exact (`MemPackedStmt` rebuilt), SLICES equal, PORT match,
      CONTRACT bound-to-mod, axioms std3, WRITTEN sv=equal cpp=equal;
  M1  the written .sv differs / the written _cppsim.h differs / a file is missing: WRITTEN rejects;
  M2  the files of ANOTHER declaration at the paths (check A, write B): WRITTEN differs;
  M3  a must-stay-refused memory row: a one-output memory declaration is refused at [packed], and a
      declaration with registers but no `Signal.loop` at [shape]; no theorem, no constant, no file.
-/
import Sparkle
import Sparkle.Compiler.Elab
import Tools.VedWriteChecked
import Tools.VedMemEntry
import Tools.VedStrictAudit

open Sparkle.Core.Domain Sparkle.Core.Signal Sparkle.Core.StateMacro

open Lean Meta in
unsafe def vedu1mEvalModImpl (e : Lean.Expr) : MetaM Sparkle.IR.AST.Module :=
  Meta.evalExpr Sparkle.IR.AST.Module (Lean.mkConst ``Sparkle.IR.AST.Module) e
open Lean Meta in
@[implemented_by vedu1mEvalModImpl] opaque vedu1mEvalMod (e : Lean.Expr) : MetaM Sparkle.IR.AST.Module

open Lean Meta in
partial def vedu1pLeaves (ty : Expr) : MetaM (List Nat) := do
  let ty ← whnfR (← instantiateMVars ty)
  match ty.getAppFnArgs with
  | (``Prod, #[a, b]) => return (← vedu1pLeaves a) ++ (← vedu1pLeaves b)
  | (``Bool, #[]) => return [1]
  | (``BitVec, #[w]) =>
    match ← evalNat (← whnf (← instantiateMVars w)) with
    | some n => return [n]
    | none => throwError "non-literal BitVec width {w}"
  | _ => throwError "unsupported leaf type {ty}"

open Lean Meta in
partial def vedu1pPairs (e : Expr) : MetaM (List (Nat × Nat)) := do
  let e ← whnf e
  match e.getAppFnArgs with
  | (``List.nil, _) => return []
  | (``List.cons, #[_, h, t]) =>
    let h ← whnf h
    match h.getAppFnArgs with
    | (``Prod.mk, #[_, _, a, b]) =>
      let some a ← evalNat (← whnf a) | throwError "non-literal offset {a}"
      let some b ← evalNat (← whnf b) | throwError "non-literal width {b}"
      return (a, b) :: (← vedu1pPairs t)
    | _ => throwError "not a pair {h}"
  | _ => throwError "not a list {e}"

open Lean Meta in
partial def vedu1pPorts (e : Expr) : MetaM (List (String × Nat)) := do
  let e ← whnf e
  match e.getAppFnArgs with
  | (``List.nil, _) => return []
  | (``List.cons, #[_, h, t]) =>
    let h ← whnf h
    match h.getAppFnArgs with
    | (``Sparkle.IR.AST.Port.mk, #[nm, ty]) =>
      let .lit (.strVal s) ← whnf nm | throwError "non-literal port name {nm}"
      let ty ← whnf ty
      match ty.getAppFnArgs with
      | (``Sparkle.IR.Type.HWType.bitVector, #[w]) =>
        let some w ← evalNat (← whnf w) | throwError "non-literal port width {w}"
        return (s, w) :: (← vedu1pPorts t)
      | _ => return (s, 0) :: (← vedu1pPorts t)
    | _ => throwError "not a port {h}"
  | _ => throwError "not a list {e}"

open Lean Elab Command Meta in
set_option maxRecDepth 20000 in
elab "#vedu1_mem_packed_probe " id:ident sv:str cpp:str : command => do
  try
    let n ← liftCoreM <| realizeGlobalConstNoOverload id
    let env ← getEnv
    let thm := n ++ `ved_mem
    let md := n ++ `ved_mod
    let ct := n ++ `ved_contract
    match env.find? thm with
    | none => logInfo m!"VED U1P THM absent"
    | some (.thmInfo _) => logInfo m!"VED U1P THM theorem"
    | some _ => logInfo m!"VED U1P THM not-a-theorem"
    -- the statement term, rebuilt here: the original constant applied to
    -- `defaultDomain` once per LEADING implicit binder of type exactly `DomainConfig`
    let k ← liftTermElabM do
      let ci ← getConstInfo n
      forallTelescope ci.type fun xs _ => do
        let mut k := 0
        for x in xs do
          let ld ← x.fvarId!.getDecl
          if !ld.binderInfo.isExplicit && ld.type.isConstOf `Sparkle.Core.Domain.DomainConfig then k := k + 1
          else break
        pure k
    logInfo m!"VED U1P STMT domains={k}"
    let stmt := mkAppN (mkConst n) (List.replicate k (mkConst `Sparkle.Core.Domain.defaultDomain)).toArray
    if let some (.thmInfo ti) := env.find? thm then
      let expected := mkAppN (mkConst ``Tools.VedMemEntry.MemPackedStmt) #[mkConst ct, mkConst md, stmt]
      logInfo m!"VED U1P TYPE {if ti.type == expected then "exact" else "differs"}"
      logInfo m!"VED U1P MVARS type={ti.type.hasMVar} value={ti.value.hasMVar} fvars={ti.type.hasFVar || ti.value.hasFVar}"
      logInfo m!"VED U1P LEVELS {ti.levelParams.length}"
      let ax ← liftCoreM <| collectAxioms thm
      logInfo m!"VED U1P AXIOMS {Tools.VedStrictAudit.showNames (Tools.VedStrictAudit.sortNames ax)}"
    match env.find? md with
    | none => logInfo m!"VED U1P MOD absent"
    | some (.defnInfo di) =>
      let closed := !di.value.hasMVar && !di.value.hasFVar && !di.value.hasLooseBVars
      logInfo m!"VED U1P MOD closed={closed} type={di.type == mkConst ``Sparkle.IR.AST.Module}"
    | some _ => logInfo m!"VED U1P MOD not-a-def"
    -- the packing rule, from the declaration's TYPE (`Signal d (A x B)`)
    let ws ← liftTermElabM do
      forallTelescopeReducing (← inferType stmt) fun _ res => do
        let res ← whnfR (← instantiateMVars res)
        match res.getAppFnArgs with
        | (``Sparkle.Core.Signal.Signal, #[_, a]) => vedu1pLeaves a
        | _ => throwError "result {res} is not a Signal"
    let total := ws.foldl (· + ·) 0
    let offs := (List.range ws.length).map fun i => (ws.drop (i + 1)).foldl (· + ·) 0
    let expSl := offs.zip ws
    let showSl (l : List (Nat × Nat)) := "[" ++ ",".intercalate (l.map fun (o, w) => s!"({o},{w})") ++ "]"
    logInfo m!"VED U1P LEAVES {ws.length} widths={ws} total={total}"
    -- the stored contract (`PContract`): slice map, port name, module name, wires
    match env.find? ct with
    | none => logInfo m!"VED U1P CONTRACT absent"
    | some (.defnInfo _) =>
      let c := mkConst ct
      let sl ← liftTermElabM <| vedu1pPairs (mkApp (mkConst ``Tools.VedU1Packed.PContract.slices) c)
      logInfo m!"VED U1P SLICES expected={showSl expSl} stored={showSl sl} {if sl == expSl then "equal" else "differs"}"
      let (cport, cmod, wiresEq, mname) ← liftTermElabM do
        let cport ← whnf (mkApp (mkConst ``Tools.VedU1Packed.PContract.port) c)
        let cmod ← whnf (mkApp (mkConst ``Tools.VedU1Packed.PContract.modName) c)
        let mname ← whnf (mkApp (mkConst ``Sparkle.IR.AST.Module.name) (mkConst md))
        let weq ← isDefEq (mkApp (mkConst ``Tools.VedU1Packed.PContract.wires) c)
          (mkApp (mkConst ``Sparkle.IR.AST.Module.wires) (mkConst md))
        pure (cport, cmod, weq, mname)
      let bound := cport == mkStrLit "out" && cmod == mname && wiresEq
      logInfo m!"VED U1P CONTRACT {if bound then "bound-to-mod" else "other"}"
    | some _ => logInfo m!"VED U1P CONTRACT not-a-def"
    -- the module's output ports: exactly one, named `out`, of the packed width
    if env.contains md then
      let ps ← liftTermElabM <| vedu1pPorts (mkApp (mkConst ``Sparkle.IR.AST.Module.outputs) (mkConst md))
      logInfo m!"VED U1P PORT module={ps} expect=[(out, {total})] {if ps == [("out", total)] then "match" else "differs"}"
    -- the written files equal the artifact the statement is about
    if let some (.defnInfo di) := env.find? md then
      let vm ← liftTermElabM <| vedu1mEvalMod di.value
      let design : Sparkle.IR.AST.Design := { topModule := vm.name, modules := [vm] }
      let readF (p : String) : IO (Option String) := do
        try return some (← IO.FS.readFile p) catch _ => return none
      let svW ← readF sv.getString
      let cW ← readF cpp.getString
      let svE := Sparkle.Backend.Verilog.toVerilogDesign design
      let cE := Sparkle.Backend.CSim.toCDesign (Sparkle.IR.Optimize.optimizeDesign design)
      let st (w : Option String) (e : String) := match w with | none => "missing" | some w => if w == e then "equal" else "differs"
      logInfo m!"VED U1P WRITTEN sv={st svW svE} cpp={st cW cE}"
    else logInfo m!"VED U1P WRITTEN sv=missing cpp=missing"
    -- the output count of the STATEMENT term's type
    let tbl ← liftTermElabM do
      Tools.VedU1Contract.readTableOfType n (← Lean.Meta.inferType stmt)
    logInfo m!"VED U1P OUTS {tbl.out.flat.length}"
  catch e => logInfo m!"VED U1P PROBE failed: {← e.toMessageData.toString}"

open Lean Elab Command in
/-- Elaborate `#vedu1_mem_packed_probe n sv cpp`, drop its messages and require every pattern in `pats` to occur
in the probe's output (a pattern starting with `!` must NOT occur). -/
elab "#vedu1_mexpect " id:str n:ident sv:str cpp:str pats:str* : command => do
  let saved := (← get).messages
  modify fun s => { s with messages := MessageLog.empty }
  elabCommand (← `(command| #vedu1_mem_packed_probe $n $sv $cpp))
  let infos ← (← get).messages.toList.mapM fun m => m.data.toString
  modify fun s => { s with messages := saved }
  let all := "\n".intercalate infos
  let has (p : String) := (all.splitOn p).length > 1
  for p in pats do
    let p := p.getString
    if p.startsWith "!" then
      let q := (p.drop 1).toString
      if has q then throwError m!"VED U1CTL {id.getString} FAIL: unexpected `{q}` in\n{all}"
    else if !has p then throwError m!"VED U1CTL {id.getString} FAIL: missing `{p}` in\n{all}"
  logInfo m!"VED U1CTL {id.getString} PASS"

open Lean Elab Command in
elab "#vedu1_absent " id:str n:ident : command => do
  if (← getEnv).contains n.getId then throwError m!"VED U1CTL {id.getString} FAIL: {n.getId} exists"
  logInfo m!"VED U1CTL {id.getString} absent {n.getId}"

open Lean Elab Command in
/-- the tool refuses (an error `VED U1 REFUSED <decl> [<stage>]`), leaving nothing behind -/
elab "#vedu1_refused " id:str stage:str c:command : command => do
  let saved := (← get).messages
  modify fun s => { s with messages := MessageLog.empty }
  elabCommand c
  let errs ← (← get).messages.toList.filterMapM fun m => do
    if m.severity == .error then pure (some (← m.data.toString)) else pure none
  modify fun s => { s with messages := saved }
  if errs.any (fun e => (e.splitOn s!"[{stage.getString}]").length > 1 && e.startsWith "VED U1 REFUSED") then
    logInfo m!"VED U1CTL {id.getString} refused at [{stage.getString}]"
  else throwError m!"VED U1CTL {id.getString} FAIL: no [{stage.getString}] refusal; errors: {errs}"

open Lean Elab Command in
/-- replace the file's text (`suffix` appended) or remove it (`none`) -/
elab "#vedu1_edit_file " p:str s:str : command => do
  let t ← IO.FS.readFile p.getString
  IO.FS.writeFile p.getString (t ++ s.getString)

open Lean Elab Command in
elab "#vedu1_rm_file " p:str : command => IO.FS.removeFile p.getString

declare_signal_state QState
  | idx  : BitVec 5  := 0#5
  | busy : Bool      := false
  | last : BitVec 16 := 0#16

set_option hygiene false in
macro "defMq " n:ident d:term : command => `(def $n {dom : DomainConfig} (start : Signal dom Bool) (writeEn : Signal dom Bool)
    (writeAddr : Signal dom (BitVec 4)) (writeData : Signal dom (BitVec 16)) :
    Signal dom (BitVec 16 × BitVec 5 × Bool) :=
  let state := Signal.loop fun state =>
    let idx := QState.idx state
    let busy := QState.busy state
    let readAddr4 := idx.map (BitVec.extractLsb' 0 4 ·)
    let inputCoeff := Signal.memoryComboRead writeAddr ($d) writeEn readAddr4
    let outMemRead := Signal.memory readAddr4 inputCoeff busy (Signal.pure 0#4)
    let done := busy &&& (idx === 15#5)
    let busyNext := Signal.mux done (Signal.pure false) (Signal.mux start (Signal.pure true) busy)
    let idxNext := Signal.mux busy (idx + 1#5) (Signal.pure 0#5)
    bundleAll! [Signal.register 0#5 idxNext, Signal.register false busyNext, Signal.register 0#16 outMemRead]
  bundle2 (QState.last state) (bundle2 (QState.idx state) (QState.busy state)))

namespace VedMc
defMq m0 writeData
defMq m1a writeData
defMq m1b writeData
defMq m1c writeData
defMq m2 writeData
defMq m2other (writeData + 1#16)

def one {dom : DomainConfig} (writeEn : Signal dom Bool) (writeAddr : Signal dom (BitVec 4))
    (writeData : Signal dom (BitVec 16)) (readAddr : Signal dom (BitVec 4)) : Signal dom (BitVec 16) :=
  Signal.memoryComboRead writeAddr writeData writeEn readAddr

def reg2 (a : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8 × BitVec 8) :=
  bundle2 (Signal.register 0#8 a) a

/-! M0 -/
#writeDesign m0 ".lake/build/gen/u1memctl/m0.sv" ".lake/build/gen/u1memctl/m0_cppsim.h"
#ved_write_checked mem_packed m0 ".lake/build/gen/u1memctl/m0.sv" ".lake/build/gen/u1memctl/m0_cppsim.h"
#vedu1_mexpect "M0" m0 ".lake/build/gen/u1memctl/m0.sv" ".lake/build/gen/u1memctl/m0_cppsim.h" "THM theorem" "TYPE exact" "CONTRACT bound-to-mod" "MOD closed=true type=true" "SLICES expected=[(6,16),(1,5),(0,1)] stored=[(6,16),(1,5),(0,1)] equal" "WRITTEN sv=equal cpp=equal" "AXIOMS [Classical.choice, Quot.sound, propext]"

