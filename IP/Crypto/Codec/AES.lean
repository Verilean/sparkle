@[inline] def sboxByte (b : UInt8) : UInt8 := sbox[b.toNat]!
@[inline] def invSboxByte (b : UInt8) : UInt8 := invSbox[b.toNat]!

/-! ### GF(2^8) multiplication, used in MixColumns. -/

/-- xtime(x) = x * {02} in GF(2^8) with reduction poly
    x^8 + x^4 + x^3 + x + 1 = 0x11b. -/
@[inline] def xtime (b : UInt8) : UInt8 :=
  let shifted := b.toNat <<< 1
  let masked := shifted &&& 0xFF
  let result := if (b.toNat &&& 0x80) ≠ 0 then masked ^^^ 0x1B else masked
  UInt8.ofNat result

/-- GF(2^8) multiplication via repeated xtime + XOR. -/
def gmul (a b : UInt8) : UInt8 := Id.run do
  let mut result : UInt8 := 0
  let mut aCur := a
  let mut bCur := b.toNat
  for _ in [:8] do
    if bCur &&& 1 ≠ 0 then
      result := result ^^^ aCur
    aCur := xtime aCur
    bCur := bCur >>> 1
  return result

/-! ### State helpers.  State is `Array UInt8` of length 16,
    column-major (s[c*4 + r] = byte at row r, column c). -/

abbrev State := Array UInt8

def emptyState : State := Array.replicate 16 0

@[inline] def getByte (s : State) (r c : Nat) : UInt8 := s[c * 4 + r]!
@[inline] def setByte (s : State) (r c : Nat) (v : UInt8) : State :=
  s.set! (c * 4 + r) v

/-! ### Round transformations. -/

def subBytes (s : State) : State := s.map sboxByte
def invSubBytes (s : State) : State := s.map invSboxByte

/-- ShiftRows: row r is cyclically shifted left by r bytes. -/
def shiftRows (s : State) : State := Id.run do
  let mut out := emptyState
  for r in [:4] do
    for c in [:4] do
      out := setByte out r c (getByte s r ((c + r) % 4))
  return out

def invShiftRows (s : State) : State := Id.run do
  let mut out := emptyState
  for r in [:4] do
    for c in [:4] do
      -- inverse: column c gets byte from column (c - r) mod 4
      let src := (c + 4 - r) % 4
      out := setByte out r c (getByte s r src)
  return out

/-- MixColumns: each column is multiplied by the fixed
    matrix [[2,3,1,1],[1,2,3,1],[1,1,2,3],[3,1,1,2]] in GF(2^8). -/
def mixColumns (s : State) : State := Id.run do
  let mut out := emptyState
  for c in [:4] do
    let s0 := getByte s 0 c
    let s1 := getByte s 1 c
    let s2 := getByte s 2 c
    let s3 := getByte s 3 c
    let t0 := gmul 2 s0 ^^^ gmul 3 s1 ^^^ s2 ^^^ s3
    let t1 := s0 ^^^ gmul 2 s1 ^^^ gmul 3 s2 ^^^ s3
    let t2 := s0 ^^^ s1 ^^^ gmul 2 s2 ^^^ gmul 3 s3
    let t3 := gmul 3 s0 ^^^ s1 ^^^ s2 ^^^ gmul 2 s3
    out := setByte out 0 c t0
    out := setByte out 1 c t1
    out := setByte out 2 c t2
    out := setByte out 3 c t3
  return out

/-- Inverse MixColumns: multiply each column by the inverse
    matrix [[14,11,13,9],[9,14,11,13],[13,9,14,11],[11,13,9,14]]. -/
def invMixColumns (s : State) : State := Id.run do
  let mut out := emptyState
  for c in [:4] do
    let s0 := getByte s 0 c
    let s1 := getByte s 1 c
    let s2 := getByte s 2 c
    let s3 := getByte s 3 c
    let t0 := gmul 0x0e s0 ^^^ gmul 0x0b s1 ^^^ gmul 0x0d s2 ^^^ gmul 0x09 s3
    let t1 := gmul 0x09 s0 ^^^ gmul 0x0e s1 ^^^ gmul 0x0b s2 ^^^ gmul 0x0d s3
    let t2 := gmul 0x0d s0 ^^^ gmul 0x09 s1 ^^^ gmul 0x0e s2 ^^^ gmul 0x0b s3
    let t3 := gmul 0x0b s0 ^^^ gmul 0x0d s1 ^^^ gmul 0x09 s2 ^^^ gmul 0x0e s3
    out := setByte out 0 c t0
    out := setByte out 1 c t1
    out := setByte out 2 c t2
    out := setByte out 3 c t3
  return out

/-- AddRoundKey: XOR the state with the round key (both 16 bytes). -/
def addRoundKey (s : State) (k : Array UInt8) : State := Id.run do
  let mut out := s
  for i in [:16] do
    out := out.set! i ((out[i]!) ^^^ (k[i]!))
  return out

/-! ### Key expansion (FIPS 197 §5.2).

    For AES-128: 11 round keys × 16 bytes = 176 bytes,
    arranged as 44 4-byte words.  Each word w[i] is derived
    from w[i-1] and w[i-4]: when i % 4 = 0, transform
    w[i-1] via SubWord(RotWord(.)) ^ Rcon[i/4 - 1]. -/

/-- Round constants for AES-128 (Rcon[1..10]).
    Each is a 4-byte word with high byte = 2^(i-1) in GF(2^8). -/
def rcon : Array UInt8 := #[ 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36 ]

/-- Expand a 16-byte AES-128 key into 176 bytes (11 round keys). -/
def keyExpansion (key : Array UInt8) : Array UInt8 := Id.run do
  let mut w : Array UInt8 := Array.replicate 176 0
  -- Copy initial key.
  for i in [:16] do
    w := w.set! i key[i]!
  -- Generate the rest 4 bytes at a time.
  for i in [4:44] do
    let mut t0 := w[(i - 1) * 4]!
    let mut t1 := w[(i - 1) * 4 + 1]!
    let mut t2 := w[(i - 1) * 4 + 2]!
    let mut t3 := w[(i - 1) * 4 + 3]!
    if i % 4 = 0 then
      -- RotWord: rotate left by 1 byte.
      let r0 := t1; let r1 := t2; let r2 := t3; let r3 := t0
      -- SubWord: S-box each byte.
      t0 := sboxByte r0
      t1 := sboxByte r1
      t2 := sboxByte r2
      t3 := sboxByte r3
      -- XOR Rcon (only on byte 0).
      t0 := t0 ^^^ rcon[i / 4 - 1]!
    -- w[i] = w[i-4] XOR t
    w := w.set! (i * 4)     ((w[(i - 4) * 4]!) ^^^ t0)
    w := w.set! (i * 4 + 1) ((w[(i - 4) * 4 + 1]!) ^^^ t1)
    w := w.set! (i * 4 + 2) ((w[(i - 4) * 4 + 2]!) ^^^ t2)
    w := w.set! (i * 4 + 3) ((w[(i - 4) * 4 + 3]!) ^^^ t3)
  return w

/-- Extract round key `r` (0..10) from the expanded key. -/
def roundKey (expanded : Array UInt8) (r : Nat) : Array UInt8 := Id.run do
  let mut k : Array UInt8 := Array.replicate 16 0
  for i in [:16] do
    k := k.set! i expanded[r * 16 + i]!
  return k

/-! ### Encryption / decryption. -/

/-- AES-128 encrypt one 16-byte block. -/
def encryptBlock (key block : Array UInt8) : Array UInt8 := Id.run do
  let expanded := keyExpansion key
  let mut s := block
  s := addRoundKey s (roundKey expanded 0)
  for r in [1:10] do
    s := subBytes s
    s := shiftRows s
    s := mixColumns s
    s := addRoundKey s (roundKey expanded r)
  s := subBytes s
  s := shiftRows s
  s := addRoundKey s (roundKey expanded 10)
  return s

/-- AES-128 decrypt one 16-byte block. -/
def decryptBlock (key block : Array UInt8) : Array UInt8 := Id.run do
  let expanded := keyExpansion key
  let mut s := block
  s := addRoundKey s (roundKey expanded 10)
  for r' in [1:10] do
    let r := 10 - r'
    s := invShiftRows s
    s := invSubBytes s
    s := addRoundKey s (roundKey expanded r)
    s := invMixColumns s
  s := invShiftRows s
  s := invSubBytes s
  s := addRoundKey s (roundKey expanded 0)
  return s

end Sparkle.IP.Crypto.AES
