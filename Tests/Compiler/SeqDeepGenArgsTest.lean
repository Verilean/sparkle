/-- Two DIFFERENT argument lists of the same child (before unit SR3u this was REFUSED). -/
def topargs (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let m2 := wrap w v
    r <~ Signal.mux (m.odd &&& m2.odd &&& en) (rs + v) rs
    return rs

#machine_endpoint topargs

/-- THREE calls of `wrap`, three distinct argument lists, both fields of some calls, groups interleaved. -/
def toptwo (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let m2 := wrap w v
    let m3 := wrap v v
    r <~ Signal.mux (m.odd &&& m2.odd &&& m3.odd &&& en) (rs + m3.s) (rs + m.s + m2.s)
    return rs

#machine_endpoint toptwo

/-- OUTSIDE the class (the NEXT axis): two DIFFERENT non-leaf children, `wrap` and `wrap2`. -/
@[hardware_module] def wrap2 {dom : DomainConfig} (x y : Signal dom (BitVec 8)) : AccOut dom :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal dom (BitVec 8))
    let a := acc x
    r <~ a.s + y
    return ({ s := rs, odd := a.odd } : AccOut dom)

def topdiff (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let m2 := wrap2 w v
    r <~ Signal.mux (m.odd &&& m2.odd &&& en) (rs + v) rs
    return rs

#machine_endpoint topdiff

