open Lean Meta Elab Command in
def auditInst (ep root child leaf : Name) : MetaM Unit := do
  let bnd := (← getConstInfo (root ++ `epD2_Bnd)).value!
  let mut defs : Array Name := #[]
  let mut todo : Array Expr := #[bnd]
  while !todo.isEmpty do
    let e := todo.back!
    todo := todo.pop
    if e.getAppFn.isConstOf ``Tools.ShippingMachineEntry.MachineDefines && e.getAppNumArgs == 6 then
      defs := defs.push (← Tools.ShippingSeqParentGen.readName e.getAppArgs[4]!)
    match e with
    | .app f a => todo := todo.push f |>.push a
    | .lam _ t b _ | .forallE _ t b _ => todo := todo.push t |>.push b
    | .mdata _ b => todo := todo.push b
    | _ => pure ()
  unless defs.toList.mergeSort (·.toString ≤ ·.toString) == [child, leaf].mergeSort (·.toString ≤ ·.toString) do
    throwError "SR3u AUDIT FAILED: {root}.epD2_Bnd asks MachineDefines for {defs}, expected {child} and {leaf}"
  let cl ← Tests.Compiler.ChildVertAuditTest.depClosure ep
  for must in [child ++ `machineData, leaf ++ `machineData, root ++ `machineData] do
    unless cl.contains must do throwError "SR3u AUDIT FAILED: {must} not in the closure of {ep}"
  for mustNot in [``Sparkle.Tests.Compiler.ShippingMachineSeqTest.grand.machineData, ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.mid.machineData,
      ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt.machineData, ``Tests.Compiler.SeqDeepGenInstTest.topw.epD2_endpoint] do
    if cl.contains mustNot then throwError "SR3u AUDIT FAILED: {mustNot} is in the closure of {ep}"
  let ty := (← getConstInfo ep).type
  let premises ← forallTelescope ty fun xs _ => do
    let mut ps : Array String := #[]
    for x in xs do
      if (← isProp (← inferType x)) then ps := ps.push s!"{(← x.fvarId!.getUserName)}"
    return ps
  unless premises.toList == ["hr", "entry", "closes"] do throwError "SR3u AUDIT FAILED: premises {premises}"
  logInfo m!"SR3u: {root} -> {child} -> {leaf} generated; MachineDefines exactly {defs}; outer premises {premises}; closure has the data of the three declarations, none of grand/mid/cnt/topw"

open Lean Meta Elab Command in
run_cmd liftTermElabM do
  auditInst ``Tests.Compiler.SeqDeepGenArgsTest.topargs.epD2_endpoint ``Tests.Compiler.SeqDeepGenArgsTest.topargs ``Tests.Compiler.SeqDeepGenInstTest.wrap
    ``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.acc
  auditInst ``Tests.Compiler.SeqDeepGenArgsTest.toptwo.epD2_endpoint ``Tests.Compiler.SeqDeepGenArgsTest.toptwo ``Tests.Compiler.SeqDeepGenInstTest.wrap
    ``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.acc

