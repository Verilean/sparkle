  let NT := `Tests.Compiler.SharedLeafMemKidIfaceTest
  let NA := `Tests.Compiler.SharedLeafMemKidIfaceAuditSrm4
  let pairs : List (Name × Name × List Name) :=
    [(NT ++ `leafM_seqChildRunN, NA ++ `leafM_seqChildRunN_Full, [NA ++ `leafM_seqChildRunN_M1]),
     (NT ++ `wrapM_seqChildRunN2, NA ++ `wrapM_seqChildRunN2_Full, [NA ++ `wrapM_seqChildRunN2_M1, NA ++ `wrapM_seqChildRunN2_M2]),
     (NT ++ `leafM_kidFactsNC, NA ++ `leafM_kidFactsNC_Full, [NA ++ `leafM_kidFactsNC_M1, NA ++ `leafM_kidFactsNC_M2]),
     (NT ++ `wrapM_kidFactsNC, NA ++ `wrapM_kidFactsNC_Full, [NA ++ `wrapM_kidFactsNC_M1, NA ++ `wrapM_kidFactsNC_M2]),
     (NT ++ `wrapQ_kidFactsNC, NA ++ `wrapQ_kidFactsNC_Full, [NA ++ `wrapQ_kidFactsNC_M1, NA ++ `wrapQ_kidFactsNC_M2]),
     (NT ++ `topshareM_hkid, NA ++ `topshareM_hkid_Full, [NA ++ `topshareM_hkid_M1, NA ++ `topshareM_hkid_M2]),
     (NT ++ `topshareM_ranA, NA ++ `topshareM_ranA_Full, [NA ++ `topshareM_ranA_M1, NA ++ `topshareM_ranA_M2]),
     (NT ++ `topshareM_runFacts, NA ++ `topshareM_runFacts_Full, [NA ++ `topshareM_runFacts_M1, NA ++ `topshareM_runFacts_M2]),
     (NT ++ `topshareM_outsCheck, NA ++ `topshareM_outsCheck_Full, [NA ++ `topshareM_outsCheck_M1, NA ++ `topshareM_outsCheck_M2]),
     (NT ++ `topshareM_kidsMasked, NA ++ `topshareM_kidsMasked_Full, [NA ++ `topshareM_kidsMasked_M1, NA ++ `topshareM_kidsMasked_M2]),
     (NT ++ `topshareM_designCheck_of_kidsPass, NA ++ `topshareM_designCheck_of_kidsPass_Full, [NA ++ `topshareM_designCheck_of_kidsPass_M1, NA ++ `topshareM_designCheck_of_kidsPass_M2]),
     (NT ++ `topshareM_traceXA, NA ++ `topshareM_traceXA_Full, [NA ++ `topshareM_traceXA_M1, NA ++ `topshareM_traceXA_M2]),
     (NT ++ `topshareM_hcallsNW, NA ++ `topshareM_hcallsNW_Full, [NA ++ `topshareM_hcallsNW_M1, NA ++ `topshareM_hcallsNW_M2]),
     (NT ++ `topshareM_composedNW, NA ++ `topshareM_composedNW_Full, [NA ++ `topshareM_composedNW_M1, NA ++ `topshareM_composedNW_M2]),
     (NT ++ `topshareQ_hkid, NA ++ `topshareQ_hkid_Full, [NA ++ `topshareQ_hkid_M1, NA ++ `topshareQ_hkid_M2]),
     (NT ++ `topshareQ_ranA, NA ++ `topshareQ_ranA_Full, [NA ++ `topshareQ_ranA_M1, NA ++ `topshareQ_ranA_M2]),
     (NT ++ `topshareQ_runFacts, NA ++ `topshareQ_runFacts_Full, [NA ++ `topshareQ_runFacts_M1, NA ++ `topshareQ_runFacts_M2]),
     (NT ++ `topshareQ_outsCheck, NA ++ `topshareQ_outsCheck_Full, [NA ++ `topshareQ_outsCheck_M1, NA ++ `topshareQ_outsCheck_M2]),
     (NT ++ `topshareQ_kidsMasked, NA ++ `topshareQ_kidsMasked_Full, [NA ++ `topshareQ_kidsMasked_M1, NA ++ `topshareQ_kidsMasked_M2]),
     (NT ++ `topshareQ_designCheck_of_kidsPass, NA ++ `topshareQ_designCheck_of_kidsPass_Full, [NA ++ `topshareQ_designCheck_of_kidsPass_M1, NA ++ `topshareQ_designCheck_of_kidsPass_M2]),
     (NT ++ `topshareQ_traceXA, NA ++ `topshareQ_traceXA_Full, [NA ++ `topshareQ_traceXA_M1, NA ++ `topshareQ_traceXA_M2])]
  for (thm, full, muts) in pairs do
    let gt ← instantiateMVars (← getConstInfo thm).type
    for (e, what) in [(gt, "the theorem's type"), (mkConst full, "the expected full type")] ++ muts.map fun c => (mkConst c, s!"mutation {c}") do
      if e.hasMVar || e.hasFVar then throwError "SRM4 AUDIT FAILED: metavariables / free variables in {what}"
      Meta.check e
    let pos ← withCurrHeartbeats (withTransparency .default (isDefEq gt (mkConst full)))
    unless pos do
      throwError "SRM4 AUDIT FAILED: the FULL type of {thm} is not definitionally the hand-written {full}"
    for c in muts do
      if (← withCurrHeartbeats (withReducible (isDefEq gt (mkConst c)))) then throwError "SRM4 AUDIT FAILED: the mutated full type of {thm} ({c}) was ACCEPTED"
    stdAxioms thm
    logInfo m!"SRM4 AUDIT: the full forall-type of {thm} is isDefEq (default transparency) to {full}; {muts.length} type-correct mutations are REJECTED (at reducible transparency); standard axioms only"

