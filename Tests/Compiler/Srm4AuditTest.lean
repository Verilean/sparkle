  -- CONTROL: the old-form memory-kid theorem IS caught by the same walk
  let ctl ← depClosure `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM
  unless (ctl.toList.filter fun c => forbidden.any (·.isPrefixOf c)).length > 0 do throwError "SRM4 AUDIT FAILED: control walk found no old-form constant"
  for thm in thms do
    let cl ← depClosure thm
    let bad := hits cl
    unless bad.isEmpty do throwError "SRM4 AUDIT FAILED: old RefLaws boundary in the closure of {thm}: {bad}"
    let bad2 := cl.toList.filter fun c => forbidden.any (·.isPrefixOf c)
    unless bad2.isEmpty do throwError "SRM4 AUDIT FAILED: old-form boundary in the closure of {thm}: {bad2}"
    let bad3 := cl.toList.filter fun c => (c.getPrefix.toString.startsWith "Tools.ShippingMemKid" || c.getPrefix.toString.startsWith "Tools.ShippingKidsChildIfaceM") && (c.getString!.startsWith "core_" || c.getString!.startsWith "kids")
    unless bad3.isEmpty do throwError "SRM4 AUDIT FAILED: old-form memory-kid chain in the closure of {thm}: {bad3}"
    -- the A-form memory lemmas ARE in the closure (what is claimed is what is used)
    let has (x : String) : Bool := (thm.toString.splitOn x).length > 1
    let must : List Name :=
      (if has "kidFactsNC" then [``Tools.ShippingSrm4Kid.memCallee_kidFactsNC, ``Tools.ShippingSrm4Core6.deepChild_kidFactsNC, ``Tools.ShippingSrm4Core5.deepChild_ranAM, ``Tools.ShippingSrm3Iface.core_kids_facts_ranAM] else []) ++
      (if has "hkid" then [``Tools.ShippingSrm4Core6.deepChild_kidFactsNC] else []) ++
      (if has "seqChildRunN" && has "leafM" then [``Tools.ShippingSrm4Run.memCallee_seqChildRunN, ``Tools.ShippingSrm4Run.memCallee_composedNW] else []) ++
      (if has "wrapM_seqChildRunN2" then [``Tools.ShippingSrm4Callee.memLeafCallee_seqChildRunN2, ``Tools.ShippingSrm4Callee.memLeafCallee_composedNW, ``Tools.ShippingSrm4Callee.memLeafCallee_hcalls] else []) ++
      (if has "runFacts" then [``Tools.ShippingSrm4Parent.kidsNC_runFacts] else []) ++
      (if has "designCheck" then [``Tools.ShippingSrm4Parent.kidsNC_designCheck_of_kidsPass] else [])
    for m in must do
      unless cl.contains m do throwError "SRM4 AUDIT FAILED: {m} not in the closure of {thm}"
    stdAxioms thm
    logInfo m!"SRM4 CLOSURE AUDIT: {thm}: standard axioms; closure {cl.size} constants; no old-form RealChild / InvW / MachineRan / MachineClosesAt / Kid / kidsChild_of_realM / ChildBnd / GenKid / KidFacts / CacheClosed; the A-form memory lemmas are in it"

end
