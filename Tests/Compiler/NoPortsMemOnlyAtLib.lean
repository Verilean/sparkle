import Tests.Compiler.NoPortsMemOnlyCounterTest

/-! # Memory-only parents under `MachineClosesAt`: the shared data log, generator call and audit (G1, unit U4, round par/b-15)

Used by the five tests `Tests/Compiler/NoPortsMemOnlyAt<Decl>Test.lean`
(`memCounter`, `syncNarrow`, `twoMems`, `mixedMems`, `memWide`). Nothing here
is a theorem about the compiler; no general theorem is added.

## The endpoint and its BASE statement

`f.machine_design_noPortsR0` is generated by the BUILT
`Tests.Compiler.NoPortsMemOnly.generateM0 … (atForm := true)`
(`Tests/Compiler/NoPortsMemOnlyCounterTest.lean` 223–316; run once, for
`memCounter`, by the log-only `NoPortsMemOnlyAtProbe`, run
20261013-061529-b14-tests).

There is NO `f.machine_design_svR0` for a memory-only parent
(`#machine_design_svR0 memCounter` refuses: "no sequential child", MEASURED).
The four check premises are therefore counted as absent AGAINST
`f.machine_design_sv0` — and `f.machine_design_noPortsR0` is a NEW statement,
not that endpoint with premises removed. All differences (the audit asserts
1–4 and LOGS 5):

1. absent: `shipsHierCheck (childMap D.modules) b`,
   `designCheck (childMap D.modules) 0 (checkedOptimize b)`,
   `outsCheck (childMap D.modules) 0 (checkedOptimize b)`,
   `kidsMem (childMap D.modules) b.body`;
2. the closing binder is `MachineClosesAt f` in place of `MachineCloses f`:
   WEAKER in what it quantifies (invariant worlds at positive synthesis
   depth and the compiler's own logger `profLogIO b`, against every world
   and every logger; `machineClosesAt_of_closes`). It is still a premise —
   the ONE premise the goal-gap classifier does not allow;
3. ADDED: the antecedent `ChildBnd mref cref w` of the run's start world,
   where the base has the boundary `True`;
4. the same other proposition binders: the run and `MachineDefines f`;
5. the wired endpoint / composed theorem inside the proof are the `RA` twin
   (`MachineTraceLBX.toLB`) and `machine_linkedT_mem` on it — the CONCLUSION
   is the head's `DesignSV …` conclusion in both; whether the two print the
   same is LOGGED, not asserted.

Why the base's own closing premise is not kept: `MachineCloses f` cannot be
discharged for a shape with calls, memory-only included
(`Tools/ShippingMemOnlyAtAll.lean`: the closing reads the child synthesis
reference before anything else).

NAME CLASH: `Tests.Compiler.NoPortsMemOnlyAtProbe` (par/b-14) creates
`memCounter.machine_design_noPortsR0` too. No test here imports it; it must
stay target-only (never in `Tests/AllTests.lean`, never imported together
with `NoPortsMemOnlyAtMemCounterTest`) or be dropped.

UNVERIFIED at the time of writing: this file was not built. -/
namespace Tests.Compiler.NoPortsMemOnlyAt
open Lean Meta Elab Command

/-- The reader's data of a memory-only parent, LOGGED first, then asserted:
`nDecl`; every call entry one of the placeholders `mems` and every
placeholder of `mems` an entry; the general closing; a register slot; the
constants the endpoint builds on; no endpoint of this name yet. -/
def logData (f : Name) (nDecl : Nat) (mems : List Name) : MetaM Unit := do
  let rf ← Tools.ShippingMachineCommand.readMachine f
  let fe := rf.shape.insts.map (·.1)
  let env ← getEnv
  let mut have_ : List Name := []
  let mut lack : List Name := []
  for s in [`machineData, `machine_ok, `machine_body, `machine_sound, `machine_composedT,
      `machine_closes, `machine_ships_hier, `machine_ships_hierR, `machine_design_sv0,
      `machine_design_svR0, `machine_design_noPorts0, `machine_design_noPortsR0,
      `machine_design_noPortsR0_closed] do
    if env.contains (f ++ s) then have_ := have_ ++ [s] else lack := lack ++ [s]
  logInfo m!"NOPORTS MEMONLY AT DATA {f}: nDecl={rf.nDecl}, binders={rf.shape.binders.length}, call entries {fe}, argument lets {rf.shape.insts.map (·.2.1)}, instFields={rf.shape.instFields}, slots={rf.shape.layout.slots.length}, lets={rf.shape.layout.lets}, outputs {rf.shape.layout.outs.map (·.name)}, loops={rf.shape.loops.length}; the memory placeholders expected {mems}; constants present {have_}; absent {lack}"
  unless rf.nDecl == nDecl do
    throwError "{f}: nDecl = {rf.nDecl}, the hand theorems are written for {nDecl}"
  if fe.isEmpty then throwError "{f}: no call entry"
  for e in fe do
    unless mems.contains e do
      throwError "{f}: the call entries are {fe}; {e} is none of {mems}"
  for m in mems do
    unless fe.contains m do
      throwError "{f}: the call entries are {fe}; the placeholder {m} is not among them (the file's description is wrong)"
  if rf.shape.instFields.isEmpty then throwError "{f}: instFields = [] — not the general closing"
  if rf.shape.layout.slots.isEmpty then
    throwError "{f}: NO REGISTER SLOT — hsl : d.shape.layout.slots ≠ [] of kidsM_runFacts / kidsM_designCheck fails; nothing below applies"
  for n in [f ++ `machine_ships_hier, f ++ `machine_design_sv0, f ++ `machineData,
      f ++ `machine_ok, f ++ `machine_body, f ++ `machine_composedT] do
    unless env.contains n do throwError "{n}: not in the imports (this file builds on it)"
  let r0 := f ++ `machine_design_noPortsR0
  if env.contains r0 then
    throwError "{r0}: exists already — is Tests.Compiler.NoPortsMemOnlyAtProbe imported? (it must stay target-only)"

/-- `f.machine_design_noPortsR0` by the built generator, at-form. -/
def generateAt (f facts outs mem design : Name) : MetaM Name :=
  Lean.withOptions (fun o => Lean.Elab.async.set o false) <|
    Tests.Compiler.NoPortsMemOnly.generateM0 f facts outs mem design (atForm := true)

/-- The first conjunct and the conclusion of an endpoint body
`∃ w…, P ∧ (A₁ → … → C)`, printed. -/
partial def innerParts (ty : Lean.Expr) : MetaM (String × String) := do
  if ty.isAppOfArity ``Exists 2 then
    let α := ty.getArg! 0
    let p := ty.getArg! 1
    let nm := if p.isLambda then p.bindingName! else `w
    withLocalDeclD nm α fun w => innerParts (mkApp p w).headBeta
  else if ty.isAppOfArity ``And 2 then
    let mut R := ty.getArg! 1
    while (← Tools.ShippingFinalGoalCommand.isPropArrow R) do
      R := R.bindingBody!
    return (toString (← ppExpr (ty.getArg! 0)), toString (← ppExpr R))
  else
    throwError "expected ∃ … , P ∧ (…), found{indentExpr ty}"

/-- The audit of `f.machine_design_noPortsR0` against the base
`f.machine_design_sv0` (an error on any failure):

* standard axioms of the general theorems, of `thms` and of the endpoint;
* the endpoint's statement mentions no checker constant, while the base
  mentions `shipsHierCheck`, `kidsMem`, `designCheck`, `outsCheck`;
* the base asks `MachineCloses` (not the at-form, not `ChildBnd`; its
  boundary prints `True`); the endpoint asks `MachineClosesAt` and not
  `MachineCloses`;
* the endpoint has three proposition binders; EXACTLY ONE is not allowed by
  the goal-gap classifier, and it is `MachineClosesAt … f f.machineData.shape`;
* under the existentials ONE antecedent, allowed, and the statement mentions
  `ChildBnd`;
* no `_closed` form exists.

LOGGED: the premise list, both binder lists, both antecedent lists, whether
the first conjunct and the conclusion print the same as the base's. -/
def auditAt (f : Name) (thms : List Name) : MetaM Unit := do
  let old := f ++ `machine_design_sv0
  let openN := f ++ `machine_design_noPortsR0
  let dataN := f ++ `machineData
  -- (a) standard axioms
  for n in [``Tools.ShippingMemOnly.kidsMem_of, ``Tools.ShippingMemOnly.core_kidsMemM,
      ``Tools.ShippingMemOnly.memOnly_kids, ``Tools.ShippingMemOnly.memOnly_runFacts,
      ``Tools.ShippingMemOnly.memOnly_outsCheck, ``Tools.ShippingMemOnly.memOnly_kidsMem,
      ``Tools.ShippingMemOnly.memOnly_designCheck, ``Tools.ShippingMemKid.memKid_facts,
      ``Tools.ShippingMemKid.kidsM_runFacts, ``Tools.ShippingMemKid.kidsM_outsCheck,
      ``Tools.ShippingMemKid.kidsM_designCheck, ``Tools.ShippingMemKid.core_callStmtM] ++
      thms ++ [openN] do
    unless (← getEnv).contains n do throwError "{n}: missing"
    Tests.Compiler.NoPortsTest.stdAxioms n
  -- (b) no closed form (nothing here proves the closing)
  for s in [`machine_design_noPortsR0_closed, `machine_design_noPortsR0_closed_gap,
      `machine_design_noPortsR0_closedB, `machine_design_noPorts0_closed] do
    if (← getEnv).contains (f ++ s) then
      throwError "{f ++ s}: a closed form EXISTS — this audit states that MachineClosesAt is still a premise; re-read the report"
  -- (c) the endpoint's statement mentions no checker constant
  let openT := (← getConstInfo openN).type
  for k in Tests.Compiler.NoPortsTest.checkers ++ Tests.Compiler.NoPortsMemOnly.forbiddenMem do
    if (openT.find? (·.isConstOf k)).isSome then
      throwError "{openN}: the statement mentions {k}"
  -- (d) the inventory: the base endpoint asks the four check premises
  let oldT := (← getConstInfo old).type
  for k in [``Tools.ShippingHierPremisesBase.shipsHierCheck,
      ``Tools.ShippingMachineShipsHier.kidsMem, ``Tools.ShippingDesignSV.designCheck,
      ``Tools.ShippingDesignSVBack.outsCheck] do
    unless (oldT.find? (·.isConstOf k)).isSome do
      throwError "{old}: does not mention {k} (the inventory is wrong)"
  -- (e) the closing: all-worlds in the base, at-form in the endpoint
  unless (oldT.find? (·.isConstOf ``Tools.ShippingMachineEntry.MachineCloses)).isSome do
    throwError "{old}: does not ask MachineCloses (the report says the base asks the all-worlds form)"
  if (oldT.find? (·.isConstOf ``Tools.ShippingChildInv.MachineClosesAt)).isSome then
    throwError "{old}: mentions MachineClosesAt (the report says the all-worlds form)"
  if (oldT.find? (·.isConstOf ``Tools.ShippingChildInv.ChildBnd)).isSome then
    throwError "{old}: asks ChildBnd already (the report says it is ADDED)"
  unless (openT.find? (·.isConstOf ``Tools.ShippingChildInv.MachineClosesAt)).isSome do
    throwError "{openN}: does not ask MachineClosesAt"
  if (openT.find? (·.isConstOf ``Tools.ShippingMachineEntry.MachineCloses)).isSome then
    throwError "{openN}: mentions MachineCloses (the all-worlds form)"
  unless (openT.find? (·.isConstOf ``Tools.ShippingChildInv.ChildBnd)).isSome do
    throwError "{openN}: does not ask ChildBnd (the report says it is the one antecedent)"
  -- (f) the proposition binders: three; exactly one NOT ALLOWED, `MachineClosesAt f`
  let nBad ← forallTelescope openT fun xs _ => do
    let mut nProp : Nat := 0
    let mut nBad : Nat := 0
    for x in xs do
      let t ← instantiateMVars (← inferType x)
      if ← isProp t then
        nProp := nProp + 1
        unless Tools.ShippingFinalGoalCommand.allowed t do
          nBad := nBad + 1
          unless t.isAppOfArity ``Tools.ShippingChildInv.MachineClosesAt 6 do
            throwError "{openN}: a binder NOT ALLOWED that is not MachineClosesAt:{indentExpr t}"
          unless ← isDefEq (t.getArg! 4) (toExpr f) do
            throwError "{openN}: its MachineClosesAt is of{indentExpr (t.getArg! 4)}\nnot of {f}"
          unless ((t.getArg! 5).find? (·.isConstOf dataN)).isSome do
            throwError "{openN}: its MachineClosesAt is of the shape{indentExpr (t.getArg! 5)}\nnot of {dataN}"
    unless nProp == 3 do
      throwError "{openN}: {nProp} proposition binders, expected 3 (the run, MachineDefines, MachineClosesAt)"
    pure nBad
  unless nBad == 1 do
    throwError "{openN}: {nBad} binders NOT ALLOWED, expected exactly 1 (MachineClosesAt {f})"
  -- (g) under the existentials: exactly one antecedent, allowed (`ChildBnd`)
  let inner ← forallTelescope openT fun _ body =>
    Tests.Compiler.NoPortsTest.innerAntecedents body
  let innerOld ← forallTelescope oldT fun _ body =>
    Tests.Compiler.NoPortsTest.innerAntecedents body
  logInfo m!"NOPORTS MEMONLY AT ANTECEDENTS {old}: {innerOld.size} — {innerOld.map (·.1)}"
  logInfo m!"NOPORTS MEMONLY AT ANTECEDENTS {openN}: {inner.size} — {inner.map (·.1)}"
  unless inner.size == 1 do
    throwError "{openN}: {inner.size} antecedents under the existentials, expected 1 (ChildBnd): {inner.map (·.1)}"
  for (s, ok) in inner do
    unless ok do throwError "{openN}: an antecedent NOT ALLOWED under the existentials: {s}"
  unless innerOld.any (fun x => x.1 == "True") do
    throwError "{old}: no antecedent printed True (the report says the base's boundary is True): {innerOld.map (·.1)}"
  -- (h) the complete premise list by the goal-gap classifier: exactly one NOT ALLOWED
  let (lines, bad) ← Tests.Compiler.NoPortsTest.premiseLines openN
  logInfo m!"{String.intercalate "\n" lines.toList}"
  unless bad.size == 1 do
    throwError "{openN}: the classifier lists {bad.size} premises NOT ALLOWED, expected exactly 1:\n{String.intercalate "\n" bad.toList}"
  -- (i) LOGGED only: the binders of both, and whether the bodies print the same
  let bOld ← Tests.Compiler.NoPortsMemOnly.propBinders oldT
  let bNew ← Tests.Compiler.NoPortsMemOnly.propBinders openT
  logInfo m!"NOPORTS MEMONLY AT BINDERS {old}: {bOld}"
  logInfo m!"NOPORTS MEMONLY AT BINDERS {openN}: {bNew}"
  let cmpBodies : MetaM String := do
    let (pO, cO) ← forallTelescope oldT fun _ body => innerParts body
    let (pN, cN) ← forallTelescope openT fun _ body => innerParts body
    pure s!"first conjunct prints the same: {pO == pN}; conclusion prints the same: {cO == cN}"
  let same ← cmpBodies <|> pure "the bodies could not be compared"
  let open0 := f ++ `machine_design_noPorts0
  let hasOpen0 : String := if (← getEnv).contains open0 then "yes" else "no"
  logInfo m!"NOPORTS MEMONLY AT AUDIT {f}: {openN} on standard axioms, with the general theorems of Tools.ShippingMemOnly (kidsMem_of, core_kidsMemM, memOnly_*) over the built Tools.ShippingMemKid and the hand lemmas {thms}. BASE: {old} (there is no machine_design_svR0 for a memory-only parent). The endpoint is a NEW statement: (1) it mentions none of portsMatchB, kidsPass, designCheck, shipsHierCheck, outsCheck, kidsMaskedN, hierCheck, kidsMixed, kidsMem, kidsMasked, while the base mentions shipsHierCheck, kidsMem, designCheck and outsCheck; (2) its closing binder is MachineClosesAt {f} (invariant worlds at positive depth, the compiler's logger) where the base has MachineCloses {f} (every world, every logger) — STILL A PREMISE, the ONE premise NOT ALLOWED ({bad.size} by the classifier), no closed form exists; (3) ADDED: the antecedent ChildBnd of the run's start world, where the base has True among its {innerOld.size} antecedents; (4) the run and MachineDefines {f} stay. Compared with the base, {same} (LOGGED, not asserted). The exchange endpoint {open0} (all-worlds closing) is in the environment: {hasOpen0}; it is not what this audit is about. SCOPE: one declaration, a memory-only parent with register slots, depth 0; data conditions decided per declaration (conditions, not reductions); compiler guards with fallback; DesignSV of the module list — not the SV string, not #sim. NOT covered: the closing, a generator, depth ≥ 1."

end Tests.Compiler.NoPortsMemOnlyAt
