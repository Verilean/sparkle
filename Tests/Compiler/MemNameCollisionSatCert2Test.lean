/-! ## The audit (an error on any failure) -/

set_option maxHeartbeats 0 in
run_cmd Lean.Elab.Command.liftTermElabM do
  let ns := `Sparkle.Tests.Compiler.MemNameCollisionGateCertTest
  let cn := `Sparkle.Tests.Compiler.MemNameCollisionGateClosedTest
  let yn := `Sparkle.Tests.Compiler.MemNameCollisionGateTypedTest
  let an := `Sparkle.Tests.Compiler.MemNameCollisionGateTypedAllTest
  let bn := `Sparkle.Tests.Compiler.MemNameCollisionGateBoundTest
  let sn := `Sparkle.Tests.Compiler.MemNameCollisionSatTest
  let kn := `Sparkle.Tests.Compiler.MemNameCollisionKidsSatTest
  let gn := `Sparkle.Tests.Compiler.MemNameCollisionGateCertGenTest
  let s2 := `Sparkle.Tests.Compiler.MemNameCollisionSatCert2Test
  for p in [`collMixSame, `collMixDiff, `collMixArgs, `collWidth] do
    let cw := s2 ++ p.appendAfter "_designClosedCW"
    let sat2 := s2 ++ p.appendAfter "_satC2"
    -- (a) the statements, as `Expr`s
    for (fin, old) in [(cw, sn ++ p.appendAfter "_designClosedBW"), (sat2, sn ++ p.appendAfter "_sat")] do
      Tests.Compiler.NoPortsTest.stdAxioms fin
      let finT ← Lean.instantiateMVars (← Lean.getConstInfo fin).type
      let oldT ← Lean.instantiateMVars (← Lean.getConstInfo old).type
      unless finT == oldT do
        throwError "{fin}: its type is not Expr-equal to {old}'s"
    -- (b) no hand-written per-parent lemma in either proof (any test namespace)
    let mut forbidden : List Lean.Name :=
      [sn ++ p.appendAfter "_designClosedBW", bn ++ p.appendAfter "_designClosedB",
       cn ++ `fakeSrc_width, an ++ `fakeN_width]
    for hN in [ns, cn, yn, an, bn, sn, kn] do
      for suf in ["_runFacts", "_outsG0", "_designP0", "_typedRun", "_names", "_gate", "_oi",
          "_inputWires", "_kidsSat", "_kidNoRegs", "_kids", "_kidTyped", "_entry", "_outChars",
          "_callWidths", "_callArgs"] do
        forbidden := (hN ++ p.appendAfter suf) :: forbidden
    for fin in [cw, sat2] do
      let some (.thmInfo fi) := (← Lean.getEnv).find? fin | throwError "{fin}: not a theorem"
      for k in forbidden do
        if (fi.value.find? (·.isConstOf k)).isSome then
          throwError "{fin}: the proof uses the hand-written {k}"
    -- (c) the routes used
    let some (.thmInfo vc) := (← Lean.getEnv).find? cw | throwError "{cw}: not a theorem"
    for k in [``Tools.ShippingGateCert2.memGate_kidsS, ``Tools.ShippingGateCert2.memGate_kidTypedS,
        ``Tools.ShippingGateCert.gateParent_runFacts, ``Tools.ShippingGateCert.gateParent_outsG0,
        ``Tools.ShippingGateCert.gateParent_designP0, ``Tools.ShippingGateCert.gateParent_typedRun,
        ``Tools.ShippingGateCert.gateParent_names, ``Tools.ShippingNoPortsTyped.machine_design_noPortsTBW,
        gn ++ p.appendAfter "_cert"] do
      unless (vc.value.find? (·.isConstOf k)).isSome do
        throwError "{cw}: the proof does not use {k}"
    let some (.thmInfo vs) := (← Lean.getEnv).find? sat2 | throwError "{sat2}: not a theorem"
    for k in [``Tools.ShippingSatCert.satOfCert, cw, gn ++ p.appendAfter "_cert"] do
      unless (vs.value.find? (·.isConstOf k)).isSome do
        throwError "{sat2}: the proof does not use {k}"
    Lean.logInfo m!"SATCERT2 AUDIT {p}: {cw} Expr-equal to {p}_designClosedBW, {sat2} Expr-equal to {p}_sat; standard axioms; no hand-written run/kid/entry lemma and no designClosedB(W) in either proof"

