/-- (SRM23 corollary, SRM24 corollary, shared binder names, binders removed, binders added): the SRM24 corollary is the SRM23 one with exactly `hW` removed -/
def srcPairs24 : List (Name × Name × List String × List String × List String) :=
  [(``Tests.Compiler.Srm23RegsTest.topshareM_regsFit_of_hstR_hst1, ``Tests.Compiler.Srm24WidthTest.topshareM_regsFit_of_hstR_hst1_noW,
      ["mctx", "mref", "cctx", "cref", "w", "w1", "b", "raw", "D", "hcore", "hpost", "entry", "hBnd", "st0"], ["hW"], []),
   (``Tests.Compiler.Srm23RegsTest.topshareQ_regsFit_of_hstR_hst1, ``Tests.Compiler.Srm24WidthTest.topshareQ_regsFit_of_hstR_hst1_noW,
      ["mctx", "mref", "cctx", "cref", "w", "w1", "b", "raw", "D", "hcore", "hpost", "entry", "hBnd", "st0"], ["hW"], [])]

abbrev Row := Nat × String × String × Bool × String

/-- normalised binder name -/
def normName (n : String) : String := if (n.splitOn "_hyg").length > 1 then "_anon" else n

/-- rows `(index, binderInfo, name, isProp, type)` of the binders of a theorem's type -/
def premiseRows (thm : Name) : MetaM (List Row) := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    let mut rows : List Row := []
    let mut i := 0
    for x in xs do
      let d ← x.fvarId!.getDecl
      let isP ← Meta.isProp d.type
      let bi := match d.binderInfo with
        | .implicit => "implicit" | .strictImplicit => "strict" | .instImplicit => "inst" | .default => "explicit"
      rows := rows ++ [(i, bi, normName d.userName.toString, isP, ((← ppExpr d.type).pretty 100000).replace "\n" " ")]
      i := i + 1
    return rows

/-- the text line of a row (the format of `scripts/srm24/PREMISES.txt`) -/
def rowLine (thm : Name) (r : Row) : String :=
  s!"S24{if r.2.2.2.1 then "PREM" else "DATA"}|{thm}|{r.1}|{r.2.1}|{r.2.2.1}|{r.2.2.2.2}"

/-- EXACT comparison of two whole tables: `none` iff equal, else the first difference -/
def tableDiff (a e : List (Name × List Row)) : Option String := Id.run do
  if a.length != e.length then return some s!"{a.length} theorems vs {e.length} expected"
  for ((n, rs), (n', rs')) in a.zip e do
    if n != n' then return some s!"theorem {n} vs expected {n'}"
    if rs.length != rs'.length then return some s!"{n}: {rs.length} binders vs {rs'.length} expected"
    for (r, r') in rs.zip rs' do
      if r != r' then return some s!"{n}: binder {r.1} differs: {rowLine n r} vs expected {rowLine n r'}"
  return none

/-- mutation 1: SEMANTIC change of the type of the first Prop binder (same index, binderInfo, name): the type string gets ` ∧ True` appended -/
def mutType (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.any (·.2.2.2.1)) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then
      let idx := (rs.findIdx? (·.2.2.2.1)).getD 0
      (n, rs.mapIdx fun i r => if i == idx then (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2 ++ " ∧ True") else r)
    else (n, rs)

/-- mutation 2: add a data binder to the first theorem -/
def mutAdd (t : List (Name × List Row)) : List (Name × List Row) :=
  t.mapIdx fun j (n, rs) => if j == 0 then (n, rs ++ [(rs.length, "implicit", "extraBinder", false, "Nat")]) else (n, rs)

/-- mutation 3: swap the first two binders of the first theorem that has two -/
def mutSwap (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.length ≥ 2) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then (match rs with | r0 :: r1 :: rest => (n, r1 :: r0 :: rest) | _ => (n, rs)) else (n, rs)

/-- does a hypothesis of `thm` restate its conclusion (reducible `isDefEq`)? -/
def restatesConclusion (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if (← Meta.isProp d.type) then
        if (← withReducible (isDefEq d.type concl)) then return true
    return false


/-- run `k` in the telescope of `thm`'s type -/
def inTelescope {α : Type} (thm : Name) (k : Array Expr → Expr → TermElabM α) : TermElabM α := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => k xs concl

/-- the fvar of the binder with user name `nm` -/
def binderNamed (xs : Array Expr) (nm : String) : MetaM (Option Expr) := do
  for x in xs do
    if (← x.fvarId!.getDecl).userName.toString == nm then return some x
  return none


/-- Standard axioms only, an error otherwise (as Tests/Compiler/ChildVertAuditTest.lean `stdAxioms`; copied so that this test does not import that integrator-only module). -/
def stdAxioms (n : Name) : MetaM Unit := do
  for ax in ← Lean.collectAxioms n do
    unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
      throwError "{n} uses a non-standard axiom: {ax}"

/-- the transitive closure of the constants `n` depends on (type, value, constructors of inductives), `n` included (as `depClosure` of ChildVertAuditTest) -/
partial def depClosure (n : Name) : MetaM NameSet := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut todo : Array Name := #[n]
  while todo.size > 0 do
    let c := todo.back!
    todo := todo.pop
    if seen.contains c then continue
    seen := seen.insert c
    match env.find? c with
    | none => pure ()
    | some ci =>
      let mut used := ci.type.getUsedConstants
      if let some v := ci.value? (allowOpaque := true) then
        used := used ++ v.getUsedConstants
      if let .inductInfo iv := ci then
        used := used ++ iv.ctors.toArray
      for u in used do
        unless seen.contains u do
          todo := todo.push u
  return seen

/-- the old-boundary names: any constant equal to or under these -/
def forbiddenRoots : List Name :=
  [`Tools.ShippingChildInv.RefLaws, `Tools.ShippingChildBndCore.RefLawsCore,
   `Tools.ShippingChildInvA.RefLawsCore.toAOps, `Tools.ShippingChildInvA.RefLawsCore.toA]

def hits (s : NameSet) : List Name :=
  s.toList.filter fun c => forbiddenRoots.any fun r => r.isPrefixOf c




def userNames (thm : Name) : MetaM (List String) := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    let mut r : List String := []
    for x in xs do r := r ++ [normName (← x.fvarId!.getDecl).userName.toString]
    return r

/-- the corollary's conclusion (after its binders) is the lemma's at the shared binders; the removed / added binder names are EXACTLY the given ones -/
def sourceDerived (lem cor : Name) (shared removed added : List String) : MetaM Unit := do
  let ln ← userNames lem
  let cn ← userNames cor
  let li ← getConstInfo lem
  let ci ← getConstInfo cor
  forallTelescope ci.type fun ys cbody => do
    let (ms, _, lbody) ← forallMetaTelescope li.type
    for s in shared do
      let some i := ln.findIdx? (· == s) | throwError "SRM24 AUDIT FAILED: {lem} has no binder {s}"
      let some j := cn.findIdx? (· == s) | throwError "SRM24 AUDIT FAILED: {cor} has no binder {s}"
      unless (← isDefEq ms[i]! ys[j]!) do throwError "SRM24 AUDIT FAILED: shared binder {s} of {cor} has not the type of {lem}"
    unless (← isDefEq lbody cbody) do throwError "SRM24 AUDIT FAILED: the conclusion of {cor} is not the conclusion of {lem}"
    let rem := (ln.filter fun n => !(cn.contains n) && n != "_anon" && n != "x" && n != "r")
    let add := (cn.filter fun n => !(ln.contains n) && n != "_anon")
    unless rem == removed do throwError "SRM24 AUDIT FAILED: binders removed from {lem} in {cor}: {rem}, expected {removed}"
    unless add == added do throwError "SRM24 AUDIT FAILED: binders added in {cor}: {add}, expected {added}"

end Tests.Compiler.Srm24AuditTest

open Tests.Compiler.Srm24AuditTest in
/-- every Prop binder type of a statement (walking `∀`, `∃`, `∧`), counted, and checked NOT defeq (for ANY parameters of the gap) to the gap Prop `gap` -/
partial def propTypesNotDefeq (gap : Name) (e : Expr) (cnt : IO.Ref Nat) : MetaM Unit := do
  let check (t : Expr) : MetaM Unit := do
    cnt.modify (· + 1)
    let gi ← getConstInfo gap
    let (ms, _, _) ← forallMetaTelescope gi.type
    if (← isDefEq t (mkAppN (mkConst gap) ms)) then throwError "SRM24 AUDIT FAILED: the gap Prop {gap} is defeq to the Prop binder type {t} (a relabelling)"
  match e with
  | .forallE .. =>
    forallTelescope e fun xs b => do
      for x in xs do
        let t ← inferType x
        if (← Meta.isProp t) then
          check t
          propTypesNotDefeq gap t cnt
      propTypesNotDefeq gap b cnt
  | .app (.app (.const ``And _) a) b => do
    check a; check b
    propTypesNotDefeq gap a cnt; propTypesNotDefeq gap b cnt
  | _ => pure ()

open Tests.Compiler.Srm24AuditTest in
run_cmd liftTermElabM do
  unless (← restatesConclusion ``Tests.Compiler.Srm24AuditTest.wrapper_mutation) do throwError "SRM24 AUDIT FAILED: the wrapper control was not caught"
  unless audited24.length == 6 do throwError "SRM24 AUDIT FAILED: audited24 has {audited24.length} theorems, expected exactly 6"
  -- (1) premise table
  let mut actual : List (Name × List Row) := []
  let mut lines : List String := []
  for thm in audited24 do
    let rows ← premiseRows thm
    actual := actual ++ [(thm, rows)]
    logInfo m!"S24THM|{thm}|{rows.length}"
    lines := lines ++ [s!"S24THM|{thm}|{rows.length}"]
    for r in rows do
      logInfo m!"{rowLine thm r}"
      lines := lines ++ [rowLine thm r]
    if (← restatesConclusion thm) then throwError "SRM24 AUDIT FAILED: a hypothesis of {thm} restates its conclusion"
  unless Tests.Compiler.Srm24AuditExpected.expectedRows.length == 6 do throwError "SRM24 AUDIT FAILED: the expected table has {Tests.Compiler.Srm24AuditExpected.expectedRows.length} theorem entries, expected exactly 6"
  match tableDiff actual Tests.Compiler.Srm24AuditExpected.expectedRows with
  | some msg => throwError "SRM24 AUDIT FAILED: the premise table differs from Tests/Compiler/Srm24AuditExpected.lean: {msg}"
  | none => pure ()
  let txt ← IO.FS.readFile "scripts/srm24/PREMISES.txt"
  let fileLines := (txt.splitOn "\n").filter (· != "")
  unless fileLines == lines do
    throwError "SRM24 AUDIT FAILED: scripts/srm24/PREMISES.txt differs from the regenerated table ({fileLines.length} lines vs {lines.length})"
  -- negative fixtures
  do
    let mt := mutType actual
    let mut changed : List (Name × Row × Row) := []
    unless mt.length == actual.length do throwError "SRM24 AUDIT FAILED: fixture 1 changed the number of theorems"
    for ((n, rs), (n', rs')) in actual.zip mt do
      unless n == n' && rs.length == rs'.length do throwError "SRM24 AUDIT FAILED: fixture 1 changed the shape of {n}"
      for (r, r') in rs.zip rs' do
        if r != r' then changed := changed ++ [(n, r, r')]
    match changed with
    | [(n, r, r')] =>
      unless r'.2.2.2.1 do throwError "SRM24 AUDIT FAILED: fixture 1 mutated row of {n} is not a Prop binder"
      unless r.2.2.2.1 && r'.1 == r.1 && r'.2.1 == r.2.1 && r'.2.2.1 == r.2.2.1 do throwError "SRM24 AUDIT FAILED: fixture 1 changed index/binderInfo/name/isProp of binder {r.1} of {n}"
      unless r'.2.2.2.2 != r.2.2.2.2 && r'.2.2.2.2.endsWith " ∧ True" && r'.2.2.2.2.length == r.2.2.2.2.length + 7 do throwError "SRM24 AUDIT FAILED: fixture 1 type string is not visibly changed"
      logInfo m!"S24FIXTURE1|{n}|binder {r.1} ({r.2.2.1})|original type: {r.2.2.2.2}|mutated type: {r'.2.2.2.2}"
      match tableDiff mt Tests.Compiler.Srm24AuditExpected.expectedRows with
      | some msg => unless (msg.splitOn s!"binder {r.1} differs").length > 1 && (msg.splitOn (toString n)).length > 1 do throwError "SRM24 AUDIT FAILED: fixture 1 rejection does not name the mutated binder"
      | none => throwError "SRM24 AUDIT FAILED: the comparator ACCEPTED fixture 1"
    | _ => throwError "SRM24 AUDIT FAILED: fixture 1 changed {changed.length} rows, expected exactly 1"
  for (nm, mt) in [("changed Prop binder type", mutType actual), ("added data binder", mutAdd actual), ("reordered binders", mutSwap actual)] do
    if mt == actual then throwError "SRM24 AUDIT FAILED: the fixture '{nm}' did not change the table (vacuous)"
    match tableDiff mt Tests.Compiler.Srm24AuditExpected.expectedRows with
    | none => throwError "SRM24 AUDIT FAILED: the comparator ACCEPTED the fixture '{nm}'"
    | some msg => logInfo m!"S24FIXTURE|{nm}|rejected: {msg}"
  logInfo m!"S24TABLE|{audited24.length} theorems, {lines.length} binders: equal to the committed table and to scripts/srm24/PREMISES.txt"
  -- (2) independent full-type expected statements
  unless pairs24.length == 6 do throwError "SRM24 AUDIT FAILED: pairs24 has {pairs24.length} entries, expected 6"
  for (t, e) in pairs24 do
    let ci ← getConstInfo t
    let ei ← getConstInfo e
    unless (← isDefEq ci.type (ei.value?.getD (mkConst e))) do throwError "SRM24 AUDIT FAILED: the statement of {t} is not defeq to its expected form {e}"
    logInfo m!"S24EXPDEFEQ|{t}|{e}|isDefEq"
  unless mutPairs24.length == 4 do throwError "SRM24 AUDIT FAILED: mutPairs24 has {mutPairs24.length} entries, expected 4"
  for (thmN, mutName) in mutPairs24 do
    let ci ← getConstInfo thmN
    let ei ← getConstInfo mutName
    if (← isDefEq ci.type (ei.value?.getD (mkConst ei.name))) then throwError "SRM24 AUDIT FAILED: the mutated expected statement {mutName} was ACCEPTED"
    logInfo m!"S24EXPMUT|{thmN}|{mutName} rejected"
  -- source-derived: the SRM24 corollaries are the SRM23 corollaries with exactly hW removed
  unless srcPairs24.length == 2 do throwError "SRM24 AUDIT FAILED: srcPairs24 has {srcPairs24.length} entries, expected 2"
  for (lem, cor, sh, rm, ad) in srcPairs24 do
    sourceDerived lem cor sh rm ad
    logInfo m!"S24SRCDERIVED|{cor}|conclusion of {lem}; removed {rm}; added {ad}"
  -- the source-derived check is non-vacuous: it REJECTS a wrong removed list
  do
    let r ← (try sourceDerived ``Tests.Compiler.Srm23RegsTest.topshareM_regsFit_of_hstR_hst1 ``Tests.Compiler.Srm24WidthTest.topshareM_regsFit_of_hstR_hst1_noW ["mctx", "mref", "cctx", "cref", "w", "w1", "b", "raw", "D", "hcore", "hpost", "entry", "hBnd", "st0"] [] []; pure false catch _ => pure true)
    unless r do throwError "SRM24 AUDIT FAILED: sourceDerived accepted a wrong removed-binder list"
    logInfo m!"S24SRCCONTROL|sourceDerived rejects a list that does not remove hW"
  -- (3a) the gap Prop is not a relabelling of any Prop binder type
  do
    let gap := ``Tools.ShippingSrm22Width.ShippedRegWidthLe
    let totalRef ← IO.mkRef (0 : Nat)
    for thm in audited24 ++ [``Tools.ShippingSrm22Width.hstX_of_hst3, ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_underComposedG,
        ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_endToEnd] do
      let ci ← getConstInfo thm
      let cnt ← IO.mkRef (0 : Nat)
      propTypesNotDefeq gap ci.type cnt
      totalRef.modify (· + (← cnt.get))
    let total ← totalRef.get
    unless total ≥ 15 do throwError "SRM24 AUDIT FAILED: only {total} (gap, Prop binder type) comparisons (vacuous)"
    logInfo m!"S24NOTRELABEL|ShippedRegWidthLe b is not defeq (for any parameters) to any of the {total} Prop binder types of the new theorems / SRM22 hstX / SRM20 M / SRM19 endToEnd M"
    let cnt ← IO.mkRef (0 : Nat)
    let r ← (try propTypesNotDefeq gap (← getConstInfo ``Tools.ShippingSrm22Width.regsFit_of_hstR_hst1).type cnt; pure false catch _ => pure true)
    unless r do throwError "SRM24 AUDIT FAILED: the relabelling control was not caught (hW : ShippedRegWidthLe b is a premise of regsFit_of_hstR_hst1)"
    logInfo m!"S24RELABELCONTROL|the walk rejects ShippedRegWidthLe b used as the premise hW of regsFit_of_hstR_hst1"
  -- (3) ONE witness for each instance theorem
  for thm in inst24 do
    inTelescope thm fun xs _ => do
      let mut cnt : List String := []
      for x in xs do cnt := cnt ++ [(← x.fvarId!.getDecl).userName.toString]
      for r in ["hcore", "hpost", "raw", "b", "D", "entry", "hBnd"] do
        unless (cnt.filter (· == r)).length == 1 do throwError "SRM24 AUDIT FAILED: {thm} has {(cnt.filter (· == r)).length} binders named {r}, expected exactly 1"
      let mut nCore : Nat := 0
      for x in xs do
        let t ← inferType x
        if t.getAppFn.constName? == some ``Tools.ShippingEntrySoundness.RunsTo then nCore := nCore + 1
      unless nCore == 1 do throwError "SRM24 AUDIT FAILED: {thm} has {nCore} RunsTo binders, expected 1"
      -- the single hBnd mentions the same raw / D as hcore (one run)
      let some hb ← binderNamed xs "hBnd" | throwError "SRM24 AUDIT FAILED: no hBnd"
      let some hc ← binderNamed xs "hcore" | throwError "SRM24 AUDIT FAILED: no hcore"
      let some rw ← binderNamed xs "raw" | throwError "SRM24 AUDIT FAILED: no raw"
      let some dd ← binderNamed xs "D" | throwError "SRM24 AUDIT FAILED: no D"
      unless (← inferType hb).containsFVar rw.fvarId! && (← inferType hb).containsFVar dd.fvarId! && (← inferType hc).containsFVar rw.fvarId! && (← inferType hc).containsFVar dd.fvarId! do
        throwError "SRM24 AUDIT FAILED: hcore / hBnd of {thm} are not about the same raw and D"
    logInfo m!"S24ONEWITNESS|{thm}|one RunsTo, hcore/hBnd about the same raw and D, one hpost/entry"
  -- (4) closure audit
  let forbidden : List Name := [`Tools.ShippingChildInv.RealChild, `Tools.ShippingChildInv.InvW, `Tools.ShippingMachineRan.MachineRan,
      `Tools.ShippingChildInv.MachineClosesAt, `Tools.ShippingMemKid.Kid, `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM,
      `Tools.ShippingChildInv.ChildBnd, `Tools.ShippingChildInv.StartV, `Tools.ShippingGenKid.GenKid,
      `Tools.ShippingKidFacts.KidFacts, `Tools.ShippingMachineDepthRun.MachineRunNC, `Tools.ShippingSharedLeafCoh.CacheClosed]
  for f in forbidden do
    unless (← getEnv).contains f do throwError "SRM24 AUDIT FAILED: the forbidden root {f} does not exist (vacuous audit)"
  let ctl ← depClosure `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM
  unless (ctl.toList.filter fun c => forbidden.any (·.isPrefixOf c)).length > 0 do throwError "SRM24 AUDIT FAILED: control walk found no old-form constant"
  for thm in audited24 do
    let cl ← depClosure thm
    let bad := hits cl
    unless bad.isEmpty do throwError "SRM24 AUDIT FAILED: old RefLaws boundary in the closure of {thm}: {bad}"
    let bad2 := cl.toList.filter fun c => forbidden.any (·.isPrefixOf c)
    unless bad2.isEmpty do throwError "SRM24 AUDIT FAILED: old-form boundary in the closure of {thm}: {bad2}"
    stdAxioms thm
    logInfo m!"S24CLOSURE|{thm}|standard axioms; closure {cl.size} constants; no old-form boundary"
  let gen := ``Tools.ShippingSrm24Width.shippedRegWidthLe_of_hierGate
  let gate := ``Tools.ShippingSrm4Core2.core_hierGate_anyAM
  for (thm, reqs) in [
      (``Tools.ShippingSrm24Width.shippedRegWidthLe_of_hierGate, [``Tools.ShippingSrm24Width.regWidth_eq_of_hierGate, ``Tools.ShippingMachineShipsS.refineCheck_regWidth, ``Tools.ShippingWidthTables.declWidth_eq_weS]),
      (``Tests.Compiler.Srm24WidthTest.topshareM_shippedRegWidthLe, [gen, gate]),
      (``Tests.Compiler.Srm24WidthTest.topshareQ_shippedRegWidthLe, [gen, gate]),
      (``Tests.Compiler.Srm24WidthTest.topshareM_regsFit_of_hstR_hst1_noW, [gen, gate, ``Tests.Compiler.Srm23RegsTest.topshareM_regsFit_of_hstR_hst1, ``Tools.ShippingSrm22Width.regsFit_of_hstR_hst1]),
      (``Tests.Compiler.Srm24WidthTest.topshareQ_regsFit_of_hstR_hst1_noW, [gen, gate, ``Tests.Compiler.Srm23RegsTest.topshareQ_regsFit_of_hstR_hst1, ``Tools.ShippingSrm22Width.regsFit_of_hstR_hst1])] do
    let cl ← depClosure thm
    for r in reqs do
      unless (← getEnv).contains r do throwError "SRM24 AUDIT FAILED: required constant {r} does not exist"
      unless cl.contains r do throwError "SRM24 AUDIT FAILED: {r} is not in the closure of {thm}"
    logInfo m!"S24CLOSURE2|{thm}|closure contains {reqs}"
end
