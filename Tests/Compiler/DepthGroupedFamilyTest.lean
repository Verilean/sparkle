run_cmd Lean.Elab.Command.liftTermElabM do
  let fs : List (Lean.Name × Nat) :=
    [(``Sparkle.Tests.Compiler.ShippingMachineSeqTest.parent, 1),
     (``Sparkle.Tests.Compiler.ShippingMachineSeqTest.chained, 1),
     (``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.two, 1),
     (``Sparkle.Tests.Compiler.ShippingMachineSeqTest.mid, 1),
     (``Sparkle.Tests.Compiler.ShippingMachineSeqTest.grand, 2),
     (``Sparkle.Tests.Compiler.ShippingMachineSeqLoopTest.loopParent, 1),
     (``Sparkle.Tests.Compiler.ShippingMachineDepthHTest.grandH, 1),
     (``Sparkle.Tests.Compiler.ShippingMachineDepthHTest.grandH, 2),
     (``Sparkle.Tests.Compiler.ShippingDesignSVTest.mid2, 1),
     (``Sparkle.Tests.Compiler.ShippingDesignSVTest.mixD1, 1),
     (``Sparkle.Tests.Compiler.ShippingDesignSVTest.mixD1, 2),
     (``Sparkle.Tests.Compiler.ShippingDesignSVTest.topD2, 2),
     (``Sparkle.Tests.Compiler.ShippingDesignSVTest.topD2, 3),
     (``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.mixDeep, 2),
     (``Sparkle.Tests.Compiler.MultiInstance.engineOnce, 1),
     (``Sparkle.Tests.Compiler.MultiInstance.twinCalls, 1),
     (``Sparkle.Tests.Compiler.MultiInstance.mesh2x2, 1)]
  let env ← Lean.getEnv
  let mut compared : Nat := 0
  let mut leftOut : List String := []
  let mut failed : List String := []
  for (f, dep) in fs do
    let gs := Tests.Compiler.DepthGroupedFamilyTest.namesOfEndpoint f "NRG" dep
    let olds := Tests.Compiler.DepthGroupedFamilyTest.namesOfEndpoint f "NR" dep
    if gs.all (fun g => env.contains g) then compared := compared + 1
    else if olds.all (fun o => env.contains o) then failed := failed ++ [s!"{f} at depth {dep}"]
    else leftOut := leftOut ++ [s!"{f} at depth {dep}"]
  Lean.logInfo m!"DEPTH GROUPED FAMILY: {compared} of {fs.length} endpoints generated by the grouped loop with statements isDefEq the built ones and standard axioms; FAILED (built theorems present, the grouped ones not generated — see the errors above): {failed}; left out (built theorems absent here): {leftOut}"
  unless failed.isEmpty do
    throwError "DEPTH GROUPED FAMILY: {failed.length} endpoints FAILED: {failed}"
  -- at least the grouping showcase must have been compared
  unless env.contains (``Sparkle.Tests.Compiler.MultiInstance.mesh2x2 ++ `machine_composedNRG1) do
    throwError "mesh2x2 was not compared: the test claims nothing"
