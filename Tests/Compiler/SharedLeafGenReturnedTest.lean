/-- The hand-written statement of `topshare2.epD2M_returned`.  `kJ` = the index of the start world `JQC O kJ w`, `dHr` = the declaration `h` synthesizes, `dE1` = the declaration of the
second callee's `entry1`, `eqQ` = the conjunct about `y.2` and `Dg`, `pickSem` = the design `DesignSemConcl` is judged with (real: `eqQ := (· = ·)`, `pickSem := fun a _ => a`, i.e. `y.2`). -/
def Share2Ret (kJ : Nat) (dHr dE1 : Name) (eqQ : Design → Design → Prop) (pickSem : Design → Design → Design) : Prop :=
  ∀ {mctx : Lean.Meta.Context} {mref : ST.Ref IO.RealWorld Lean.Meta.State} {cctx : Lean.Core.Context} {cref : ST.Ref IO.RealWorld Lean.Core.State}
    (O : RefLawsAOps MkRefd mref cref) (T : RefLawsATele O.quiet mref cref) (hA : AdmCtx O.quiet mctx cctx)
    (entryP : MachineDefines mctx mref cctx cref ``topshare2 topshare2.machineData.shape)
    (entry0 : MachineDefines mctx mref cctx cref ``wrapQ wrapQ.machineData.shape)
    (entry1 : MachineDefines mctx mref cctx cref dE1 wrapP.machineData.shape)
    (hR0 : MachineDefines mctx mref cctx cref ``leaf16 leaf16.machineData.shape)
    {w w' : Void IO.RealWorld} {y : Res} (hw : JQC O kJ w)
    (h : RunsTo (synthesizeCombinational dHr) mctx mref cctx cref w y w'),
    ∃ (y₁ y₂ : Res) (t t' : Sparkle.IR.AST.Module) (d₀ : Sparkle.IR.AST.Design)
      (M : Sparkle.IR.AST.Module) (Dg : Sparkle.IR.AST.Design) (w10 wc : Void IO.RealWorld),
      closeLets topshare2.machineData.shape.layout.lets t = some t' ∧
      some (M, Dg) = Sparkle.IR.Machine.closeInstsG (machNIn topshare2.machineData.shape) topshare2.machineData.shape.insts.length
        topshare2.machineData.shape.layout.slots.length (t.inputs.map (·.name)) (topshare2.machineData.shape.insts.map (·.2.1))
        topshare2.machineData.shape.instFields [y₁, y₁, y₂, y₂] (closeMachine topshare2.machineData.shape.layout t', d₀) ∧
      JQC O 0 w' ∧ cv w' = cv w10 ∧
      CacheClosed (cv w10) ∧ KeyTop (cv w10) ∧ CacheCoh (cv w10) ∧
      (cv w10).get? ``wrapQ = some y₁ ∧ (cv w10).get? ``wrapP = some y₂ ∧
      (∀ a ∈ ModsOf y₁, ∀ b ∈ ModsOf y₂, a.name = b.name → a = b) ∧
      (∀ k₁ (hk₁ : k₁ < wrapQ.machineData.shape.insts.length) k₂ (hk₂ : k₂ < wrapP.machineData.shape.insts.length),
        (wrapQ.machineData.shape.insts[k₁]).1 = (wrapP.machineData.shape.insts[k₂]).1 →
        ∃ e, (cv w10).get? (wrapQ.machineData.shape.insts[k₁]).1 = some e ∧ e.1 ∈ y₁.2.modules ∧ e.1 ∈ y₂.2.modules) ∧
      RunsTo (synthesizeCombinationalCore ``topshare2 [] false) mctx mref cctx cref w (M, Dg) wc ∧ cv wc = cv w10 ∧
      ((y.1 = Sparkle.IR.ZeroWidth.dropZeroWidthModule M ∧
          y.2 = topMap M.name Sparkle.IR.ZeroWidth.dropZeroWidthModule Dg) ∨
       (y.1 = Sparkle.IR.RefineCheck.mergeChecked (Sparkle.IR.ZeroWidth.dropZeroWidthModule M) ∧
          y.2 = topMap M.name Sparkle.IR.RefineCheck.mergeChecked
            (topMap M.name Sparkle.IR.ZeroWidth.dropZeroWidthModule Dg))) ∧
      (∀ x ∈ Dg.modules, x.name ≠ M.name) ∧ eqQ y.2 Dg ∧
      ComposedG (fun D => KSn (childMap D.modules) 2) (ResetNk 2) ``topshare2 topshare2.machineData 3 M Dg
        (fun _ : Unit => Sparkle.Core.Domain.defaultDomain) topshare2.machineSource
        (fun i bools bits => topshare2.machineExt i bools bits
          (Tools.ShippingMachineSource.stateLoop topshare2.machineInits (topshare2.machineBody i bools bits)))
        (fun i bools bits => topshare2.machineExtB i bools bits
          (Tools.ShippingMachineSource.stateLoop topshare2.machineInits (topshare2.machineBody i bools bits))) ∧
      DesignSemConcl 2 ``topshare2 topshare2.machineData 3
        (fun _ : Unit => Sparkle.Core.Domain.defaultDomain) topshare2.machineSource
        (fun i bools bits => topshare2.machineExt i bools bits
          (Tools.ShippingMachineSource.stateLoop topshare2.machineInits (topshare2.machineBody i bools bits)))
        (fun i bools bits => topshare2.machineExtB i bools bits
          (Tools.ShippingMachineSource.stateLoop topshare2.machineInits (topshare2.machineBody i bools bits)))
        y.1 M (pickSem y.2 Dg)

/-- The hand-written statement of `topshare2.epD2M_wired` (parameters as for `Share2Ret`; `pickSem` chooses the design of `DesignSemConcl`: real `fun _ b => b`, i.e. `Dg`). -/
def Share2Wired (kJ : Nat) (dHr dE1 : Name) (pickSem : Design → Design → Design) : Prop :=
  ∀ {mctx : Lean.Meta.Context} {mref : ST.Ref IO.RealWorld Lean.Meta.State} {cctx : Lean.Core.Context} {cref : ST.Ref IO.RealWorld Lean.Core.State}
    (O : RefLawsAOps MkRefd mref cref) (T : RefLawsATele O.quiet mref cref) (hA : AdmCtx O.quiet mctx cctx)
    (entryP : MachineDefines mctx mref cctx cref ``topshare2 topshare2.machineData.shape)
    (entry0 : MachineDefines mctx mref cctx cref ``wrapQ wrapQ.machineData.shape)
    (entry1 : MachineDefines mctx mref cctx cref dE1 wrapP.machineData.shape)
    (hR0 : MachineDefines mctx mref cctx cref ``leaf16 leaf16.machineData.shape)
    {w w' : Void IO.RealWorld} {y : Res} (hw : JQC O kJ w)
    (h : RunsTo (synthesizeCombinational dHr) mctx mref cctx cref w y w'),
    ∃ (y₁ y₂ : Res) (t t' : Sparkle.IR.AST.Module) (d₀ : Sparkle.IR.AST.Design)
      (M : Sparkle.IR.AST.Module) (Dg : Sparkle.IR.AST.Design) (w10 wc : Void IO.RealWorld),
      closeLets topshare2.machineData.shape.layout.lets t = some t' ∧
      some (M, Dg) = Sparkle.IR.Machine.closeInstsG (machNIn topshare2.machineData.shape) topshare2.machineData.shape.insts.length
        topshare2.machineData.shape.layout.slots.length (t.inputs.map (·.name)) (topshare2.machineData.shape.insts.map (·.2.1))
        topshare2.machineData.shape.instFields [y₁, y₁, y₂, y₂] (closeMachine topshare2.machineData.shape.layout t', d₀) ∧
      JQC O 0 w' ∧ cv w' = cv w10 ∧
      CacheClosed (cv w10) ∧ KeyTop (cv w10) ∧ CacheCoh (cv w10) ∧
      (cv w10).get? ``wrapQ = some y₁ ∧ (cv w10).get? ``wrapP = some y₂ ∧
      (∀ a ∈ ModsOf y₁, ∀ b ∈ ModsOf y₂, a.name = b.name → a = b) ∧
      (∀ k₁ (hk₁ : k₁ < wrapQ.machineData.shape.insts.length) k₂ (hk₂ : k₂ < wrapP.machineData.shape.insts.length),
        (wrapQ.machineData.shape.insts[k₁]).1 = (wrapP.machineData.shape.insts[k₂]).1 →
        ∃ e, (cv w10).get? (wrapQ.machineData.shape.insts[k₁]).1 = some e ∧ e.1 ∈ y₁.2.modules ∧ e.1 ∈ y₂.2.modules) ∧
      RunsTo (synthesizeCombinationalCore ``topshare2 [] false) mctx mref cctx cref w (M, Dg) wc ∧ cv wc = cv w10 ∧
      ((y.1 = Sparkle.IR.ZeroWidth.dropZeroWidthModule M ∧
          y.2 = topMap M.name Sparkle.IR.ZeroWidth.dropZeroWidthModule Dg) ∨
       (y.1 = Sparkle.IR.RefineCheck.mergeChecked (Sparkle.IR.ZeroWidth.dropZeroWidthModule M) ∧
          y.2 = topMap M.name Sparkle.IR.RefineCheck.mergeChecked
            (topMap M.name Sparkle.IR.ZeroWidth.dropZeroWidthModule Dg))) ∧
      ComposedG (fun D => KSn (childMap D.modules) 2) (ResetNk 2) ``topshare2 topshare2.machineData 3 M Dg
        (fun _ : Unit => Sparkle.Core.Domain.defaultDomain) topshare2.machineSource
        (fun i bools bits => topshare2.machineExt i bools bits
          (Tools.ShippingMachineSource.stateLoop topshare2.machineInits (topshare2.machineBody i bools bits)))
        (fun i bools bits => topshare2.machineExtB i bools bits
          (Tools.ShippingMachineSource.stateLoop topshare2.machineInits (topshare2.machineBody i bools bits))) ∧
      DesignSemConcl 2 ``topshare2 topshare2.machineData 3
        (fun _ : Unit => Sparkle.Core.Domain.defaultDomain) topshare2.machineSource
        (fun i bools bits => topshare2.machineExt i bools bits
          (Tools.ShippingMachineSource.stateLoop topshare2.machineInits (topshare2.machineBody i bools bits)))
        (fun i bools bits => topshare2.machineExtB i bools bits
          (Tools.ShippingMachineSource.stateLoop topshare2.machineInits (topshare2.machineBody i bools bits)))
        y.1 M (pickSem y.2 Dg) ∧
      (∀ mn : String, mn ≠ M.name →
        Sparkle.IR.Machine.moduleByName y.2.modules mn = Sparkle.IR.Machine.moduleByName Dg.modules mn)

/-- the expected statements -/
def Share2RetE : Prop := Share2Ret 0 ``topshare2 ``wrapP (· = ·) (fun a _ => a)
def Share2WiredE : Prop := Share2Wired 0 ``topshare2 ``wrapP (fun _ b => b)
end

open Lean Elab Command Meta in
set_option maxHeartbeats 0 in
run_cmd Lean.Elab.Command.liftTermElabM do
  let top := ``Tests.Compiler.SharedLeafGenTest.topshare2
  let rt ← instantiateMVars (← getConstInfo (top ++ `epD2M_returned)).type
  let wt ← instantiateMVars (← getConstInfo (top ++ `epD2M_wired)).type
  let e := mkConst
  let mutR (kJ : Nat) (dHr dE1 : Name) (eqQ pick : Expr) : Expr :=
    mkAppN (e ``Share2Ret) #[mkNatLit kJ, toExpr dHr, toExpr dE1, eqQ, pick]
  let mutW (kJ : Nat) (dHr dE1 : Name) (pick : Expr) : Expr :=
    mkAppN (e ``Share2Wired) #[mkNatLit kJ, toExpr dHr, toExpr dE1, pick]
  let ty := mkConst ``Sparkle.IR.AST.Design
  let eqReal ← withLocalDeclD `a ty fun a => withLocalDeclD `b ty fun b => do mkLambdaFVars #[a, b] (← mkEq a b)
  let eqTriv ← withLocalDeclD `a ty fun a => withLocalDeclD `b ty fun b => mkLambdaFVars #[a, b] (mkConst ``True)
  let pickA ← withLocalDeclD `a ty fun a => withLocalDeclD `b ty fun b => mkLambdaFVars #[a, b] a
  let pickB ← withLocalDeclD `a ty fun a => withLocalDeclD `b ty fun b => mkLambdaFVars #[a, b] b
  let wrapQ := ``Tests.Compiler.SharedLeafGenTest.wrapQ
  let wrapP := ``Tests.Compiler.SharedLeafGenTest.wrapP
  let retExp := mutR 0 top wrapP eqReal pickA
  let wiredExp := mutW 0 top wrapP pickB
  let retMuts := [(mutR 1 top wrapP eqReal pickA, "start world JQC O 1 w"), (mutR 0 wrapQ wrapP eqReal pickA, "h synthesizes wrapQ"),
    (mutR 0 top wrapQ eqReal pickA, "entry1 is for wrapQ"), (mutR 0 top wrapP eqTriv pickA, "the conjunct y.2 = Dg replaced by True"),
    (mutR 0 top wrapP eqReal pickB, "DesignSemConcl of Dg instead of y.2")]
  let wiredMuts := [(mutW 1 top wrapP pickB, "start world JQC O 1 w"), (mutW 0 wrapQ wrapP pickB, "h synthesizes wrapQ"),
    (mutW 0 top wrapQ pickB, "entry1 is for wrapQ"), (mutW 0 top wrapP pickA, "DesignSemConcl of y.2 instead of Dg")]
  for (x, what) in [(rt, "epD2M_returned"), (wt, "epD2M_wired"), (retExp, "expected returned"), (wiredExp, "expected wired")] ++
      (retMuts ++ wiredMuts).map fun (x, w) => (x, s!"mutation {w}") do
    if x.hasMVar || x.hasFVar then throwError "SR14 AUDIT FAILED: metavariables / free variables in {what}"
    Meta.check x
  unless (← isDefEq rt retExp) do throwError "SR14 AUDIT FAILED: the FULL type of topshare2.epD2M_returned is not definitionally the hand-written Share2Ret"
  unless (← isDefEq wt wiredExp) do throwError "SR14 AUDIT FAILED: the FULL type of topshare2.epD2M_wired is not definitionally the hand-written Share2Wired"
  for (x, w) in retMuts do
    if (← isDefEq rt x) then throwError "SR14 AUDIT FAILED: the mutated returned type ({w}) was ACCEPTED"
  for (x, w) in wiredMuts do
    if (← isDefEq wt x) then throwError "SR14 AUDIT FAILED: the mutated wired type ({w}) was ACCEPTED"
  unless !(← isDefEq rt wt) do throwError "SR14 AUDIT FAILED: the returned and wired types coincide"
  logInfo m!"SR14: the FULL forall-types of the GENERATED topshare2.epD2M_returned (y.2 = Dg; DesignSemConcl for y.2) and topshare2.epD2M_wired (DesignSemConcl for Dg; lookup agreement) are isDefEq to the hand-written Share2Ret / Share2Wired; {retMuts.length} resp. {wiredMuts.length} type-correct mutations (start world, h's declaration, entry1's declaration, y.2 = Dg dropped / the design of DesignSemConcl swapped) are REJECTED"

/-! ## closure audit -/

open Lean Elab Command Meta in
open Tests.Compiler.ChildVertAuditTest in
set_option maxHeartbeats 0 in
run_cmd Lean.Elab.Command.liftTermElabM do
  for nm in [`epD2M_returned, `epD2M_wired] do
    let c := ``Tests.Compiler.SharedLeafGenTest.topshare2 ++ nm
    stdAxioms c
    let cl ← depClosure c
    let forbidden : List Name := [`Tools.ShippingChildInv.ChildBnd, `Tools.ShippingChildInv.StartV, `Tools.ShippingGenKid.GenKid,
      `Tools.ShippingKidFacts.KidFacts, `Tools.ShippingMachineDepthRun.MachineRunNC,
      `Tools.ShippingMachineDepthRun.machineRunNC_of_real, `Tools.ShippingMachineDepthRun.seqChildRunN_of_composedC]
    for f in forbidden do
      unless (← getEnv).contains f do throwError "SR14 AUDIT FAILED: the forbidden name {f} does not exist (the audit would check nothing)"
    let bad := hits cl ++ cl.toList.filter fun x => forbidden.any (·.isPrefixOf x)
    unless bad.isEmpty do throwError "SR14 AUDIT FAILED: old boundary / old child predicate in the closure of {c}: {bad}"
    for must in [(if nm == `epD2M_returned then ``Tools.ShippingQuadReturned.quad_returned else ``Tools.ShippingQuadReturned.quad_wired),
        ``Tools.ShippingQuadReturned.quad_returned, ``Tools.ShippingQuadLeafGeneric.quad_entry_run_ret_np,
        ``Tools.ShippingTopShareNoParent.returned_design_eq, ``Tools.ShippingSeqParentAt.machine_design_noShips_noBd_dc_at] do
      unless cl.contains must do throwError "SR14 AUDIT FAILED: {must} not in the closure of {c}"
    for old in [`Tests.Compiler.SharedLeafGenTest.topshare2.machine_composedNR2, `Tests.Compiler.SharedLeafGenTest.topshare2.machine_design_svNR2] do
      unless (← getEnv).contains old do throwError "SR14 AUDIT FAILED: {old} does not exist"
      if cl.contains old then throwError "SR14 AUDIT FAILED: the old generated theorem {old} is in the closure of {c}"
    for no in [`Tests.Compiler.SharedLeafGenTest.topshare2.epD2M_closesA, `Tests.Compiler.SharedLeafGenTest.topshare2.epD2M_disj] do
      if cl.contains no then throwError "SR14 AUDIT FAILED: {no} is in the closure of {c}"
    logInfo m!"SR14 CLOSURE AUDIT: {c}: standard axioms; closure {cl.size} constants; no ChildBnd/StartV/GenKid/old KidFacts/MachineRunNC/machineRunNC_of_real/seqChildRunN_of_composedC, no RefLaws/RefLawsCore/toAOps/toA; the old generated composed theorems and epD2M_closesA / epD2M_disj are not in it; the generic quad theorem, quad_entry_run_ret_np, returned_design_eq, machine_design_noShips_noBd_dc_at are"

end Tests.Compiler.SharedLeafGenReturnedTest
