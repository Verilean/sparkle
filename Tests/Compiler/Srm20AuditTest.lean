section
open Lean Elab Command Meta

namespace Tests.Compiler.Srm20AuditTest

/-- a hand-made MUTATION for the binder audit's control: a theorem whose single hypothesis IS its conclusion -/
theorem wrapper_mutation (p : Prop) (h : p) : p := h

/-- the new SRM20 theorems audited -/
def audited20 : List Name :=
  [``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_underComposedG,
   ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_underComposedG]

/-- (final theorem, expected statement in the generated file) -/
def pairs20 : List (Name × Name) :=
  [(``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_underComposedG, ``Tests.Compiler.Srm20ExpStmt.Exp_topshareM_svBoundsH_underComposedG),
   (``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_underComposedG, ``Tests.Compiler.Srm20ExpStmt.Exp_topshareQ_svBoundsH_underComposedG)]

/-- elaborate a hand-written term string -/
def elabStr (s : String) : TermElabM Expr := do
  match Parser.runParserCategory (← getEnv) `term s with
  | .error e => throwError "SRM20 AUDIT FAILED: expected string does not parse: {e}\n{s}"
  | .ok stx =>
    let e ← Term.elabTerm stx none
    Term.synthesizeSyntheticMVarsNoPostponing
    instantiateMVars e

/-- is the theorem's type defeq to the hand-written expected statement? -/
def typeIs (thm : Name) (s : String) : TermElabM Bool := do
  let ci ← getConstInfo thm
  let e ← elabStr s
  isDefEq ci.type e

/-- the independently written expected statements of the generic theorems (hand-written, NOT produced by a script from the theorems) -/


abbrev Row := Nat × String × String × Bool × String

/-- normalised binder name -/
def normName (n : String) : String := if (n.splitOn "_hyg").length > 1 then "_anon" else n

/-- rows `(index, binderInfo, name, isProp, type)` of the binders of a theorem's type -/
def premiseRows (thm : Name) : MetaM (List Row) := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    let mut rows : List Row := []
    let mut i := 0
    for x in xs do
      let d ← x.fvarId!.getDecl
      let isP ← Meta.isProp d.type
      let bi := match d.binderInfo with
        | .implicit => "implicit" | .strictImplicit => "strict" | .instImplicit => "inst" | .default => "explicit"
      rows := rows ++ [(i, bi, normName d.userName.toString, isP, ((← ppExpr d.type).pretty 100000).replace "\n" " ")]
      i := i + 1
    return rows

/-- the text line of a row (the format of `scripts/srm20/PREMISES.txt`) -/
def rowLine (thm : Name) (r : Row) : String :=
  s!"S20{if r.2.2.2.1 then "PREM" else "DATA"}|{thm}|{r.1}|{r.2.1}|{r.2.2.1}|{r.2.2.2.2}"

/-- EXACT comparison of two whole tables: `none` iff equal, else the first difference -/
def tableDiff (a e : List (Name × List Row)) : Option String := Id.run do
  if a.length != e.length then return some s!"{a.length} theorems vs {e.length} expected"
  for ((n, rs), (n', rs')) in a.zip e do
    if n != n' then return some s!"theorem {n} vs expected {n'}"
    if rs.length != rs'.length then return some s!"{n}: {rs.length} binders vs {rs'.length} expected"
    for (r, r') in rs.zip rs' do
      if r != r' then return some s!"{n}: binder {r.1} differs: {rowLine n r} vs expected {rowLine n r'}"
  return none

/-- mutation 1: SEMANTIC change of the type of the first Prop binder (same index, binderInfo, name): the type string gets ` ∧ True` appended -/
def mutType (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.any (·.2.2.2.1)) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then
      let idx := (rs.findIdx? (·.2.2.2.1)).getD 0
      (n, rs.mapIdx fun i r => if i == idx then (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2 ++ " ∧ True") else r)
    else (n, rs)

/-- mutation 2: add a data binder to the first theorem -/
def mutAdd (t : List (Name × List Row)) : List (Name × List Row) :=
  t.mapIdx fun j (n, rs) => if j == 0 then (n, rs ++ [(rs.length, "implicit", "extraBinder", false, "Nat")]) else (n, rs)

/-- mutation 3: swap the first two binders of the first theorem that has two -/
def mutSwap (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.length ≥ 2) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then (match rs with | r0 :: r1 :: rest => (n, r1 :: r0 :: rest) | _ => (n, rs)) else (n, rs)

/-- does a hypothesis of `thm` restate its conclusion (reducible `isDefEq`)? -/
def restatesConclusion (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if (← Meta.isProp d.type) then
        if (← withReducible (isDefEq d.type concl)) then return true
    return false

/-- does a hypothesis of `thm` mention the uniform children's check? -/
def mentionsUniformUNUSED (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if d.type.getUsedConstants.any (fun c => c == ``Tools.ShippingDesignSV.kidsPass || c == ``Tools.ShippingChecksDesign.kidCheck || c == ``Tools.ShippingDesignSVBack.outsCheck || c == ``Tools.ShippingDesignSV.designCheck || c == ``Tools.ShippingSrm6Sem.SVBoundsH || c == ``Tools.ShippingDesignSV.SVBounds) then return true
    return false


/-- run `k` in the telescope of `thm`'s type -/
def inTelescope {α : Type} (thm : Name) (k : Array Expr → Expr → TermElabM α) : TermElabM α := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => k xs concl

/-- the fvar of the binder with user name `nm` -/
def binderNamed (xs : Array Expr) (nm : String) : MetaM (Option Expr) := do
  for x in xs do
    if (← x.fvarId!.getDecl).userName.toString == nm then return some x
  return none


/-- Standard axioms only, an error otherwise (as Tests/Compiler/ChildVertAuditTest.lean `stdAxioms`; copied so that this test does not import that integrator-only module). -/
def stdAxioms (n : Name) : MetaM Unit := do
  for ax in ← Lean.collectAxioms n do
    unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
      throwError "{n} uses a non-standard axiom: {ax}"

/-- the transitive closure of the constants `n` depends on (type, value, constructors of inductives), `n` included (as `depClosure` of ChildVertAuditTest) -/
partial def depClosure (n : Name) : MetaM NameSet := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut todo : Array Name := #[n]
  while todo.size > 0 do
    let c := todo.back!
    todo := todo.pop
    if seen.contains c then continue
    seen := seen.insert c
    match env.find? c with
    | none => pure ()
    | some ci =>
      let mut used := ci.type.getUsedConstants
      if let some v := ci.value? (allowOpaque := true) then
        used := used ++ v.getUsedConstants
      if let .inductInfo iv := ci then
        used := used ++ iv.ctors.toArray
      for u in used do
        unless seen.contains u do
          todo := todo.push u
  return seen

/-- the old-boundary names: any constant equal to or under these -/
def forbiddenRoots : List Name :=
  [`Tools.ShippingChildInv.RefLaws, `Tools.ShippingChildBndCore.RefLawsCore,
   `Tools.ShippingChildInvA.RefLawsCore.toAOps, `Tools.ShippingChildInvA.RefLawsCore.toA]

def hits (s : NameSet) : List Name :=
  s.toList.filter fun c => forbiddenRoots.any fun r => r.isPrefixOf c

end Tests.Compiler.Srm20AuditTest

open Tests.Compiler.Srm20AuditTest in
/-- the Prop binder types of a statement, walking `∀`, `∃` and `∧` (the `∃ ids …` and `∧` structure of the conclusion included), compared against `q` inside the telescope -/
partial def propTypesNotDefeq (q : Expr) (e : Expr) (cnt : IO.Ref Nat) : MetaM Unit := do
  match e with
  | .forallE .. =>
    forallTelescope e fun xs b => do
      for x in xs do
        let t ← inferType x
        if (← Meta.isProp t) && t != q then
          cnt.modify (· + 1)
          if (← isDefEq t q) then throwError "SRM20 AUDIT FAILED: QDepthLift is defeq to another Prop binder type {t}"
          propTypesNotDefeq q t cnt
      propTypesNotDefeq q b cnt
  | .app (.app (.const ``Exists _) _) (.lam n d b bi) =>
    withLocalDecl n bi d fun x => propTypesNotDefeq q (b.instantiate1 x) cnt
  | .app (.app (.const ``And _) a) b => do propTypesNotDefeq q a cnt; propTypesNotDefeq q b cnt
  | _ => pure ()

open Tests.Compiler.Srm20AuditTest in
run_cmd liftTermElabM do
  unless (← restatesConclusion ``Tests.Compiler.Srm20AuditTest.wrapper_mutation) do throwError "SRM20 AUDIT FAILED: the wrapper control was not caught"
  unless audited20.length == 2 do throwError "SRM20 AUDIT FAILED: audited20 has {audited20.length} theorems, expected exactly 2"
  -- (1) premise table
  let mut actual : List (Name × List Row) := []
  let mut lines : List String := []
  for thm in audited20 do
    let rows ← premiseRows thm
    actual := actual ++ [(thm, rows)]
    logInfo m!"S20THM|{thm}|{rows.length}"
    lines := lines ++ [s!"S20THM|{thm}|{rows.length}"]
    for r in rows do
      logInfo m!"{rowLine thm r}"
      lines := lines ++ [rowLine thm r]
    if (← restatesConclusion thm) then throwError "SRM20 AUDIT FAILED: a hypothesis of {thm} restates its conclusion"
  unless Tests.Compiler.Srm20AuditExpected.expectedRows.length == 2 do throwError "SRM20 AUDIT FAILED: the expected table has {Tests.Compiler.Srm20AuditExpected.expectedRows.length} theorem entries, expected exactly 2"
  match tableDiff actual Tests.Compiler.Srm20AuditExpected.expectedRows with
  | some msg => throwError "SRM20 AUDIT FAILED: the premise table differs from Tests/Compiler/Srm20AuditExpected.lean: {msg}"
  | none => pure ()
  let txt ← IO.FS.readFile "scripts/srm20/PREMISES.txt"
  let fileLines := (txt.splitOn "\n").filter (· != "")
  unless fileLines == lines do
    throwError "SRM20 AUDIT FAILED: scripts/srm20/PREMISES.txt differs from the regenerated table ({fileLines.length} lines vs {lines.length})"
  -- negative fixtures
  do
    let mt := mutType actual
    let mut changed : List (Name × Row × Row) := []
    unless mt.length == actual.length do throwError "SRM20 AUDIT FAILED: fixture 1 changed the number of theorems"
    for ((n, rs), (n', rs')) in actual.zip mt do
      unless n == n' && rs.length == rs'.length do throwError "SRM20 AUDIT FAILED: fixture 1 changed the shape of {n}"
      for (r, r') in rs.zip rs' do
        if r != r' then changed := changed ++ [(n, r, r')]
    match changed with
    | [(n, r, r')] =>
      unless r'.2.2.2.1 do throwError "SRM20 AUDIT FAILED: fixture 1 mutated row of {n} is not a Prop binder"
      unless r.2.2.2.1 && r'.1 == r.1 && r'.2.1 == r.2.1 && r'.2.2.1 == r.2.2.1 do throwError "SRM20 AUDIT FAILED: fixture 1 changed index/binderInfo/name/isProp of binder {r.1} of {n}"
      unless r'.2.2.2.2 != r.2.2.2.2 && r'.2.2.2.2.endsWith " ∧ True" && r'.2.2.2.2.length == r.2.2.2.2.length + 7 do throwError "SRM20 AUDIT FAILED: fixture 1 type string is not visibly changed"
      logInfo m!"S20FIXTURE1|{n}|binder {r.1} ({r.2.2.1})|original type: {r.2.2.2.2}|mutated type: {r'.2.2.2.2}"
      match tableDiff mt Tests.Compiler.Srm20AuditExpected.expectedRows with
      | some msg => unless (msg.splitOn s!"binder {r.1} differs").length > 1 && (msg.splitOn (toString n)).length > 1 do throwError "SRM20 AUDIT FAILED: fixture 1 rejection does not name the mutated binder: {msg}"
      | none => throwError "SRM20 AUDIT FAILED: the comparator ACCEPTED fixture 1"
    | _ => throwError "SRM20 AUDIT FAILED: fixture 1 changed {changed.length} rows, expected exactly 1"
  for (nm, mt) in [("changed Prop binder type", mutType actual), ("added data binder", mutAdd actual), ("reordered binders", mutSwap actual)] do
    if mt == actual then throwError "SRM20 AUDIT FAILED: the fixture '{nm}' did not change the table (vacuous)"
    match tableDiff mt Tests.Compiler.Srm20AuditExpected.expectedRows with
    | none => throwError "SRM20 AUDIT FAILED: the comparator ACCEPTED the fixture '{nm}'"
    | some msg => logInfo m!"S20FIXTURE|{nm}|rejected: {msg}"
  logInfo m!"S20TABLE|{audited20.length} theorems, {lines.length} binders: equal to the committed table and to scripts/srm20/PREMISES.txt"
  -- (2) independent full-type expected statements
  unless pairs20.length == 2 do throwError "SRM20 AUDIT FAILED: pairs20 has {pairs20.length} entries, expected 2"
  for (t, e) in pairs20 do
    let ci ← getConstInfo t
    let ei ← getConstInfo e
    unless (← isDefEq ci.type (ei.value?.getD (mkConst e))) do throwError "SRM20 AUDIT FAILED: the statement of {t} is not defeq to its expected form {e}"
    logInfo m!"S20EXPDEFEQ|{t}|{e}|isDefEq"
  -- QDepthLift against the text of EXPECTED.txt
  do
    let a ← getConstInfo ``Tests.Compiler.SharedLeafMemKidIfaceTest.QDepthLift
    let e ← getConstInfo ``Tests.Compiler.Srm20ExpStmt.Exp_QDepthLift
    unless (← isDefEq a.value! e.value!) do throwError "SRM20 AUDIT FAILED: QDepthLift is not defeq to Exp_QDepthLift (the text of scripts/srm20/EXPECTED.txt)"
    logInfo m!"S20EXPDEFEQ|QDepthLift|Exp_QDepthLift|isDefEq"
  for (thmN, mutName) in [(``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_underComposedG, ``Tests.Compiler.Srm20ExpStmt.Exp_mutation_noHfit),
      (``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_underComposedG, ``Tests.Compiler.Srm20ExpStmt.Exp_mutation_noReset),
      (``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_underComposedG, ``Tests.Compiler.Srm20ExpStmt.Exp_mutation_noHlift)] do
    let ci ← getConstInfo thmN
    let ei ← getConstInfo mutName
    if (← isDefEq ci.type (ei.value?.getD (mkConst ei.name))) then throwError "SRM20 AUDIT FAILED: the mutated expected statement {mutName} was ACCEPTED"
    logInfo m!"S20EXPMUT|{mutName} rejected"
  -- (3) ONE witness
  for thm in audited20 do
    inTelescope thm fun xs concl => do
      let mut cnt : List String := []
      for x in xs do cnt := cnt ++ [(← x.fvarId!.getDecl).userName.toString]
      for r in ["hcore", "hpost", "raw", "b", "D", "entry", "hBnd", "hBd"] do
        unless (cnt.filter (· == r)).length == 1 do throwError "SRM20 AUDIT FAILED: {thm} has {(cnt.filter (· == r)).length} binders named {r}, expected exactly 1"
      for r in ["hrun", "hRK", "hfit", "s", "hsk", "rk", "kids", "st0", "ins"] do
        if (cnt.filter (· == r)).length != 0 then throwError "SRM20 AUDIT FAILED: {thm} has a top-level binder named {r} (the run/state/Reset binders must live inside the ComposedG-shaped conclusion)"
      let mut nCore : Nat := 0
      let mut nRun : Nat := 0
      for x in xs do
        let t ← inferType x
        if t.getAppFn.constName? == some ``Tools.ShippingEntrySoundness.RunsTo then nCore := nCore + 1
        if t.getUsedConstants.contains ``Tools.ShippingHierStateG.runModuleTG then nRun := nRun + 1
      unless nCore == 1 && nRun == 0 do throwError "SRM20 AUDIT FAILED: {thm} has {nCore} RunsTo and {nRun} runModuleTG binders, expected 1 and 0"
      -- walk the conclusion: ∃ ids, … ∃ cache regs, … ∀ data, hyps → ∃ envs, run ∧ len ∧ obs ∧ SVBoundsH
      let rec peel (e : Expr) (acc : Array Expr) (k : Array Expr → Expr → MetaM Unit) : MetaM Unit := do
        match e with
        | .app (.app (.const ``Exists _) _) (.lam n d b bi) =>
          withLocalDecl n bi d fun x => peel (b.instantiate1 x) (acc.push x) k
        | .app (.app (.const ``And _) a) r =>
          -- the leading conjuncts of the ComposedG existential part are Prop facts; keep walking into the last, but stop at the run equation
          if a.getAppFn.constName? == some ``Eq && a.getUsedConstants.contains ``Tools.ShippingHierStateG.runModuleTG then k acc e
          else peel r acc k
        | .forallE .. => forallTelescope e fun ys b => peel b (acc ++ ys) k
        | _ => k acc e
      peel concl #[] fun acc inner => do
        let names ← acc.mapM fun x => do pure (← x.fvarId!.getDecl).userName.toString
        for r in ["ids", "cache", "regs", "ins", "st0", "mems", "kids", "T", "envs"] do
          unless (names.filter (· == r)).size == 1 do throwError "SRM20 AUDIT FAILED: inside the conclusion of {thm}, {(names.filter (· == r)).size} binders named {r}, expected exactly 1"
        unless (names.filter (· == "hrun")).size == 0 do throwError "SRM20 AUDIT FAILED: hrun appears in {thm}"
        -- ids / cache / regs (the ComposedG witnesses) occur in the hypotheses (SourceInputs / regs pass / init)
        let hypTys ← acc.filterMapM fun x => do
          let t ← inferType x
          if (← Meta.isProp t) then pure (some t) else pure none
        for r in ["ids", "cache", "regs"] do
          let mut fv : Option Expr := none
          for x in acc do
            if (← x.fvarId!.getDecl).userName.toString == r then fv := some x
          let some x := fv | throwError "SRM20 AUDIT FAILED: witness {r} missing"
          unless hypTys.any (·.containsFVar x.fvarId!) do throwError "SRM20 AUDIT FAILED: the ComposedG witness {r} of {thm} is not used in any hypothesis"
        -- the inner conjunction: run ∧ length ∧ obs ∧ SVBoundsH
        let rec flat (e : Expr) : List Expr := match e with
          | .app (.app (.const ``And _) a) b => a :: flat b
          | _ => [e]
        let conj := flat inner
        unless conj.length == 4 do throwError "SRM20 AUDIT FAILED: the inner conjunction of {thm} has {conj.length} parts, expected 4 (run, length, outputs, SVBoundsH)"
        let run := conj[0]!
        let sv := conj[3]!
        unless run.getAppFn.constName? == some ``Eq do throwError "SRM20 AUDIT FAILED: first conjunct of {thm} is not an equation"
        let lhs := run.getAppArgs[1]!
        unless lhs.getAppFn.constName? == some ``Tools.ShippingHierStateG.runModuleTG do throwError "SRM20 AUDIT FAILED: first conjunct of {thm} is not a runModuleTG equation"
        unless sv.getAppFn.constName? == some ``Tools.ShippingSrm6Sem.SVBoundsH do throwError "SRM20 AUDIT FAILED: last conjunct of {thm} is not SVBoundsH"
        let ra := lhs.getAppArgs   -- σ KS we children body seed T s
        let sa := sv.getAppArgs
        unless ra.size == 8 do throwError "SRM20 AUDIT FAILED: runModuleTG has {ra.size} args"
        -- SVBoundsH args: children rk n o seed T s envs
        let sIdx := sa.size - 8
        unless sa.size ≥ 8 do throwError "SRM20 AUDIT FAILED: SVBoundsH has {sa.size} args"
        unless ra[3]! == sa[sIdx]! do throwError "SRM20 AUDIT FAILED: run and SVBoundsH have different children maps"
        unless ra[5]! == sa[sIdx+4]! do throwError "SRM20 AUDIT FAILED: run and SVBoundsH have different seeds"
        unless ra[6]! == sa[sIdx+5]! do throwError "SRM20 AUDIT FAILED: run and SVBoundsH have different T"
        unless ra[7]! == sa[sIdx+6]! do throwError "SRM20 AUDIT FAILED: run and SVBoundsH have different start states"
        unless ra[4]!.getAppFn.constName? == some ``Sparkle.IR.AST.Module.body && ra[4]!.appArg! == sa[sIdx+3]! do throwError "SRM20 AUDIT FAILED: run body is not the body of the module of SVBoundsH"
        let some envsFv ← (do
          for x in acc do
            if (← x.fvarId!.getDecl).userName.toString == "envs" then return some x
          return none : MetaM (Option Expr)) | throwError "SRM20 AUDIT FAILED: no envs"
        unless run.getAppArgs[2]!.isAppOf ``Option.some && run.getAppArgs[2]!.appArg! == envsFv && sa[sIdx+7]! == envsFv do throwError "SRM20 AUDIT FAILED: run result and SVBoundsH list are not the same `envs`"
        unless conj[1]!.containsFVar envsFv.fvarId! && conj[2]!.containsFVar envsFv.fvarId! do throwError "SRM20 AUDIT FAILED: length / outputs conjuncts are not about the same envs"
    logInfo m!"S20ONEWITNESS|{thm}|one RunsTo/hcore/hpost/raw/b/D; no hrun binder; ids/cache/regs used in the hypotheses; run and SVBoundsH share children, seed, T, start state, body and the single `envs`"
  -- (4) QDepthLift is not defeq to any other Prop binder of its theorem
  do
    let thmQ := ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_underComposedG
    inTelescope thmQ fun xs _ => do
      let some hl ← binderNamed xs "hlift" | throwError "SRM20 AUDIT FAILED: no hlift"
      let q ← inferType hl
      unless q.getAppFn.constName? == some ``Tests.Compiler.SharedLeafMemKidIfaceTest.QDepthLift do throwError "SRM20 AUDIT FAILED: hlift is not QDepthLift"
      let cnt ← IO.mkRef 0
      let ci ← getConstInfo thmQ
      propTypesNotDefeq q ci.type cnt
      let n ← cnt.get
      unless n ≥ 20 do throwError "SRM20 AUDIT FAILED: only {n} Prop binder types compared with QDepthLift (vacuous)"
      logInfo m!"S20NOTRELABEL|QDepthLift is not defeq (isDefEq) to any of {n} other Prop binder types of topshareQ_svBoundsH_underComposedG"
  -- the depth difference of topshareQ is a fact about the two source statements
  do
    let srm9 ← getConstInfo ``Tests.Compiler.Srm9ComposedTest.topshareQ_composed_binder
    let srm19 ← getConstInfo ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_endToEnd
    let depthOf (e : Expr) : Option Expr := (e.find? fun x => x.isAppOf ``Tools.ShippingMachineShipsDepth.ResetNk).map fun x => x.getAppArgs[0]!
    let some d9 := depthOf srm9.type | throwError "SRM20 AUDIT FAILED: no ResetNk in the SRM9 Q composed binder"
    let some d19 := depthOf srm19.type | throwError "SRM20 AUDIT FAILED: no ResetNk in the SRM19 Q theorem"
    unless (← whnf d9).rawNatLit? == some 2 || d9.nat? == some 2 do throwError "SRM20 AUDIT FAILED: SRM9 Q composed binder is not at ResetNk 2"
    unless (← whnf d19).rawNatLit? == some 1 || d19.nat? == some 1 do throwError "SRM20 AUDIT FAILED: SRM19 Q theorem is not at ResetNk 1"
    logInfo m!"S20QDEPTH|SRM9 topshareQ_composed_binder: ComposedG at ResetNk 2 / KSn 2 / KT 2;  SRM19 topshareQ_svBoundsH_endToEnd: ResetNk 1 / KSn 1 / KT 1 (types differ; QDepthLift bridges them)"
    let m9 ← getConstInfo ``Tests.Compiler.Srm9ComposedTest.topshareM_composed_binder
    let m19 ← getConstInfo ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_endToEnd
    let some dm9 := depthOf m9.type | throwError "SRM20 AUDIT FAILED"
    let some dm19 := depthOf m19.type | throwError "SRM20 AUDIT FAILED"
    unless dm9.nat? == some 2 || (← whnf dm9).rawNatLit? == some 2 do throwError "SRM20 AUDIT FAILED: M composed binder depth"
    unless dm19.nat? == some 2 || (← whnf dm19).rawNatLit? == some 2 do throwError "SRM20 AUDIT FAILED: M SRM19 depth"
    logInfo m!"S20MDEPTH|topshareM: SRM9 composed binder and SRM19 theorem are both at ResetNk 2"
  -- (5) closure audit
  let forbidden : List Name := [`Tools.ShippingChildInv.RealChild, `Tools.ShippingChildInv.InvW, `Tools.ShippingMachineRan.MachineRan,
      `Tools.ShippingChildInv.MachineClosesAt, `Tools.ShippingMemKid.Kid, `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM,
      `Tools.ShippingChildInv.ChildBnd, `Tools.ShippingChildInv.StartV, `Tools.ShippingGenKid.GenKid,
      `Tools.ShippingKidFacts.KidFacts, `Tools.ShippingMachineDepthRun.MachineRunNC, `Tools.ShippingSharedLeafCoh.CacheClosed]
  for f in forbidden do
    unless (← getEnv).contains f do throwError "SRM20 AUDIT FAILED: the forbidden root {f} does not exist (vacuous audit)"
  let ctl ← depClosure `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM
  unless (ctl.toList.filter fun c => forbidden.any (·.isPrefixOf c)).length > 0 do throwError "SRM20 AUDIT FAILED: control walk found no old-form constant"
  for thm in audited20 do
    let cl ← depClosure thm
    let bad := hits cl
    unless bad.isEmpty do throwError "SRM20 AUDIT FAILED: old RefLaws boundary in the closure of {thm}: {bad}"
    let bad2 := cl.toList.filter fun c => forbidden.any (·.isPrefixOf c)
    unless bad2.isEmpty do throwError "SRM20 AUDIT FAILED: old-form boundary in the closure of {thm}: {bad2}"
    stdAxioms thm
    let inst := if (toString thm).startsWith "Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM" then "M" else "Q"
    let req : List Name := [``Tools.ShippingMachineShipsHier.ComposedG, ``Tools.ShippingMachineShipsDepth.composedG_of_NW,
      Name.mkStr `Tests.Compiler.Srm9ComposedTest s!"topshare{inst}_composed_binder", Name.mkStr `Tests.Compiler.Srm9ComposedTest s!"topshare{inst}_hierC_at_free",
      ``Tools.ShippingShipsFree.machine_ships_hierC_at_free,
      Name.mkStr `Tests.Compiler.SharedLeafMemKidIfaceTest s!"topshare{inst}_svBoundsH_endToEnd", Name.mkStr `Tests.Compiler.SharedLeafMemKidIfaceTest s!"topshare{inst}_composedNW"]
    for r in req do
      unless (← getEnv).contains r do throwError "SRM20 AUDIT FAILED: required constant {r} does not exist"
      unless cl.contains r do throwError "SRM20 AUDIT FAILED: {r} is not in the closure of {thm}"
    unless (← getEnv).contains ``Tools.ShippingComposedGW.ComposedGW do throwError "SRM20 AUDIT FAILED: ComposedGW does not exist"
    let gw := cl.contains ``Tools.ShippingComposedGW.ComposedGW
    logInfo m!"S20CLOSURE|{thm}|standard axioms; closure {cl.size} constants; no old-form boundary; contains ComposedG, composedG_of_NW, SRM9 {inst} composed_binder and hierC_at_free, machine_ships_hierC_at_free, SRM19 endToEnd; ComposedGW in closure: {gw}"
end
