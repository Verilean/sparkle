open Tests.Compiler.Srm22AuditTest in
/-- every Prop binder type of a statement (walking `∀`, `∃`, `∧`), counted, and checked NOT defeq (for ANY parameters of the gap) to the gap Prop `gap` -/
partial def propTypesNotDefeq (gap : Name) (skipHead : Bool) (e : Expr) (cnt : IO.Ref Nat) : MetaM Unit := do
  let check (t : Expr) : MetaM Unit := do
    if skipHead && t.getAppFn.constName? == some gap then return
    cnt.modify (· + 1)
    let gi ← getConstInfo gap
    let (ms, _, _) ← forallMetaTelescope gi.type
    if (← isDefEq t (mkAppN (mkConst gap) ms)) then throwError "SRM22 AUDIT FAILED: the gap Prop {gap} is defeq to the Prop binder type {t} (a relabelling)"
  match e with
  | .forallE .. =>
    forallTelescope e fun xs b => do
      for x in xs do
        let t ← inferType x
        if (← Meta.isProp t) then
          check t
          propTypesNotDefeq gap skipHead t cnt
      propTypesNotDefeq gap skipHead b cnt
  | .app (.app (.const ``Exists _) _) (.lam n d b bi) =>
    withLocalDecl n bi d fun x => propTypesNotDefeq gap skipHead (b.instantiate1 x) cnt
  | .app (.app (.const ``And _) a) b => do
    check a; check b
    propTypesNotDefeq gap skipHead a cnt; propTypesNotDefeq gap skipHead b cnt
  | _ => pure ()

open Tests.Compiler.Srm22AuditTest in
def corols22 : List Name :=
  [``Tests.Compiler.Srm22PairsTest.topshareM_svBoundsH_underComposedG_noHin,
   ``Tests.Compiler.Srm22PairsTest.topshareQ_svBoundsH_underComposedG'_noHin]

open Tests.Compiler.Srm22AuditTest in
run_cmd liftTermElabM do
  unless (← restatesConclusion ``Tests.Compiler.Srm22AuditTest.wrapper_mutation) do throwError "SRM22 AUDIT FAILED: the wrapper control was not caught"
  unless audited22.length == 17 do throwError "SRM22 AUDIT FAILED: audited22 has {audited22.length} theorems, expected exactly 17"
  -- (1) premise table
  let mut actual : List (Name × List Row) := []
  let mut lines : List String := []
  for thm in audited22 do
    let rows ← premiseRows thm
    actual := actual ++ [(thm, rows)]
    logInfo m!"S22THM|{thm}|{rows.length}"
    lines := lines ++ [s!"S22THM|{thm}|{rows.length}"]
    for r in rows do
      logInfo m!"{rowLine thm r}"
      lines := lines ++ [rowLine thm r]
    if (← restatesConclusion thm) then throwError "SRM22 AUDIT FAILED: a hypothesis of {thm} restates its conclusion"
  unless Tests.Compiler.Srm22AuditExpected.expectedRows.length == 17 do throwError "SRM22 AUDIT FAILED: the expected table has {Tests.Compiler.Srm22AuditExpected.expectedRows.length} theorem entries, expected exactly 17"
  match tableDiff actual Tests.Compiler.Srm22AuditExpected.expectedRows with
  | some msg => throwError "SRM22 AUDIT FAILED: the premise table differs from Tests/Compiler/Srm22AuditExpected.lean: {msg}"
  | none => pure ()
  let txt ← IO.FS.readFile "scripts/srm22/PREMISES.txt"
  let fileLines := (txt.splitOn "\n").filter (· != "")
  unless fileLines == lines do
    throwError "SRM22 AUDIT FAILED: scripts/srm22/PREMISES.txt differs from the regenerated table ({fileLines.length} lines vs {lines.length})"
  -- negative fixtures
  do
    let mt := mutType actual
    let mut changed : List (Name × Row × Row) := []
    unless mt.length == actual.length do throwError "SRM22 AUDIT FAILED: fixture 1 changed the number of theorems"
    for ((n, rs), (n', rs')) in actual.zip mt do
      unless n == n' && rs.length == rs'.length do throwError "SRM22 AUDIT FAILED: fixture 1 changed the shape of {n}"
      for (r, r') in rs.zip rs' do
        if r != r' then changed := changed ++ [(n, r, r')]
    match changed with
    | [(n, r, r')] =>
      unless r'.2.2.2.1 do throwError "SRM22 AUDIT FAILED: fixture 1 mutated row of {n} is not a Prop binder"
      unless r.2.2.2.1 && r'.1 == r.1 && r'.2.1 == r.2.1 && r'.2.2.1 == r.2.2.1 do throwError "SRM22 AUDIT FAILED: fixture 1 changed index/binderInfo/name/isProp of binder {r.1} of {n}"
      unless r'.2.2.2.2 != r.2.2.2.2 && r'.2.2.2.2.endsWith " ∧ True" && r'.2.2.2.2.length == r.2.2.2.2.length + 7 do throwError "SRM22 AUDIT FAILED: fixture 1 type string is not visibly changed"
      logInfo m!"S22FIXTURE1|{n}|binder {r.1} ({r.2.2.1})|original type: {r.2.2.2.2}|mutated type: {r'.2.2.2.2}"
      match tableDiff mt Tests.Compiler.Srm22AuditExpected.expectedRows with
      | some msg => unless (msg.splitOn s!"binder {r.1} differs").length > 1 && (msg.splitOn (toString n)).length > 1 do throwError "SRM22 AUDIT FAILED: fixture 1 rejection does not name the mutated binder: {msg}"
      | none => throwError "SRM22 AUDIT FAILED: the comparator ACCEPTED fixture 1"
    | _ => throwError "SRM22 AUDIT FAILED: fixture 1 changed {changed.length} rows, expected exactly 1"
  for (nm, mt) in [("changed Prop binder type", mutType actual), ("added data binder", mutAdd actual), ("reordered binders", mutSwap actual)] do
    if mt == actual then throwError "SRM22 AUDIT FAILED: the fixture '{nm}' did not change the table (vacuous)"
    match tableDiff mt Tests.Compiler.Srm22AuditExpected.expectedRows with
    | none => throwError "SRM22 AUDIT FAILED: the comparator ACCEPTED the fixture '{nm}'"
    | some msg => logInfo m!"S22FIXTURE|{nm}|rejected: {msg}"
  logInfo m!"S22TABLE|{audited22.length} theorems, {lines.length} binders: equal to the committed table and to scripts/srm22/PREMISES.txt"
  -- (2) independent full-type expected statements
  unless pairs22.length == 10 do throwError "SRM22 AUDIT FAILED: pairs22 has {pairs22.length} entries, expected 10"
  for (t, e) in pairs22 do
    let ci ← getConstInfo t
    let ei ← getConstInfo e
    unless (← isDefEq ci.type (ei.value?.getD (mkConst e))) do throwError "SRM22 AUDIT FAILED: the statement of {t} is not defeq to its expected form {e}"
    logInfo m!"S22EXPDEFEQ|{t}|{e}|isDefEq"
  unless defPairs22.length == 5 do throwError "SRM22 AUDIT FAILED: defPairs22 has {defPairs22.length} entries, expected 5"
  for (d, e) in defPairs22 do
    let a ← getConstInfo d
    let x ← getConstInfo e
    unless (← isDefEq a.value! x.value!) do throwError "SRM22 AUDIT FAILED: definition {d} is not defeq to its expected form {e} (the text of scripts/srm22/EXPECTED.txt)"
    logInfo m!"S22DEFDEFEQ|{d}|{e}|isDefEq"
  unless mutPairs22.length == 6 do throwError "SRM22 AUDIT FAILED: mutPairs22 has {mutPairs22.length} entries, expected 6"
  for (thmN, mutName) in mutPairs22 do
    let ci ← getConstInfo thmN
    let ei ← getConstInfo mutName
    if (← isDefEq ci.type (ei.value?.getD (mkConst ei.name))) then throwError "SRM22 AUDIT FAILED: the mutated expected statement {mutName} was ACCEPTED"
    logInfo m!"S22EXPMUT|{thmN}|{mutName} rejected"
  -- control: the SRM20 statement with hin kept IS the SRM20 theorem's type (so the mutation is a faithful copy of the source), and differs from the corollary only by the deleted/inserted binders
  do
    let s20 ← getConstInfo ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_underComposedG
    let ex ← getConstInfo ``Tests.Compiler.Srm22ExpStmt.Exp_mut_cor_withHin
    unless (← isDefEq s20.type ex.value!) do throwError "SRM22 AUDIT FAILED: Exp_mut_cor_withHin is not the SRM20 statement (the mutation control is vacuous)"
    logInfo m!"S22EXPCONTROL|Exp_mut_cor_withHin is defeq to the SRM20 theorem's type"
  -- (3a) the gap Props are not relabellings of any Prop binder of the SRM20/21/19/9 statements or of the new theorems
  do
    let others : List Name :=
      [``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_underComposedG,
       ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_underComposedG,
       ``Tests.Compiler.Srm21LiftTest.topshareQ_svBoundsH_underComposedG',
       ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_endToEnd,
       ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_endToEnd,
       ``Tests.Compiler.Srm9ComposedTest.topshareM_hierC_at_free,
       ``Tests.Compiler.Srm9ComposedTest.topshareQ_hierC_at_free,
       ``Tools.ShippingShipsFree.machine_ships_hierC_at_free,
       ``Tools.ShippingSrm13Supply.bounded_of_regsAtInit]
    let totalRef ← IO.mkRef (0 : Nat)
    for (gapN, _) in defPairs22 do
      for (thm, sk) in others.map (·, false) ++ audited22.map (·, true) do
        let ci ← getConstInfo thm
        let cnt ← IO.mkRef (0 : Nat)
        propTypesNotDefeq gapN sk ci.type cnt
        totalRef.modify (· + (← cnt.get))
    let total ← totalRef.get
    unless total ≥ 1000 do throwError "SRM22 AUDIT FAILED: only {total} (gap, Prop binder type) comparisons (vacuous)"
    logInfo m!"S22NOTRELABEL|each of the 5 gap Props is not defeq (for any parameters) to any of the Prop binder types compared ({total} comparisons) in the SRM20/21/19/9 statements and the 17 new theorems"
    -- control: the check does reject a relabelling (a Prop binder of RegsAtInit's own text is defeq to itself)
    let ci ← getConstInfo ``Tools.ShippingSrm22Width.InputsAreWires
    let cnt ← IO.mkRef (0 : Nat)
    let r ← (try propTypesNotDefeq ``Tools.ShippingSrm22Width.InputsAreWires false (← inferType (mkConst ``Tools.ShippingSrm22Width.hinsFit_of_hin [])) cnt; pure false catch _ => pure true)
    unless r do
      -- hinsFit_of_hin has the premise `hW : InputsAreWires b`: the walk MUST reject it, proving that the audit can fail
      throwError "SRM22 AUDIT FAILED: the relabelling control was not caught (hW : InputsAreWires b is a premise of hinsFit_of_hin)"
    logInfo m!"S22RELABELCONTROL|the walk rejects InputsAreWires b used as a premise of hinsFit_of_hin ({ci.name})"
  -- (3) ONE witness
  for thm in corols22 do
    inTelescope thm fun xs concl => do
      let mut cnt : List String := []
      for x in xs do cnt := cnt ++ [(← x.fvarId!.getDecl).userName.toString]
      for r in ["hcore", "hpost", "raw", "b", "D", "entry", "hBnd", "hBd"] do
        unless (cnt.filter (· == r)).length == 1 do throwError "SRM22 AUDIT FAILED: {thm} has {(cnt.filter (· == r)).length} binders named {r}, expected exactly 1"
      for r in ["hrun", "hRK", "hfit", "s", "hsk", "rk", "kids", "st0", "ins"] do
        if (cnt.filter (· == r)).length != 0 then throwError "SRM22 AUDIT FAILED: {thm} has a top-level binder named {r} (the run/state/Reset binders must live inside the ComposedG-shaped conclusion)"
      let mut nCore : Nat := 0
      let mut nRun : Nat := 0
      for x in xs do
        let t ← inferType x
        if t.getAppFn.constName? == some ``Tools.ShippingEntrySoundness.RunsTo then nCore := nCore + 1
        if t.getUsedConstants.contains ``Tools.ShippingHierStateG.runModuleTG then nRun := nRun + 1
      unless nCore == 1 && nRun == 0 do throwError "SRM22 AUDIT FAILED: {thm} has {nCore} RunsTo and {nRun} runModuleTG binders, expected 1 and 0"
      -- walk the conclusion: ∃ ids, … ∃ cache regs, … ∀ data, hyps → ∃ envs, run ∧ len ∧ obs ∧ SVBoundsH
      let rec peel (e : Expr) (acc : Array Expr) (k : Array Expr → Expr → MetaM Unit) : MetaM Unit := do
        match e with
        | .app (.app (.const ``Exists _) _) (.lam n d b bi) =>
          withLocalDecl n bi d fun x => peel (b.instantiate1 x) (acc.push x) k
        | .app (.app (.const ``And _) a) r =>
          -- the leading conjuncts of the ComposedG existential part are Prop facts; keep walking into the last, but stop at the run equation
          if a.getAppFn.constName? == some ``Eq && a.getUsedConstants.contains ``Tools.ShippingHierStateG.runModuleTG then k acc e
          else peel r acc k
        | .forallE .. => forallTelescope e fun ys b => peel b (acc ++ ys) k
        | _ => k acc e
      peel concl #[] fun acc inner => do
        let names ← acc.mapM fun x => do pure (← x.fvarId!.getDecl).userName.toString
        for r in ["ids", "cache", "regs", "ins", "st0", "mems", "kids", "T", "envs"] do
          unless (names.filter (· == r)).size == 1 do throwError "SRM22 AUDIT FAILED: inside the conclusion of {thm}, {(names.filter (· == r)).size} binders named {r}, expected exactly 1"
        unless (names.filter (· == "hrun")).size == 0 do throwError "SRM22 AUDIT FAILED: hrun appears in {thm}"
        -- ids / cache / regs (the ComposedG witnesses) occur in the hypotheses (SourceInputs / regs pass / init)
        let hypTys ← acc.filterMapM fun x => do
          let t ← inferType x
          if (← Meta.isProp t) then pure (some t) else pure none
        for r in ["ids", "cache", "regs"] do
          let mut fv : Option Expr := none
          for x in acc do
            if (← x.fvarId!.getDecl).userName.toString == r then fv := some x
          let some x := fv | throwError "SRM22 AUDIT FAILED: witness {r} missing"
          unless hypTys.any (·.containsFVar x.fvarId!) do throwError "SRM22 AUDIT FAILED: the ComposedG witness {r} of {thm} is not used in any hypothesis"
        -- the inner conjunction: run ∧ length ∧ obs ∧ SVBoundsH
        let rec flat (e : Expr) : List Expr := match e with
          | .app (.app (.const ``And _) a) b => a :: flat b
          | _ => [e]
        let conj := flat inner
        unless conj.length == 4 do throwError "SRM22 AUDIT FAILED: the inner conjunction of {thm} has {conj.length} parts, expected 4 (run, length, outputs, SVBoundsH)"
        let run := conj[0]!
        let sv := conj[3]!
        unless run.getAppFn.constName? == some ``Eq do throwError "SRM22 AUDIT FAILED: first conjunct of {thm} is not an equation"
        let lhs := run.getAppArgs[1]!
        unless lhs.getAppFn.constName? == some ``Tools.ShippingHierStateG.runModuleTG do throwError "SRM22 AUDIT FAILED: first conjunct of {thm} is not a runModuleTG equation"
        unless sv.getAppFn.constName? == some ``Tools.ShippingSrm6Sem.SVBoundsH do throwError "SRM22 AUDIT FAILED: last conjunct of {thm} is not SVBoundsH"
        let ra := lhs.getAppArgs   -- σ KS we children body seed T s
        let sa := sv.getAppArgs
        unless ra.size == 8 do throwError "SRM22 AUDIT FAILED: runModuleTG has {ra.size} args"
        -- SVBoundsH args: children rk n o seed T s envs
        let sIdx := sa.size - 8
        unless sa.size ≥ 8 do throwError "SRM22 AUDIT FAILED: SVBoundsH has {sa.size} args"
        unless ra[3]! == sa[sIdx]! do throwError "SRM22 AUDIT FAILED: run and SVBoundsH have different children maps"
        unless ra[5]! == sa[sIdx+4]! do throwError "SRM22 AUDIT FAILED: run and SVBoundsH have different seeds"
        unless ra[6]! == sa[sIdx+5]! do throwError "SRM22 AUDIT FAILED: run and SVBoundsH have different T"
        unless ra[7]! == sa[sIdx+6]! do throwError "SRM22 AUDIT FAILED: run and SVBoundsH have different start states"
        unless ra[4]!.getAppFn.constName? == some ``Sparkle.IR.AST.Module.body && ra[4]!.appArg! == sa[sIdx+3]! do throwError "SRM22 AUDIT FAILED: run body is not the body of the module of SVBoundsH"
        let some envsFv ← (do
          for x in acc do
            if (← x.fvarId!.getDecl).userName.toString == "envs" then return some x
          return none : MetaM (Option Expr)) | throwError "SRM22 AUDIT FAILED: no envs"
        unless run.getAppArgs[2]!.isAppOf ``Option.some && run.getAppArgs[2]!.appArg! == envsFv && sa[sIdx+7]! == envsFv do throwError "SRM22 AUDIT FAILED: run result and SVBoundsH list are not the same `envs`"
        unless conj[1]!.containsFVar envsFv.fvarId! && conj[2]!.containsFVar envsFv.fvarId! do throwError "SRM22 AUDIT FAILED: length / outputs conjuncts are not about the same envs"
    logInfo m!"S22ONEWITNESS|{thm}|one RunsTo/hcore/hpost/raw/b/D; no hrun binder; ids/cache/regs used in the hypotheses; run and SVBoundsH share children, seed, T, start state, body and the single `envs`"
  -- the corollaries: hin deleted (no weS constant left in the conclusion's hypotheses), residuals kept
  for thm in corols22 do
    let ci ← getConstInfo thm
    if ci.type.getUsedConstants.contains ``Tools.ShippingDesignSV.weS then throwError "SRM22 AUDIT FAILED: {thm} still mentions weS (the hin binder)"
    for need in [``Tools.ShippingMachineShipsDepth.ResetNk, ``Tools.ShippingSrm13Supply.FitTree, ``Tools.ShippingSrm13Supply.RegsAtInit, ``Tools.ShippingSrm13Supply.RegsFit, ``Tools.ShippingSrm13Supply.NonRegBounded, ``Tools.ShippingHierOpen.bodyInstOuts, ``Sparkle.IR.OptCheck.seqRegs] do
      unless ci.type.getUsedConstants.contains need do throwError "SRM22 AUDIT FAILED: the residual {need} is missing from {thm}"
    inTelescope thm fun xs _ => do
      for r in ["hnd", "hsI", "hIW", "hBd", "hBnd", "hcore", "hpost", "entry"] do
        let mut c : Nat := 0
        for x in xs do
          if (← x.fvarId!.getDecl).userName.toString == r then c := c + 1
        unless c == 1 do throwError "SRM22 AUDIT FAILED: {thm} has {c} binders named {r}, expected exactly 1"
    logInfo m!"S22RESIDUALS|{thm}|no weS (hin deleted); ResetNk, FitTree, RegsAtInit, RegsFit, NonRegBounded, bodyInstOuts, seqRegs kept; hnd/hsI/hIW/hBd/hBnd/hcore/hpost/entry once each"
  -- (4) closure audit
  let forbidden : List Name := [`Tools.ShippingChildInv.RealChild, `Tools.ShippingChildInv.InvW, `Tools.ShippingMachineRan.MachineRan,
      `Tools.ShippingChildInv.MachineClosesAt, `Tools.ShippingMemKid.Kid, `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM,
      `Tools.ShippingChildInv.ChildBnd, `Tools.ShippingChildInv.StartV, `Tools.ShippingGenKid.GenKid,
      `Tools.ShippingKidFacts.KidFacts, `Tools.ShippingMachineDepthRun.MachineRunNC, `Tools.ShippingSharedLeafCoh.CacheClosed]
  for f in forbidden do
    unless (← getEnv).contains f do throwError "SRM22 AUDIT FAILED: the forbidden root {f} does not exist (vacuous audit)"
  let ctl ← depClosure `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM
  unless (ctl.toList.filter fun c => forbidden.any (·.isPrefixOf c)).length > 0 do throwError "SRM22 AUDIT FAILED: control walk found no old-form constant"
  for thm in audited22 do
    let cl ← depClosure thm
    let bad := hits cl
    unless bad.isEmpty do throwError "SRM22 AUDIT FAILED: old RefLaws boundary in the closure of {thm}: {bad}"
    let bad2 := cl.toList.filter fun c => forbidden.any (·.isPrefixOf c)
    unless bad2.isEmpty do throwError "SRM22 AUDIT FAILED: old-form boundary in the closure of {thm}: {bad2}"
    stdAxioms thm
    logInfo m!"S22CLOSURE|{thm}|standard axioms; closure {cl.size} constants; no old-form boundary"
  for (thm, req) in [(corols22[0]!, ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_underComposedG), (corols22[1]!, ``Tests.Compiler.Srm21LiftTest.topshareQ_svBoundsH_underComposedG')] do
    let cl ← depClosure thm
    for r in [req, ``Tools.ShippingSrm22Width.hin_of_hinsFit, ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_endToEnd, ``Tools.ShippingShipsFree.machine_ships_hierC_at_free] do
      unless (← getEnv).contains r do throwError "SRM22 AUDIT FAILED: required constant {r} does not exist"
      if r == ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_endToEnd && thm == corols22[1]! then continue
      unless cl.contains r do throwError "SRM22 AUDIT FAILED: {r} is not in the closure of {thm}"
    logInfo m!"S22CLOSURE2|{thm}|closure contains {req}, hin_of_hinsFit, machine_ships_hierC_at_free"
end
