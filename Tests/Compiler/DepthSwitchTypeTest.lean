import Lean.Elab.Command
import Tools.ShippingMachineDepthCommandROld
import Tests.Compiler.ShippingCallsCloseDeepTest
import Tests.Compiler.NoPortsTwoTest
import Tests.Compiler.NoPortsMidTest
import Tests.Compiler.NoPortsKidsMid2Test
import Tests.Compiler.NoPortsLoopParentTest
import Tests.Compiler.NoPortsSlotlessEngineOnceTest
import Tests.Compiler.NoPortsSlotlessTwinCallsTest
import Tests.Compiler.NoPortsSlotlessMesh2x2Test

/-! # Old loop against switched loop: the 51 statements compared as TYPES, on one tree (round par/b-23)

WRITTEN, NOT BUILT. TARGET-ONLY. This is the PRIMARY acceptance check of the
switch of `#machine_design_svNR` to the grouped loop
(`docs/parallel/B-depth-switch.md` §4).

In this environment the imported tests have generated, for 17 endpoints, the
three theorems `f.machine_composedNR{n}`, `f.machine_ships_hierNR{n}`,
`f.machine_design_svNR{n}` with the command AS IT IS ON THIS TREE (after the
switch: the grouped loop). Here the SAME endpoints are generated again by
the per-entry loop of before the switch
(`Tools/ShippingMachineDepthCommandROld.lean`: the old lines verbatim) under
the names `…NRO{n}`, and per pair of statements:

* ASSERTED: `isDefEq` of the two types (after `instantiateMVars`);
* ASSERTED: standard axioms of both theorems;
* LOGGED, not asserted: whether the two types are the same term (`==`).

ASSERTED about the run itself: 17 endpoints, no endpoint twice, exactly 51
comparisons made, 51 distinct `NR` names and 51 distinct `NRO` names, no
theorem compared with itself, no endpoint skipped — a missing `NR` theorem,
an existing `NRO` theorem, or a failure of the old generator is an ERROR
(collected, all reported, then thrown). There is no mode in which this file
passes without comparing.

What it does NOT say: (a) a CHILD's composed theorem used by the old loop is
the one in the environment (generated by the switched command, or by
`generateRunOfR` now) — the old code here is the loop over the PARENT's
entries and what fixes the parent's statement; (b) nothing about the Keccak
sponge: the old loop does not finish on it (`docs/parallel/A-depth-grouped.md`),
so no old-vs-new comparison exists there; its acceptance is the switched
command ending with a kernel-checked theorem and the downstream no-ports
chain; (c) the statement of an endpoint depends on which closing theorems of
its children exist when it is generated — if an imported file added one
AFTER generating `…NR{n}`, the comparison fails without a defect of either
loop (the error lists the closings present now).
-/

namespace Tests.Compiler.DepthSwitchTypeTest
open Lean Meta Elab Command

/-- The endpoints (the 17 of `DepthGroupedFamilyTest`). -/
def endpoints : List (Name × Nat) :=
  [(``Sparkle.Tests.Compiler.ShippingMachineSeqTest.parent, 1),
   (``Sparkle.Tests.Compiler.ShippingMachineSeqTest.chained, 1),
   (``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.two, 1),
   (``Sparkle.Tests.Compiler.ShippingMachineSeqTest.mid, 1),
   (``Sparkle.Tests.Compiler.ShippingMachineSeqTest.grand, 2),
   (``Sparkle.Tests.Compiler.ShippingMachineSeqLoopTest.loopParent, 1),
   (``Sparkle.Tests.Compiler.ShippingMachineDepthHTest.grandH, 1),
   (``Sparkle.Tests.Compiler.ShippingMachineDepthHTest.grandH, 2),
   (``Sparkle.Tests.Compiler.ShippingDesignSVTest.mid2, 1),
   (``Sparkle.Tests.Compiler.ShippingDesignSVTest.mixD1, 1),
   (``Sparkle.Tests.Compiler.ShippingDesignSVTest.mixD1, 2),
   (``Sparkle.Tests.Compiler.ShippingDesignSVTest.topD2, 2),
   (``Sparkle.Tests.Compiler.ShippingDesignSVTest.topD2, 3),
   (``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.mixDeep, 2),
   (``Sparkle.Tests.Compiler.MultiInstance.engineOnce, 1),
   (``Sparkle.Tests.Compiler.MultiInstance.twinCalls, 1),
   (``Sparkle.Tests.Compiler.MultiInstance.mesh2x2, 1)]

/-- The three names of an endpoint at depth `dep`, with the marker `mk`
(`"NR"`: the switched command; `"NRO"`: the old loop). -/
def namesOfEndpoint (f : Name) (mk : String) (dep : Nat) : List Name :=
  [f ++ Name.mkSimple s!"machine_composed{mk}{dep}",
   f ++ Name.mkSimple s!"machine_ships_hier{mk}{dep}",
   f ++ Name.mkSimple s!"machine_design_sv{mk}{dep}"]

/-- Standard axioms only, an error otherwise. -/
def stdAxiomsT (n : Name) : MetaM Unit := do
  for ax in ← Lean.collectAxioms n do
    unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
      throwError "{n} uses a non-standard axiom: {ax}"

/-- The closing theorems of `f`'s direct children present now. -/
def closingsNow (f : Name) : MetaM (List Name) := do
  let r ← Tools.ShippingMachineCommand.readMachine f
  let env ← getEnv
  let kids : List Name := (r.shape.insts.map fun i => i.1).eraseDups
  let mut out : List Name := []
  for c in kids do
    for s in [`machine_closes_at, `closes_deep, `machine_closes] do
      if env.contains (c ++ s) then out := out ++ [c ++ s]
  return out

/-- One endpoint: the old loop's three theorems generated, the three pairs
compared. Returns, per pair, the two names and whether the types are the
same term. Throws on anything else. -/
def compareEndpoint (f : Name) (dep : Nat) : CommandElabM (List (Name × Name × Bool)) := do
  let env0 ← getEnv
  let news := namesOfEndpoint f "NR" dep
  let olds := namesOfEndpoint f "NRO" dep
  for n in news do
    unless env0.contains n do
      throwError "{n}: not in the environment (the imported tests do not generate it with the switched command)"
  for o in olds do
    if env0.contains o then throwError "{o}: exists already (the old loop would not run)"
  Tools.ShippingMachineDepthCommand.preClose f
  discard <| liftTermElabM <|
    withOptions (fun o => maxRecDepth.set (Lean.Elab.async.set o false) 1000000) <|
      withTheReader Core.Context (fun c => { c with maxRecDepth := 1000000 })
        (Tools.ShippingMachineDepthCommand.OldLoop.generateDesignNROld f dep)
  liftTermElabM <|
    withOptions (fun o => maxRecDepth.set o 1000000) <|
      withTheReader Core.Context (fun c => { c with maxRecDepth := 1000000 }) do
    let mut res : List (Name × Name × Bool) := []
    for (n, o) in news.zip olds do
      let some (ConstantInfo.thmInfo tn) := (← getEnv).find? n
        | throwError "{n}: not a theorem"
      let some (ConstantInfo.thmInfo told) := (← getEnv).find? o
        | throwError "{o}: not generated as a theorem by the old loop"
      let tyN ← instantiateMVars tn.type
      let tyO ← instantiateMVars told.type
      let same : Bool := tyN == tyO
      unless ← isDefEq tyN tyO do
        let cl ← closingsNow f
        throwError "{n}: its statement is NOT isDefEq the statement of {o} (the old loop's). Closing theorems of the children present now: {cl}"
      stdAxiomsT n
      stdAxiomsT o
      res := res ++ [(n, o, same)]
    pure res

/-- All endpoints; the run's own assertions (see the header). -/
def compareAll : CommandElabM Unit := do
  let eps := endpoints
  unless eps.length == 17 do throwError "DEPTH SWITCH TYPES: {eps.length} endpoints listed, expected 17"
  unless eps.eraseDups.length == eps.length do throwError "DEPTH SWITCH TYPES: an endpoint is listed twice"
  let mut pairs : List (Name × Name × Bool) := []
  let mut failed : List String := []
  for (f, dep) in eps do
    let res : Except String (List (Name × Name × Bool)) ← try
        let r ← compareEndpoint f dep
        pure (Except.ok r)
      catch ex =>
        let msg ← ex.toMessageData.toString
        pure (Except.error msg)
    match res with
    | Except.error msg =>
      failed := failed ++ [s!"{f} at depth {dep}: {msg}"]
      logError m!"DEPTH SWITCH TYPES FAILED {f} at depth {dep}: {msg}"
    | Except.ok r =>
      if r.length == 3 then
        pairs := pairs ++ r
        let sames : List Bool := r.map fun (x : Name × Name × Bool) => x.2.2
        logInfo m!"DEPTH SWITCH TYPES {f} at depth {dep}: 3 statements of the switched command isDefEq the old loop's, standard axioms of all 6; the same term (composed, ships_hier, design_sv): {sames}"
      else
        failed := failed ++ [s!"{f} at depth {dep}: {r.length} comparisons, expected 3"]
  unless failed.isEmpty do
    throwError "DEPTH SWITCH TYPES: {failed.length} of {eps.length} endpoints FAILED or were not compared: {failed}"
  let newNames : List Name := pairs.map fun (x : Name × Name × Bool) => x.1
  let oldNames : List Name := pairs.map fun (x : Name × Name × Bool) => x.2.1
  unless pairs.length == 51 do throwError "DEPTH SWITCH TYPES: {pairs.length} comparisons, expected 51"
  unless newNames.eraseDups.length == 51 && oldNames.eraseDups.length == 51 do
    throwError "DEPTH SWITCH TYPES: duplicate names among the compared theorems"
  unless (newNames.filter fun n => oldNames.contains n).isEmpty do
    throwError "DEPTH SWITCH TYPES: a theorem was compared with itself"
  let nSame : Nat := (pairs.filter fun (x : Name × Name × Bool) => x.2.2).length
  logInfo m!"DEPTH SWITCH TYPES: 51 of 51 statement pairs isDefEq (the switched command against the per-entry loop of before the switch, both generated on this tree), 17 endpoints, none skipped, standard axioms of all 102 theorems; the same term: {nSame} of 51 (logged, not asserted). NOT covered: the Keccak sponge (the old loop does not finish on it); children's composed theorems are shared by both loops"

end Tests.Compiler.DepthSwitchTypeTest

set_option maxHeartbeats 0 in
run_cmd Tests.Compiler.DepthSwitchTypeTest.compareAll
