    [(ns ++ `a_wrap_hcalls, old ++ `ts1_C_hcalls), (ns ++ `a_wrap3_hcalls, old ++ `ts0_C_hcalls),
     (ns ++ `a_wrap_composedA, old ++ `ts1_C_composedA), (ns ++ `a_wrap_seqChildRunN2, old ++ `ts1_C_seqChildRunN2),
