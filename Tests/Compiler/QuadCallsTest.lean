/-! ## closure audit -/

open Lean Elab Command Meta in
open Tests.Compiler.ChildVertAuditTest in
set_option maxHeartbeats 0 in
run_cmd Lean.Elab.Command.liftTermElabM do
  let old := `Tests.Compiler.TopShareComposedTest
  let t2 := `Tests.Compiler.SharedLeafGenTest.topshare2
  for (c, olds) in [(``Tests.Compiler.QuadCallsTest.a_returned4, [old ++ `ts0_C_hcalls, old ++ `ts1_C_hcalls, old ++ `ts_composedA, old ++ `ts_soundLA, old ++ `ts0_C_composedA,
                       old ++ `ts1_C_composedA, old ++ `ts0_C_seqChildRunN2, old ++ `ts1_C_seqChildRunN2, `Tests.Compiler.QuadComposedTest.qc_hgrp]),
                    (``Tests.Compiler.QuadCallsTest.a_wired4, [old ++ `ts0_C_hcalls, old ++ `ts1_C_hcalls, old ++ `ts_composedA, `Tests.Compiler.QuadComposedTest.qc_hgrp]),
                    (``Tests.Compiler.QuadCallsTest.b_returned4, [t2 ++ `epD2M0_C_hcalls, t2 ++ `epD2M1_C_hcalls, t2 ++ `epD2M_composedA, t2 ++ `epD2M_soundLA,
                       t2 ++ `epD2M0_C_composedA, t2 ++ `epD2M1_C_composedA, t2 ++ `epD2M0_C_seqChildRunN2, t2 ++ `epD2M1_C_seqChildRunN2, t2 ++ `machine_composedNR2,
                       t2 ++ `epD2M_returned, t2 ++ `epD2M_wired]),
                    (``Tests.Compiler.QuadCallsTest.b_wired4, [t2 ++ `epD2M0_C_hcalls, t2 ++ `epD2M1_C_hcalls, t2 ++ `epD2M_composedA, t2 ++ `epD2M_returned, t2 ++ `epD2M_wired])] do
    stdAxioms c
    let cl ← depClosure c
    let forbidden : List Name := [`Tools.ShippingChildInv.ChildBnd, `Tools.ShippingChildInv.StartV, `Tools.ShippingGenKid.GenKid,
      `Tools.ShippingKidFacts.KidFacts, `Tools.ShippingMachineDepthRun.MachineRunNC,
      `Tools.ShippingMachineDepthRun.machineRunNC_of_real, `Tools.ShippingMachineDepthRun.seqChildRunN_of_composedC]
    for f in forbidden do
      unless (← getEnv).contains f do throwError "SR16 AUDIT FAILED: the forbidden name {f} does not exist (the audit would check nothing)"
    let bad := hits cl ++ cl.toList.filter fun x => forbidden.any (·.isPrefixOf x)
    unless bad.isEmpty do throwError "SR16 AUDIT FAILED: old boundary / old child predicate in the closure of {c}: {bad}"
    for n in olds do
      unless (← getEnv).contains n do throwError "SR16 AUDIT FAILED: {n} does not exist (the audit would check nothing)"
      if cl.contains n then throwError "SR16 AUDIT FAILED: the old block {n} is in the closure of {c}"
    for must in [``Tools.ShippingQuadReturned.quad_returned, ``Tools.ShippingQuadCalls.quad_composed_split, ``Tools.ShippingQuadCalls.leafCallee_hcalls,
        ``Tools.ShippingQuadCalls.quad_inRange, ``Tools.ShippingQuadCalls.call_inRange, ``Tools.ShippingQuadComposed.quad_composed,
        ``Tools.ShippingQuadComposed.quad_soundLA, ``Tools.ShippingQuadComposed.leafCallee_seqChildRunN2] do
      unless cl.contains must do throwError "SR16 AUDIT FAILED: {must} not in the closure of {c}"
    let remaining := cl.toList.filter fun x => (`Tests.Compiler.TopShareComposedTest).isPrefixOf x
    logInfo m!"SR16 CLOSURE AUDIT: {c}: standard axioms; closure {cl.size} constants; none of the old hcalls / composed / seqChildRunN2 blocks; the split generic lemmas are in it; remaining TopShareComposedTest constants: {remaining}"

end Tests.Compiler.QuadCallsTest
