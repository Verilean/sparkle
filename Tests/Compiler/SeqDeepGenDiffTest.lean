  refusedM ``Tests.Compiler.SeqDeepGenDiffTest.topd3 ["REFUSED", "depth 3", "wrap4", "wrap"]
  refusedM ``Tests.Compiler.SeqDeepGenDiffTest.topdmem ["REFUSED", "memory in P", "topdmem"]

