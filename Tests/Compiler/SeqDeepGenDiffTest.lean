/-- a second leaf, DIFFERENT from `acc` -/
@[hardware_module] def acc2 {dom : DomainConfig} (x : Signal dom (BitVec 8)) : AccOut dom :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal dom (BitVec 8))
    r <~ rs + x + x
    return ({ s := rs, odd := rs === (Signal.pure 3#8 : Signal dom (BitVec 8)) } : AccOut dom)

/-- a second callee with calls of its own: `wrap2 -> acc2` -/
@[hardware_module] def wrap2 {dom : DomainConfig} (x y : Signal dom (BitVec 8)) : AccOut dom :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal dom (BitVec 8))
    let a := acc2 x
    r <~ a.s + y
    return ({ s := rs, odd := a.odd } : AccOut dom)

def topdiff2 (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let m2 := wrap2 w v
    r <~ Signal.mux (m.odd &&& m2.odd &&& en) (rs + v) rs
    return rs

#machine_endpoint topdiff2

/-- FOUR calls, two callees, different argument lists per callee, interleaved; several fields of one call read. -/
def topdiff3 (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let m2 := wrap2 w v
    let m3 := wrap v v
    let m4 := wrap2 v w
    r <~ Signal.mux (m.odd &&& m2.odd &&& m3.odd &&& m4.odd &&& en) (rs + m3.s + m4.s) (rs + m.s + m2.s)
    return rs

#machine_endpoint topdiff3

/-- a single callee, in a file that imports the several-callee module -/
def topone (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap2 v w
    r <~ Signal.mux (m.odd &&& en) (rs + v) rs
    return rs

#machine_endpoint topone

