open Lean Meta Elab Command in
def auditDiff (ep root : Name) (cs gs : List Name) : MetaM Unit := do
  let bnd := (← getConstInfo (root ++ `epD2M_Bnd)).value!
  let mut defs : Array Name := #[]
  let mut todo : Array Expr := #[bnd]
  while !todo.isEmpty do
    let e := todo.back!
    todo := todo.pop
    if e.getAppFn.isConstOf ``Tools.ShippingMachineEntry.MachineDefines && e.getAppNumArgs == 6 then
      defs := defs.push (← Tools.ShippingSeqParentGen.readName e.getAppArgs[4]!)
    match e with
    | .app f a => todo := todo.push a |>.push f
    | .lam _ t b _ | .forallE _ t b _ => todo := todo.push b |>.push t
    | .mdata _ b => todo := todo.push b
    | _ => pure ()
  -- IN ORDER: callee 0, its leaf, callee 1, its leaf (the order of the generated boundary)
  let want := (cs.zip gs).foldr (fun (c, g) acc => c :: g :: acc) []
  unless defs.toList == want do
    throwError "SR3w AUDIT FAILED: {root}.epD2M_Bnd asks MachineDefines for {defs}, expected exactly {want}"
  let cl ← Tests.Compiler.ChildVertAuditTest.depClosure ep
  for must in (root :: cs ++ gs).map (· ++ `machineData) do
    unless cl.contains must do throwError "SR3w AUDIT FAILED: {must} not in the closure of {ep}"
  for mustNot in [``Sparkle.Tests.Compiler.ShippingMachineSeqTest.grand.machineData, ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.mid.machineData,
      ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt.machineData, ``Tests.Compiler.SeqDeepGenInstTest.topw.epD2_endpoint,
      ``Tests.Compiler.SeqDeepGenArgsTest.toptwo.epD2_endpoint] do
    if cl.contains mustNot then throwError "SR3w AUDIT FAILED: {mustNot} is in the closure of {ep}"
  let ty := (← getConstInfo ep).type
  let premises ← forallTelescope ty fun xs _ => do
    let mut ps : Array String := #[]
    for x in xs do
      if (← isProp (← inferType x)) then ps := ps.push s!"{(← x.fvarId!.getUserName)}"
    return ps
  unless premises.toList == ["hr", "entry", "closes"] do throwError "SR3w AUDIT FAILED: premises {premises}"
  logInfo m!"SR3w: {root} -> {cs.zip gs} generated; MachineDefines exactly {defs} (in this order); outer premises {premises}; closure has the data of all {2 * cs.length + 1} declarations, none of grand/mid/cnt/topw/toptwo"

open Lean Meta Elab Command in
run_cmd liftTermElabM do
  auditDiff ``Tests.Compiler.SeqDeepGenDiffTest.topdiff2.epD2M_endpoint ``Tests.Compiler.SeqDeepGenDiffTest.topdiff2
    [``Tests.Compiler.SeqDeepGenInstTest.wrap, ``Tests.Compiler.SeqDeepGenDiffTest.wrap2]
    [``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.acc, ``Tests.Compiler.SeqDeepGenDiffTest.acc2]
  auditDiff ``Tests.Compiler.SeqDeepGenDiffTest.topdiff3.epD2M_endpoint ``Tests.Compiler.SeqDeepGenDiffTest.topdiff3
    [``Tests.Compiler.SeqDeepGenInstTest.wrap, ``Tests.Compiler.SeqDeepGenDiffTest.wrap2]
    [``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.acc, ``Tests.Compiler.SeqDeepGenDiffTest.acc2]

/-! ## refusals (message asserted; no `epD2M_*` / `epD2_*` declaration created) -/

/-- two callees that call the SAME leaf `acc` (`wrap` and `wrap3`) -/
@[hardware_module] def wrap3 {dom : DomainConfig} (x y : Signal dom (BitVec 8)) : AccOut dom :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal dom (BitVec 8))
    let a := acc x
    r <~ a.s + y
    return ({ s := rs, odd := a.odd } : AccOut dom)

def topshare (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let m2 := wrap3 w v
    r <~ Signal.mux (m.odd &&& m2.odd &&& en) (rs + v) rs
    return rs

#machine_endpoint topshare

/-- a leaf `cnt` next to the depth-2 callee `wrap` -/
def topmix (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let k := cnt en
    r <~ Signal.mux (m.odd &&& k.hit) (rs + v) rs
    return rs

#machine_endpoint topmix

/-- THE NEXT AXIS: a callee `wrap4` whose callee is `wrap`, which has calls of its own (depth 3) -/
@[hardware_module] def wrap4 {dom : DomainConfig} (x y : Signal dom (BitVec 8)) : AccOut dom :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal dom (BitVec 8))
    let a := wrap x y
    r <~ a.s + y
    return ({ s := rs, odd := a.odd } : AccOut dom)

def topd3 (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap2 v w
    let m2 := wrap4 w v
    r <~ Signal.mux (m.odd &&& m2.odd &&& en) (rs + v) rs
    return rs

#machine_endpoint topd3

/-- two callees AND a memory in the parent -/
def topdmem (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) (wa : Signal defaultDomain (BitVec 4)) :
    Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let m2 := wrap2 w v
    let rd := Signal.memoryComboRead wa v en wa
    r <~ Signal.mux (m.odd &&& m2.odd &&& en) (rs + rd) rs
    return rs

#machine_endpoint topdmem

open Lean Meta Elab Command in
def refusedM (decl : Name) (needles : List String) : CommandElabM Unit := do
  let saved := (← get).messages
  elabCommand (← `(command| #machine_seq_parent_endpoint $(mkIdent decl)))
  let ms := (← get).messages
  let errs ← ms.toList.filterM fun m => pure (m.severity == .error)
  let txts ← errs.mapM fun m => m.data.toString
  modify fun s => { s with messages := saved }
  unless txts.length == 1 do throwError "SR3w AUDIT FAILED: expected exactly one refusal for {decl}, got {txts}"
  unless (txts.head!.splitOn "unit SR3w").length > 1 do throwError "SR3w AUDIT FAILED: the refusal of {decl} is not from the several-callees elaborator: {txts.head!}"
  for n in needles do
    unless (txts.head!.splitOn n).length > 1 do throwError "SR3w AUDIT FAILED: the refusal of {decl} does not mention `{n}`: {txts.head!}"
  let n := (← getEnv).constants.fold (init := (0 : Nat)) fun (n : Nat) c _ =>
    if decl.isPrefixOf c && ((c.toString.splitOn ".epD2M").length > 1 || (c.toString.splitOn ".epD2_").length > 1) then n + 1 else n
  unless n == 0 do throwError "SR3w AUDIT FAILED: {n} epD2M_*/epD2_* declaration(s) exist for the refused {decl}"
  logInfo m!"SR3w: {decl} REFUSED as expected: {txts.head!.take 300}…"

