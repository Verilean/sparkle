      t ++ `machine_kidsD2, t ++ `machine_runFactsK2, t ++ `machine_outsGK2,
      t ++ `machine_maskedGK2, t ++ `machine_designPK2] do
    unless (← Lean.getEnv).contains n do throwError "{n}: not generated"
    Tests.Compiler.NoPortsTest.stdAxioms n
  -- (3) the refused declarations left nothing
  for n in [g ++ `machine_kidsD1, g ++ `machine_design_noPortsNR1,
      midH ++ `machine_kidsD2, midH ++ `machine_design_noPortsNR2,
      cnt ++ `machine_kidsD2, cnt ++ `machine_design_noPortsNR2] do
    if (← Lean.getEnv).contains n then throwError "{n}: exists — it was not refused"
  -- (4) what the `_try` generations left: LOGGED; whatever exists is checked
  let mut lines : Array String := #[]
  for (f, n) in [(t, 3), (mx, 2), (gH, 2), (m1, 2)] do
    let openN := f ++ Lean.Name.mkSimple s!"machine_design_noPortsNR{n}"
    let closed := f ++ Lean.Name.mkSimple s!"machine_design_noPortsNR{n}_closed"
    let old := f ++ Lean.Name.mkSimple s!"machine_design_svNR{n}"
    for e in [openN, closed] do
      if (← Lean.getEnv).contains e then
        Tests.Compiler.NoPortsTest.stdAxioms e
        let ty := (← Lean.getConstInfo e).type
        for k in Tests.Compiler.NoPortsTest.checkers do
          if (ty.find? (·.isConstOf k)).isSome then
            throwError "{e}: the statement mentions {k}"
        let mut inv : List Lean.Name := []
        if (← Lean.getEnv).contains old then
          let oldT := (← Lean.getConstInfo old).type
          for k in [``Tools.ShippingHierPremisesBase.shipsHierCheck,
              ``Tools.ShippingMachineShipsDepth.kidsMaskedN, ``Tools.ShippingDesignSV.designCheck,
              ``Tools.ShippingDesignSVBack.outsCheck] do
            if (oldT.find? (·.isConstOf k)).isSome then inv := inv ++ [k]
        let asksClosing := (ty.find? (·.isConstOf ``Tools.ShippingChildInv.MachineClosesAt)).isSome
        lines := lines.push s!"{e}: GENERATED, standard axioms, no checker constant; asks MachineClosesAt: {asksClosing}; {old} mentions {inv}"
      else
        lines := lines.push s!"{e}: NOT in the environment (refused, or no closed form — see the NOPORTS DEEP lines above)"
  Lean.logInfo m!"{String.intercalate "\n" lines.toList}"
  Lean.logInfo m!"NOPORTS DEEP FAMILY: {g} and {t} at depth 2 — COMPARE path, both statements of each rebuilt by #machine_no_ports_deep (GenKid of {mid} over the leaf {cnt}; GenKid of {m2} over the one-output {midH}) and isDefEq the hand ones, kept as _regen on standard axioms (nothing new removed). Generation by the _try commands: {lines.size} endpoints listed above (GENERATED or NOT in the environment), not asserted. REFUSED with reasons (logged above), nothing added: {g} at 1, {midH} at 2, {cnt} at 2. TARGET-BUILT ONLY: it creates names owned by NoPortsTopD2N3Test and NoPortsMixDeepTest. SCOPE: one declaration each, a parent WITH a register under the general closing, callees = leaf register machines, one-output machines over ONE gate child, or general-closing machines over ONE such callee; data conditions decided per declaration (conditions, not reductions); compiler guards with fallback; DesignSV of the module list with the children UNOPTIMISED — not the SV string, not #sim; the run, the reflections and the boundary remain premises."
