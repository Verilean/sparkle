set_option maxHeartbeats 0 in
run_cmd Lean.Elab.Command.liftTermElabM do
  let g := ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.grand
  let mid := ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.mid
  let cnt := ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt
  let t := ``Sparkle.Tests.Compiler.ShippingDesignSVTest.topD2
  let m2 := ``Sparkle.Tests.Compiler.ShippingDesignSVTest.mid2
  let midH := ``Sparkle.Tests.Compiler.ShippingMachineDepthHTest.midH
  let mx := ``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.mixDeep
  let gH := ``Sparkle.Tests.Compiler.ShippingMachineDepthHTest.grandH
  let m1 := ``Sparkle.Tests.Compiler.ShippingDesignSVTest.mixD1
  -- (1) the compare path RAN on grand and topD2 (the rebuilt theorems exist) and agrees
  for f in [g, t] do
    for s in ["machine_design_noPortsNR2", "machine_design_noPortsNR2_closed"] do
      let e := f ++ Lean.Name.mkSimple s
      let r := f ++ Lean.Name.mkSimple (s ++ "_regen")
      unless (← Lean.getEnv).contains r do
        throwError "{r}: missing — the compare path did not rebuild {e}"
      Tests.Compiler.NoPortsTest.stdAxioms r
      unless ← Lean.Meta.isDefEq (← Lean.getConstInfo e).type (← Lean.getConstInfo r).type do
        throwError "{r}: its statement is not that of {e}"
      for k in Tests.Compiler.NoPortsTest.checkers do
        if ((← Lean.getConstInfo r).type.find? (·.isConstOf k)).isSome then
          throwError "{r}: the statement mentions {k}"
  -- (2) the generated lemmas of the compare path, on standard axioms
  for n in [mid ++ `machine_genKid1, m2 ++ `machine_genKid1, midH ++ `machine_oneOutKid,
      cnt ++ `machine_leafKid, g ++ `machine_kidsD2, g ++ `machine_runFactsK2,
