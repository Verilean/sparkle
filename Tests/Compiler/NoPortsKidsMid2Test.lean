/-! ## The reader's data: LOGGED first, then asserted -/

set_option maxHeartbeats 0 in
run_cmd Lean.Elab.Command.liftTermElabM do
  let f := ``Sparkle.Tests.Compiler.ShippingDesignSVTest.mid2
  let m := ``Sparkle.Tests.Compiler.ShippingMachineDepthHTest.midH
  let rc := ``Sparkle.Tests.Compiler.ShippingMachineDepthHTest.rcH
  let r ← Tools.ShippingMachineCommand.readMachine f
  let mr ← Tools.ShippingMachineCommand.readMachine m
  let env ← Lean.getEnv
  let mut have_ : List Lean.Name := []
  let mut lack : List Lean.Name := []
  for n in [f ++ `machineData, f ++ `machine_ok, f ++ `machine_body, f ++ `machine_sound,
      f ++ `closes_deep, f ++ `machine_closes_at, f ++ `machine_ships_hierNR1,
      f ++ `machine_design_svNR1, f ++ `machine_design_noPortsNR1, f ++ `machine_kidsK1,
      m ++ `closes_deep, m ++ `machine_portsRawH, m ++ `oneout_callsOk, m ++ `machine_oneOutKid,
      m ++ `machine_design_svH_full_closed, rc ++ `gate_full, rc ++ `gate_kidK, rc ++ `gateValue,
      rc ++ `gate_peel] do
    if env.contains n then have_ := have_ ++ [n] else lack := lack ++ [n]
  Lean.logInfo m!"NOPORTS MID2 DATA {f}: nDecl={r.nDecl}, binders={r.shape.binders.length}, slots={r.shape.layout.slots.length}, lets={r.shape.layout.lets}, call entries {r.shape.insts.map (·.1)}, argument lets {r.shape.insts.map (·.2.1)}, instFields={r.shape.instFields}, outputs {r.shape.layout.outs.map (·.name)}. CALLEE {m}: nDecl={mr.nDecl}, slots={mr.shape.layout.slots.length}, call entries {mr.shape.insts.map (·.1)}, instFields={mr.shape.instFields}. In the environment: {have_}; not: {lack}"
  unless (r.shape.insts.map (·.1)).eraseDups == [m] do
    throwError "{f}: the called declarations are {(r.shape.insts.map (·.1)).eraseDups}, expected [{m}]"
  if r.shape.layout.slots.isEmpty then throwError "{f}: no register"
  if r.shape.instFields.isEmpty then throwError "{f}: instFields = [] — not the general closing"
  unless (mr.shape.insts.map (·.1)).eraseDups == [rc] do
    throwError "{m}: the called declarations are {(mr.shape.insts.map (·.1)).eraseDups}, expected [{rc}]"
  unless mr.shape.instFields.isEmpty do
    throwError "{m}: instFields = {mr.shape.instFields} — not the one-output closing"
  if mr.shape.layout.slots.isEmpty then throwError "{m}: no register"
  for n in [f ++ `closes_deep, m ++ `closes_deep, m ++ `machine_portsRawH, rc ++ `gate_full,
      rc ++ `gate_kidK, rc ++ `gateValue] do
    unless env.contains n do throwError "{n}: not in the imports (this file builds on it)"
  for n in [f ++ `machine_design_noPortsNR1, f ++ `machine_design_noPortsNR1_closed,
      f ++ `machine_kidsK1, m ++ `machine_oneOutKid] do
    if env.contains n then
      throwError "{n}: exists already — a family test is imported (NAME CLASH, see the header)"

