   (``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_designSVH_viaResetState, ``Tests.Compiler.Srm16ExpStmt.Exp_topshareM_designSVH_viaResetState, ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_designSVH_viaReset),
   (``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_viaResetO, ``Tests.Compiler.Srm16ExpStmt.Exp_topshareQ_svBoundsH_viaResetO, ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_viaReset),
   (``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_viaResetState, ``Tests.Compiler.Srm16ExpStmt.Exp_topshareQ_svBoundsH_viaResetState, ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_viaReset),
   (``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_designSVH_viaResetO, ``Tests.Compiler.Srm16ExpStmt.Exp_topshareQ_designSVH_viaResetO, ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_designSVH_viaReset),
   (``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_designSVH_viaResetState, ``Tests.Compiler.Srm16ExpStmt.Exp_topshareQ_designSVH_viaResetState, ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_designSVH_viaReset)]

/-- elaborate a hand-written term string -/
def elabStr (s : String) : TermElabM Expr := do
  match Parser.runParserCategory (← getEnv) `term s with
  | .error e => throwError "SRM16 AUDIT FAILED: expected string does not parse: {e}\n{s}"
  | .ok stx =>
    let e ← Term.elabTerm stx none
    Term.synthesizeSyntheticMVarsNoPostponing
    instantiateMVars e

/-- is the theorem's type defeq to the hand-written expected statement? -/
def typeIs (thm : Name) (s : String) : TermElabM Bool := do
  let ci ← getConstInfo thm
  let e ← elabStr s
  isDefEq ci.type e

/-- the independently written expected statements of the generic theorems (hand-written, NOT produced by a script from the theorems) -/


abbrev Row := Nat × String × String × Bool × String

/-- normalised binder name -/
def normName (n : String) : String := if (n.splitOn "_hyg").length > 1 then "_anon" else n

/-- rows `(index, binderInfo, name, isProp, type)` of the binders of a theorem's type -/
def premiseRows (thm : Name) : MetaM (List Row) := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    let mut rows : List Row := []
    let mut i := 0
    for x in xs do
      let d ← x.fvarId!.getDecl
      let isP ← Meta.isProp d.type
      let bi := match d.binderInfo with
        | .implicit => "implicit" | .strictImplicit => "strict" | .instImplicit => "inst" | .default => "explicit"
      rows := rows ++ [(i, bi, normName d.userName.toString, isP, ((← ppExpr d.type).pretty 100000).replace "\n" " ")]
      i := i + 1
    return rows

/-- the text line of a row (the format of `scripts/srm16/PREMISES.txt`) -/
def rowLine (thm : Name) (r : Row) : String :=
  s!"S16{if r.2.2.2.1 then "PREM" else "DATA"}|{thm}|{r.1}|{r.2.1}|{r.2.2.1}|{r.2.2.2.2}"

/-- EXACT comparison of two whole tables: `none` iff equal, else the first difference -/
def tableDiff (a e : List (Name × List Row)) : Option String := Id.run do
  if a.length != e.length then return some s!"{a.length} theorems vs {e.length} expected"
  for ((n, rs), (n', rs')) in a.zip e do
    if n != n' then return some s!"theorem {n} vs expected {n'}"
    if rs.length != rs'.length then return some s!"{n}: {rs.length} binders vs {rs'.length} expected"
    for (r, r') in rs.zip rs' do
      if r != r' then return some s!"{n}: binder {r.1} differs: {rowLine n r} vs expected {rowLine n r'}"
  return none

/-- mutation 1: SEMANTIC change of the type of the first Prop binder (same index, binderInfo, name): the type string gets ` ∧ True` appended -/
def mutType (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.any (·.2.2.2.1)) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then
      let idx := (rs.findIdx? (·.2.2.2.1)).getD 0
      (n, rs.mapIdx fun i r => if i == idx then (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2 ++ " ∧ True") else r)
    else (n, rs)

/-- mutation 2: add a data binder to the first theorem -/
def mutAdd (t : List (Name × List Row)) : List (Name × List Row) :=
  t.mapIdx fun j (n, rs) => if j == 0 then (n, rs ++ [(rs.length, "implicit", "extraBinder", false, "Nat")]) else (n, rs)

/-- mutation 3: swap the first two binders of the first theorem that has two -/
def mutSwap (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.length ≥ 2) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then (match rs with | r0 :: r1 :: rest => (n, r1 :: r0 :: rest) | _ => (n, rs)) else (n, rs)

/-- does a hypothesis of `thm` restate its conclusion (reducible `isDefEq`)? -/
def restatesConclusion (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if (← Meta.isProp d.type) then
        if (← withReducible (isDefEq d.type concl)) then return true
    return false

/-- does a hypothesis of `thm` mention the uniform children's check? -/
def mentionsUniformUNUSED (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if d.type.getUsedConstants.any (fun c => c == ``Tools.ShippingDesignSV.kidsPass || c == ``Tools.ShippingChecksDesign.kidCheck || c == ``Tools.ShippingDesignSVBack.outsCheck || c == ``Tools.ShippingDesignSV.designCheck || c == ``Tools.ShippingSrm6Sem.SVBoundsH || c == ``Tools.ShippingDesignSV.SVBounds) then return true
    return false


/-- run `k` in the telescope of `thm`'s type -/
def inTelescope {α : Type} (thm : Name) (k : Array Expr → Expr → TermElabM α) : TermElabM α := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => k xs concl

/-- the fvar of the binder with user name `nm` -/
def binderNamed (xs : Array Expr) (nm : String) : MetaM (Option Expr) := do
  for x in xs do
    if (← x.fvarId!.getDecl).userName.toString == nm then return some x
  return none


/-- Standard axioms only, an error otherwise (as Tests/Compiler/ChildVertAuditTest.lean `stdAxioms`; copied so that this test does not import that integrator-only module). -/
def stdAxioms (n : Name) : MetaM Unit := do
  for ax in ← Lean.collectAxioms n do
    unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
      throwError "{n} uses a non-standard axiom: {ax}"

/-- the transitive closure of the constants `n` depends on (type, value, constructors of inductives), `n` included (as `depClosure` of ChildVertAuditTest) -/
partial def depClosure (n : Name) : MetaM NameSet := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut todo : Array Name := #[n]
  while todo.size > 0 do
    let c := todo.back!
    todo := todo.pop
    if seen.contains c then continue
    seen := seen.insert c
    match env.find? c with
    | none => pure ()
    | some ci =>
      let mut used := ci.type.getUsedConstants
      if let some v := ci.value? (allowOpaque := true) then
        used := used ++ v.getUsedConstants
      if let .inductInfo iv := ci then
        used := used ++ iv.ctors.toArray
      for u in used do
        unless seen.contains u do
          todo := todo.push u
  return seen

/-- the old-boundary names: any constant equal to or under these -/
def forbiddenRoots : List Name :=
  [`Tools.ShippingChildInv.RefLaws, `Tools.ShippingChildBndCore.RefLawsCore,
   `Tools.ShippingChildInvA.RefLawsCore.toAOps, `Tools.ShippingChildInvA.RefLawsCore.toA]

def hits (s : NameSet) : List Name :=
  s.toList.filter fun c => forbiddenRoots.any fun r => r.isPrefixOf c

end Tests.Compiler.Srm16AuditTest

open Tests.Compiler.Srm16AuditTest in
run_cmd liftTermElabM do
  unless (← restatesConclusion ``Tests.Compiler.Srm16AuditTest.wrapper_mutation) do throwError "SRM16 AUDIT FAILED: the wrapper control was not caught"
  unless audited16.length == 14 do throwError "SRM16 AUDIT FAILED: audited16 has {audited16.length} theorems, expected exactly 14"
  -- (1) premise table
  let mut actual : List (Name × List Row) := []
  let mut lines : List String := []
  for thm in audited16 do
    let rows ← premiseRows thm
    actual := actual ++ [(thm, rows)]
    logInfo m!"S16THM|{thm}|{rows.length}"
    lines := lines ++ [s!"S16THM|{thm}|{rows.length}"]
    for r in rows do
      logInfo m!"{rowLine thm r}"
      lines := lines ++ [rowLine thm r]
    if (← restatesConclusion thm) then throwError "SRM16 AUDIT FAILED: a hypothesis of {thm} restates its conclusion"
  unless Tests.Compiler.Srm16AuditExpected.expectedRows.length == 14 do throwError "SRM16 AUDIT FAILED: the expected table has {Tests.Compiler.Srm16AuditExpected.expectedRows.length} theorem entries, expected exactly 14"
  match tableDiff actual Tests.Compiler.Srm16AuditExpected.expectedRows with
  | some msg => throwError "SRM16 AUDIT FAILED: the premise table differs from Tests/Compiler/Srm16AuditExpected.lean: {msg}"
  | none => pure ()
  let txt ← IO.FS.readFile "scripts/srm16/PREMISES.txt"
  let fileLines := (txt.splitOn "\n").filter (· != "")
  unless fileLines == lines do
    throwError "SRM16 AUDIT FAILED: scripts/srm16/PREMISES.txt differs from the regenerated table ({fileLines.length} lines vs {lines.length})"
  -- negative fixtures
  do
    let mt := mutType actual
    let mut changed : List (Name × Row × Row) := []
    unless mt.length == actual.length do throwError "SRM16 AUDIT FAILED: fixture 1 changed the number of theorems"
    for ((n, rs), (n', rs')) in actual.zip mt do
      unless n == n' && rs.length == rs'.length do throwError "SRM16 AUDIT FAILED: fixture 1 changed the shape of {n}"
      for (r, r') in rs.zip rs' do
        if r != r' then changed := changed ++ [(n, r, r')]
    match changed with
    | [(n, r, r')] =>
      unless r'.2.2.2.1 do throwError "SRM16 AUDIT FAILED: fixture 1 mutated row of {n} is not a Prop binder"
      unless r.2.2.2.1 && r'.1 == r.1 && r'.2.1 == r.2.1 && r'.2.2.1 == r.2.2.1 do throwError "SRM16 AUDIT FAILED: fixture 1 changed index/binderInfo/name/isProp of binder {r.1} of {n}"
      unless r'.2.2.2.2 != r.2.2.2.2 && r'.2.2.2.2.endsWith " ∧ True" && r'.2.2.2.2.length == r.2.2.2.2.length + 7 do throwError "SRM16 AUDIT FAILED: fixture 1 type string is not visibly changed"
      logInfo m!"S16FIXTURE1|{n}|binder {r.1} ({r.2.2.1})|original type: {r.2.2.2.2}|mutated type: {r'.2.2.2.2}"
      match tableDiff mt Tests.Compiler.Srm16AuditExpected.expectedRows with
      | some msg => unless (msg.splitOn s!"binder {r.1} differs").length > 1 && (msg.splitOn (toString n)).length > 1 do throwError "SRM16 AUDIT FAILED: fixture 1 rejection does not name the mutated binder: {msg}"
      | none => throwError "SRM16 AUDIT FAILED: the comparator ACCEPTED fixture 1"
    | _ => throwError "SRM16 AUDIT FAILED: fixture 1 changed {changed.length} rows, expected exactly 1"
  for (nm, mt) in [("changed Prop binder type", mutType actual), ("added data binder", mutAdd actual), ("reordered binders", mutSwap actual)] do
    if mt == actual then throwError "SRM16 AUDIT FAILED: the fixture '{nm}' did not change the table (vacuous)"
    match tableDiff mt Tests.Compiler.Srm16AuditExpected.expectedRows with
    | none => throwError "SRM16 AUDIT FAILED: the comparator ACCEPTED the fixture '{nm}'"
    | some msg => logInfo m!"S16FIXTURE|{nm}|rejected: {msg}"
  logInfo m!"S16TABLE|{audited16.length} theorems, {lines.length} binders: equal to the committed table and to scripts/srm16/PREMISES.txt"
  -- (2) independent expected statements (generated from the SRM13 source statements by scripts/srm16/gen_exp.py)
  unless pairs16.length == 10 do throwError "SRM16 AUDIT FAILED: pairs16 has {pairs16.length} entries, expected 10"
  for (t, e, _) in pairs16 do
    let ci ← getConstInfo t
    let ei ← getConstInfo e
    unless (← isDefEq ci.type (ei.value?.getD (mkConst e))) do throwError "SRM16 AUDIT FAILED: the statement of {t} is not defeq to its expected form {e}"
    logInfo m!"S16EXPDEFEQ|{t}|{e}|isDefEq"
  -- one wrong expected form (hfit deleted) must be rejected
  do
    let ci ← getConstInfo ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_viaResetO
    let ei ← getConstInfo ``Tests.Compiler.Srm16ExpStmt.Exp_mutation_noHfit
    if (← isDefEq ci.type (ei.value?.getD (mkConst ei.name))) then throwError "SRM16 AUDIT FAILED: the mutated expected statement (hfit deleted) was ACCEPTED"
    logInfo m!"S16EXPMUT|hfit-deleted expected form rejected"
  -- binders deleted / replaced relative to the SRM13 source theorem; residual Props are NOT the premise they replace
  for (new, _, src) in pairs16.drop 2 do
    let isState := (toString new).endsWith "viaResetState"
    let N := if (toString new).startsWith "Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM" then 2 else 1
    let srcHasRk ← inTelescope src fun xs _ => do return ((← binderNamed xs "hrk").isSome && (← binderNamed xs "hO").isSome)
    unless srcHasRk do throwError "SRM16 AUDIT FAILED: the SRM13 source {src} lacks hrk/hO"
    inTelescope new fun xs _ => do
      if (← binderNamed xs "hO").isSome then throwError "SRM16 AUDIT FAILED: {new} still has hO"
      if isState then
        if (← binderNamed xs "hrk").isSome then throwError "SRM16 AUDIT FAILED: {new} still has hrk"
        let rk ← elabStr s!"Tools.ShippingMachineShipsDepth.ResetNk {N} raw D s.kids"
        for nm in ["hsk", "hIUraw", "hIU", "hAg", "hRd"] do
          let some x ← binderNamed xs nm | throwError "SRM16 AUDIT FAILED: {new} lacks the binder {nm}"
          unless (← Meta.isProp (← inferType x)) do throwError "SRM16 AUDIT FAILED: {nm} of {new} is not a Prop binder"
          if (← isDefEq (← inferType x) rk) then throwError "SRM16 AUDIT FAILED: binder {nm} of {new} IS defeq to the SRM13 premise hrk (relabelling)"
          logInfo m!"S16NOTRELABEL|{new}|{nm} is not defeq to hrk"
      else
        let some x ← binderNamed xs "hrk" | throwError "SRM16 AUDIT FAILED: {new} lacks hrk"
        let rk ← elabStr s!"Tools.ShippingMachineShipsDepth.ResetNk {N} raw D s.kids"
        unless (← isDefEq (← inferType x) rk) do throwError "SRM16 AUDIT FAILED: hrk of {new} changed"
      for nm in ["hfit", "hst₁", "hst₂", "hst₃", "hin", "hrun"] do
        unless (← binderNamed xs nm).isSome do throwError "SRM16 AUDIT FAILED: {new} lacks the residual premise {nm}"
    logInfo m!"S16BINDERS|{new}|hO deleted{if isState then ", hrk replaced by hsk/hIUraw/hIU/hAg/hRd" else ", hrk kept"}; hfit/hst₁₂₃/hin/hrun kept"
  -- (3) closure audit
  let forbidden : List Name := [`Tools.ShippingChildInv.RealChild, `Tools.ShippingChildInv.InvW, `Tools.ShippingMachineRan.MachineRan,
      `Tools.ShippingChildInv.MachineClosesAt, `Tools.ShippingMemKid.Kid, `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM,
      `Tools.ShippingChildInv.ChildBnd, `Tools.ShippingChildInv.StartV, `Tools.ShippingGenKid.GenKid,
      `Tools.ShippingKidFacts.KidFacts, `Tools.ShippingMachineDepthRun.MachineRunNC, `Tools.ShippingSharedLeafCoh.CacheClosed]
  for f in forbidden do
    unless (← getEnv).contains f do throwError "SRM16 AUDIT FAILED: the forbidden root {f} does not exist (vacuous audit)"
  let ctl ← depClosure `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM
  unless (ctl.toList.filter fun c => forbidden.any (·.isPrefixOf c)).length > 0 do throwError "SRM16 AUDIT FAILED: control walk found no old-form constant"
  for thm in audited16 do
    let cl ← depClosure thm
    let bad := hits cl
    unless bad.isEmpty do throwError "SRM16 AUDIT FAILED: old RefLaws boundary in the closure of {thm}: {bad}"
    let bad2 := cl.toList.filter fun c => forbidden.any (·.isPrefixOf c)
    unless bad2.isEmpty do throwError "SRM16 AUDIT FAILED: old-form boundary in the closure of {thm}: {bad2}"
    stdAxioms thm
    logInfo m!"S16CLOSURE|{thm}|standard axioms; closure {cl.size} constants; no old-form boundary"
  for (new, _, old) in pairs16.drop 2 do
    let cl ← depClosure new
    unless cl.contains old do throwError "SRM16 AUDIT FAILED: {old} is not in the closure of {new}"
    if (toString new).endsWith "viaResetState" then
      unless cl.contains ``Tools.ShippingSrm16Reset.resetNk_resetKids do throwError "SRM16 AUDIT FAILED: resetNk_resetKids is not in the closure of {new}"
    logInfo m!"S16CORCLOSURE|{new}|contains {old}"
  for t in [``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_hO, ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_hO] do
    let cl ← depClosure t
    for need in [``Tools.ShippingKidsResetSat.inst_checkedOptimize_sub, ``Tools.ShippingSrm4Core2.core_hierGate_anyAM, ``Tools.ShippingParentTailsA.core_kids_facts_ranA] do
      unless cl.contains need do throwError "SRM16 AUDIT FAILED: {need} is not in the closure of {t}"
    logInfo m!"S16HOCLOSURE|{t}|contains inst_checkedOptimize_sub, core_hierGate_anyAM, core_kids_facts_ranA"

end
