/-- (definition, expected definition) -/
def defPairs21 : List (Name × Name) :=
  [(``Tools.ShippingSrm21Lift.GrandInstFree, ``Tests.Compiler.Srm21ExpStmt.Exp_GrandInstFree),
   (``Tools.ShippingSrm21Lift.QGrandInstFree, ``Tests.Compiler.Srm21ExpStmt.Exp_QGrandInstFree),
