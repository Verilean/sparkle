abbrev Row := Nat × String × String × Bool × String

/-- normalised binder name -/
def normName (n : String) : String := if (n.splitOn "_hyg").length > 1 then "_anon" else n

/-- rows `(index, binderInfo, name, isProp, type)` of the binders of a theorem's type -/
def premiseRows (thm : Name) : MetaM (List Row) := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    let mut rows : List Row := []
    let mut i := 0
    for x in xs do
      let d ← x.fvarId!.getDecl
      let isP ← Meta.isProp d.type
      let bi := match d.binderInfo with
        | .implicit => "implicit" | .strictImplicit => "strict" | .instImplicit => "inst" | .default => "explicit"
      rows := rows ++ [(i, bi, normName d.userName.toString, isP, ((← ppExpr d.type).pretty 100000).replace "\n" " ")]
      i := i + 1
    return rows

/-- the text line of a row (the format of `scripts/srm21/PREMISES.txt`) -/
def rowLine (thm : Name) (r : Row) : String :=
  s!"S21{if r.2.2.2.1 then "PREM" else "DATA"}|{thm}|{r.1}|{r.2.1}|{r.2.2.1}|{r.2.2.2.2}"

/-- EXACT comparison of two whole tables: `none` iff equal, else the first difference -/
def tableDiff (a e : List (Name × List Row)) : Option String := Id.run do
  if a.length != e.length then return some s!"{a.length} theorems vs {e.length} expected"
  for ((n, rs), (n', rs')) in a.zip e do
    if n != n' then return some s!"theorem {n} vs expected {n'}"
    if rs.length != rs'.length then return some s!"{n}: {rs.length} binders vs {rs'.length} expected"
    for (r, r') in rs.zip rs' do
      if r != r' then return some s!"{n}: binder {r.1} differs: {rowLine n r} vs expected {rowLine n r'}"
  return none

/-- mutation 1: SEMANTIC change of the type of the first Prop binder (same index, binderInfo, name): the type string gets ` ∧ True` appended -/
def mutType (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.any (·.2.2.2.1)) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then
      let idx := (rs.findIdx? (·.2.2.2.1)).getD 0
      (n, rs.mapIdx fun i r => if i == idx then (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2 ++ " ∧ True") else r)
    else (n, rs)

/-- mutation 2: add a data binder to the first theorem -/
def mutAdd (t : List (Name × List Row)) : List (Name × List Row) :=
  t.mapIdx fun j (n, rs) => if j == 0 then (n, rs ++ [(rs.length, "implicit", "extraBinder", false, "Nat")]) else (n, rs)

/-- mutation 3: swap the first two binders of the first theorem that has two -/
def mutSwap (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.length ≥ 2) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then (match rs with | r0 :: r1 :: rest => (n, r1 :: r0 :: rest) | _ => (n, rs)) else (n, rs)

/-- does a hypothesis of `thm` restate its conclusion (reducible `isDefEq`)? -/
def restatesConclusion (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if (← Meta.isProp d.type) then
        if (← withReducible (isDefEq d.type concl)) then return true
    return false


/-- run `k` in the telescope of `thm`'s type -/
def inTelescope {α : Type} (thm : Name) (k : Array Expr → Expr → TermElabM α) : TermElabM α := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => k xs concl

/-- the fvar of the binder with user name `nm` -/
def binderNamed (xs : Array Expr) (nm : String) : MetaM (Option Expr) := do
  for x in xs do
    if (← x.fvarId!.getDecl).userName.toString == nm then return some x
  return none


/-- Standard axioms only, an error otherwise (as Tests/Compiler/ChildVertAuditTest.lean `stdAxioms`; copied so that this test does not import that integrator-only module). -/
def stdAxioms (n : Name) : MetaM Unit := do
  for ax in ← Lean.collectAxioms n do
    unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
      throwError "{n} uses a non-standard axiom: {ax}"

/-- the transitive closure of the constants `n` depends on (type, value, constructors of inductives), `n` included (as `depClosure` of ChildVertAuditTest) -/
partial def depClosure (n : Name) : MetaM NameSet := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut todo : Array Name := #[n]
  while todo.size > 0 do
    let c := todo.back!
    todo := todo.pop
    if seen.contains c then continue
    seen := seen.insert c
    match env.find? c with
    | none => pure ()
    | some ci =>
      let mut used := ci.type.getUsedConstants
      if let some v := ci.value? (allowOpaque := true) then
        used := used ++ v.getUsedConstants
      if let .inductInfo iv := ci then
        used := used ++ iv.ctors.toArray
      for u in used do
        unless seen.contains u do
          todo := todo.push u
  return seen

/-- the old-boundary names: any constant equal to or under these -/
def forbiddenRoots : List Name :=
  [`Tools.ShippingChildInv.RefLaws, `Tools.ShippingChildBndCore.RefLawsCore,
   `Tools.ShippingChildInvA.RefLawsCore.toAOps, `Tools.ShippingChildInvA.RefLawsCore.toA]

def hits (s : NameSet) : List Name :=
  s.toList.filter fun c => forbiddenRoots.any fun r => r.isPrefixOf c


end Tests.Compiler.Srm21AuditTest

open Tests.Compiler.Srm21AuditTest in
/-- every Prop binder type of a statement (walking `∀`, `∃`, `∧`), counted, and checked NOT defeq to `q` -/
partial def propTypesNotDefeq (q : Expr) (e : Expr) (cnt : IO.Ref Nat) : MetaM Unit := do
  match e with
  | .forallE .. =>
    forallTelescope e fun xs b => do
      for x in xs do
        let t ← inferType x
        if (← Meta.isProp t) && t != q then
          cnt.modify (· + 1)
          if (← isDefEq t q) then throwError "SRM21 AUDIT FAILED: QDepthLift is defeq to another Prop binder type {t}"
          propTypesNotDefeq q t cnt
      propTypesNotDefeq q b cnt
  | .app (.app (.const ``Exists _) _) (.lam n d b bi) =>
    withLocalDecl n bi d fun x => propTypesNotDefeq q (b.instantiate1 x) cnt
  | .app (.app (.const ``And _) a) b => do propTypesNotDefeq q a cnt; propTypesNotDefeq q b cnt
  | _ => pure ()

open Tests.Compiler.Srm21AuditTest in
run_cmd liftTermElabM do
  unless (← restatesConclusion ``Tests.Compiler.Srm21AuditTest.wrapper_mutation) do throwError "SRM21 AUDIT FAILED: the wrapper control was not caught"
  unless audited21.length == 6 do throwError "SRM21 AUDIT FAILED: audited21 has {audited21.length} theorems, expected exactly 6"
  -- (1) premise table
  let mut actual : List (Name × List Row) := []
  let mut lines : List String := []
  for thm in audited21 do
    let rows ← premiseRows thm
    actual := actual ++ [(thm, rows)]
    logInfo m!"S21THM|{thm}|{rows.length}"
    lines := lines ++ [s!"S21THM|{thm}|{rows.length}"]
    for r in rows do
      logInfo m!"{rowLine thm r}"
      lines := lines ++ [rowLine thm r]
    if (← restatesConclusion thm) then throwError "SRM21 AUDIT FAILED: a hypothesis of {thm} restates its conclusion"
  unless Tests.Compiler.Srm21AuditExpected.expectedRows.length == 6 do throwError "SRM21 AUDIT FAILED: the expected table has {Tests.Compiler.Srm21AuditExpected.expectedRows.length} theorem entries, expected exactly 6"
  match tableDiff actual Tests.Compiler.Srm21AuditExpected.expectedRows with
  | some msg => throwError "SRM21 AUDIT FAILED: the premise table differs from Tests/Compiler/Srm21AuditExpected.lean: {msg}"
  | none => pure ()
  let txt ← IO.FS.readFile "scripts/srm21/PREMISES.txt"
  let fileLines := (txt.splitOn "\n").filter (· != "")
  unless fileLines == lines do
    throwError "SRM21 AUDIT FAILED: scripts/srm21/PREMISES.txt differs from the regenerated table ({fileLines.length} lines vs {lines.length})"
  -- negative fixtures
  do
    let mt := mutType actual
    let mut changed : List (Name × Row × Row) := []
    unless mt.length == actual.length do throwError "SRM21 AUDIT FAILED: fixture 1 changed the number of theorems"
    for ((n, rs), (n', rs')) in actual.zip mt do
      unless n == n' && rs.length == rs'.length do throwError "SRM21 AUDIT FAILED: fixture 1 changed the shape of {n}"
      for (r, r') in rs.zip rs' do
        if r != r' then changed := changed ++ [(n, r, r')]
    match changed with
    | [(n, r, r')] =>
      unless r'.2.2.2.1 do throwError "SRM21 AUDIT FAILED: fixture 1 mutated row of {n} is not a Prop binder"
      unless r.2.2.2.1 && r'.1 == r.1 && r'.2.1 == r.2.1 && r'.2.2.1 == r.2.2.1 do throwError "SRM21 AUDIT FAILED: fixture 1 changed index/binderInfo/name/isProp of binder {r.1} of {n}"
      unless r'.2.2.2.2 != r.2.2.2.2 && r'.2.2.2.2.endsWith " ∧ True" && r'.2.2.2.2.length == r.2.2.2.2.length + 7 do throwError "SRM21 AUDIT FAILED: fixture 1 type string is not visibly changed"
      logInfo m!"S21FIXTURE1|{n}|binder {r.1} ({r.2.2.1})|original type: {r.2.2.2.2}|mutated type: {r'.2.2.2.2}"
      match tableDiff mt Tests.Compiler.Srm21AuditExpected.expectedRows with
      | some msg => unless (msg.splitOn s!"binder {r.1} differs").length > 1 && (msg.splitOn (toString n)).length > 1 do throwError "SRM21 AUDIT FAILED: fixture 1 rejection does not name the mutated binder: {msg}"
      | none => throwError "SRM21 AUDIT FAILED: the comparator ACCEPTED fixture 1"
    | _ => throwError "SRM21 AUDIT FAILED: fixture 1 changed {changed.length} rows, expected exactly 1"
  for (nm, mt) in [("changed Prop binder type", mutType actual), ("added data binder", mutAdd actual), ("reordered binders", mutSwap actual)] do
    if mt == actual then throwError "SRM21 AUDIT FAILED: the fixture '{nm}' did not change the table (vacuous)"
    match tableDiff mt Tests.Compiler.Srm21AuditExpected.expectedRows with
    | none => throwError "SRM21 AUDIT FAILED: the comparator ACCEPTED the fixture '{nm}'"
    | some msg => logInfo m!"S21FIXTURE|{nm}|rejected: {msg}"
  logInfo m!"S21TABLE|{audited21.length} theorems, {lines.length} binders: equal to the committed table and to scripts/srm21/PREMISES.txt"
  -- (2) independent full-type expected statements
  unless pairs21.length == 6 do throwError "SRM21 AUDIT FAILED: pairs21 has {pairs21.length} entries, expected 6"
  for (t, e) in pairs21 do
    let ci ← getConstInfo t
    let ei ← getConstInfo e
    unless (← isDefEq ci.type (ei.value?.getD (mkConst e))) do throwError "SRM21 AUDIT FAILED: the statement of {t} is not defeq to its expected form {e}"
    logInfo m!"S21EXPDEFEQ|{t}|{e}|isDefEq"
  unless defPairs21.length == 4 do throwError "SRM21 AUDIT FAILED: defPairs21 has {defPairs21.length} entries, expected 4"
  for (d, e) in defPairs21 do
    let a ← getConstInfo d
    let x ← getConstInfo e
    unless (← isDefEq a.value! x.value!) do throwError "SRM21 AUDIT FAILED: definition {d} is not defeq to its expected form {e} (the text of scripts/srm21/EXPECTED.txt)"
    logInfo m!"S21DEFDEFEQ|{d}|{e}|isDefEq"
  for (thmN, mutName) in [(``Tools.ShippingSrm21Lift.runModuleTG_depth2_depth1_of_grandInstFree, ``Tests.Compiler.Srm21ExpStmt.Exp_mut_P2_noHf),
      (``Tools.ShippingSrm21Lift.runModuleTG_depth2_depth1_of_grandInstFree, ``Tests.Compiler.Srm21ExpStmt.Exp_mut_P2_depth),
      (``Tools.ShippingSrm21Lift.resetNk_depth_lift, ``Tests.Compiler.Srm21ExpStmt.Exp_mut_P3_noHf),
      (``Tests.Compiler.Srm21LiftTest.topshareQ_grandInstFree, ``Tests.Compiler.Srm21ExpStmt.Exp_mut_Q_firstConjunct),
      (``Tests.Compiler.Srm21LiftTest.topshareQ_svBoundsH_underComposedG', ``Tests.Compiler.Srm21ExpStmt.Exp_mut_corollary_withHlift)] do
    let ci ← getConstInfo thmN
    let ei ← getConstInfo mutName
    if (← isDefEq ci.type (ei.value?.getD (mkConst ei.name))) then throwError "SRM21 AUDIT FAILED: the mutated expected statement {mutName} was ACCEPTED"
    logInfo m!"S21EXPMUT|{mutName} rejected"
  -- (3) the corollary has no QDepthLift / hlift / hrun; QDepthLift is not a relabelling of any Prop binder of the new theorems
  let qd := ``Tests.Compiler.SharedLeafMemKidIfaceTest.QDepthLift
  do
    let cor ← getConstInfo ``Tests.Compiler.Srm21LiftTest.topshareQ_svBoundsH_underComposedG'
    if cor.type.getUsedConstants.contains qd then throwError "SRM21 AUDIT FAILED: the corollary's type still mentions QDepthLift"
    inTelescope ``Tests.Compiler.Srm21LiftTest.topshareQ_svBoundsH_underComposedG' fun xs _ => do
      for r in ["hlift", "hrun"] do
        if (← binderNamed xs r).isSome then throwError "SRM21 AUDIT FAILED: the corollary has a binder named {r}"
      for r in ["hcore", "hpost", "entry", "hBnd", "hBd"] do
        let mut c : Nat := 0
        for x in xs do
          if (← x.fvarId!.getDecl).userName.toString == r then c := c + 1
        unless c == 1 do throwError "SRM21 AUDIT FAILED: the corollary has {c} binders named {r}, expected exactly 1"
    let s20 ← getConstInfo ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_underComposedG
    unless s20.type.getUsedConstants.contains qd do throwError "SRM21 AUDIT FAILED: SRM20's theorem does not mention QDepthLift (the deleted binder is not the one it had)"
    logInfo m!"S21NOQDL|the corollary's type has no QDepthLift constant, no hlift/hrun binder; SRM20's theorem has it"
  do
    let qdci ← getConstInfo qd
    let totalRef ← IO.mkRef (0 : Nat)
    for thm in audited21 do
      let ci ← getConstInfo thm
      forallTelescope qdci.type fun qs _ => do
        let q := mkAppN (mkConst qd) qs
        let cnt ← IO.mkRef (0 : Nat)
        propTypesNotDefeq q ci.type cnt
        totalRef.modify (· + (← cnt.get))
    let total ← totalRef.get
    unless total ≥ 40 do throwError "SRM21 AUDIT FAILED: only {total} Prop binder types compared with QDepthLift (vacuous)"
    logInfo m!"S21NOTRELABEL|QDepthLift (as a function of raw D b) is not defeq to any of {total} Prop binder types of the six new theorems"
  do
    let gi ← getConstInfo ``Tools.ShippingSrm21Lift.GrandInstFree
    let uc := gi.value!.getUsedConstants
    unless uc.contains ``Tools.ShippingMachineLinked.childMap && uc.contains ``Tools.ShippingHierStateG.instFree do throwError "SRM21 AUDIT FAILED: GrandInstFree is not stated through childMap and instFree"
    for bad in [qd, ``Tools.ShippingHierStateG.runModuleTG, ``Tools.ShippingMachineShipsDepth.ResetNk, ``Tools.ShippingHierStateG.KSn] do
      if uc.contains bad then throwError "SRM21 AUDIT FAILED: GrandInstFree mentions {bad}"
    logInfo m!"S21P1DATA|GrandInstFree is a Prop about D.modules (childMap) and instFree only; it mentions no QDepthLift, runModuleTG, ResetNk, KSn"
  -- (4) closure audit
  let forbidden : List Name := [`Tools.ShippingChildInv.RealChild, `Tools.ShippingChildInv.InvW, `Tools.ShippingMachineRan.MachineRan,
      `Tools.ShippingChildInv.MachineClosesAt, `Tools.ShippingMemKid.Kid, `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM,
      `Tools.ShippingChildInv.ChildBnd, `Tools.ShippingChildInv.StartV, `Tools.ShippingGenKid.GenKid,
      `Tools.ShippingKidFacts.KidFacts, `Tools.ShippingMachineDepthRun.MachineRunNC, `Tools.ShippingSharedLeafCoh.CacheClosed]
  for f in forbidden do
    unless (← getEnv).contains f do throwError "SRM21 AUDIT FAILED: the forbidden root {f} does not exist (vacuous audit)"
  let ctl ← depClosure `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM
  unless (ctl.toList.filter fun c => forbidden.any (·.isPrefixOf c)).length > 0 do throwError "SRM21 AUDIT FAILED: control walk found no old-form constant"
  for thm in audited21 do
    let cl ← depClosure thm
    let bad := hits cl
    unless bad.isEmpty do throwError "SRM21 AUDIT FAILED: old RefLaws boundary in the closure of {thm}: {bad}"
    let bad2 := cl.toList.filter fun c => forbidden.any (·.isPrefixOf c)
    unless bad2.isEmpty do throwError "SRM21 AUDIT FAILED: old-form boundary in the closure of {thm}: {bad2}"
    stdAxioms thm
    logInfo m!"S21CLOSURE|{thm}|standard axioms; closure {cl.size} constants; no old-form boundary"
  let corol := ``Tests.Compiler.Srm21LiftTest.topshareQ_svBoundsH_underComposedG'
  let cl ← depClosure corol
  for r in [``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_underComposedG, qd,
      ``Tests.Compiler.Srm21LiftTest.topshareQ_qDepthLift, ``Tests.Compiler.Srm21LiftTest.topshareQ_grandInstFree, ``Tests.Compiler.Srm21LiftTest.qDepthLift_of_grandInstFree,
      ``Tools.ShippingSrm21Lift.resetNk_depth_lift, ``Tools.ShippingSrm21Lift.runModuleTG_depth2_depth1_of_grandInstFree,
      ``Tools.ShippingHierStateG.evalAssignsKG_instFree, ``Tests.Compiler.Srm12CorrTest.topshareQ_corr, ``Tests.Compiler.Srm12CorrTest.inst_rank_of_modCorr_Q,
      ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_endToEnd, ``Tools.ShippingShipsFree.machine_ships_hierC_at_free] do
    unless (← getEnv).contains r do throwError "SRM21 AUDIT FAILED: required constant {r} does not exist"
    unless cl.contains r do throwError "SRM21 AUDIT FAILED: {r} is not in the closure of the corollary"
  logInfo m!"S21CLOSURE2|corollary closure contains SRM20's theorem, QDepthLift, P2, P3, P4, the topshareQ instances, evalAssignsKG_instFree, topshareQ_corr, inst_rank_of_modCorr_Q, SRM19 endToEnd, machine_ships_hierC_at_free; runKS_instFree in closure: {cl.contains ``Tools.ShippingHierStateG.runKS_instFree}; runModuleTG_instFree in closure: {cl.contains ``Tools.ShippingHierStateG.runModuleTG_instFree}"
end
