-- BUILT (unit SRM19): dev runs s2 (exit 1), s3 (exit 1, stale table), s4 (exit 1), s5 (exit 0); the final-SHA rebuild in REPORT-SRM19.md is the only final evidence.
-- SCOPE (SRM19 audits) of `topshare{M,Q}_svBoundsH_endToEnd`.  (1) PREMISE TABLE (index, binderInfo, name, Prop-or-data, type) equal to `Tests/Compiler/Srm19AuditExpected.lean` and `scripts/srm19/PREMISES.txt`, `S19THM` marker per theorem, literal count guard;
-- three semantic negative fixtures (` ∧ True` on a Prop binder, added data binder, reordered binders), each non-vacuous and rejected.  REGENERATION: build Tests.Compiler.Srm19AuditTest, then `python3 scripts/srm19/gen_audit.py LOG`.
-- (2) INDEPENDENT FULL-TYPE EXPECTED STATEMENTS: `Tests/Compiler/Srm19ExpStmt.lean` GENERATED by scripts/srm19/gen_exp.py from the SOURCE statements of SRM18 `_viaStartNk` (binder deletion list) and SRM14 `_computed` (rank term), `isDefEq` to each final type;
-- two wrong expected forms (hfit deleted; rank binders deleted but rk not substituted) are rejected.  (3) ONE WITNESS: exactly one hrun/hcore/hpost/raw/b/D binder and one start state (st0, mems, kids).
-- (4) CLOSURE: standard axioms; forbidden old-form roots (with control); SRM18 viaStartNk, SRM16 viaResetO and hO, SRM7 rkOf_mem/rkOf_decl in the closure.  The SRM14 `_computed` theorems are NOT in the closure (SRM11-shaped, see the header of Srm19EndToEndTest); this is asserted as a fact.
set_option Elab.async false
set_option autoImplicit false
section
open Lean Elab Command Meta

namespace Tests.Compiler.Srm19AuditTest

/-- a hand-made MUTATION for the binder audit's control: a theorem whose single hypothesis IS its conclusion -/
theorem wrapper_mutation (p : Prop) (h : p) : p := h

/-- the new SRM19 theorems audited -/
def audited19 : List Name :=
  [``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_endToEnd,
   ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_endToEnd]

/-- (final theorem, expected statement in the generated file) -/
def pairs19 : List (Name × Name) :=
  [(``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_endToEnd, ``Tests.Compiler.Srm19ExpStmt.Exp_topshareM_svBoundsH_endToEnd),
   (``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareQ_svBoundsH_endToEnd, ``Tests.Compiler.Srm19ExpStmt.Exp_topshareQ_svBoundsH_endToEnd)]

/-- elaborate a hand-written term string -/
def elabStr (s : String) : TermElabM Expr := do
  match Parser.runParserCategory (← getEnv) `term s with
  | .error e => throwError "SRM19 AUDIT FAILED: expected string does not parse: {e}\n{s}"
  | .ok stx =>
    let e ← Term.elabTerm stx none
    Term.synthesizeSyntheticMVarsNoPostponing
    instantiateMVars e

/-- is the theorem's type defeq to the hand-written expected statement? -/
def typeIs (thm : Name) (s : String) : TermElabM Bool := do
  let ci ← getConstInfo thm
  let e ← elabStr s
  isDefEq ci.type e

/-- the independently written expected statements of the generic theorems (hand-written, NOT produced by a script from the theorems) -/


abbrev Row := Nat × String × String × Bool × String

/-- normalised binder name -/
def normName (n : String) : String := if (n.splitOn "_hyg").length > 1 then "_anon" else n

/-- rows `(index, binderInfo, name, isProp, type)` of the binders of a theorem's type -/
def premiseRows (thm : Name) : MetaM (List Row) := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    let mut rows : List Row := []
    let mut i := 0
    for x in xs do
      let d ← x.fvarId!.getDecl
      let isP ← Meta.isProp d.type
      let bi := match d.binderInfo with
        | .implicit => "implicit" | .strictImplicit => "strict" | .instImplicit => "inst" | .default => "explicit"
      rows := rows ++ [(i, bi, normName d.userName.toString, isP, ((← ppExpr d.type).pretty 100000).replace "\n" " ")]
      i := i + 1
    return rows

/-- the text line of a row (the format of `scripts/srm19/PREMISES.txt`) -/
def rowLine (thm : Name) (r : Row) : String :=
  s!"S19{if r.2.2.2.1 then "PREM" else "DATA"}|{thm}|{r.1}|{r.2.1}|{r.2.2.1}|{r.2.2.2.2}"

/-- EXACT comparison of two whole tables: `none` iff equal, else the first difference -/
def tableDiff (a e : List (Name × List Row)) : Option String := Id.run do
  if a.length != e.length then return some s!"{a.length} theorems vs {e.length} expected"
  for ((n, rs), (n', rs')) in a.zip e do
    if n != n' then return some s!"theorem {n} vs expected {n'}"
    if rs.length != rs'.length then return some s!"{n}: {rs.length} binders vs {rs'.length} expected"
    for (r, r') in rs.zip rs' do
      if r != r' then return some s!"{n}: binder {r.1} differs: {rowLine n r} vs expected {rowLine n r'}"
  return none

/-- mutation 1: SEMANTIC change of the type of the first Prop binder (same index, binderInfo, name): the type string gets ` ∧ True` appended -/
def mutType (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.any (·.2.2.2.1)) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then
      let idx := (rs.findIdx? (·.2.2.2.1)).getD 0
      (n, rs.mapIdx fun i r => if i == idx then (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2 ++ " ∧ True") else r)
    else (n, rs)

/-- mutation 2: add a data binder to the first theorem -/
def mutAdd (t : List (Name × List Row)) : List (Name × List Row) :=
  t.mapIdx fun j (n, rs) => if j == 0 then (n, rs ++ [(rs.length, "implicit", "extraBinder", false, "Nat")]) else (n, rs)

/-- mutation 3: swap the first two binders of the first theorem that has two -/
def mutSwap (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.length ≥ 2) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then (match rs with | r0 :: r1 :: rest => (n, r1 :: r0 :: rest) | _ => (n, rs)) else (n, rs)

/-- does a hypothesis of `thm` restate its conclusion (reducible `isDefEq`)? -/
def restatesConclusion (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if (← Meta.isProp d.type) then
        if (← withReducible (isDefEq d.type concl)) then return true
    return false

/-- does a hypothesis of `thm` mention the uniform children's check? -/
def mentionsUniformUNUSED (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if d.type.getUsedConstants.any (fun c => c == ``Tools.ShippingDesignSV.kidsPass || c == ``Tools.ShippingChecksDesign.kidCheck || c == ``Tools.ShippingDesignSVBack.outsCheck || c == ``Tools.ShippingDesignSV.designCheck || c == ``Tools.ShippingSrm6Sem.SVBoundsH || c == ``Tools.ShippingDesignSV.SVBounds) then return true
    return false


/-- run `k` in the telescope of `thm`'s type -/
def inTelescope {α : Type} (thm : Name) (k : Array Expr → Expr → TermElabM α) : TermElabM α := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => k xs concl

/-- the fvar of the binder with user name `nm` -/
def binderNamed (xs : Array Expr) (nm : String) : MetaM (Option Expr) := do
  for x in xs do
    if (← x.fvarId!.getDecl).userName.toString == nm then return some x
  return none


/-- Standard axioms only, an error otherwise (as Tests/Compiler/ChildVertAuditTest.lean `stdAxioms`; copied so that this test does not import that integrator-only module). -/
def stdAxioms (n : Name) : MetaM Unit := do
  for ax in ← Lean.collectAxioms n do
    unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
      throwError "{n} uses a non-standard axiom: {ax}"

/-- the transitive closure of the constants `n` depends on (type, value, constructors of inductives), `n` included (as `depClosure` of ChildVertAuditTest) -/
partial def depClosure (n : Name) : MetaM NameSet := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut todo : Array Name := #[n]
  while todo.size > 0 do
    let c := todo.back!
    todo := todo.pop
    if seen.contains c then continue
    seen := seen.insert c
    match env.find? c with
    | none => pure ()
    | some ci =>
      let mut used := ci.type.getUsedConstants
      if let some v := ci.value? (allowOpaque := true) then
        used := used ++ v.getUsedConstants
      if let .inductInfo iv := ci then
        used := used ++ iv.ctors.toArray
      for u in used do
        unless seen.contains u do
          todo := todo.push u
  return seen

/-- the old-boundary names: any constant equal to or under these -/
def forbiddenRoots : List Name :=
  [`Tools.ShippingChildInv.RefLaws, `Tools.ShippingChildBndCore.RefLawsCore,
   `Tools.ShippingChildInvA.RefLawsCore.toAOps, `Tools.ShippingChildInvA.RefLawsCore.toA]

def hits (s : NameSet) : List Name :=
  s.toList.filter fun c => forbiddenRoots.any fun r => r.isPrefixOf c

end Tests.Compiler.Srm19AuditTest

open Tests.Compiler.Srm19AuditTest in
run_cmd liftTermElabM do
  unless (← restatesConclusion ``Tests.Compiler.Srm19AuditTest.wrapper_mutation) do throwError "SRM19 AUDIT FAILED: the wrapper control was not caught"
  unless audited19.length == 2 do throwError "SRM19 AUDIT FAILED: audited19 has {audited19.length} theorems, expected exactly 2"
  -- (1) premise table
  let mut actual : List (Name × List Row) := []
  let mut lines : List String := []
  for thm in audited19 do
    let rows ← premiseRows thm
    actual := actual ++ [(thm, rows)]
    logInfo m!"S19THM|{thm}|{rows.length}"
    lines := lines ++ [s!"S19THM|{thm}|{rows.length}"]
    for r in rows do
      logInfo m!"{rowLine thm r}"
      lines := lines ++ [rowLine thm r]
    if (← restatesConclusion thm) then throwError "SRM19 AUDIT FAILED: a hypothesis of {thm} restates its conclusion"
  unless Tests.Compiler.Srm19AuditExpected.expectedRows.length == 2 do throwError "SRM19 AUDIT FAILED: the expected table has {Tests.Compiler.Srm19AuditExpected.expectedRows.length} theorem entries, expected exactly 2"
  match tableDiff actual Tests.Compiler.Srm19AuditExpected.expectedRows with
  | some msg => throwError "SRM19 AUDIT FAILED: the premise table differs from Tests/Compiler/Srm19AuditExpected.lean: {msg}"
  | none => pure ()
  let txt ← IO.FS.readFile "scripts/srm19/PREMISES.txt"
  let fileLines := (txt.splitOn "\n").filter (· != "")
  unless fileLines == lines do
    throwError "SRM19 AUDIT FAILED: scripts/srm19/PREMISES.txt differs from the regenerated table ({fileLines.length} lines vs {lines.length})"
  -- negative fixtures
  do
    let mt := mutType actual
    let mut changed : List (Name × Row × Row) := []
    unless mt.length == actual.length do throwError "SRM19 AUDIT FAILED: fixture 1 changed the number of theorems"
    for ((n, rs), (n', rs')) in actual.zip mt do
      unless n == n' && rs.length == rs'.length do throwError "SRM19 AUDIT FAILED: fixture 1 changed the shape of {n}"
      for (r, r') in rs.zip rs' do
        if r != r' then changed := changed ++ [(n, r, r')]
    match changed with
    | [(n, r, r')] =>
      unless r'.2.2.2.1 do throwError "SRM19 AUDIT FAILED: fixture 1 mutated row of {n} is not a Prop binder"
      unless r.2.2.2.1 && r'.1 == r.1 && r'.2.1 == r.2.1 && r'.2.2.1 == r.2.2.1 do throwError "SRM19 AUDIT FAILED: fixture 1 changed index/binderInfo/name/isProp of binder {r.1} of {n}"
      unless r'.2.2.2.2 != r.2.2.2.2 && r'.2.2.2.2.endsWith " ∧ True" && r'.2.2.2.2.length == r.2.2.2.2.length + 7 do throwError "SRM19 AUDIT FAILED: fixture 1 type string is not visibly changed"
      logInfo m!"S19FIXTURE1|{n}|binder {r.1} ({r.2.2.1})|original type: {r.2.2.2.2}|mutated type: {r'.2.2.2.2}"
      match tableDiff mt Tests.Compiler.Srm19AuditExpected.expectedRows with
      | some msg => unless (msg.splitOn s!"binder {r.1} differs").length > 1 && (msg.splitOn (toString n)).length > 1 do throwError "SRM19 AUDIT FAILED: fixture 1 rejection does not name the mutated binder: {msg}"
      | none => throwError "SRM19 AUDIT FAILED: the comparator ACCEPTED fixture 1"
    | _ => throwError "SRM19 AUDIT FAILED: fixture 1 changed {changed.length} rows, expected exactly 1"
  for (nm, mt) in [("changed Prop binder type", mutType actual), ("added data binder", mutAdd actual), ("reordered binders", mutSwap actual)] do
    if mt == actual then throwError "SRM19 AUDIT FAILED: the fixture '{nm}' did not change the table (vacuous)"
    match tableDiff mt Tests.Compiler.Srm19AuditExpected.expectedRows with
    | none => throwError "SRM19 AUDIT FAILED: the comparator ACCEPTED the fixture '{nm}'"
    | some msg => logInfo m!"S19FIXTURE|{nm}|rejected: {msg}"
  logInfo m!"S19TABLE|{audited19.length} theorems, {lines.length} binders: equal to the committed table and to scripts/srm19/PREMISES.txt"
  -- (2) independent full-type expected statements
  unless pairs19.length == 2 do throwError "SRM19 AUDIT FAILED: pairs19 has {pairs19.length} entries, expected 2"
  for (t, e) in pairs19 do
    let ci ← getConstInfo t
    let ei ← getConstInfo e
    unless (← isDefEq ci.type (ei.value?.getD (mkConst e))) do throwError "SRM19 AUDIT FAILED: the statement of {t} is not defeq to its expected form {e}"
    logInfo m!"S19EXPDEFEQ|{t}|{e}|isDefEq"
  for mutName in [``Tests.Compiler.Srm19ExpStmt.Exp_mutation_noHfit, ``Tests.Compiler.Srm19ExpStmt.Exp_mutation_rkVar] do
    let ci ← getConstInfo ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_endToEnd
    let ei ← getConstInfo mutName
    if (← isDefEq ci.type (ei.value?.getD (mkConst ei.name))) then throwError "SRM19 AUDIT FAILED: the mutated expected statement {mutName} was ACCEPTED"
    logInfo m!"S19EXPMUT|{mutName} rejected"
  -- (3) ONE witness: exactly one of each run/witness binder, and the rank binders gone
  for thm in audited19 do
    inTelescope thm fun xs concl => do
      let mut cnt : List (String × Nat) := []
      for x in xs do
        let nm := (← x.fvarId!.getDecl).userName.toString
        cnt := cnt ++ [(nm, 1)]
      for r in ["hrun", "hcore", "hpost", "raw", "b", "D", "st0", "mems", "kids", "ins", "hRK", "hin", "hfit", "hst₁", "hst₂", "hst₃"] do
        unless (cnt.filter (·.1 == r)).length == 1 do throwError "SRM19 AUDIT FAILED: {thm} has {(cnt.filter (·.1 == r)).length} binders named {r}, expected exactly 1"
      for r in ["s", "hsk", "rk", "hrkmem", "hrT", "hrW", "hrW3", "hrP", "hrQ", "hrL", "hO", "seed", "hseedB", "hst", "hkids"] do
        if (cnt.filter (·.1 == r)).length != 0 then throwError "SRM19 AUDIT FAILED: {thm} has a binder named {r}"
      -- exactly one run proposition and one RunsTo (by head constant of the binder type)
      let mut nRun : Nat := 0
      let mut nCore : Nat := 0
      for x in xs do
        let t ← inferType x
        if t.getAppFn.constName? == some ``Eq && t.getAppArgs.size == 3 && t.getAppArgs[1]!.getAppFn.constName? == some ``Tools.ShippingHierStateG.runModuleTG then nRun := nRun + 1
        if t.getAppFn.constName? == some ``Tools.ShippingEntrySoundness.RunsTo then nCore := nCore + 1
      unless nRun == 1 && nCore == 1 do throwError "SRM19 AUDIT FAILED: {thm} has {nRun} runModuleTG binders and {nCore} RunsTo binders, expected 1 and 1"
      -- the single hrun runs from the start state built from st0/mems/kids, and the conclusion is about the same state
      let some hrun ← binderNamed xs "hrun" | throwError "SRM19 AUDIT FAILED"
      let some st0 ← binderNamed xs "st0" | throwError "SRM19 AUDIT FAILED"
      let some kids ← binderNamed xs "kids" | throwError "SRM19 AUDIT FAILED"
      let hty ← inferType hrun
      unless hty.containsFVar st0.fvarId! && hty.containsFVar kids.fvarId! && concl.containsFVar st0.fvarId! && concl.containsFVar kids.fvarId! do
        throwError "SRM19 AUDIT FAILED: hrun / conclusion of {thm} are not both about the start state (st0, kids)"
      -- the rank table in the conclusion is the computed one (no rank variable)
      unless concl.getUsedConstants.contains ``Tools.ShippingSrm7Rank.rkOf do throwError "SRM19 AUDIT FAILED: conclusion of {thm} does not use rkOf"
      let some hRK ← binderNamed xs "hRK" | throwError "SRM19 AUDIT FAILED"
      unless (← inferType hRK).getAppFn.constName? == some ``Tools.ShippingMachineShipsDepth.ResetNk do throwError "SRM19 AUDIT FAILED: hRK of {thm} is not ResetNk"
    logInfo m!"S19ONEWITNESS|{thm}|one hrun, hcore, hpost, raw, b, D, start state (st0 mems kids), ins; no s/hsk/rank binders"
  -- (4) closure audit
  let forbidden : List Name := [`Tools.ShippingChildInv.RealChild, `Tools.ShippingChildInv.InvW, `Tools.ShippingMachineRan.MachineRan,
      `Tools.ShippingChildInv.MachineClosesAt, `Tools.ShippingMemKid.Kid, `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM,
      `Tools.ShippingChildInv.ChildBnd, `Tools.ShippingChildInv.StartV, `Tools.ShippingGenKid.GenKid,
      `Tools.ShippingKidFacts.KidFacts, `Tools.ShippingMachineDepthRun.MachineRunNC, `Tools.ShippingSharedLeafCoh.CacheClosed]
  for f in forbidden do
    unless (← getEnv).contains f do throwError "SRM19 AUDIT FAILED: the forbidden root {f} does not exist (vacuous audit)"
  let ctl ← depClosure `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM
  unless (ctl.toList.filter fun c => forbidden.any (·.isPrefixOf c)).length > 0 do throwError "SRM19 AUDIT FAILED: control walk found no old-form constant"
  for thm in audited19 do
    let cl ← depClosure thm
    let bad := hits cl
    unless bad.isEmpty do throwError "SRM19 AUDIT FAILED: old RefLaws boundary in the closure of {thm}: {bad}"
    let bad2 := cl.toList.filter fun c => forbidden.any (·.isPrefixOf c)
    unless bad2.isEmpty do throwError "SRM19 AUDIT FAILED: old-form boundary in the closure of {thm}: {bad2}"
    stdAxioms thm
    let inst := if (toString thm).startsWith "Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM" then "M" else "Q"
    let req : List Name := [Name.mkStr thm.getPrefix s!"topshare{inst}_svBoundsH_viaStartNk", Name.mkStr thm.getPrefix s!"topshare{inst}_svBoundsH_viaResetO",
      Name.mkStr thm.getPrefix s!"topshare{inst}_hO", ``Tools.ShippingSrm13Supply.kidInvN_of_resetNk, ``Tools.ShippingSrm7Rank.rkOf_mem, ``Tools.ShippingSrm7Rank.rkOf_decl]
    for r in req do
      unless (← getEnv).contains r do throwError "SRM19 AUDIT FAILED: required constant {r} does not exist"
      unless cl.contains r do throwError "SRM19 AUDIT FAILED: {r} is not in the closure of {thm}"
    let cname := Name.mkStr `Tests.Compiler.Srm14RankTest s!"topshare{inst}_svBoundsH_computed"
    unless (← getEnv).contains cname do throwError "SRM19 AUDIT FAILED: {cname} does not exist"
    if cl.contains cname then throwError "SRM19 AUDIT FAILED: the SRM14 computed theorem unexpectedly is in the closure of {thm} (header claim wrong)"
    logInfo m!"S19CLOSURE|{thm}|standard axioms; closure {cl.size} constants; no old-form boundary; contains viaStartNk, viaResetO, hO, kidInvN_of_resetNk, rkOf_mem, rkOf_decl; SRM14 computed NOT in closure"

end
