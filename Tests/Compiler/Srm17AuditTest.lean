/-- elaborate a hand-written term string -/
def elabStr (s : String) : TermElabM Expr := do
  match Parser.runParserCategory (← getEnv) `term s with
  | .error e => throwError "SRM17 AUDIT FAILED: expected string does not parse: {e}\n{s}"
  | .ok stx =>
    let e ← Term.elabTerm stx none
    Term.synthesizeSyntheticMVarsNoPostponing
    instantiateMVars e

/-- is the theorem's type defeq to the hand-written expected statement? -/
def typeIs (thm : Name) (s : String) : TermElabM Bool := do
  let ci ← getConstInfo thm
  let e ← elabStr s
  isDefEq ci.type e

/-- the independently written expected statements of the generic theorems (hand-written, NOT produced by a script from the theorems) -/


abbrev Row := Nat × String × String × Bool × String

/-- normalised binder name -/
def normName (n : String) : String := if (n.splitOn "_hyg").length > 1 then "_anon" else n

/-- rows `(index, binderInfo, name, isProp, type)` of the binders of a theorem's type -/
def premiseRows (thm : Name) : MetaM (List Row) := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    let mut rows : List Row := []
    let mut i := 0
    for x in xs do
      let d ← x.fvarId!.getDecl
      let isP ← Meta.isProp d.type
      let bi := match d.binderInfo with
        | .implicit => "implicit" | .strictImplicit => "strict" | .instImplicit => "inst" | .default => "explicit"
      rows := rows ++ [(i, bi, normName d.userName.toString, isP, ((← ppExpr d.type).pretty 100000).replace "\n" " ")]
      i := i + 1
    return rows

/-- the text line of a row (the format of `scripts/srm17/PREMISES.txt`) -/
def rowLine (thm : Name) (r : Row) : String :=
  s!"S17{if r.2.2.2.1 then "PREM" else "DATA"}|{thm}|{r.1}|{r.2.1}|{r.2.2.1}|{r.2.2.2.2}"

/-- EXACT comparison of two whole tables: `none` iff equal, else the first difference -/
def tableDiff (a e : List (Name × List Row)) : Option String := Id.run do
  if a.length != e.length then return some s!"{a.length} theorems vs {e.length} expected"
  for ((n, rs), (n', rs')) in a.zip e do
    if n != n' then return some s!"theorem {n} vs expected {n'}"
    if rs.length != rs'.length then return some s!"{n}: {rs.length} binders vs {rs'.length} expected"
    for (r, r') in rs.zip rs' do
      if r != r' then return some s!"{n}: binder {r.1} differs: {rowLine n r} vs expected {rowLine n r'}"
  return none

/-- mutation 1: SEMANTIC change of the type of the first Prop binder (same index, binderInfo, name): the type string gets ` ∧ True` appended -/
def mutType (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.any (·.2.2.2.1)) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then
      let idx := (rs.findIdx? (·.2.2.2.1)).getD 0
      (n, rs.mapIdx fun i r => if i == idx then (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2 ++ " ∧ True") else r)
    else (n, rs)

/-- mutation 2: add a data binder to the first theorem -/
def mutAdd (t : List (Name × List Row)) : List (Name × List Row) :=
  t.mapIdx fun j (n, rs) => if j == 0 then (n, rs ++ [(rs.length, "implicit", "extraBinder", false, "Nat")]) else (n, rs)

/-- mutation 3: swap the first two binders of the first theorem that has two -/
def mutSwap (t : List (Name × List Row)) : List (Name × List Row) :=
  match t.findIdx? (fun (_, rs) => rs.length ≥ 2) with
  | none => t
  | some k => t.mapIdx fun j (n, rs) =>
    if j == k then (match rs with | r0 :: r1 :: rest => (n, r1 :: r0 :: rest) | _ => (n, rs)) else (n, rs)

/-- does a hypothesis of `thm` restate its conclusion (reducible `isDefEq`)? -/
def restatesConclusion (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if (← Meta.isProp d.type) then
        if (← withReducible (isDefEq d.type concl)) then return true
    return false

/-- does a hypothesis of `thm` mention the uniform children's check? -/
def mentionsUniformUNUSED (thm : Name) : MetaM Bool := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs _ => do
    for x in xs do
      let d ← x.fvarId!.getDecl
      if d.type.getUsedConstants.any (fun c => c == ``Tools.ShippingDesignSV.kidsPass || c == ``Tools.ShippingChecksDesign.kidCheck || c == ``Tools.ShippingDesignSVBack.outsCheck || c == ``Tools.ShippingDesignSV.designCheck || c == ``Tools.ShippingSrm6Sem.SVBoundsH || c == ``Tools.ShippingDesignSV.SVBounds) then return true
    return false


/-- run `k` in the telescope of `thm`'s type -/
def inTelescope {α : Type} (thm : Name) (k : Array Expr → Expr → TermElabM α) : TermElabM α := do
  let ci ← getConstInfo thm
  forallTelescope ci.type fun xs concl => k xs concl

/-- the fvar of the binder with user name `nm` -/
def binderNamed (xs : Array Expr) (nm : String) : MetaM (Option Expr) := do
  for x in xs do
    if (← x.fvarId!.getDecl).userName.toString == nm then return some x
  return none


/-- Standard axioms only, an error otherwise (as Tests/Compiler/ChildVertAuditTest.lean `stdAxioms`; copied so that this test does not import that integrator-only module). -/
def stdAxioms (n : Name) : MetaM Unit := do
  for ax in ← Lean.collectAxioms n do
    unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
      throwError "{n} uses a non-standard axiom: {ax}"

/-- the transitive closure of the constants `n` depends on (type, value, constructors of inductives), `n` included (as `depClosure` of ChildVertAuditTest) -/
partial def depClosure (n : Name) : MetaM NameSet := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut todo : Array Name := #[n]
  while todo.size > 0 do
    let c := todo.back!
    todo := todo.pop
    if seen.contains c then continue
    seen := seen.insert c
    match env.find? c with
    | none => pure ()
    | some ci =>
      let mut used := ci.type.getUsedConstants
      if let some v := ci.value? (allowOpaque := true) then
        used := used ++ v.getUsedConstants
      if let .inductInfo iv := ci then
        used := used ++ iv.ctors.toArray
      for u in used do
        unless seen.contains u do
          todo := todo.push u
  return seen

/-- the old-boundary names: any constant equal to or under these -/
def forbiddenRoots : List Name :=
  [`Tools.ShippingChildInv.RefLaws, `Tools.ShippingChildBndCore.RefLawsCore,
   `Tools.ShippingChildInvA.RefLawsCore.toAOps, `Tools.ShippingChildInvA.RefLawsCore.toA]

def hits (s : NameSet) : List Name :=
  s.toList.filter fun c => forbiddenRoots.any fun r => r.isPrefixOf c

end Tests.Compiler.Srm17AuditTest

open Tests.Compiler.Srm17AuditTest in
run_cmd liftTermElabM do
  unless (← restatesConclusion ``Tests.Compiler.Srm17AuditTest.wrapper_mutation) do throwError "SRM17 AUDIT FAILED: the wrapper control was not caught"
  unless audited17.length == 32 do throwError "SRM17 AUDIT FAILED: audited17 has {audited17.length} theorems, expected exactly 32"
  -- (1) premise table
  let mut actual : List (Name × List Row) := []
  let mut lines : List String := []
  for thm in audited17 do
    let rows ← premiseRows thm
    actual := actual ++ [(thm, rows)]
    logInfo m!"S17THM|{thm}|{rows.length}"
    lines := lines ++ [s!"S17THM|{thm}|{rows.length}"]
    for r in rows do
      logInfo m!"{rowLine thm r}"
      lines := lines ++ [rowLine thm r]
    if (← restatesConclusion thm) then throwError "SRM17 AUDIT FAILED: a hypothesis of {thm} restates its conclusion"
  unless Tests.Compiler.Srm17AuditExpected.expectedRows.length == 32 do throwError "SRM17 AUDIT FAILED: the expected table has {Tests.Compiler.Srm17AuditExpected.expectedRows.length} theorem entries, expected exactly 32"
  match tableDiff actual Tests.Compiler.Srm17AuditExpected.expectedRows with
  | some msg => throwError "SRM17 AUDIT FAILED: the premise table differs from Tests/Compiler/Srm17AuditExpected.lean: {msg}"
  | none => pure ()
  let txt ← IO.FS.readFile "scripts/srm17/PREMISES.txt"
  let fileLines := (txt.splitOn "\n").filter (· != "")
  unless fileLines == lines do
    throwError "SRM17 AUDIT FAILED: scripts/srm17/PREMISES.txt differs from the regenerated table ({fileLines.length} lines vs {lines.length})"
  -- negative fixtures
  do
    let mt := mutType actual
    let mut changed : List (Name × Row × Row) := []
    unless mt.length == actual.length do throwError "SRM17 AUDIT FAILED: fixture 1 changed the number of theorems"
    for ((n, rs), (n', rs')) in actual.zip mt do
      unless n == n' && rs.length == rs'.length do throwError "SRM17 AUDIT FAILED: fixture 1 changed the shape of {n}"
      for (r, r') in rs.zip rs' do
        if r != r' then changed := changed ++ [(n, r, r')]
    match changed with
    | [(n, r, r')] =>
      unless r'.2.2.2.1 do throwError "SRM17 AUDIT FAILED: fixture 1 mutated row of {n} is not a Prop binder"
      unless r.2.2.2.1 && r'.1 == r.1 && r'.2.1 == r.2.1 && r'.2.2.1 == r.2.2.1 do throwError "SRM17 AUDIT FAILED: fixture 1 changed index/binderInfo/name/isProp of binder {r.1} of {n}"
      unless r'.2.2.2.2 != r.2.2.2.2 && r'.2.2.2.2.endsWith " ∧ True" && r'.2.2.2.2.length == r.2.2.2.2.length + 7 do throwError "SRM17 AUDIT FAILED: fixture 1 type string is not visibly changed"
      logInfo m!"S17FIXTURE1|{n}|binder {r.1} ({r.2.2.1})|original type: {r.2.2.2.2}|mutated type: {r'.2.2.2.2}"
      match tableDiff mt Tests.Compiler.Srm17AuditExpected.expectedRows with
      | some msg => unless (msg.splitOn s!"binder {r.1} differs").length > 1 && (msg.splitOn (toString n)).length > 1 do throwError "SRM17 AUDIT FAILED: fixture 1 rejection does not name the mutated binder: {msg}"
      | none => throwError "SRM17 AUDIT FAILED: the comparator ACCEPTED fixture 1"
    | _ => throwError "SRM17 AUDIT FAILED: fixture 1 changed {changed.length} rows, expected exactly 1"
  for (nm, mt) in [("changed Prop binder type", mutType actual), ("added data binder", mutAdd actual), ("reordered binders", mutSwap actual)] do
    if mt == actual then throwError "SRM17 AUDIT FAILED: the fixture '{nm}' did not change the table (vacuous)"
    match tableDiff mt Tests.Compiler.Srm17AuditExpected.expectedRows with
    | none => throwError "SRM17 AUDIT FAILED: the comparator ACCEPTED the fixture '{nm}'"
    | some msg => logInfo m!"S17FIXTURE|{nm}|rejected: {msg}"
  logInfo m!"S17TABLE|{audited17.length} theorems, {lines.length} binders: equal to the committed table and to scripts/srm17/PREMISES.txt"
  -- (2) independent expected statements (generated from the SRM13 source statements by scripts/srm17/gen_exp.py)
  unless pairs17.length == 12 do throwError "SRM17 AUDIT FAILED: pairs17 has {pairs17.length} entries, expected 12"
  for (t, e, _) in pairs17 do
    let ci ← getConstInfo t
    let ei ← getConstInfo e
    unless (← isDefEq ci.type (ei.value?.getD (mkConst e))) do throwError "SRM17 AUDIT FAILED: the statement of {t} is not defeq to its expected form {e}"
    logInfo m!"S17EXPDEFEQ|{t}|{e}|isDefEq"
  -- one wrong expected form (hfit deleted) must be rejected
  do
    let ci ← getConstInfo ``Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM_svBoundsH_viaResetSrc
    let ei ← getConstInfo ``Tests.Compiler.Srm17ExpStmt.Exp_mutation_noHfit
    if (← isDefEq ci.type (ei.value?.getD (mkConst ei.name))) then throwError "SRM17 AUDIT FAILED: the mutated expected statement (hfit deleted) was ACCEPTED"
    logInfo m!"S17EXPMUT|hfit-deleted expected form rejected"
  -- the corollaries: the four residual binders are deleted, nothing else (hsk, hfit, hst₁₂₃, hin, hrun kept; hrk, hO absent as in the source); the residual facts are not relabellings of hrk / hsk
  for (new, _, src) in pairs17 do
    let nm := toString new
    let isCor := nm.endsWith "viaResetSrc"
    let N := if nm.startsWith "Tests.Compiler.SharedLeafMemKidIfaceTest.topshareM" then 2 else 1
    let srcHas ← inTelescope src fun xs _ => do
      for r in ["hIUraw", "hIU", "hAg", "hRd", "hsk", "hfit"] do
        unless (← binderNamed xs r).isSome do throwError "SRM17 AUDIT FAILED: the SRM16 source {src} lacks the binder {r}"
      return true
    unless srcHas do throwError "SRM17 AUDIT FAILED: source {src}"
    if isCor then
      inTelescope new fun xs _ => do
        for r in ["hIUraw", "hIU", "hAg", "hRd", "hO", "hrk"] do
          if (← binderNamed xs r).isSome then throwError "SRM17 AUDIT FAILED: {new} still has the binder {r}"
        let some hsk ← binderNamed xs "hsk" | throwError "SRM17 AUDIT FAILED: {new} lacks hsk"
        let skT ← elabStr s!"fun (D : Sparkle.IR.AST.Design) (raw : Sparkle.IR.AST.Module) (s : Tools.ShippingHierStateG.KState (Tools.ShippingHierStateG.KT {N})) => s.kids = Tools.ShippingSrm16Reset.resetKids D {N} raw"
        unless (← Meta.isProp (← inferType hsk)) do throwError "SRM17 AUDIT FAILED: hsk of {new} is not a Prop binder"
        for r in ["hfit", "hst₁", "hst₂", "hst₃", "hin", "hrun"] do
          let some x ← binderNamed xs r | throwError "SRM17 AUDIT FAILED: {new} lacks the premise {r}"
          unless (← Meta.isProp (← inferType x)) do throwError "SRM17 AUDIT FAILED: {r} of {new} is not a Prop binder"
        let _ := skT
      logInfo m!"S17BINDERS|{new}|hIUraw hIU hAg hRd deleted; hsk hfit hst₁₂₃ hin hrun kept as explicit premises"
    else
      -- the residual-fact conclusion is a Prop, not the premise `hrk`/`hsk` and not a conclusion of the form `ResetNk ..`
      inTelescope new fun _ concl => do
        unless (← Meta.isProp concl) do throwError "SRM17 AUDIT FAILED: conclusion of {new} is not a Prop"
        let rk ← elabStr s!"Tools.ShippingMachineShipsDepth.ResetNk {N} raw D s.kids"
        if concl.getUsedConstants.contains ``Tools.ShippingMachineShipsDepth.ResetNk then throwError "SRM17 AUDIT FAILED: conclusion of {new} mentions ResetNk (relabelling of hrk)"
        let _ := rk
      logInfo m!"S17RESIDUAL|{new}|conclusion is a Prop that is not ResetNk (its statement is defeq to the expected form generated from the SRM16 binder, checked above)"
  -- (3) closure audit
  let forbidden : List Name := [`Tools.ShippingChildInv.RealChild, `Tools.ShippingChildInv.InvW, `Tools.ShippingMachineRan.MachineRan,
      `Tools.ShippingChildInv.MachineClosesAt, `Tools.ShippingMemKid.Kid, `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM,
      `Tools.ShippingChildInv.ChildBnd, `Tools.ShippingChildInv.StartV, `Tools.ShippingGenKid.GenKid,
      `Tools.ShippingKidFacts.KidFacts, `Tools.ShippingMachineDepthRun.MachineRunNC, `Tools.ShippingSharedLeafCoh.CacheClosed]
  for f in forbidden do
    unless (← getEnv).contains f do throwError "SRM17 AUDIT FAILED: the forbidden root {f} does not exist (vacuous audit)"
  let ctl ← depClosure `Tools.ShippingKidsChildIfaceM.kidsChild_of_realM
  unless (ctl.toList.filter fun c => forbidden.any (·.isPrefixOf c)).length > 0 do throwError "SRM17 AUDIT FAILED: control walk found no old-form constant"
  for thm in audited17 do
    let cl ← depClosure thm
    let bad := hits cl
    unless bad.isEmpty do throwError "SRM17 AUDIT FAILED: old RefLaws boundary in the closure of {thm}: {bad}"
    let bad2 := cl.toList.filter fun c => forbidden.any (·.isPrefixOf c)
    unless bad2.isEmpty do throwError "SRM17 AUDIT FAILED: old-form boundary in the closure of {thm}: {bad2}"
    stdAxioms thm
    logInfo m!"S17CLOSURE|{thm}|standard axioms; closure {cl.size} constants; no old-form boundary"
  for (new, _, old) in pairs17 do
    let cl ← depClosure new
    if (toString new).endsWith "viaResetSrc" then
      unless cl.contains old do throwError "SRM17 AUDIT FAILED: {old} is not in the closure of {new}"
      unless cl.contains ``Tools.ShippingSrm16Reset.resetNk_resetKids do throwError "SRM17 AUDIT FAILED: resetNk_resetKids is not in the closure of {new}"
      unless cl.contains ``Tools.ShippingSrm17Corr.ran_designP do throwError "SRM17 AUDIT FAILED: ran_designP is not in the closure of {new}"
      logInfo m!"S17CORCLOSURE|{new}|contains {old}, resetNk_resetKids, ran_designP"
    else
      unless cl.contains ``Tools.ShippingSrm17Corr.ran_designP do throwError "SRM17 AUDIT FAILED: ran_designP is not in the closure of {new}"
      logInfo m!"S17RESCLOSURE|{new}|contains ran_designP"
  for d in ["topshareM", "topshareQ"] do
    let thm := (`Tests.Compiler.SharedLeafMemKidIfaceTest).str s!"{d}_modP"
    let cl ← depClosure thm
    for need in [``Tools.ShippingSrm17Corr.ran_designP, ``Tools.ShippingSrm17Corr.memCallee_childP, ``Tools.ShippingSrm17Corr.leaf_childP, ``Tools.ShippingSrm17Corr.memModule_modP,
        ``Tools.ShippingSrm17Ran.ran_modP, ``Tools.ShippingSrm17Ran.leaf_modPA, ``Tools.ShippingSrm17Body.modP_mergeChecked, ``Tools.ShippingSrm4Core2.core_raw_facts_ranAM] do
      unless cl.contains need do throwError "SRM17 AUDIT FAILED: {need} is not in the closure of {thm}"
    logInfo m!"S17MODPCLOSURE|{thm}|contains ran_designP, memCallee_childP, leaf_childP, memModule_modP, ran_modP, leaf_modPA, modP_mergeChecked, core_raw_facts_ranAM"

end
