import Tests.Compiler.PortsMatchRawLeafTest
import Tools.ShippingLeafEntry
import Tools.ShippingFinalGoalCommand

/-! # `cnt` AS AN ENTRY: the wired endpoint with its three check premises replaced (G1, round par/a-23)

`cnt` (`Tests/Compiler/ShippingMachineSeqTest.lean` 20) is a leaf register
machine: no call, one register. Its strongest endpoint is
`cnt.machine_ships_wired`, which under `∃ raw` asks, for every `wof`,

    simpleBody b = false
    seqCheck wof (weOf wof) (checkedOptimize b).body = true
    (seqNames (checkedOptimize b).body).all (declWidth (checkedOptimize b) · == weOf wof ·) = true

This file adds `cnt.machine_ships_leaf`: the same conclusion at
`wof = wofOf (checkedOptimize b)` by
`Tools.ShippingLeafEntry.leaf_entry_ships_of` /
`leaf_entry_textChecks`, with the closing discharged by `cnt.machine_closes`.

## What the statement is — and is NOT

The three check premises are NOT removed without a price. They are replaced
by THREE binders the goal-gap classifier logs NOT ALLOWED:

* `hw : InvW mref cref w` — `leaf_run_typedIn` asks it (it needs only
  `ChildBnd`, which is ALLOWED; generalising it is an edit of an existing
  file);
* `hmergeReg` — the checked merge of a module with a register has a
  non-assignment statement (for `simpleBody b = false`); not a theorem about
  `mergeChecked` today;
* `hoptPrint : checkedOptimize b = b ∨ printOk (checkedOptimize b) = true` —
  the instance-free branch of `checkedOptimize` is not print-guarded. Where
  the optimizer's candidate IS accepted this is `printOk` of the shipped
  module, i.e. the content of the two text checks: for such a run NOTHING is
  removed.

So: `simpleBody`, `seqCheck` and the width agreement no longer occur in the
statement; two compiler facts and one over-strong boundary occur instead.
The statement is added by elaborating the proof term and taking its inferred
type (the declaration's domain family and source function are the generated
endpoint's own; they are not written here), and LOGGED.

## Order

1. the reader's data and the constants this file needs: LOGGED, then
   asserted;
2. `cnt.machine_ships_leaf`: added, standard axioms (an error otherwise);
3. its statement and every proposition binder (ALLOWED / NOT ALLOWED by
   `Tools.ShippingFinalGoalCommand.allowed`): LOGGED; then asserted — the
   base endpoint mentions `simpleBody` and `seqCheck`, the new one neither;
   exactly three binders are NOT ALLOWED.

## SCOPE (binding for any report)

ONE declaration, `cnt`, as an entry; ONE module (`MachineShips`: the IR run
of `checkedOptimize b` and `runModuleSV` of its emitted statements at the
emitter's own width map) — not `DesignSV`, not the SV string, not `#sim`;
data conditions decided for `cnt` (`cnt_leafKid`); the run and the reflection
stay premises; the three NOT ALLOWED binders above stay premises.

UNVERIFIED at the time of writing: this file was not built. -/
namespace Tests.Compiler.LeafEntryCntTest

/-! ## 1. The reader's data: LOGGED first, then asserted -/

set_option maxHeartbeats 0 in
run_cmd Lean.Elab.Command.liftTermElabM do
  let c := ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt
  let r ← Tools.ShippingMachineCommand.readMachine c
  let env ← Lean.getEnv
  let mut have_ : List Lean.Name := []
  let mut lack : List Lean.Name := []
  for n in [c ++ `machineData, c ++ `machine_ok, c ++ `machine_body, c ++ `machine_sound,
      c ++ `machine_closes, c ++ `machine_ships_wired, c ++ `machine_ships_wired_closed,
      ``Tests.Compiler.PortsMatchRawLeafTest.cnt_leafKid] do
    if env.contains n then have_ := have_ ++ [n] else lack := lack ++ [n]
  Lean.logInfo m!"LEAFENTRY CNT DATA {c}: nDecl={r.nDecl}, binders={r.shape.binders.length}, slots={r.shape.layout.slots.length}, lets={r.shape.layout.lets}, loops={r.shape.loops.length}, call entries {r.shape.insts.map (·.1)}, instFields={r.shape.instFields}, outputs {r.shape.layout.outs.map (·.name)}. In the environment: {have_}; not: {lack}"
  unless r.shape.insts.isEmpty do throwError "{c}: it has calls — not a leaf"
  if r.shape.layout.slots.isEmpty then throwError "{c}: no register slot"
  for n in [c ++ `machineData, c ++ `machine_closes, c ++ `machine_ships_wired,
      ``Tests.Compiler.PortsMatchRawLeafTest.cnt_leafKid] do
    unless env.contains n do
      throwError "{n}: not in the environment — this file needs it (the base endpoint of {c} is generated by #machine_endpoint of its parents)"

/-! ## 2. `cnt.machine_ships_leaf` -/

set_option maxHeartbeats 0 in
set_option hygiene false in
run_cmd Lean.Elab.Command.liftTermElabM do
  let c := ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt
  let stx ← `(fun {mctx : Lean.Meta.Context} {mref : ST.Ref IO.RealWorld Lean.Meta.State}
      {cctx : Lean.Core.Context} {cref : ST.Ref IO.RealWorld Lean.Core.State}
      {w w' : Void IO.RealWorld} {b : Sparkle.IR.AST.Module} {design : Sparkle.IR.AST.Design}
      (hw : Tools.ShippingChildInv.InvW mref cref w)
      (hr : Tools.ShippingEntrySoundness.RunsTo
        (Sparkle.Compiler.Elab.synthesizeCombinational
          ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt)
        mctx mref cctx cref w (b, design) w')
      (entry : Tools.ShippingMachineEntry.MachineDefines mctx mref cctx cref
        ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt
        Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt.machineData.shape)
      (hmergeReg : ∀ m0 : Sparkle.IR.AST.Module,
        b = Sparkle.IR.RefineCheck.mergeChecked m0 →
        m0.body.all Sparkle.IR.RegDedup.isAssign = false →
        b.body.all Sparkle.IR.RegDedup.isAssign = false)
      (hoptPrint : Sparkle.IR.OptCheck.checkedOptimize b = b ∨
        Sparkle.IR.PrintGuard.printOk (Sparkle.IR.OptCheck.checkedOptimize b) = true) =>
      Tools.ShippingLeafEntry.leaf_entry_ships_of
        (Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt.machine_ships_wired hr entry
          (Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt.machine_closes mctx mref cctx cref))
        (Tools.ShippingLeafEntry.leaf_entry_textChecks
          (Tests.Compiler.PortsMatchRawLeafTest.cnt_leafKid entry) hw hr hmergeReg hoptPrint))
  let e0 ← Lean.Elab.Term.elabTermAndSynthesize stx none
  let e ← Lean.instantiateMVars e0
  if e.hasMVar then
    throwError "{c}: the proof term of machine_ships_leaf has an unassigned metavariable"
  let ty0 ← Lean.Meta.inferType e
  let ty ← Lean.instantiateMVars ty0
  let leaf := c ++ `machine_ships_leaf
  Tools.ShippingMachineLinkedCommand.addTheorem leaf ty e
  Lean.logInfo m!"LEAFENTRY CNT ADDED {leaf} (standard axioms): {ty}"

/-! ## 3. The premise listing and the assertions -/

set_option maxHeartbeats 0 in
run_cmd Lean.Elab.Command.liftTermElabM do
  let c := ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt
  let leaf := c ++ `machine_ships_leaf
  let base := c ++ `machine_ships_wired
  let info ← Lean.getConstInfo leaf
  let binfo ← Lean.getConstInfo base
  -- every proposition binder, classified
  let report ← Lean.Meta.forallTelescope info.type fun xs body => do
    let mut lines : Array String := #[]
    let mut bad : Nat := 0
    for x in xs do
      let t0 ← Lean.Meta.inferType x
      let t ← Lean.instantiateMVars t0
      let isP ← Lean.Meta.isProp t
      if isP then
        let pp ← Lean.Meta.ppExpr t
        let nm ← x.fvarId!.getUserName
        if Tools.ShippingFinalGoalCommand.allowed t then
          lines := lines.push s!"LEAFENTRY PREMISE {leaf}: ALLOWED     binder {nm} : {pp}"
        else
          bad := bad + 1
          lines := lines.push s!"LEAFENTRY PREMISE {leaf}: NOT ALLOWED binder {nm} : {pp}"
    let ppBody ← Lean.Meta.ppExpr body
    lines := lines.push s!"LEAFENTRY CONCLUSION {leaf}: {ppBody}"
    return (lines, bad)
  for l in report.1 do Lean.logInfo l
  -- the check constants: in the base endpoint, not in the new one
  let mentions (t : Lean.Expr) (n : Lean.Name) : Bool := (t.find? (·.isConstOf n)).isSome
  let checks : List Lean.Name :=
    [``Sparkle.IR.OptCheck.simpleBody, ``Tools.SVParser.EmitSem.seqCheck,
      ``Tools.ShippingSeqSVSoundness.seqNames]
  let inBase := checks.filter (mentions binfo.type)
  let inLeaf := checks.filter (mentions info.type)
  let closing := mentions info.type ``Tools.ShippingMachineEntry.MachineCloses
  Lean.logInfo m!"LEAFENTRY CNT CHECKS: of {checks} — in {base}: {inBase}; in {leaf}: {inLeaf}. MachineCloses in {leaf}: {closing}. NOT ALLOWED binders of {leaf}: {report.2}"
  unless inBase.length == 3 do
    throwError "{base}: expected to mention the three check constants, mentions {inBase}"
  unless inLeaf.isEmpty do
    throwError "{leaf}: still mentions {inLeaf}"
  if closing then throwError "{leaf}: still mentions MachineCloses"
  unless report.2 == 3 do
    throwError "{leaf}: {report.2} NOT ALLOWED binders, expected 3 (InvW, hmergeReg, hoptPrint)"
  -- the general theorems: standard axioms
  for n in [``Tools.ShippingLeafEntry.simpleBody_false_of,
      ``Tools.ShippingLeafEntry.text_post_reg,
      ``Tools.ShippingLeafEntry.text_shipped_of_print,
      ``Tools.ShippingLeafEntry.checkedOptimize_seqBody,
      ``Tools.ShippingLeafEntry.leaf_entry_raw,
      ``Tools.ShippingLeafEntry.leaf_entry_textChecks,
      ``Tools.ShippingLeafEntry.leaf_entry_textChecks_id,
      ``Tools.ShippingLeafEntry.leaf_entry_shipped_seq,
      ``Tools.ShippingLeafEntry.leaf_entry_ships_of,
      ``Tools.ShippingLeafEntry.leaf_entry_ships,
      ``Tools.ShippingLeafEntry.oracle_seq,
      ``Tools.ShippingLeafEntry.designSV0_of_leaf, leaf] do
    for ax in ← Lean.collectAxioms n do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "{n} uses a non-standard axiom: {ax}"
  Lean.logInfo m!"LEAFENTRY CNT: {leaf} — the conclusion of {base} at the emitter's own width map wofOf (checkedOptimize b), with NO occurrence of simpleBody, seqCheck or seqNames and no MachineCloses; standard axioms. NOT a check-free endpoint: three binders are NOT ALLOWED — InvW at the start world (ChildBnd would do: one hypothesis of leaf_run_typedIn), hmergeReg (the checked merge keeps a non-assignment statement: not a theorem about mergeChecked) and hoptPrint (checkedOptimize b = b or printOk of the shipped module: the instance-free branch of checkedOptimize has no print guard; where the candidate is accepted this IS the text check). SCOPE: one declaration, one module (MachineShips), data conditions decided for cnt, the run and MachineDefines cnt stay premises; not DesignSV, not the SV string, not #sim"

end Tests.Compiler.LeafEntryCntTest
