import Tests.Compiler.ShippingCallsCloseDeepTest

/-! # The closing generators: the name conditions from the declaration names, against the previous proofs, on ONE tree (round par/b-30)

WRITTEN, NOT BUILT.

## TARGET-ONLY (the integrator's choice whether it enters `Tests/AllTests.lean`)

It adds only new names (`…_candidates`), so it does not clash with any test.
It is kept out of `AllTests` by default because the previous path's proofs
are the expensive ones (`sepB`: the kernel enumerates candidate renderings;
`ShippingCallsCloseDeepTest` was split for memory because of them).

## What is compared

The imports generated, with the NEW path (default options), the closings

    callerMix.machine_closes_at   one-output closing, two called declarations
    parent.machine_closes_at      the general closing (closesAtCoreG)
    grand.closes_deep, mid.closes_deep / mid.iface_deep   a child with calls

Here each is generated AGAIN in the same environment with

    shipping.nameCandidates := true      (the previous proofs: Tools.ShippingNameSep)

under another name (`…_candidates`; for the deep closings through
`shipping.deepSuffix`), kernel-checked, and for every pair the two
STATEMENTS are required `isDefEq` (the kernel-level comparison of the two
types — not a hash, not a printed text). An error otherwise.

Also asserted, on the proof terms' DIRECT constants: the new
`machine_closes_at` applies `Tools.ShippingNameDischarge.parent_ne` and
`names_inj` and neither `Enc.hparent_of` nor `Enc.hnames_of`; the
`…_candidates` one applies `Enc.hparent_of` and not `parent_ne`.

NOT compared here: every other declaration the commands are run on (the
list is in `docs/parallel/B-name-discharge-2.md`); add a line each. For a
declaration that already has `f.machine_closes_at`, running
`set_option shipping.nameCandidates true in #machine_closes_at f` is the
same comparison without a second name: `closesAtTheorem` regenerates the
statement under a scratch name and requires `isDefEq` with the existing one. -/

namespace Tests.Compiler.NameGenCompareTest
open Lean Meta Elab Command

def std (n : Name) : MetaM Unit := do
  for ax in ← Lean.collectAxioms n do
    unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
      throwError "{n} uses a non-standard axiom: {ax}"

def direct (n : Name) : MetaM (Array Name) := do
  match (← getEnv).find? n with
  | some (.thmInfo ti) => return ti.value.getUsedConstants
  | _ => throwError "{n}: not a theorem"

def sameStatement (a b : Name) : MetaM Unit := do
  unless ← isDefEq (← getConstInfo a).type (← getConstInfo b).type do
    throwError "{b}: its statement is not that of {a}:{indentExpr (← getConstInfo a).type}\nvs{indentExpr (← getConstInfo b).type}"

/-- The machine descendants of `c` (callees with reflected data), `fuel` levels. -/
partial def below (c : Name) (fuel : Nat) : MetaM (List Name) := do
  if fuel == 0 then return []
  unless (← getEnv).contains (c ++ `machineData) do return []
  let r ← Tools.ShippingMachineCommand.readMachine c
  let mut out : List Name := []
  for k in (r.shape.insts.map (·.1)).eraseDups do
    unless out.contains k do out := out ++ [k]
    for g in ← below k (fuel - 1) do
      unless out.contains g do out := out ++ [g]
  return out

/-- `#name_gen_compare_at f`: `f.machine_closes_at` exists (new path);
generate it again on the previous path as `f.machine_closes_at_candidates`
and require the same statement. -/
elab "#name_gen_compare_at " d:ident : command => do
  let c ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo d
  let cl := c ++ `machine_closes_at
  let old := c ++ `machine_closes_at_candidates
  unless (← getEnv).contains cl do throwError "{cl}: missing (not generated by the imports)"
  let setOld : Lean.Options → Lean.Options := fun o =>
    Lean.Option.set (Lean.Option.set o Lean.Elab.async false) shipping.nameCandidates true
  discard <| withScope (fun s => { s with opts := setOld s.opts })
    (Tools.ShippingMachineClosesAtGen.closesAtCore c none old)
  liftTermElabM do
    std old
    sameStatement cl old
    let uNew ← direct cl
    let uOld ← direct old
    let pNew := ``Tools.ShippingNameDischarge.parent_ne
    let nNew := ``Tools.ShippingNameDischarge.names_inj
    let pOld := ``Tools.ShippingNameSep.Enc.hparent_of
    let nOld := ``Tools.ShippingNameSep.Enc.hnames_of
    unless uNew.contains pNew && uNew.contains nNew && !uNew.contains pOld && !uNew.contains nOld do
      throwError "{cl}: expected parent_ne and names_inj and no candidate lemma among {uNew}"
    unless uOld.contains pOld && !uOld.contains pNew && !uOld.contains nNew do
      throwError "{old}: expected Enc.hparent_of and no Name-level lemma among {uOld}"
    logInfo m!"NAMEGEN COMPARE AT {c}: {old} generated on the previous path (candidate renderings; standard axioms); its statement isDefEq that of {cl} (kernel isDefEq of the types). {cl} applies names_inj / parent_ne; {old} applies Enc.hparent_of (Enc.hnames_of used: {uOld.contains nOld} — false means one called declaration, decided on Names already before). NAME and TYPE of {cl} unchanged; the proof differs."

/-- `#name_gen_compare_deep f`: `f.closes_deep` exists (new path); generate
the deep closings of `f` and of its descendants again on the previous path
under the suffix `_candidates` and require the same statements. -/
elab "#name_gen_compare_deep " d:ident : command => do
  let c ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo d
  unless (← getEnv).contains (c ++ `closes_deep) do
    throwError "{c ++ `closes_deep}: missing (not generated by the imports)"
  let setOld : Lean.Options → Lean.Options := fun o =>
    Lean.Option.set
      (Lean.Option.set (Lean.Option.set o Lean.Elab.async false) shipping.nameCandidates true)
      shipping.deepSuffix "_candidates"
  discard <| withScope (fun s => { s with opts := setOld s.opts })
    (Tools.ShippingChildIfaceGen.closesDeep c)
  liftTermElabM do
    let nodes := c :: (← below c 8)
    let mut done : Array Name := #[]
    for k in nodes do
      for s in ["closes_deep", "iface_deep"] do
        let a := k ++ Name.mkSimple s
        let b := k ++ Name.mkSimple (s ++ "_candidates")
        if (← getEnv).contains b then
          unless (← getEnv).contains a do throwError "{b} exists, {a} does not"
          std b
          sameStatement a b
          done := done.push a
    unless done.contains (c ++ `closes_deep) do
      throwError "{c}: the previous path did not generate {c ++ `closes_deep_candidates}"
    logInfo m!"NAMEGEN COMPARE DEEP {c}: generated again on the previous path under the suffix _candidates (standard axioms); statements isDefEq for {done} (kernel isDefEq of the types). NAMES and TYPES unchanged; the proofs differ."

end Tests.Compiler.NameGenCompareTest

set_option maxHeartbeats 0 in
#name_gen_compare_at Sparkle.Tests.Compiler.ShippingPremiseEvalTest.callerMix

set_option maxHeartbeats 0 in
#name_gen_compare_at Sparkle.Tests.Compiler.ShippingMachineSeqTest.parent

set_option maxHeartbeats 0 in
#name_gen_compare_deep Sparkle.Tests.Compiler.ShippingMachineSeqTest.grand
