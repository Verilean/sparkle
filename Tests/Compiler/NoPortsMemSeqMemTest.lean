/-! ## The audit (an error on any failure) -/

set_option maxHeartbeats 0 in
run_cmd Lean.Elab.Command.liftTermElabM do
  let f := ``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.seqMem
  let c := ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt
  let old := f ++ `machine_design_svR0
  let openN := f ++ `machine_design_noPortsR0
  -- (a) standard axioms: the general theorems of this round, the hand lemmas, the endpoint
  for n in [``Tools.ShippingMemKid.kid_of,
      ``Tools.ShippingMemKid.core_kids_factsM,
      ``Tools.ShippingMemKid.core_runFactsM,
      ``Tools.ShippingMemKid.core_outsCheck_all_gateM,
      ``Tools.ShippingMemKid.core_callStmtM,
      ``Tools.ShippingMemKid.core_portsMatch_rawM,
      ``Tools.ShippingMemKid.core_kidsPass_deepM,
      ``Tools.ShippingMemKid.core_designCheck_runM,
      ``Tools.ShippingMemKid.core_kidsMixedM,
      ``Tools.ShippingMemKid.callStmtG_portNames,
      ``Tools.ShippingMemKid.memKid_facts,
      ``Tools.ShippingMemKid.kidFacts_toM,
      ``Tools.ShippingMemKid.kidsM_runFacts,
      ``Tools.ShippingMemKid.kidsM_outsCheck,
      ``Tools.ShippingMemKid.kidsM_mixed,
      ``Tools.ShippingMemKid.kidsM_designCheck,
      ``Tools.ShippingLeafKidFacts.leafKid_facts,
      ``Tests.Compiler.NoPortsMemSeqMemTest.seqMem_entry,
      ``Tests.Compiler.NoPortsMemSeqMemTest.seqMem_kids,
      ``Tests.Compiler.NoPortsMemSeqMemTest.seqMem_callWidths,
      ``Tests.Compiler.NoPortsMemSeqMemTest.seqMem_callArgs,
      ``Tests.Compiler.NoPortsMemSeqMemTest.seqMem_runFacts,
      ``Tests.Compiler.NoPortsMemSeqMemTest.seqMem_outsG0,
      ``Tests.Compiler.NoPortsMemSeqMemTest.seqMem_mixedG,
      ``Tests.Compiler.NoPortsMemSeqMemTest.seqMem_designP0, openN] do
    unless (← Lean.getEnv).contains n do throwError "{n}: missing"
    Tests.Compiler.NoPortsTest.stdAxioms n
  -- (b) the endpoint's statement mentions no checker constant — the depth
  -- chain's and the flat child bounds
  let openT := (← Lean.getConstInfo openN).type
  for k in Tests.Compiler.NoPortsTest.checkers ++ Tests.Compiler.NoPortsMemSeqMemTest.forbiddenMem do
    if (openT.find? (·.isConstOf k)).isSome then
      throwError "{openN}: the statement mentions {k}"
  -- (c) the inventory: the base endpoint of this build asks the four check premises
  let oldT := (← Lean.getConstInfo old).type
  for k in [``Tools.ShippingHierPremisesBase.shipsHierCheck,
      ``Tools.ShippingMachineShipsHier.kidsMixed, ``Tools.ShippingDesignSV.designCheck,
      ``Tools.ShippingDesignSVBack.outsCheck] do
    unless (oldT.find? (·.isConstOf k)).isSome do
      throwError "{old}: does not mention {k} (the inventory is wrong)"
  -- (d) the closing: asked by BOTH (nothing here derives it)
  for (n, t) in [(old, oldT), (openN, openT)] do
    unless (t.find? (·.isConstOf ``Tools.ShippingChildInv.MachineClosesAt)).isSome do
      throwError "{n}: does not ask MachineClosesAt (the report says it stays a premise)"
  -- (e) the binders: the SAME as the base endpoint's, printed the same, in the same order
  let bindersOf (t : Lean.Expr) : Lean.MetaM (Array String) :=
    Lean.Meta.forallTelescope t fun xs _ => do
      let mut out : Array String := #[]
      for x in xs do
        let ty ← Lean.instantiateMVars (← Lean.Meta.inferType x)
        if ← Lean.Meta.isProp ty then out := out.push (toString (← Lean.Meta.ppExpr ty))
      return out
  let bOld ← bindersOf oldT
  let bNew ← bindersOf openT
  unless bOld == bNew do
    throwError "{openN}: its proposition binders differ from {old}'s:\n{bNew}\nvs\n{bOld}"
  unless bNew.size == 3 do
    throwError "{openN}: {bNew.size} proposition binders, expected 3 (the run, MachineDefines, MachineClosesAt)"
  -- (f) the antecedents under the existentials: exactly one (the boundary);
  -- the base endpoint's are LOGGED (five by reading: shipsHierCheck,
  -- designCheck, outsCheck, the boundary, kidsMixed)
  let inner ← Lean.Meta.forallTelescope openT fun _ body =>
    Tests.Compiler.NoPortsTest.innerAntecedents body
  let innerOld ← Lean.Meta.forallTelescope oldT fun _ body =>
    Tests.Compiler.NoPortsTest.innerAntecedents body
  unless inner.size == 1 do
    throwError "{openN}: {inner.size} antecedents under the existentials, expected 1 (the boundary): {inner.map (·.1)}"
  let same := innerOld.any fun x => x.1 == inner[0]!.1
  Lean.logInfo m!"NOPORTS MEM ANTECEDENTS {old}: {innerOld.size} — {innerOld.map (·.1)}"
  Lean.logInfo m!"NOPORTS MEM ANTECEDENTS {openN}: {inner.size} — {inner.map (·.1)}"
  -- (g) the complete premise list, with the goal-gap classifier's verdicts (LOGGED, not asserted:
  -- MachineClosesAt is a premise of this endpoint)
  let (lines, bad) ← Tests.Compiler.NoPortsTest.premiseLines openN
  Lean.logInfo m!"{String.intercalate "\n" lines.toList}"
  Lean.logInfo m!"NOPORTS MEM AUDIT {f}: {openN} on standard axioms, with the general theorems of Tools.ShippingMemKid (the core_* chain over Kid, KidFactsM, memKid_facts, kidsM_*), Tools.ShippingLeafKidFacts.leafKid_facts and the hand lemmas seqMem_kids, seqMem_runFacts, seqMem_outsG0, seqMem_mixedG, seqMem_designP0. The endpoint's statement mentions none of portsMatchB, kidsPass, designCheck, shipsHierCheck, outsCheck, kidsMaskedN, hierCheck, kidsMixed, kidsMem, kidsMasked, while {old} mentions shipsHierCheck, kidsMixed, designCheck and outsCheck. Proposition binders: the SAME {bNew.size} as {old}'s (the run, MachineDefines {f}, MachineClosesAt {f}) — MachineClosesAt is STILL A PREMISE, no closed form exists. Under the existentials: 1 antecedent (the boundary: ChildBnd and the reflection of {c}; printed the same as an antecedent of {old}: {same}), against {innerOld.size} in {old}. The goal-gap classifier lists {bad.size} premise(s) NOT ALLOWED (logged above; not asserted). SCOPE: one declaration, a parent WITH a register under the general closing, a leaf register machine child and one combinational-read memory (aw 4, dw 8), depth 0; data conditions decided per declaration (conditions, not reductions); compiler guards with fallback; DesignSV of the module list — not the SV string, not #sim. NOT covered: the closing, memCounter / twoMems / mixedMems / memWide / syncNarrow, a generator, depth ≥ 1 with a memory child."
