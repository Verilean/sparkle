noncomputable def outsOf (c : Lean.Name) : List Sparkle.IR.Machine.OutField :=
  if c = ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt then
    (Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt.machineData).shape.layout.outs
  else memOuts 8

/-- The callee's argument widths, keyed by the callee. -/
noncomputable def insOf (c : Lean.Name) : List Nat :=
  if c = ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt then
    Tools.ShippingPortWidthsPure.declWidths
      Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt.machineData
  else memIns 4 8

theorem outsOf_cnt : outsOf ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt =
    (Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt.machineData).shape.layout.outs := by
