import Tests.Compiler.SeqDeepGenTest
import Tests.Compiler.ShippingChildBoundaryTest
-- UNBUILT (unit SR3t): written, not yet built.
-- SCOPE (binding): a SECOND depth-2 instance in the class of `Tools/ShippingSeqParentGenD2.lean`, with a DIFFERENT call structure and
-- argument layout from `grand -> mid -> cnt`: `topw -> wrap -> acc`.
--   * the root `topw` has THREE own inputs and ONE call instance (it reads only `.odd` of the call `wrap v w`), the call's arguments are the
--     inputs 1 and 2 (not 0); `grand` has one input and two instances;
--   * the child `wrap` has two inputs and TWO instances of the leaf `acc` (both fields of ONE call, `acc y`: the second input);
--   * the leaf `acc` has an 8-bit argument (declared width `[8]`), not the 1-bit `en` of `cnt`.
-- Generated by `#machine_seq_parent_endpoint topw`; the call structure root -> child -> leaf is ASSERTED (kernel-checked equations and the
-- generator's own audit of `MachineDefines` for exactly {wrap, acc}).  Two declarations OUTSIDE the class are REFUSED with the expected reason
-- (asserted): `topbad` (calls two DIFFERENT children, `wrap` and `cnt`), `topargs` (two DIFFERENT argument lists of the same child).
-- Not a general theorem; boundary premises stay inside `topw.epD2_Bnd`.
namespace Tests.Compiler.SeqDeepGenInstTest
open Sparkle.Core.Domain Sparkle.Core.Signal
open Sparkle.Tests.Compiler.ShippingMachineSeqTest
open Sparkle.Tests.Compiler.ShippingChildBoundaryTest

/-- A child with two inputs whose call to the leaf `acc` reads the second one, and both fields of the call. -/
@[hardware_module] def wrap {dom : DomainConfig} (x y : Signal dom (BitVec 8)) : AccOut dom :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal dom (BitVec 8))
    let a := acc y
    r <~ a.s + x
    return ({ s := rs, odd := a.odd } : AccOut dom)

/-- A root with three inputs and ONE call instance (only `.odd`), the call's arguments the inputs 1 and 2. -/
def topw (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    r <~ Signal.mux (m.odd &&& en) (rs + v) rs
    return rs

#machine_endpoint topw

/-- OUTSIDE the class: two DIFFERENT children (`wrap` and `cnt`). -/
def topbad (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let k := cnt en
    r <~ Signal.mux (m.odd &&& k.hit) (rs + v) rs
    return rs

#machine_endpoint topbad

/-- OUTSIDE the class: the same child called with two DIFFERENT argument lists. -/
def topargs (en : Signal defaultDomain Bool) (v w : Signal defaultDomain (BitVec 8)) : Signal defaultDomain (BitVec 8) :=
  circuit do
    let r ← Signal.reg 0#8
    let rs := (r : Signal defaultDomain (BitVec 8))
    let m := wrap v w
    let m2 := wrap w v
    r <~ Signal.mux (m.odd &&& m2.odd &&& en) (rs + v) rs
    return rs

#machine_endpoint topargs

set_option maxHeartbeats 0 in
#machine_design_svNR Tests.Compiler.SeqDeepGenInstTest.topw 2

set_option maxHeartbeats 0 in
#machine_seq_parent_endpoint Tests.Compiler.SeqDeepGenInstTest.topw

-- root -> child -> leaf, KERNEL-checked
theorem topw_callees : topw.machineData.shape.insts.map (·.1) = [``wrap] := by decide
theorem wrap_callees : wrap.machineData.shape.insts.map (·.1) = [``acc, ``acc] := by decide
theorem acc_callees : acc.machineData.shape.insts.map (·.1) = [] := by decide
-- the argument layout differs from `grand`'s: the call of `topw` reads the inputs 1 and 2
theorem topw_args : topw.machineData.shape.insts.map (·.2.1) = [[1, 2]] := by decide

#print axioms Tests.Compiler.SeqDeepGenInstTest.topw.epD2_endpoint

open Lean Meta Elab Command in
run_cmd liftTermElabM do
  let ep := ``Tests.Compiler.SeqDeepGenInstTest.topw.epD2_endpoint
  let ty := (← getConstInfo ep).type
  -- the boundary of the generated endpoint asks MachineDefines for exactly {wrap, acc}
  let bnd := (← getConstInfo ``Tests.Compiler.SeqDeepGenInstTest.topw.epD2_Bnd).value!
  let mut defs : Array Name := #[]
  let mut todo : Array Expr := #[bnd]
  while !todo.isEmpty do
    let e := todo.back!
    todo := todo.pop
    if e.getAppFn.isConstOf ``Tools.ShippingMachineEntry.MachineDefines && e.getAppNumArgs == 6 then
      defs := defs.push (← Tools.ShippingSeqParentGen.readName e.getAppArgs[4]!)
    match e with
    | .app f a => todo := todo.push f |>.push a
    | .lam _ t b _ | .forallE _ t b _ => todo := todo.push t |>.push b
    | .mdata _ b => todo := todo.push b
    | _ => pure ()
  unless defs.toList.mergeSort (·.toString ≤ ·.toString) == [``Tests.Compiler.SeqDeepGenInstTest.wrap, ``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.acc].mergeSort (·.toString ≤ ·.toString) do
    throwError "SR3t AUDIT FAILED: topw.epD2_Bnd asks MachineDefines for {defs}, expected wrap and acc"
  -- the endpoint mentions the ROOT's data (topw), the child's (wrap) and the leaf's (acc) in its generated closure, and not grand/mid/cnt
  let cl ← Tests.Compiler.ChildVertAuditTest.depClosure ep
  for must in [``Tests.Compiler.SeqDeepGenInstTest.wrap.machineData, ``Sparkle.Tests.Compiler.ShippingChildBoundaryTest.acc.machineData,
      ``Tests.Compiler.SeqDeepGenInstTest.topw.machineData] do
    unless cl.contains must do throwError "SR3t AUDIT FAILED: {must} not in the closure of {ep}"
  for mustNot in [``Sparkle.Tests.Compiler.ShippingMachineSeqTest.grand.machineData, ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.mid.machineData,
      ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.cnt.machineData, ``Sparkle.Tests.Compiler.ShippingMachineSeqTest.grand.epD2_endpoint] do
    if cl.contains mustNot then throwError "SR3t AUDIT FAILED: {mustNot} is in the closure of {ep} (the generated endpoint of topw must not depend on the first instance)"
  let _ := ty
  logInfo m!"SR3t: topw -> wrap -> acc generated; MachineDefines exactly {defs}; its closure has the data of topw/wrap/acc and none of grand/mid/cnt"

-- the refusals, with the expected reasons
open Lean Meta Elab Command in
def refusedWith (decl : Name) (needles : List String) : CommandElabM Unit := do
  let saved := (← get).messages
  elabCommand (← `(command| #machine_seq_parent_endpoint $(mkIdent decl)))
  let ms := (← get).messages
  let errs ← ms.toList.filterM fun m => pure (m.severity == .error)
  let txts ← errs.mapM fun m => m.data.toString
  modify fun s => { s with messages := saved }
  unless txts.length == 1 do throwError "SR3t AUDIT FAILED: expected exactly one refusal for {decl}, got {txts}"
  for n in needles do
    unless (txts.head!.splitOn n).length > 1 do throwError "SR3t AUDIT FAILED: the refusal of {decl} does not mention `{n}`: {txts.head!}"
  unless !(← getEnv).contains (decl ++ `epD2_endpoint) do throwError "SR3t AUDIT FAILED: {decl}.epD2_endpoint exists although refused"
  unless !(← getEnv).contains (decl ++ `epA_endpoint) do throwError "SR3t AUDIT FAILED: {decl}.epA_endpoint exists although refused"
  logInfo m!"SR3t: {decl} REFUSED as expected: {txts.head!.take 260}…"

open Lean Meta Elab Command in
run_cmd do
  refusedWith ``Tests.Compiler.SeqDeepGenInstTest.topbad ["REFUSED", "DIFFERENT children", "Tests.Compiler.SeqDeepGenInstTest.wrap", "cnt"]
  refusedWith ``Tests.Compiler.SeqDeepGenInstTest.topargs ["REFUSED", "DIFFERENT argument lists"]

end Tests.Compiler.SeqDeepGenInstTest
