import Tests.Compiler.ShippingCallsCloseTest
import Tools.ShippingCallsGatePinned
-- BUILT (unit CT): ct3 exit 0 (ct1, ct2 exit 1: explicit O argument, qualified names, audit name test). Standard axioms.

/-! # `MachineClosesAtA` of `callerTwice` and `callerRep` on the new boundary (unit CT)

The old boundary has `callerTwice.machine_closes_at` and `callerRep.machine_closes_at`
(`#machine_closes_at`, generated by `Tools/ShippingMachineClosesAtGen.lean` from
`machineClosesAt_of_gateKids`). Here the same decided data and name conditions are fed to
`Tools.ShippingCallsGatePinned.machineClosesAtA_of_gateKids'` (no `hnodup`).

* `callerRep`: TWO instances of `pick` (`insts.map (·.1) = [pick, pick]`): a REPEATED callee.
* `callerTwice`: two identical source calls, ONE instance after deduplication — not a repeated
  callee on the instance list (checked below); proved for completeness.

PREMISES: `O`, `hA`, `T` (`RefLawsATele`, a separate assumption family), and the reflection of `pick`
(`EntryDefines`, as in the old theorems). PROVED: the rest, by `decide` on the reader's data and by
`names_inj` / `parent_ne`. `ChildrenRealA` is a history; not a runtime-fit proof. -/

namespace Tests.Compiler.CallerTwiceATest
open Tools.ShippingChildFresh Tools.ShippingChildInvA Tools.ShippingChildRunAKids
open Sparkle.Tests.Compiler.ShippingMachineInstTest

variable {mctx : Lean.Meta.Context} {mref : ST.Ref IO.RealWorld Lean.Meta.State}
  {cctx : Lean.Core.Context} {cref : ST.Ref IO.RealWorld Lean.Core.State}

theorem callerRep_closesA (O : RefLawsAOps MkRefd mref cref)
    (T : RefLawsATele O.quiet mref cref) (hA : AdmCtx O.quiet mctx cctx)
    (hR0 : Tools.ShippingInlineSoundness.EntryDefines mctx mref cctx cref ``pick pick.gateValue) :
    MachineClosesAtA (mref := mref) (cref := cref) O mctx cctx ``callerRep
      (callerRep.machineData).shape :=
  Tools.ShippingCallsGatePinned.machineClosesAtA_of_gateKids' (nDecl := 1) O T hA
    callerRep.machineData callerRep.machine_ok callerRep.machine_body (by decide) (by decide)
    (fun k => List.getD [(pick.gateBinders.filter fun x => x.2 != .domain).length,
      (pick.gateBinders.filter fun x => x.2 != .domain).length] k 0)
    (by decide)
    (by
      intro k hk y hy
      have hk' : k < 2 := hk
      match k, hk' with
      | 0, _ | 1, _ =>
        exact Tools.ShippingCallsGate.ChildFull.iface
          (Tools.ShippingCallsGateA.childFull_of_realA O hR0 pick.gate_old pick.gate_peel
            pick.gate_wf (Tools.ShippingGateChild.bool_positions (by decide))
            (Tools.ShippingGateChild.bits_positions (by decide)) hy))
    (by decide) (Tools.ShippingNameDischarge.names_inj _)
    (Tools.ShippingNameDischarge.parent_ne _ _ (by decide))
    (fun k _ o ho => Tools.ShippingCallsGate.instName_ne_of_head
      ((by decide : ∀ o ∈ (callerRep.machineData).shape.layout.outs,
        o.name.toList.head? ≠ some 'i') o ho) k _)

theorem callerTwice_closesA (O : RefLawsAOps MkRefd mref cref)
    (T : RefLawsATele O.quiet mref cref) (hA : AdmCtx O.quiet mctx cctx)
    (hR0 : Tools.ShippingInlineSoundness.EntryDefines mctx mref cctx cref ``pick pick.gateValue) :
    MachineClosesAtA (mref := mref) (cref := cref) O mctx cctx ``callerTwice
      (callerTwice.machineData).shape :=
  Tools.ShippingCallsGatePinned.machineClosesAtA_of_gateKids' (nDecl := 1) O T hA
    callerTwice.machineData callerTwice.machine_ok callerTwice.machine_body (by decide)
    (by decide)
    (fun k => List.getD [(pick.gateBinders.filter fun x => x.2 != .domain).length] k 0)
    (by decide)
    (by
      intro k hk y hy
      have hk' : k < 1 := hk
      match k, hk' with
      | 0, _ =>
        exact Tools.ShippingCallsGate.ChildFull.iface
          (Tools.ShippingCallsGateA.childFull_of_realA O hR0 pick.gate_old pick.gate_peel
            pick.gate_wf (Tools.ShippingGateChild.bool_positions (by decide))
            (Tools.ShippingGateChild.bits_positions (by decide)) hy))
    (by decide) (Tools.ShippingNameDischarge.names_inj _)
    (Tools.ShippingNameDischarge.parent_ne _ _ (by decide))
    (fun k _ o ho => Tools.ShippingCallsGate.instName_ne_of_head
      ((by decide : ∀ o ∈ (callerTwice.machineData).shape.layout.outs,
        o.name.toList.head? ≠ some 'i') o ho) k _)

end Tests.Compiler.CallerTwiceATest

#print axioms Tests.Compiler.CallerTwiceATest.callerRep_closesA
#print axioms Tests.Compiler.CallerTwiceATest.callerTwice_closesA

open Lean Meta Elab in
/-- Constants (definitions included, transitively) reached by a constant's type and value. -/
partial def Tests.Compiler.CallerTwiceATest.reachC (env : Environment) (todo : List Name)
    (seen : NameSet) : NameSet :=
  match todo with
  | [] => seen
  | n :: rest =>
    if seen.contains n then reachC env rest seen
    else
      let seen := seen.insert n
      match env.find? n with
      | some ci =>
        let v := match ci with
          | .defnInfo d => d.value.getUsedConstants.toList
          | .thmInfo t => t.value.getUsedConstants.toList     -- theorem bodies (the roots are theorems)
          | .opaqueInfo o => o.value.getUsedConstants.toList  -- opaque bodies
          | _ => []
        reachC env (ci.type.getUsedConstants.toList ++ v ++ rest) seen
      | none => reachC env rest seen

open Lean Meta Elab in
run_cmd Lean.Elab.Command.liftTermElabM do
  let env ← getEnv
  for (c, thm, old) in [(``callerRep, ``Tests.Compiler.CallerTwiceATest.callerRep_closesA,
        ``callerRep.machine_closes_at),
      (``Sparkle.Tests.Compiler.ShippingMachineInstTest.callerTwice, ``Tests.Compiler.CallerTwiceATest.callerTwice_closesA,
        ``Sparkle.Tests.Compiler.ShippingMachineInstTest.callerTwice.machine_closes_at)] do
    -- the instance lists
    let r ← Tools.ShippingMachineCommand.readMachine c
    let insts := r.shape.insts.map (·.1)
    if c == ``callerRep && insts != [``Sparkle.Tests.Compiler.ShippingMachineInstTest.pick, ``Sparkle.Tests.Compiler.ShippingMachineInstTest.pick] then
      throwError "callerRep insts: {insts}"
    if c == ``Sparkle.Tests.Compiler.ShippingMachineInstTest.callerTwice && insts != [``Sparkle.Tests.Compiler.ShippingMachineInstTest.pick] then
      throwError "callerTwice insts: {insts}"
    -- the new theorem: standard axioms; its closure has none of the old boundary
    for ax in ← Lean.collectAxioms thm do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "{thm}: non-standard axiom {ax}"
    let seen := Tests.Compiler.CallerTwiceATest.reachC env [thm] {}
    for bad in [``Tools.ShippingChildInv.RefLaws, ``Tools.ShippingChildBndCore.RefLawsCore,
        ``Tools.ShippingChildInv.MachineClosesAt] do
      if seen.contains bad then throwError "{thm} reaches {bad}"
    for n in seen.toList do
      let l := (n.components.getLast?.map (·.toString)).getD ""
      if l == "toAOps" || l == "toA" || l == "ChildBnd" || l == "StartV" then
        throwError "{thm} reaches {n}"
    -- old/new: SYNTACTIC comparison of the conclusion's last two arguments (declName, shape) only;
    -- NOT a defeq check of the whole conclusion (the old and new boundary predicates differ)
    let tn ← forallTelescope (← getConstInfo thm).type fun _ b => pure b
    let to ← forallTelescope (← getConstInfo old).type fun _ b => pure b
    let an := tn.getAppArgs
    let ao := to.getAppArgs
    unless an.back! == ao.back! && an[an.size - 2]! == ao[ao.size - 2]! do
      throwError "{thm}: declName/shape differ from {old}: {an.back!} vs {ao.back!}"
  Lean.logInfo m!"CT: callerRep (pick, pick; repeated callee) and callerTwice (one instance) have MachineClosesAtA via machineClosesAtA_of_gateKids' (no hnodup); standard axioms; closure free of RefLaws/RefLawsCore/MachineClosesAt/toAOps/ChildBnd/StartV; the conclusion's last two arguments (declName, shape) are syntactically those of the old machine_closes_at (argument comparison only, not conclusion defeq: MachineClosesAtA vs MachineClosesAt differ). Premises: O, hA, T, EntryDefines pick. Not a runtime-fit proof."
