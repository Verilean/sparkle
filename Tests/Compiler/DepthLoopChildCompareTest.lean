import Lean.Elab.Command
import Tools.ShippingMachineDepthCommand
import Tests.Compiler.NoPortsLoopParentTest

/-! # The generator's `Signal.loop` branch against the hand-written theorem (round par/b-23)

WRITTEN, NOT BUILT. TARGET-ONLY for now; it adds NO constant (the
environment is put back), so it clashes with nothing and could go into
`Tests/AllTests.lean`.

`Tests/Compiler/NoPortsLoopParentTest.lean` (built, in `AllTests`) adds
`toggleL.seq_child_runN` by hand (`seqChildRunNOfLoop`: `seqChildRunN_full`
at `machine_traceL_of_loop`, eight decided conditions). Round par/b-23 gives
`generateSeqChildN` (`Tools/ShippingMachineDepthCommand.lean`) the same
branch. Here, WITH the hand-written constant in the environment:

1. `compareSeqChildN toggleL` — the generator's compare path: it rebuilds
   the proof by `seqChildNProof` (the generator's own code) and requires
   its type `isDefEq` the hand-written statement. THROWS otherwise.
2. the rebuilt proof is added as `toggleL.seq_child_runN_regen` through the
   generators' `addTheorem` (kernel check, standard axioms), its statement
   being the HAND-written one — so the kernel, not only `Meta.isDefEq`,
   accepts the generator's proof at the hand statement. Then the
   environment is put back: no constant is kept.
3. `generateSeqChildN toggleL` returns the existing name and adds nothing
   (why `NoPortsLoopParentTest` keeps working whether or not the generator
   has the branch).

LOGGED: whether the two statements are the same term, and the fingerprint
(`Expr.hash` of the type, number of leading binders) of the hand-written
statement — to be read against the line `DEPTH LOOP CHILD: …` of
`Tests/Compiler/DepthLoopChildTest.lean`, where the same constant is
generated by the command without the hand-written one.

SCOPE: one child, `toggleL`. Nothing about `machine_trace_of_regs`.
-/

namespace Tests.Compiler.DepthLoopChildCompareTest

/-- The number of leading binders of a statement. -/
partial def binderCount : Lean.Expr → Nat
  | Lean.Expr.forallE _ _ b _ => binderCount b + 1
  | Lean.Expr.mdata _ e => binderCount e
  | _ => 0

end Tests.Compiler.DepthLoopChildCompareTest

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
run_cmd Lean.Elab.Command.liftTermElabM do
  let c := ``Sparkle.Tests.Compiler.ShippingMachineSeqLoopTest.toggleL
  let name := c ++ `seq_child_runN
  let regen := c ++ `seq_child_runN_regen
  let env0 ← Lean.getEnv
  let handTy ← match env0.find? name with
    | some (Lean.ConstantInfo.thmInfo ti) => pure ti.type
    | _ => throwError "{name}: not a theorem of the imports (NoPortsLoopParentTest adds it by hand)"
  if env0.contains regen then throwError "{regen}: exists already"
  -- 1. the compare path
  let (p, same) ← Tools.ShippingMachineDepthCommand.compareSeqChildN c
  -- 2. the generator's proof at the HAND-written statement, by the kernel
  Lean.withOptions (fun o => Lean.Elab.async.set o false) <|
    Tools.ShippingMachineLinkedCommand.addTheorem regen handTy p
  Lean.setEnv env0
  -- 3. the generator returns the existing constant
  let got ← Tools.ShippingMachineDepthCommand.generateSeqChildN c
  unless got == name do throwError "generateSeqChildN returned {got}, expected {name}"
  let env1 ← Lean.getEnv
  if env1.contains regen then throwError "{regen}: still in the environment"
  match env1.find? name with
  | some (Lean.ConstantInfo.thmInfo ti) =>
    unless ti.type == handTy do throwError "{name}: its statement changed"
  | _ => throwError "{name}: no longer a theorem"
  Lean.logInfo m!"DEPTH LOOP CHILD COMPARE: {name} — the statement generateSeqChildN builds (seqChildNProof: seqChildRunN_full at the wired twin of the machine_trace_of_loop endpoint) isDefEq the hand-written one of NoPortsLoopParentTest (the same term: {same}); the generator's proof was accepted by the kernel AT the hand-written statement, standard axioms (as {regen}, then removed: no constant is kept); generateSeqChildN returns the existing constant. Hand-written statement: hash {handTy.hash.toNat}, {Tests.Compiler.DepthLoopChildCompareTest.binderCount handTy} binders"
