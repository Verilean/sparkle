/-- the projection to the OLD `R4Run` (e7181279) is a theorem, checked by Lean (not a defeq). -/
theorem r4RunInv_to_R4Run {ι : Type} {dom : ι → Sparkle.Core.Domain.DomainConfig}
    {mref : ST.Ref IO.RealWorld Meta.State} {cref : ST.Ref IO.RealWorld Core.State}
    (L : Laws mref cref) (P : Pkgs ι dom) (Reach : Name → Prop)
    (mctx : Meta.Context) (cctx : Core.Context) (D : Nat)
    (declName : Name) (shape : MachineShape) (m : Sparkle.IR.AST.Module) (d : Sparkle.IR.AST.Design)
    (w w' : Void IO.RealWorld)
    (h : R4RunInv L P Reach mctx cctx D declName shape m d w w') :
    R4Run L.O mctx cctx D declName shape m d w w' := by
  obtain ⟨tenv, pb, ci, envR', w₁, w₂, w₃, w₄, w₅, w₆, _, _, h⟩ := h
  exact ⟨tenv, pb, ci, envR', w₁, w₂, w₃, w₄, w₅, w₆, h⟩

/-- the combined extraction, projected: `A4MachineSideA ∨ R4Run` (the shape of `a4_machine_or_R4Run`), same hypotheses
as `a4_inv_machine_or_R4RunInv`. -/
theorem a4_inv_projects_to_a4_machine_or_R4Run {ι : Type} {dom : ι → Sparkle.Core.Domain.DomainConfig}
    {mref : ST.Ref IO.RealWorld Meta.State} {cref : ST.Ref IO.RealWorld Core.State}
    (L : Laws mref cref) (P : Pkgs ι dom) (Reach : Name → Prop)
    {mctx : Meta.Context} {cctx : Core.Context} (hA : AdmCtx L.O.quiet mctx cctx)
    {declName : Name} {shape : MachineShape} {D : Nat}
    {w w' : Void IO.RealWorld} {m : Sparkle.IR.AST.Module} {d : Sparkle.IR.AST.Design}
    (hI : InvAt L P Reach D w) (hC : ChildKeepsInv L P Reach (D + 1))
    (hr : RunsTo (synthesizeCombinationalCore declName [] false) mctx mref cctx cref w (m, d) w')
    (entry : MachineDefines mctx mref cctx cref declName shape) :
    A4MachineSideA L.O mctx cctx D declName shape m d w w' ∨ R4Run L.O mctx cctx D declName shape m d w w' :=
  (a4_inv_machine_or_R4RunInv L P Reach hA hI hC hr entry).imp id
    (r4RunInv_to_R4Run L P Reach mctx cctx D declName shape m d w w')

