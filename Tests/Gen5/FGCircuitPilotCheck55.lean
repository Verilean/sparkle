/-! ## (F) the corrected definitions do not DIRECTLY reference the listed programs, Laws, CellPrem or the old `Rel` (direct-reference check; not a closure audit) -/
run_cmd liftTermElabM do
  let env ← getEnv
  let hyps : List Name := [`Tools.ShippingFGCircuitS3oFix.RelE, `Tools.ShippingFGCircuitS3oFix.CorrE, `Tools.ShippingFGCircuitS3oFix.GetCorrE, `Tools.ShippingFGCircuitS3oFix.SetCorrE, `Tools.ShippingFGCircuitS3oFix.StderrCorrE, `Tools.ShippingFGCircuitS3oFix.EnvCorrE, `Tools.ShippingFGCircuitS3oFix.InitCorrE, `Tools.ShippingFGCircuitS3oFix.quietRE, `Tools.ShippingFGCircuitS3oFix.GCorr]
  let forbidden : List Name := [`Tools.ShippingFGCircuitS3oFix.realProg, `Tools.ShippingFGCircuitS3oFix.modelProg, `Tools.ShippingFGCircuitS3oFix.realEnvProg, `Tools.ShippingFGCircuitS3oFix.modelEnvProg, `Tools.ShippingFGCircuitS3n.prog, `Tools.ShippingFGCircuitS3jStart.pilotEntry3,
    `Tools.ShippingGen2.Laws, `Tools.ShippingGen5EnvFrame3.CellPrem, `Tools.ShippingFGCircuitS3f2Final.rootDefB_sound, `Tools.ShippingFGCircuitS3nBridge.Rel, `Tools.ShippingFGCircuitS3nBridge.Corr, `Tools.ShippingFGCircuitS3nBridge.EnvCorr, `Tools.ShippingFGCircuitS3nBridge.quietR, `Tools.ShippingFGCircuitS3nBridge.InitCorr]
  for n in hyps do
    let some ci := env.find? n | throwError "FGCIRCUIT55 HYPS: {n} missing"
    let used := ci.type.getUsedConstants ++ (match ci with | .defnInfo v => v.value.getUsedConstants | _ => #[])
    for f in forbidden do
      if used.contains f then throwError "FGCIRCUIT55 HYPS: {n} mentions {f}"
    unless ci.isDefinition do throwError "FGCIRCUIT55 HYPS: {n} is not a definition (a Prop, not an axiom)"
  -- Reachability of `RelE` through definition bodies, DEPTH-BOUNDED (6 definitions).  `found` = a path to `RelE` of length <= 6 was found.
  -- `cut` = some definition body was NOT explored because the depth bound ran out; then `found = false` only means "not found within depth 6", NOT "unreachable".
  let reach (n : Name) : Bool × Bool :=
    let rec go (fuel : Nat) (n : Name) : Bool × Bool :=
      match fuel with
      | 0 => (false, match env.find? n with | some (.defnInfo _) => true | _ => false)
      | f + 1 =>
        match env.find? n with
        | some (.defnInfo v) =>
          v.value.getUsedConstants.foldl (fun (acc : Bool × Bool) c =>
            if c == `Tools.ShippingFGCircuitS3oFix.RelE then (true, acc.2)
            else let r := go f c; (acc.1 || r.1, acc.2 || r.2)) (false, false)
        | _ => (false, false)
    go 6 n
  -- positive claim (must hold, else this check FAILS): EnvCorrE reaches RelE within depth 6
  let (foundE, _) := reach `Tools.ShippingFGCircuitS3oFix.EnvCorrE
  unless foundE do throwError "FGCIRCUIT55 HYPS: EnvCorrE does not reach RelE within depth 6"
  -- the old EnvCorr: reaching RelE within depth 6 would be an error; NOT finding it is reported with its search status, never as a proof of non-reachability
  let (foundO, cutO) := reach `Tools.ShippingFGCircuitS3nBridge.EnvCorr
  if foundO then throwError "FGCIRCUIT55 HYPS: the old EnvCorr reaches RelE"
  logInfo m!"FGCIRCUIT55 HYPS: {hyps.length} corrected definitions (RelE, CorrE, GetCorrE, SetCorrE, StderrCorrE, EnvCorrE, InitCorrE, quietRE, GCorr) are plain definitions (no axiom); a DIRECT-REFERENCE check (the constants of each definition's type and value; NOT a closure audit, it does not recognize an arbitrary v11 conclusion): none directly references the {forbidden.length} listed forbidden constants (the programs realProg/modelProg/realEnvProg/modelEnvProg/prog, pilotEntry3, Laws, CellPrem, rootDefB_sound, the old Rel/Corr/EnvCorr/quietR/InitCorr); within a depth-6 search EnvCorrE reaches RelE (the oracle); within the same depth-6 search the old EnvCorr was NOT found to reach RelE (search cut by the depth bound: {cutO}; this is not a proof of non-reachability)"

/-! ## (G) AXIOMS -/
run_cmd liftTermElabM do
  let env ← getEnv
  let names : List Name := [`Tools.ShippingFGCircuitS3oFix.envCorr_inconsistent_of_run, `Tools.ShippingFGCircuitS3oFix.envCorr_inconsistent, `Tools.ShippingFGCircuitS3oFix.oldInit_any_world, `Tools.ShippingFGCircuitS3oFix.oldQuietR_eq_true, `Tools.ShippingFGCircuitS3oFix.corrE_bind, `Tools.ShippingFGCircuitS3oFix.bridge_smallE, `Tools.ShippingFGCircuitS3oFix.envCorrE_returns, `Tools.ShippingFGCircuitS3oFix.bridge_env_twice, `Tools.ShippingFGCircuitS3oFix.real_env_twice, `Tools.ShippingFGCircuitS3oFix.relE_not_both, `Tools.ShippingFGCircuitS3oFix.envCorrE_observation_committed, `Tools.ShippingFGCircuitS3oFix.initCorrE_iff, `Tools.ShippingFGCircuitS3oFix.quietRE_world_independent, `Tools.ShippingFGCircuitS3oFix.quietRE_oracle_nonconst, `Tools.ShippingFGCircuitS3oFix.Toy.simultaneous_sat, `Tools.ShippingFGCircuitS3oFix.runsTo_getEnv, `Tools.ShippingFGCircuitS3oFix.rel_heapOf, `Tools.ShippingFGCircuitS3oFix.gcorr_pure, `Tools.ShippingFGCircuitS3oFix.gcorr_bind, `Tools.ShippingFGCircuitS3oFix.corrE_eq_gcorr, `Tools.ShippingFGCircuitS3oFix.runsTo_pure, `Tools.ShippingFGCircuitS3oFix.corrE_pure, `Tools.ShippingFGCircuitS3oFix.getCorrE_of_readWorld, `Tools.ShippingFGCircuitS3oFix.getCorrE_depth, `Tools.ShippingFGCircuitS3oFix.setCorrE_depth, `Tools.ShippingFGCircuitS3oFix.modelProg_specE, `Tools.ShippingFGCircuitS3oFix.real_small_consequenceE, `Tools.ShippingFGCircuitS3oFix.relE_env_unique, `Tools.ShippingFGCircuitS3oFix.stderrKeeps_of_corrE, `Tools.ShippingFGCircuitS3oFix.quietRE_iff, `Tools.ShippingFGCircuitS3oFix.getEnv_eq_lookup, `Tools.ShippingFGCircuitS3oFix.Toy.gc_get, `Tools.ShippingFGCircuitS3oFix.Toy.gc_set, `Tools.ShippingFGCircuitS3oFix.Toy.gc_stderr, `Tools.ShippingFGCircuitS3oFix.Toy.gc_env, `Tools.ShippingFGCircuitS3oFix.Toy.gc_prog]
  for n in names do
    unless env.contains n do throwError "{n} does not exist"
  let mut axs : NameSet := {}
  for nm in names do
    for ax in ← Lean.collectAxioms nm do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do throwError "{nm} uses {ax}"
      axs := axs.insert ax
  logInfo m!"FGCIRCUIT55 AXIOMS: {names.length} names, standard axioms only ({axs.toList}); no sorryAx, no native_decide"

end Tests.Gen5.FGCircuitPilotCheck55
