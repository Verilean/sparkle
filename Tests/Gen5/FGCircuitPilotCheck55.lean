example (E : List (String × String)) (h : Tools.ShippingHeapModel.Heap Tools.ShippingFGCircuitS3nBridge.realSig) (w : Void IO.RealWorld) :
    Tools.ShippingFGCircuitS3oFix.RelE E h w ↔ (Tools.ShippingChildBndCore.cv w = h.cache ∧ Tools.ShippingChildBndCore.sv w = h.synth ∧ Tools.ShippingChildBndCore.dv w = h.depth ∧ h.reg.env = E) := Iff.rfl

example (E : List (String × String)) (k : String) : Tools.ShippingFGCircuitS3oFix.lookupEnv E k = (E.find? (fun p => p.1 == k)).map (fun p => p.2) := rfl

