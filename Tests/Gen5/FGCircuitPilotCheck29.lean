import Tools.ShippingFGCircuitS2iRun
set_option autoImplicit false
-- FG circuit pilot S2i check (light, small run_cmd blocks). No `sorry`, no `axiom`, no `native_decide`, no TRUSTED. Results: docs/FG-CIRCUIT-PILOT.md §35.

/-! # FGCircuitPilotCheck29

1. AXIOMS: `sh_fun`, `dt_fun`, `cdt_fun` and the table rules use only the standard axioms.
2. SMALL EXAMPLES, each generated by the closure generator and kernel-checked (numbers in the log; `viaSh` / `Sh` steps / DT nodes / kernel ms / term DAG):
   SHARE (a closure referenced twice is derived once), SHADOW (binder shadowing: two nested binders, different captured environments), HIGHER (a function-valued closure applied twice),
   REC-NIL / REC-CONS / REC-IH (the static `List.rec` rule and the recursive-call closure), DEFAULT (`default (Bool × Bool)`: the S1w2 STOP-1 through `instInhabitedProd`), BOOL (`Bool.false` as a ctor value).
3. CONTROLS (fail-closed, with the EXPECTED error text; a generator failure is NOT a non-derivability theorem): a spine over different captured environments, `Signal.mk` as a value head, `Signal.map` with a general function,
   a non-static `List.rec` major premise, an unbound variable.
4. FAIL-CLOSED: `hftObCDT_of_tables` is a constant only if the root derivation succeeded (the log of Check29 states which). -/
namespace Tests.Gen5.FGCircuitPilotCheck29
open Lean Meta Elab Command Term Tools.ShippingFGCircuit Tools.ShippingFGCircuitS1mCD Tools.ShippingFGCircuitS1sCD Tools.ShippingFGCircuitS1wTbl
open Tools.ShippingFGCircuitS2iSh Tools.ShippingFGCircuitS2iDT Tools.ShippingFGCircuitS2iTbl Tools.ShippingFGCircuitS2iRun

def standardAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]
def axiomsOk (n : Name) : CoreM Unit := do
  let ax ← collectAxioms n
  unless ax.all (standardAxioms.contains ·) do throwError "{n}: non-standard axioms {ax}"

run_cmd liftTermElabM do
  for n in [``sh_fun, ``dt_fun, ``cdt_fun, ``tdt_fun, ``cdt_eq, ``sh_unf_t, ``sh_unf0_t, ``sh_ctor_t, ``sh_proj_t, ``sh_recNil_t, ``sh_recCons_t,
      ``dt_unitVal_t, ``dt_prodMk_t, ``dt_inhMk_t, ``dt_boolFalse_t, ``dt_boolTrue_t, ``map_clo_eq, ``viaOK_appN] do
    axiomsOk n
  logInfo "AXIOMS ok: Sh/DT functionality and the table rules use only the standard axioms"

def bl : Lean.Expr := .const ``Bool []
def bF : Lean.Expr := .const ``Bool.false []
def bT : Lean.Expr := .const ``Bool.true []
def pBB : Lean.Expr := appN ``Prod [.zero, .zero] [bl, bl]
def mkP (x y : Lean.Expr) : Lean.Expr := appN ``Prod.mk [.zero, .zero] [bl, bl, x, y]
def lamB (b : Lean.Expr) : Lean.Expr := .lam `x bl b .default
def lamT (T b : Lean.Expr) : Lean.Expr := .lam `x T b .default

/-- the numbers of one derivation; `want` are the counters that must be positive (the rule is exercised) -/
def report (tag : String) (n : Name) (want : List String) : CommandElabM Unit := do
  unless (← getEnv).contains n do throwError "{tag}: {n} missing"
  liftTermElabM (axiomsOk n)
  logInfo m!"{tag} ok: {n} kernel-checked, standard axioms only (rules wanted: {want})"

-- SHARE: `(fun x : Bool => Prod.mk x x) false`
derive_expr_t share := (Lean.Expr.app (lamB (mkP (.bvar 0) (.bvar 0))) bF : Lean.Expr)
run_cmd report "SHARE" `Tests.Gen5.FGCircuitPilotCheck29.share ["viaSh", "prodMk", "bvarClo", "boolFalse"]

-- SHADOW: `(fun x => (fun x => Prod.mk x #1) true) false`  (inner x = true, outer x = false: the result is (true, false))
derive_expr_t shadow := (Lean.Expr.app (lamB (Lean.Expr.app (lamB (mkP (.bvar 0) (.bvar 1))) bT)) bF : Lean.Expr)
run_cmd report "SHADOW" `Tests.Gen5.FGCircuitPilotCheck29.shadow ["viaSh", "prodMk", "bvarClo"]

-- HIGHER: `(fun g : Bool → Bool => Prod.mk (g true) (g false)) (fun b => b)` (a function-valued closure applied twice, different arguments)
def bb : Lean.Expr := .forallE `a bl bl .default
derive_expr_t higher := (Lean.Expr.app (lamT bb (mkP (.app (.bvar 0) bT) (.app (.bvar 0) bF))) (lamB (.bvar 0)) : Lean.Expr)
run_cmd report "HIGHER" `Tests.Gen5.FGCircuitPilotCheck29.higher ["viaSh", "prodMk", "boolTrue", "boolFalse"]

-- the static lists `[true]` and `[]`
def nilB : Lean.Expr := appN ``List.nil [.zero] [bl]
def consTB : Lean.Expr := appN ``List.cons [.zero] [bl, bT, nilB]
def motB : Lean.Expr := lamT (appN ``List [.zero] [bl]) bl
def recB (nilc consc major : Lean.Expr) : Lean.Expr := appN ``List.rec [.succ .zero, .zero] [bl, motB, nilc, consc, major]
def listBl : Lean.Expr := appN ``List [.zero] [bl]
-- consc = fun h t ih => h
def consH : Lean.Expr := .lam `h bl (.lam `t listBl (.lam `ih bl (.bvar 2) .default) .default) .default
def consIH : Lean.Expr := .lam `h bl (.lam `t listBl (.lam `ih bl (.bvar 0) .default) .default) .default

-- REC-NIL: `List.rec false (fun h t ih => h) []` = false
derive_expr_t recNil := (recB bF consH nilB : Lean.Expr)
run_cmd report "REC-NIL" `Tests.Gen5.FGCircuitPilotCheck29.recNil ["viaSh", "boolFalse"]
-- REC-CONS: `List.rec false (fun h t ih => h) [true]` = true
derive_expr_t recCons := (recB bF consH consTB : Lean.Expr)
run_cmd report "REC-CONS" `Tests.Gen5.FGCircuitPilotCheck29.recCons ["viaSh", "boolTrue"]
-- REC-IH: `List.rec false (fun h t ih => ih) [true]` = false (the recursive-call closure, over [t, consc, nilc, mot, a0])
derive_expr_t recIH := (recB bF consIH consTB : Lean.Expr)
run_cmd report "REC-IH" `Tests.Gen5.FGCircuitPilotCheck29.recIH ["viaSh", "boolFalse"]

-- DEFAULT: `default (Bool × Bool)` through `instInhabitedProd` (`Inhabited.mk.{max 1 1}` in the unfolding)
def smallRoot : Lean.Expr :=
  appN ``Inhabited.default [.succ .zero] [pBB,
    appN ``instInhabitedProd [.zero, .zero] [bl, bl, .const ``instInhabitedBool [], .const ``instInhabitedBool []]]
derive_expr_t dflt := smallRoot
run_cmd report "DEFAULT" `Tests.Gen5.FGCircuitPilotCheck29.dflt ["inhDefault", "inhMk"]

-- BOOL: `Bool.false` alone is a direct ctor value
derive_expr_t boolF := bF
run_cmd report "BOOL" `Tests.Gen5.FGCircuitPilotCheck29.boolF ["boolFalse"]

/-- the error of a derivation, or `none` if it succeeded -/
def errOf (n : Name) (e : Lean.Expr) : CommandElabM (Option String) := do
  try
    deriveTerm n e
    pure none
  catch ex => pure (some (← (liftCoreM ex.toMessageData.toString)))

def expectErr (tag : String) (n : Name) (e : Lean.Expr) (needle : String) : CommandElabM Unit := do
  match ← errOf n e with
  | none => throwError "{tag}: the control was derived"
  | some msg =>
    unless (msg.splitOn needle).length > 1 do throwError "{tag}: unexpected error text: {msg}"
    if (← getEnv).contains n then throwError "{tag}: a theorem was added"
    logInfo m!"{tag} ok: not derived, with the expected generator error «{needle}» (a generator failure, not a non-derivability theorem)"

-- (fun f => f false) (Prod.mk true): the spine of the stuck/ctor head mixes two captured environments
run_cmd expectErr "CTRL-ENVS" `Tests.Gen5.FGCircuitPilotCheck29.ctrlEnvs
  (Lean.Expr.app (lamT (.forallE `a bl pBB .default) (.app (.bvar 0) bF)) (appN ``Prod.mk [.zero, .zero] [bl, bl, bT]))
  "different environments"
-- Signal.mk is a value head without a rule
run_cmd expectErr "CTRL-SIGNALMK" `Tests.Gen5.FGCircuitPilotCheck29.ctrlMk
  (appN ``Sparkle.Core.Signal.Signal.mk [.zero] [.const ``Sparkle.Core.Domain.defaultDomain [], bl, .lam `t (.const ``Nat []) bF .default]) "has no rule"
-- an unbound variable
run_cmd expectErr "CTRL-UNBOUND" `Tests.Gen5.FGCircuitPilotCheck29.ctrlUnbound (.bvar 3) "not bound"
-- a non-static major premise of List.rec (a variable of the empty environment)
run_cmd expectErr "CTRL-REC-MAJOR" `Tests.Gen5.FGCircuitPilotCheck29.ctrlRecMajor (recB bF consH (.bvar 0)) "not bound"

end Tests.Gen5.FGCircuitPilotCheck29
