/-- **The children's check of the shipped module of a machine with calls**,
on the core run's design, at every depth, from one fact per real child —
`core_kidsPass_leaf` without `hfne`. -/
theorem core_kidsPass_anyA (O : Tools.ShippingChildInvA.RefLawsAOps Tools.ShippingChildFresh.MkRefd mref cref) {c : Name} (d : MachineData) (ok : d.ok = true)
    (hbody : d.shape.body = quote d.dom
      (fun j => inputExpr d.shape.binders.length (d.bpos j))
      (fun j => inputExpr d.shape.binders.length (d.vpos j)) d.packed)
    {nDecl : Nat} (hC : d.callsOk nDecl = true)
    (hslots : d.ss.length = d.shape.layout.slots.length)
    (hdomB : ∀ b ∈ d.shape.binders.drop nDecl, b.2 ≠ .domain)
    (hins : d.shape.insts ≠ [])
    (outTy : ∀ o ∈ d.shape.layout.outs, o.ty.bitWidth = o.width)
    (hnomem : ∀ x ∈ d.shape.instTagged, x.2.child?.isNone = true ∧ (Sparkle.Compiler.MachMemory.memChild? x.1).isNone = true)
    (hkidK : ∀ (k : Nat) (hk : k < d.shape.insts.length) (y : Res),
      Tools.ShippingChildCacheA.RealChildA O (d.shape.insts[k]).1 y →
      (∀ (C : String → Option (Sparkle.IR.AST.Module × Sparkle.IR.Semantics.WEnv)) (n : Nat),
          Tools.ShippingChecksDesign.kidCheck C n y.1 = true) ∧
        ∀ g ∈ y.2.modules,
          ∀ (C : String → Option (Sparkle.IR.AST.Module × Sparkle.IR.Semantics.WEnv)) (n : Nat),
            Tools.ShippingChecksDesign.kidCheck C n g = true)
    {M b : Sparkle.IR.AST.Module} {D : Design}
    (hpost : b = Sparkle.IR.ZeroWidth.dropZeroWidthModule M ∨
      b = mergeChecked (Sparkle.IR.ZeroWidth.dropZeroWidthModule M))
    (ran : Tools.ShippingParentRanA.MachineRanA O mctx cctx c d.shape M D) (n : Nat) :
    Tools.ShippingDesignSV.kidsPass (childMap D.modules)
      (Tools.ShippingChecksDesign.kidCheck (childMap D.modules) n)
      (checkedOptimize b).body = true := by
  obtain ⟨-, hbody', -, hresM, hrealD, -⟩ :=
    core_kids_facts_ranA O d ok hbody hC hslots hdomB hins outTy hnomem hpost ran
  have hgate : Sparkle.IR.RefineCheck.hierGate b = true :=
    core_hierGate_anyA O d ok hbody hC hslots hdomB hins outTy hnomem hpost ran
  unfold Tools.ShippingDesignSV.kidsPass
  rw [List.all_eq_true]
  intro st hst
  cases st with
  | inst mn iname conns =>
    have hm : Stmt.inst mn iname conns ∈ b.body :=
      (Tools.ShippingChecksDepthGate.checkedOptimize_inst_iff_gate hgate mn iname conns).mp hst
    rw [hbody'] at hm
    obtain ⟨mc, hmc⟩ := hresM mn iname conns hm
    have hmem : mc ∈ D.modules := (Tools.ShippingHierPremisesBase.moduleByName_mem hmc).1
    obtain ⟨k, hk, y, hre, hor, -⟩ := hrealD mc hmem
    have hCm : childMap D.modules mn = some (mc, Sparkle.IR.RegDedup.declWidth mc) :=
      congrArg (fun o : Option Sparkle.IR.AST.Module =>
        o.map fun g => (g, Sparkle.IR.RegDedup.declWidth g)) hmc
    simp only [hCm]
    rcases hor with heq | hin
    · rw [heq]
      exact (hkidK k hk y hre).1 _ n
    · exact (hkidK k hk y hre).2 mc hin _ n
  | _ => rfl

/-- **The one-output closing of a core run, exposed**: a core run of a
machine with calls and `instFields = []`, at the machine boundary, returns
`closeInsts` of the closed machine of a harness run, with real children. -/
theorem core_closeInstsA (O : Tools.ShippingChildInvA.RefLawsAOps Tools.ShippingChildFresh.MkRefd mref cref) {c : Name} (d : MachineData)
    (hins : d.shape.insts ≠ []) (hf : d.shape.instFields = [])
    {M : Sparkle.IR.AST.Module} {D : Design}
    (ran : Tools.ShippingParentRanA.MachineRanA O mctx cctx c d.shape M D) :
    ∃ (tenv : Lean.Environment) (logProf : String → IO Unit) (t t' : Sparkle.IR.AST.Module)
      (d₀ : Design)
      (children : List (Sparkle.IR.AST.Module × Design)),
      MReturns (synthesizeMixedCertified
        (fun e hint top named => translateExprToWire tenv e hint top named) logProf c
        d.shape.binders d.shape.body) (t, d₀) ∧
      closeLets d.shape.layout.lets t = some t' ∧
      closeInsts (machNIn d.shape) d.shape.insts.length d.shape.layout.slots.length
        (t.inputs.map (·.name)) (d.shape.insts.map (·.2.1)) children
        (closeMachine d.shape.layout t', d₀) = some (M, D) ∧
      Tools.ShippingChildRunAKids.ChildrenRealA O d.shape children := by
  obtain ⟨_, bb, w9, w10, hrun9, t, t', d₀, run, hcl, hmt⟩ := ran
  rcases hmt with ⟨hno, -, -⟩ | ⟨-, children, hcc, hreal⟩
  · exact absurd hno hins
  rcases hcc with ⟨-, hI⟩ | ⟨hfe, -, -⟩
  · exact ⟨_, _, t, t', d₀, children, run, hcl, hI, hreal⟩
  · exact absurd hf hfe

