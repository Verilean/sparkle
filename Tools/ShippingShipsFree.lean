/-- **The depth head without `shipsHierCheck` and without `outsCheck`.**
`machine_ships_hierC_free` at `KSn`, composed with the closed emitted texts,
both checks derived inside at the core run the full entry contains: from
`hFacts` (the run's facts) and `hOuts` (the output check under the gate). -/
theorem machine_design_noOuts_noShips (n : Nat)
    (Reset : Sparkle.IR.AST.Module → Design → (String → KT n) → Prop)
    (Bnd : CtxBnd)
    (C : Meta.Context → ST.Ref IO.RealWorld Meta.State → Core.Context →
      ST.Ref IO.RealWorld Core.State → Prop)
    (Bd : Sparkle.IR.AST.Module → Design → Prop) (Inv : Sparkle.IR.AST.Module → KT n → Prop)
    (hBd : ∀ b D, Bd b D → KSBoundedIn (childMap D.modules) (KSn (childMap D.modules) n) b.body Inv)
    (hRI : ResetImpliesInv Reset Inv)
    {declName : Name} (d : MachineData) {kD : Nat}
    {ι : Type} {dom : ι → DomainConfig}
    {src : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) → List (Nat → Nat)}
    {ext : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) →
      (j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)}
    {extB : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) → Nat → Signal (dom i) Bool}
    {lsrc srcL : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) → List (Nat → Nat)}
    {extL : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) →
      (j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)}
    {extBL : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) → Nat → Signal (dom i) Bool}
    -- the wired endpoint, for the cleanup facts only (its source may be the
    -- fused / sign-normalised one a transported endpoint rewrites)
    (soundL : ∀ {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
      {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State} {w w' : Void IO.RealWorld}
      {m : Sparkle.IR.AST.Module} {design : Design},
      RunsTo (synthesizeCombinationalCore declName [] false) mctx mref cctx cref w
        (m, design) w' →
      MachineDefines mctx mref cctx cref declName d.shape →
      C mctx mref cctx cref →
      Bnd mctx mref cctx cref w m design →
      MachineTraceLB declName d m design dom srcL extL extBL lsrc)
    (composed : ∀ {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
      {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State} {w w' : Void IO.RealWorld}
      {m : Sparkle.IR.AST.Module} {design : Design},
      RunsTo (synthesizeCombinationalCore declName [] false) mctx mref cctx cref w
        (m, design) w' →
      MachineDefines mctx mref cctx cref declName d.shape →
      C mctx mref cctx cref →
      Bnd mctx mref cctx cref w m design → Tools.ConeFold.memFree m.body →
      ComposedG (fun D => KSn (childMap D.modules) n) Reset declName d kD m design dom src ext extB)
    (houtTy : ∀ o ∈ d.shape.layout.outs, o.ty.bitWidth = o.width)
    {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
    {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State} {w w' : Void IO.RealWorld}
    {b : Sparkle.IR.AST.Module} {design : Design}
    (hr : RunsTo (synthesizeCombinational declName) mctx mref cctx cref w (b, design) w')
    (entry : MachineDefines mctx mref cctx cref declName d.shape)
    (closes : C mctx mref cctx cref)
    -- the run's facts of the full entry's module, from the CORE run the full entry contains
    (hFacts : ∀ {raw : Sparkle.IR.AST.Module} {D : Design} {w1 : Void IO.RealWorld},
      RunsTo (synthesizeCombinationalCore declName [] false) mctx mref cctx cref w (raw, D) w1 →
      (b = Sparkle.IR.ZeroWidth.dropZeroWidthModule raw ∨
        b = mergeChecked (Sparkle.IR.ZeroWidth.dropZeroWidthModule raw)) →
      Bnd mctx mref cctx cref w raw D →
      Tools.ShippingGuardsSound.RunFacts (childMap D.modules) b)
    -- the output check, from the same core run, under the statement-kind gate
    (hOuts : ∀ {raw : Sparkle.IR.AST.Module} {D : Design} {w1 : Void IO.RealWorld},
      RunsTo (synthesizeCombinationalCore declName [] false) mctx mref cctx cref w (raw, D) w1 →
      (b = Sparkle.IR.ZeroWidth.dropZeroWidthModule raw ∨
        b = mergeChecked (Sparkle.IR.ZeroWidth.dropZeroWidthModule raw)) →
      hierGate b = true → Bnd mctx mref cctx cref w raw D →
      Tools.ShippingDesignSVBack.outsCheck (childMap D.modules) n (checkedOptimize b) = true) :
    ∃ (raw : Sparkle.IR.AST.Module) (D : Design),
      (b = Sparkle.IR.ZeroWidth.dropZeroWidthModule raw ∨
        b = mergeChecked (Sparkle.IR.ZeroWidth.dropZeroWidthModule raw)) ∧
      (-- NO checker premise
        -- the shipped design's emitted-text checks
        designCheck (childMap D.modules) n (checkedOptimize b) = true →
        Bnd mctx mref cctx cref w raw D → Bd b D →
        ∃ ids : List FVarId, ids.Nodup ∧ ids.length = d.shape.binders.length ∧
        ∃ (cache : IO.Ref (ExprStructMap String)) (regs : List String),
          regs.Nodup ∧ regs.length = d.ss.length ∧
          ∀ (i : ι) (bools : Nat → Signal (dom i) Bool)
            (bits : (j : Nat) → (n : Nat) → Signal (dom i) (BitVec n))
            (T : Nat) (ins : Nat → String → Nat) (st0 : String → Nat) (mems : MEnv)
            (kids : String → KT n),
            (∀ t st, t < T → SourceInputs declName (d.bsIn.take kD) ids cache
              (fun j => (extB i bools bits j).val (T - 1 - t))
              (fun j n => (ext i bools bits j n).val (T - 1 - t)) (seedIn b ins t st)) →
            (∀ t st r, r ∈ regs → seedIn b ins t st r = st r) →
            (∀ t, ins t "rst" = 0) → (∀ t st, seedIn b ins t st "clk" = 0) →
            (∀ (k : Nat) (r : String) (f : SlotField), regs[k]? = some r →
              d.shape.layout.slots[k]? = some f → st0 r = f.init) →
            Reset raw D kids →
            (∀ t x, x ∈ b.inputs.map (·.name) → ins t x < 2 ^ declWidth b x) →
            (∀ x ∈ (openIns b).map (·.name), x ∉ bodyInstOuts (childMap D.modules) b.body →
              st0 x < 2 ^ declWidth b x) →
            (∀ r ∈ seqRegs (openFlat b (openIns b) (openOuts b)), st0 r.1 < 2 ^ declWidth b r.1) →
            -- the emitted widths' use conditions: inputs, start registers, instance states
            (∀ t x, x ∈ b.inputs.map (·.name) → ins t x < 2 ^ weS (checkedOptimize b) x) →
            Bounded (weS (checkedOptimize b)) st0 →
            (∀ mn iname conns gc gcwe, Stmt.inst mn iname conns ∈ (checkedOptimize b).body →
              childMap D.modules mn = some (gc, gcwe) → InvN (childMap D.modules) n gc (kids iname)) →
            -- a closed run of the emitted texts showing the source exists ...
            (∃ envsO,
              DesignSV (childMap D.modules) n (checkedOptimize b) (seedIn b ins) T ⟨st0, mems, kids⟩ envsO ∧
              envsO.length = T ∧
              ∀ j (hj : j < envsO.length) (k : Nat) (o : OutField) (f : Nat → Nat),
                d.shape.layout.outs[k]? = some o → (src i bools bits)[k]? = some f →
                (envsO[j]'hj) o.name = f j)
            -- ... and EVERY closed run from the same seeding and states shows it
            ∧ ∀ envs', DesignSV (childMap D.modules) n (checkedOptimize b) (seedIn b ins) T ⟨st0, mems, kids⟩ envs' →
                envs'.length = T ∧
                ∀ j (hj : j < envs'.length) (k : Nat) (o : OutField) (f : Nat → Nat),
                  d.shape.layout.outs[k]? = some o → (src i bools bits)[k]? = some f →
                  (envs'[j]'hj) o.name = f j) := by
  obtain ⟨raw, D, w1, hcore, hpost⟩ := synthesizeCombinational_checked hr
  refine ⟨raw, D, hpost, ?_⟩
  exact design_at_free n Reset (Bnd mctx mref cctx cref w) Bd
    (machine_ships_hierC_at_free (fun D => KSn (childMap D.modules) n)
      (fun D => KSn_local (childMap D.modules) n) Reset Bnd C Bd Inv hBd hRI d soundL composed
      houtTy hcore hpost entry closes (fun hBnd => hFacts hcore hpost hBnd))
    (fun hBnd => hOuts hcore hpost (hFacts hcore hpost hBnd).gate hBnd)

end Tools.ShippingShipsFree

namespace Tools.ShippingShipsFreeSV
open Sparkle.IR.AST Sparkle.IR.Semantics
open Sparkle.IR.RegDedup (declWidth)
open Sparkle.IR.OptCheck (checkedOptimize)
open Tools.ShippingHierOpen Tools.ShippingHierState Tools.ShippingHierStateG Tools.ShippingHierOptRun
open Tools.ShippingSeqOptSoundness (seedIn)

/-- **The shipped module's emitted Verilog runs as its linked run, with no
checker premise**: `shipped_sv` with the run's facts of the full entry's
module in place of `hierCheck` (statement copied; `hIW`, `hOut` and the
other emitted-side premises on the shipped module are unchanged). -/
theorem shipped_sv_free {σ : Type} (KS : KStep σ) (children : String → Option (Module × WEnv))
    {b : Module} {wof : String → Option Nat} (Inv : Module → σ → Prop)
    (hfacts : Tools.ShippingGuardsSound.RunFacts children b)
    (hKSb : KSBoundedIn children KS (checkedOptimize b).body Inv)
    (hIW : instOutWidthsOk children (declWidth (checkedOptimize b)) (checkedOptimize b).body = true)
    (hOut : ∀ w ∈ bodyInstOuts children (checkedOptimize b).body,
      w ∈ (Sparkle.IR.HierCheck.openIns (checkedOptimize b)).map (·.name))
    (hOW : ∀ w ∈ bodyInstOuts children (checkedOptimize b).body,
      declWidth (checkedOptimize b) w ≤ Tools.SVParser.EmitSem.weOf wof w)
    (hok : (checkedOptimize b).body.all Tools.ShippingHierSVSoundness.seqStmtOkI = true)
    (hsv : Tools.SVParser.EmitSem.seqCheck wof (Tools.SVParser.EmitSem.weOf wof)
      (checkedOptimize b).body = true)
    (hwag : ∀ n ∈ Tools.ShippingSeqSVSoundness.seqNames (checkedOptimize b).body,
      declWidth (checkedOptimize b) n = Tools.SVParser.EmitSem.weOf wof n)
    (ins : Nat → String → Nat)
    (hinsW : ∀ t x, x ∈ b.inputs.map (·.name) → ins t x < 2 ^ Tools.SVParser.EmitSem.weOf wof x)
    {T : Nat} {s : KState σ} {envs : List Env}
    (hrun : runModuleTG KS (declWidth (checkedOptimize b)) children (checkedOptimize b).body
      (seedIn b ins) T s = some envs)
    (hinv : ∀ mn iname conns, Stmt.inst mn iname conns ∈ (checkedOptimize b).body → ∀ child cwe,
      children mn = some (child, cwe) → Inv child (s.kids iname))
    (hstX : ∀ x ∈ (Sparkle.IR.HierCheck.openIns (checkedOptimize b)).map (·.name),
      x ∉ bodyInstOuts children (checkedOptimize b).body → s.st x < 2 ^ declWidth (checkedOptimize b) x)
    (hst : Bounded (Tools.SVParser.EmitSem.weOf wof) s.st) :
    ∃ pairs regs mprog,
      Tools.SVParser.EmitSem.emitAssigns wof (checkedOptimize b).body = some pairs ∧
      Tools.SVParser.EmitSem.emitRegs wof (checkedOptimize b).body = some regs ∧
      Tools.SVParser.EmitSem.emitMemWrites wof (checkedOptimize b).body = some mprog ∧
      Tools.SVParser.EmitSem.runModuleSV wof pairs regs mprog
        (Tools.ShippingHierSVRun.oracle children (checkedOptimize b).body
          (fun k => (envs[T - 1 - k]?).getD (fun _ => 0)) (seedIn b ins)) T
        s.st s.mems = some envs := by
  obtain ⟨hwfO, hndO, hin⟩ := Tools.ShippingChecksRunFacts.core_shipped_facts hfacts
  have hseed := Tools.ShippingHierShipsSV.seedIn_eq hin ins
  rw [← hseed] at hrun ⊢
  exact Tools.ShippingHierSVRun.linked_sv_of_run KS children Inv hKSb hwfO hndO hIW hOut hOW
    hok hsv hwag ins (by rw [hin]; exact hinsW) hrun hinv hstX hst

/-- **`hIW` and `hOut` of the shipped module in the fallback cases**: when
the compiler ships the module as it is, they are the run's facts. (For an
accepted candidate they are not derived: see the header.) -/
theorem shipped_iw_out_of_fallback {children : String → Option (Module × WEnv)} {b : Module}
    (hfacts : Tools.ShippingGuardsSound.RunFacts children b)
    (hsame : checkedOptimize b = b) :
    instOutWidthsOk children (declWidth (checkedOptimize b)) (checkedOptimize b).body = true ∧
      ∀ w ∈ bodyInstOuts children (checkedOptimize b).body,
        w ∈ (Sparkle.IR.HierCheck.openIns (checkedOptimize b)).map (·.name) := by
  rw [hsame]
  exact ⟨hfacts.wid, Tools.ShippingHierPremisesBase.outsExtracted_sound hfacts.outs⟩

/-- The fallback cases, named: the hierarchical check does not bind, or it
binds and the interface check rejects the guarded candidate. -/
theorem checkedOptimize_fallback {children : String → Option (Module × WEnv)} {b : Module}
    (hfacts : Tools.ShippingGuardsSound.RunFacts children b)
    (h : Sparkle.IR.RefineCheck.hierBinds b = false ∨
      Sparkle.IR.RefineCheck.hierRefineCheck b
        (Sparkle.IR.HierCheck.deinline b (Sparkle.IR.Optimize.optimizeModule b)) = false) :
    checkedOptimize b = b := by
  by_cases hb : Sparkle.IR.RefineCheck.hierBinds b = true
  · rcases h with h | h
    · rw [hb] at h
      cases h
    · rw [Tools.ShippingGuardsSound.checkedOptimize_binding hb]
      exact if_neg (by rw [h]; exact Bool.false_ne_true)
  · have hb0 : Sparkle.IR.RefineCheck.hierBinds b = false := by simpa using hb
    exact Tools.ShippingGuardsSound.checkedOptimize_not_binding hfacts.gate hb0

end Tools.ShippingShipsFreeSV
