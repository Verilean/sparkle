variable {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
  {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State}

/-- **`BodyStepAX O` from `T` alone**: each depth step builds the handlers and the legacy tail
from its own `hC : ChildKeepsAX O D`. -/
theorem bodyStepA_mainX (O : RefLawsAOpsX MkRefd mref cref) (T : RefLawsATeleX O.quiet O.adm mref cref) :
    BodyStepAX O :=
  fun D _ hC => bodyKeepsA_of_teleX O T D hC
    (Tools.ShippingChildLegacyTailA.legacyTailA_of_stepX O T D hC)

/-- **The child entry at every depth `D ≥ 1`** (JQ level). -/
theorem childKeepsA_mainX (O : RefLawsAOpsX MkRefd mref cref) (T : RefLawsATeleX O.quiet O.adm mref cref) :
    ∀ D, 1 ≤ D → ChildKeepsAX O D :=
  childKeepsA_allX O (bodyStepA_mainX O T)

/-- **Main theorem (JQ level).** From `OutQ O.quiet` the core entry keeps `OutQ` on every
outcome (success: `OutQ`; exception: `OutQ ∧ OkExc`). Premises: `O`, `hA`, `T`. -/
theorem core_tripleA_mainX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    (T : RefLawsATeleX O.quiet O.adm mref cref) (declName : Name) :
    Triple mctx mref cctx cref (OutQ O.quiet) (synthesizeCombinationalCore declName [] false)
      (fun _ => OutQ O.quiet) (fun e w => OutQ O.quiet w ∧ OkExc e) :=
  core_tripleA_of_bodiesX O hA declName (bodyStepA_mainX O T)

end Tools.ShippingChildMainA
