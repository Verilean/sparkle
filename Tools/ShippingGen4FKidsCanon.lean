/-- `fuelFixM` for `KeepsCS` (as `KeepsCP.fuelFixM`, Tools/ShippingChildLoopsCP.lean). -/
theorem KeepsCS.fuelFixM {I : Void IO.RealWorld → Prop} {α β : Type}
    (step : (α → CompilerM β) → α → CompilerM β)
    (hstep : ∀ rec : α → CompilerM β,
      (∀ a, KeepsCS mctx mref cctx cref I (rec a)) →
      ∀ a, KeepsCS mctx mref cctx cref I (step rec a)) :
    ∀ (k : Nat) (a : α), KeepsCS mctx mref cctx cref I (Sparkle.Compiler.Elab.fuelFixM step k a)
  | 0, a => by
    unfold Sparkle.Compiler.Elab.fuelFixM
    exact KeepsCS.throw _ (by okmsg)
  | k + 1, a => by
    unfold Sparkle.Compiler.Elab.fuelFixM
    exact hstep _ (KeepsCS.fuelFixM step hstep k) a

section Step
variable {O : RefLawsAOps MkRefd mref cref} (M : MemoFamily O) (hA : AdmCtx O.quiet mctx cctx)
  {I : Void IO.RealWorld → Prop} (hS : StableK O.quiet I)
include M hA hS

/-- **One step of `canonHardwareExpr`**, given the recursive call. -/
theorem canonHardwareExprStepKS (rec : Lean.Expr → CompilerM Lean.Expr)
    (hrec : ∀ a, KeepsCS mctx mref cctx cref I (rec a)) (value : Lean.Expr) :
    KeepsCS mctx mref cctx cref I (canonHardwareExprStep rec value) := by
  unfold canonHardwareExprStep
  refine KeepsCS.bind (KeepsCS.lift (keepsK_framedNM M hA hS (FramedNM.sideGetIO SideRefNM.wireCanon)))
    (fun canon => ?_)
  dsimp only
  refine KeepsCS.bind (KeepsCS.forIn_range _ (fun _ v => ?_) _ _) (fun v1 => ?_)
  · try dsimp only
    refine KeepsCS.bind (KeepsCS.forIn_array _ (fun fv repl => ?_) _ _) (fun repl => ?_)
    · try dsimp only
      refine KeepsCS.bind (lookupVarPS fv) (fun x => ?_)
      refine KeepsCS.ite (fun _ => KeepsCS.pure _) (fun _ => ?_)
      refine KeepsCS.bind (KeepsCS.lift (Keeps.of_ok fun w => ⟨_, rfl⟩)) (fun d => ?_)
      cases d with
      | none => exact KeepsCS.pure _
      | some decl =>
        dsimp only
        split <;> exact KeepsCS.pure _
    · exact KeepsCS.ite (fun _ => KeepsCS.pure _) (fun _ => KeepsCS.pure _)
  · try dsimp only
    refine KeepsCS.ite (fun _ => ?_) (fun _ => ?_)
    rotate_left
    ctailK
    refine KeepsCS.bind (KeepsCS.lift (keepsK_framedNM M hA hS
      (FramedNM.sideGetIO SideRefNM.loopWire))) (fun cache => ?_)
    refine KeepsCS.bind (KeepsCS.forIn_array _ (fun l loopRepl => ?_) _ _) (fun lr => ?_)
    · refine KeepsCS.bind (hrec l) (fun k => ?_)
      try dsimp only
      split <;> exact KeepsCS.pure _
    · refine KeepsCS.ite (fun _ => ?_) (fun _ => ?_)
      all_goals ctailK

theorem canonHardwareExprKS (value : Lean.Expr) :
    KeepsCS mctx mref cctx cref I (canonHardwareExpr value) := by
  unfold canonHardwareExpr
  exact KeepsCS.fuelFixM canonHardwareExprStep
    (fun rec hrec a => canonHardwareExprStepKS M hA hS rec hrec a) helperFuelLimit value

theorem canonHardwareKeyKS (value : Lean.Expr) :
    KeepsCS mctx mref cctx cref I (canonHardwareKey value) := by
  unfold canonHardwareKey
  exact KeepsCS.bind (canonHardwareExprKS M hA hS value) (fun _ => KeepsCS.pure _)

end Step

