/-- **The telescope bundle from `O` and the two telescope laws.** `localDecl`, `letDecl` PROVED. -/
theorem RefLawsATeleX.ofTeleLamX (O : RefLawsAOpsX MkRefd mref cref)
    (htel : ForallTelescopeLawAX O.quiet O.adm mref cref) (hlam : LamTelescopeLawAX O.quiet O.adm mref cref) :
    RefLawsATeleX O.quiet O.adm mref cref where
  telescope := htel
  lamTelescope := hlam
  localDecl := fun _ hA hIq hI n ty k hk => localDecl_of_OX O hA hIq hI n ty k hk
  letDecl := fun _ hA hIq hI n ty v k hk => letDecl_of_OX O hA hIq hI n ty v k hk

/-- `MainA.core_tripleA_mainX` with premises `O`, `hA`, `htel`, `hlam`. -/
theorem core_tripleA_main_tlX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    (htel : ForallTelescopeLawAX O.quiet O.adm mref cref) (hlam : LamTelescopeLawAX O.quiet O.adm mref cref)
    (declName : Name) :
    Triple mctx mref cctx cref (OutQ O.quiet) (synthesizeCombinationalCore declName [] false)
      (fun _ => OutQ O.quiet) (fun e w => OutQ O.quiet w ∧ OkExc e) :=
  Tools.ShippingChildMainA.core_tripleA_mainX O hA (RefLawsATeleX.ofTeleLamX O htel hlam) declName

/-- `ComposeC.core_tripleAC_of_teleX` with premises `O`, `hA`, `htel`, `hlam`. -/
theorem core_tripleAC_of_tele_tlX (O : RefLawsAOpsX MkRefd mref cref)
    (hA : O.adm mctx cctx)
    (htel : ForallTelescopeLawAX O.quiet O.adm mref cref) (hlam : LamTelescopeLawAX O.quiet O.adm mref cref)
    (declName : Name) :
    Triple mctx mref cctx cref (JQ O.quiet 0) (synthesizeCombinationalCore declName [] false)
      (fun _ => JQCX O 0) (EQ O.quiet 0) :=
  Tools.ShippingChildComposeC.core_tripleAC_of_teleX O hA (RefLawsATeleX.ofTeleLamX O htel hlam)
    declName

/-- `ComposeC.full_tripleAC_of_teleX` with premises `O`, `hA`, `htel`, `hlam`. -/
theorem full_tripleAC_of_tele_tlX (O : RefLawsAOpsX MkRefd mref cref)
    (hA : O.adm mctx cctx)
    (htel : ForallTelescopeLawAX O.quiet O.adm mref cref) (hlam : LamTelescopeLawAX O.quiet O.adm mref cref)
    (declName : Name) :
    Triple mctx mref cctx cref (JQ O.quiet 0) (synthesizeCombinational declName)
      (fun _ => JQCX O 0) (EQ O.quiet 0) :=
  Tools.ShippingChildComposeC.full_tripleAC_of_teleX O hA (RefLawsATeleX.ofTeleLamX O htel hlam)
    declName

/-- `RunAMain.htr_of_teleX` with premises `O`, `hA`, `htel`, `hlam`. -/
theorem htr_of_tele_tlX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    (htel : ForallTelescopeLawAX O.quiet O.adm mref cref) (hlam : LamTelescopeLawAX O.quiet O.adm mref cref)
    (D : Nat) :
    ∀ (tenv : Lean.Environment) e hint top named, KeepsCP mctx mref cctx cref (JQCX O (D + 1))
      (translateExprToWire tenv e hint top named) :=
  Tools.ShippingChildRunAMain.htr_of_teleX O hA (RefLawsATeleX.ofTeleLamX O htel hlam) D

/-- `RunAMain.machine_children_realA_mainX` with premises `O`, `hA`, `htel`, `hlam` (others
unchanged: start world, `MachineDefines`, `MachineClosesAtAX` (UNRESOLVED), `shape.insts ≠ []`). -/
theorem machine_children_realA_main_tlX (O : RefLawsAOpsX MkRefd mref cref)
    (hA : O.adm mctx cctx)
    (htel : ForallTelescopeLawAX O.quiet O.adm mref cref) (hlam : LamTelescopeLawAX O.quiet O.adm mref cref)
    {declName : Name} {shape : MachineShape} {D : Nat}
    {w w' : Void IO.RealWorld} {m : Sparkle.IR.AST.Module} {d : Sparkle.IR.AST.Design}
    (hr : RunsTo (synthesizeCombinationalCore declName [] false) mctx mref cctx cref w (m, d) w')
    (entry : MachineDefines mctx mref cctx cref declName shape)
    (closes : MachineClosesAtAX (mref := mref) (cref := cref) O mctx cctx declName shape)
    (hw : JQ O.quiet D w) (hc : D = 0 ∨ CacheInvAX O (cv w)) (hi : shape.insts ≠ []) :
    ∃ t t' d₀ children,
      Sparkle.IR.Machine.closeLets shape.layout.lets t = some t' ∧
      CloseCalls shape t (Sparkle.IR.Machine.closeMachine shape.layout t') d₀ children m d ∧
      ChildrenRealAX O shape children :=
  Tools.ShippingChildRunAMain.machine_children_realA_mainX O hA (RefLawsATeleX.ofTeleLamX O htel hlam)
    hr entry closes hw hc hi

