@[keepsAX] theorem fuelFixM_keepsAX {adm : CtxPred} {I : Void IO.RealWorld → Prop}
    {α β : Type} (step : (α → MetaM β) → α → MetaM β)
    (hstep : ∀ rec : α → MetaM β,
      (∀ (mctx : Meta.Context) (cctx : Core.Context), adm mctx cctx → ∀ a,
        Keeps mctx mref cctx cref I (rec a)) →
      ∀ (mctx : Meta.Context) (cctx : Core.Context), adm mctx cctx → ∀ a,
        Keeps mctx mref cctx cref I (step rec a)) :
    ∀ (k : Nat) (mctx : Meta.Context) (cctx : Core.Context), adm mctx cctx → ∀ (a : α),
      Keeps mctx mref cctx cref I (fuelFixM step k a)
  | 0, mctx, cctx, _, a => by
    unfold fuelFixM
    exact Keeps.throw _ (by okmsg)
  | k + 1, mctx, cctx, hA, a => by
    unfold fuelFixM
    exact hstep _ (fun _ _ hA' a' => fuelFixM_keepsAX step hstep k _ _ hA' a') mctx cctx hA a

