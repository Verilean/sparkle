      | some w =>
        exact KeepsCP.ite (fun _ => KeepsCP.pure _)
          (fun _ => KeepsCP.bind (recordTranslationAX O hA hS _ _ _) (fun _ => KeepsCP.pure _))
      | none => exact hfb _ _ _ _
  · refine KeepsCP.bind (translateCoreAX O hA hS rec hrec _ _ _ _) (fun y => ?_)
    cases y with
    | some w =>
      exact KeepsCP.ite (fun _ => KeepsCP.pure _)
        (fun _ => KeepsCP.bind (recordTranslationAX O hA hS _ _ _) (fun _ => KeepsCP.pure _))
    | none => exact hfb _ _ _ _

