theorem cacheLookupValidatedAX (e : Lean.Expr) :
    KeepsCPX mctx mref cctx cref I (cacheLookupValidated e) := by
  unfold cacheLookupValidated
  refine KeepsCP.bindCtx (fun cs hcs => ?_)
  try dsimp only  -- guess: T3
  cases hc : cs.exprCache with
  | none => exact KeepsCP.pure _
  | some r =>
    have hr := hcs r hc
    refine KeepsCP.bind (KeepsCP.lift ?_) (fun hit => ?_)
    · first  -- guess: T4
        | exact Keeps.bind (keepsA_framedX O hA hS (FramedA.exprCacheGetIO r hr)) fun _ => Keeps.pure _
        | exact Keeps.bind (keepsA_framedX O hA hS (FramedA.exprCacheGet r hr)) fun _ => Keeps.pure _
    · cases hit with
      | none => exact KeepsCP.pure _
      | some w =>
        refine KeepsCP.bind KeepsCP.get (fun s => ?_)
        split <;> exact KeepsCP.pure _

