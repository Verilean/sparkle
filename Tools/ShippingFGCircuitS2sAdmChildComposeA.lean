variable {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
  {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State}

/-- **One depth step with the handlers discharged locally** (from `ChildKeepsAX O D`). -/
theorem bodyKeepsA_of_tele (O : RefLawsAOpsX MkRefd mref cref) (T : RefLawsATeleX O.quiet O.adm mref cref)
    (D : Nat) (hC : ChildKeepsAX O D) (hlegacy : LegacyTailAX O D) : BodyKeepsAX O D :=
  have hS := stableA_JQ O.quiet D
  have hchild : ChildEntryAX O (JQ O.quiet D) := childEntryA_JQ_of_childSynthAX O D hC
  have hcanon : CanonKeyAX O (JQ O.quiet D) := Tools.ShippingChildCanonKeyA.canonKeyAX O hS
  have hImpl : LegacyImplAX O (JQ O.quiet D) :=
    Tools.ShippingChildLegacyImplA.legacyImplA_of_teleX O hS T hcanon hchild
  bodyKeepsA_frontendsX O D hImpl
    (Tools.ShippingChildLegacyCachedA.legacyCachedA_of_implX O hS hImpl) hcanon
    (Tools.ShippingChildProjFieldA.projFieldNameAX O T hS) hC hlegacy

end Tools.ShippingChildComposeA
