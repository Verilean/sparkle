variable {mref : ST.Ref IO.RealWorld Meta.State} {cref : ST.Ref IO.RealWorld Core.State}
  {Fresh : (σ : Type) → IO.Ref σ → Prop}

-- unfold (delta+beta) every application of a constant whose name ends with one of the given
-- last components, including PRIVATE ones that cannot be written.
open Lean Elab Tactic Meta in
elab "unfold_suffixX " id:ident : tactic => do
  let sufs := #[id.getId.toString]
  liftMetaTactic1 fun g => do
    let t ← g.getType
    let t' ← Core.transform t (post := fun e => do
      let f := e.getAppFn
      if let .const nm _ := f then
        let s := nm.toString
        if sufs.any (fun p => s.endsWith ("." ++ p)) then
          if let some e' ← unfoldDefinition? e then
            return .done e'.headBeta
      return .continue)
    g.replaceTargetDefEq t'

theorem keeps_read_bindX {mctx : Meta.Context} {cctx : Core.Context} {α : Type}
    {I : Void IO.RealWorld → Prop} {g : Meta.Context → MetaM α}
    (h : Keeps mctx mref cctx cref I (g mctx)) :
    Keeps mctx mref cctx cref I (read >>= g) := fun w hw => h w hw

/-- `withReader` on the Meta context by an update that keeps the unfolding callback. -/
theorem keeps_withReaderAX {mctx : Meta.Context} {cctx : Core.Context} {adm : CtxPred} (hc : CtxClosed adm)
    {I : Void IO.RealWorld → Prop} (hA : adm mctx cctx)
    {α : Type} {x : MetaM α} (f : Meta.Context → Meta.Context)
    (hf : ∀ m, (f m).canUnfold? = m.canUnfold?)
    (h : adm (f mctx) cctx → Keeps (f mctx) mref cctx cref I x) :
    Keeps mctx mref cctx cref I (withReader f x) :=
  fun w hw => h (hc.canUnfold hA f hf) w hw


section
variable {mctx : Meta.Context} {cctx : Core.Context} {α : Type}

/-- **`RefLawsATeleX.localDecl`, derived.** The field's statement for `withLocalDeclD`, from
`O : RefLawsAOpsX` alone (any `Fresh`): no `RefLawsATeleX`. Uses `FramedA.freshFVar`
(`mkFreshFVarId`), `FramedA.isClass?`, `FramedA.fvarThrowUnknown`, and pure context reads/updates
(AdmCtx kept: `lctx` / `localInstances` updates leave `canUnfold?`). -/
theorem localDecl_of_OX (O : RefLawsAOpsX Fresh mref cref) {I : Void IO.RealWorld → Prop}
    (hA : O.adm mctx cctx) (hIq : ∀ w, I w → O.quiet w)
    (hI : ∀ w w', cv w' = cv w → sv w' = sv w → dv w' = dv w → (O.quiet w → O.quiet w') →
      I w → I w')
    (n : Name) (ty : Lean.Expr) (k : Lean.Expr → MetaM α)
    (hk : ∀ (mctx' : Meta.Context) (cctx' : Core.Context) x, O.adm mctx' cctx' →
      Keeps mctx' mref cctx' cref I (k x)) :
    Keeps mctx mref cctx cref I (Lean.Meta.withLocalDeclD n ty k) := by
  have hS : StableA O.quiet I := ⟨hIq, hI⟩
  unfold Lean.Meta.withLocalDeclD Lean.Meta.withLocalDecl Lean.Meta.map1MetaM
  unfold controlAt
  unfold_suffixX withLocalDeclImp
  refine Keeps.bind ?_ (fun a => Keeps.pure a)
  dsimp only [liftWith, instMonadControlTOfPure]
  refine Keeps.bind (keepsA_framedX O hA hS FramedA.freshFVar) (fun fvarId => ?_)
  refine keeps_read_bindX ?_
  refine keeps_withReaderAX O.adm_closed hA _ (fun m => rfl) (fun hA' => ?_)
  unfold_suffixX withNewFVar
  refine Keeps.bind (keepsA_framedX O hA' hS (FramedA.isClass? _)) (fun cc => ?_)
  cases cc with
  | none => exact hk _ cctx _ hA'
  | some c =>
    show Keeps _ mref cctx cref I (withNewLocalInstance c (mkFVar fvarId) (k (mkFVar fvarId)))
    unfold Lean.Meta.withNewLocalInstance Lean.Meta.mapMetaM
    unfold controlAt
    unfold_suffixX withNewLocalInstanceImp
    refine Keeps.bind ?_ (fun a => Keeps.pure a)
    dsimp only [liftWith, instMonadControlTOfPure]
    unfold Lean.Meta.getFVarLocalDecl Lean.FVarId.getDecl
    refine Keeps.bind (Keeps.bind (Keeps.of_ok fun w => ⟨_, rfl⟩) (fun l => ?_)) (fun d => ?_)
    · split
      · exact Keeps.pure _
      · exact keepsA_framedX O hA' hS (FramedA.fvarThrowUnknown _)
    · split
      · exact hk _ cctx _ hA'
      · exact keeps_withReaderAX O.adm_closed hA' _ (fun m => rfl) (fun h => hk _ cctx _ h)

/-- **`RefLawsATeleX.letDecl`**: same derivation for `withLetDecl` (see the header). -/
theorem letDecl_of_OX (O : RefLawsAOpsX Fresh mref cref) {I : Void IO.RealWorld → Prop}
    (hA : O.adm mctx cctx) (hIq : ∀ w, I w → O.quiet w)
    (hI : ∀ w w', cv w' = cv w → sv w' = sv w → dv w' = dv w → (O.quiet w → O.quiet w') →
      I w → I w')
    (n : Name) (ty v : Lean.Expr) (k : Lean.Expr → MetaM α)
    (hk : ∀ (mctx' : Meta.Context) (cctx' : Core.Context) x, O.adm mctx' cctx' →
      Keeps mctx' mref cctx' cref I (k x)) :
    Keeps mctx mref cctx cref I (Lean.Meta.withLetDecl n ty v k) := by
  have hS : StableA O.quiet I := ⟨hIq, hI⟩
  unfold Lean.Meta.withLetDecl Lean.Meta.map1MetaM
  unfold controlAt
  unfold_suffixX withLetDeclImp
  refine Keeps.bind ?_ (fun a => Keeps.pure a)
  dsimp only [liftWith, instMonadControlTOfPure]
  refine Keeps.bind (keepsA_framedX O hA hS FramedA.freshFVar) (fun fvarId => ?_)
  refine keeps_read_bindX ?_
  refine keeps_withReaderAX O.adm_closed hA _ (fun m => rfl) (fun hA' => ?_)
  unfold_suffixX withNewFVar
  refine Keeps.bind (keepsA_framedX O hA' hS (FramedA.isClass? _)) (fun cc => ?_)
  cases cc with
  | none => exact hk _ cctx _ hA'
  | some c =>
    show Keeps _ mref cctx cref I (withNewLocalInstance c (mkFVar fvarId) (k (mkFVar fvarId)))
    unfold Lean.Meta.withNewLocalInstance Lean.Meta.mapMetaM
    unfold controlAt
    unfold_suffixX withNewLocalInstanceImp
    refine Keeps.bind ?_ (fun a => Keeps.pure a)
    dsimp only [liftWith, instMonadControlTOfPure]
    unfold Lean.Meta.getFVarLocalDecl Lean.FVarId.getDecl
    refine Keeps.bind (Keeps.bind (Keeps.of_ok fun w => ⟨_, rfl⟩) (fun l => ?_)) (fun d => ?_)
    · split
      · exact Keeps.pure _
      · exact keepsA_framedX O hA' hS (FramedA.fvarThrowUnknown _)
    · split
      · exact hk _ cctx _ hA'
      · exact keeps_withReaderAX O.adm_closed hA' _ (fun m => rfl) (fun h => hk _ cctx _ h)

/-- The bundle with `localDecl`/`letDecl` taken from `O` instead of `T`: the statements of the two
fields are exactly those of `localDecl_of_OX` / `letDecl_of_OX` (checked by the type ascription). -/
theorem RefLawsATeleX.withDerivedX (O : RefLawsAOpsX Fresh mref cref)
    (T : RefLawsATeleX O.quiet O.adm mref cref) : RefLawsATeleX O.quiet O.adm mref cref :=
  { T with
    localDecl := fun _ hA hIq hI n ty k hk => localDecl_of_OX O hA hIq hI n ty k hk
    letDecl := fun _ hA hIq hI n ty v k hk => letDecl_of_OX O hA hIq hI n ty v k hk }

end
