section Defs
variable {mref : ST.Ref IO.RealWorld Meta.State} {cref : ST.Ref IO.RealWorld Core.State}

inductive RealChildEX (O : RefLawsAOpsX MkRefd mref cref) (E : StartEv) : Name → Res → Prop
  | run {c : Name} {r : Res} (mctx : Meta.Context) (cctx : Core.Context)
      (w w' : Void IO.RealWorld)
      (adm : O.adm mctx cctx)
      (cache : ∀ c' r', (cv w).get? c' = some r' → RealChildEX O E c' r')
      (synth : sv w = some synthesizeChild)
      (quiet : O.quiet w)
      (hr : RunsTo (synthesizeCombinational c) mctx mref cctx cref w r w')
      (ev : E mctx cctx w) : RealChildEX O E c r

theorem RealChildEX.toA {O : RefLawsAOpsX MkRefd mref cref} {E : StartEv} {c : Name} {r : Res}
    (h : RealChildEX O E c r) : RealChildAX O c r := by
  induction h with
  | run mctx cctx w w' adm cache synth quiet hr ev ih =>
    exact RealChildAX.run mctx cctx w w' adm (fun c' r' h' => ih c' r' h') synth quiet hr

def CacheEX (O : RefLawsAOpsX MkRefd mref cref) (E : StartEv) (m : Std.HashMap Name Res) : Prop :=
  ∀ c r, m.get? c = some r → RealChildEX O E c r

def JQHX (O : RefLawsAOpsX MkRefd mref cref) (E : StartEv) (D : Nat) (w : Void IO.RealWorld) : Prop :=
  JQ O.quiet D w ∧ CacheEX O E (cv w)

def EQHX (O : RefLawsAOpsX MkRefd mref cref) (E : StartEv) (D : Nat) : Exception → Void IO.RealWorld → Prop :=
  fun e w => JQHX O E D w ∧ OkExc e

theorem cacheE_emptyX (O : RefLawsAOpsX MkRefd mref cref) (E : StartEv) : CacheEX O E {} := by
  intro c r h
  first
    | simp at h
    | (rw [Std.HashMap.get?_empty] at h; cases h)

theorem cacheE_insertX {O : RefLawsAOpsX MkRefd mref cref} {E : StartEv} {m : Std.HashMap Name Res} {c : Name}
    {r : Res} (h : CacheEX O E m) (hr : RealChildEX O E c r) : CacheEX O E (m.insert c r) := by
  intro c' r' h'
  rw [Std.HashMap.get?_insert] at h'
  split at h'
  · rename_i heq
    have : c = c' := by simpa using heq
    subst this
    cases h'
    exact hr
  · exact h c' r' h'

theorem stableA_JQHX (O : RefLawsAOpsX MkRefd mref cref) (E : StartEv) (D : Nat) : StableA O.quiet (JQHX O E D) :=
  ⟨fun _ h => h.1.1, fun w w' hc hs hd hq h =>
    ⟨(stableA_JQ O.quiet D).2 w w' hc hs hd hq h.1, by rw [hc]; exact h.2⟩⟩

end Defs

variable {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
  {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State}

def MissEX (O : RefLawsAOpsX MkRefd mref cref) (E : StartEv) : Prop :=
  ∀ (mctx : Meta.Context) (cctx : Core.Context), O.adm mctx cctx →
    ∀ (D : Nat), 1 ≤ D → ∀ (n : Name) (w : Void IO.RealWorld),
      JQHX O E D w → (cv w).get? n = none → E mctx cctx w

theorem keepsH_framedX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    (D : Nat) {α : Type} {p : MetaM α} (hp : FramedA MkRefd p) :
    Keeps mctx mref cctx cref (JQHX O E D) p :=
  keepsA_framedX O hA (stableA_JQHX O E D) hp

theorem jqh_cacheGetX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    {D : Nat} {w : Void IO.RealWorld} {m : Std.HashMap Name Res} {w' : Void IO.RealWorld}
    (hw : JQHX O E D w)
    (h : RunsTo (sparkleChildCache.get : MetaM _) mctx mref cctx cref w m w') :
    m = cv w' ∧ JQHX O E D w' := by
  have hk := O.frame hA _ FramedA.cacheGet w hw.1.1
  have hq := O.frameQ hA _ FramedA.cacheGet w hw.1.1
  rw [endW_of_runs h] at hk hq
  exact ⟨(runsTo_get_readOf _ h).trans hk.1.symm, (stableA_JQHX O E D).2 w w' hk.1 hk.2.1 hk.2.2 (fun _ => hq) hw⟩

theorem tripleH_cacheGetX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    (D : Nat) :
    Triple mctx mref cctx cref (JQHX O E D) (sparkleChildCache.get : MetaM _)
      (fun m w => JQHX O E D w ∧ m = cv w) (EQHX O E D) := by
  intro w hw
  have hK := keeps_iff.mp (keepsH_framedX O hA D FramedA.cacheGet) w hw
  cases hm : (sparkleChildCache.get : MetaM _) mctx mref cctx cref w with
  | ok a w1 =>
    obtain ⟨ha, hw1⟩ := jqh_cacheGetX O hA hw hm
    exact ⟨hw1, ha⟩
  | error e w1 => rw [hm] at hK; exact hK

theorem tripleH_clearX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    (D : Nat) {R : Exception → Void IO.RealWorld → Prop} :
    Triple mctx mref cctx cref (JQ O.quiet D) (sparkleChildCache.set {} : MetaM Unit)
      (fun _ => JQHX O E D) R :=
  Triple.of_runs (refSet_runs _ _) fun w u w' hw h => by
    have hk := O.cacheSet hA _ _ _ _ h hw.1
    refine ⟨⟨O.cacheSetQ hA _ _ _ _ h hw.1, hk.2.1.trans hw.2.1, hk.2.2.trans hw.2.2⟩, ?_⟩
    rw [hk.1]; exact cacheE_emptyX O E

theorem tripleH_clear'X (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    (D : Nat) {R : Exception → Void IO.RealWorld → Prop} :
    Triple mctx mref cctx cref (JQHX O E D) (sparkleChildCache.set {} : MetaM Unit)
      (fun _ => JQHX O E D) R :=
  Triple.conseq (tripleH_clearX O hA D) (fun _ h => h.1) (fun _ _ h => h) (fun _ _ h => h)

theorem tripleH_depthSetX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    (D v : Nat) {R : Exception → Void IO.RealWorld → Prop} :
    Triple mctx mref cctx cref (JQHX O E D) (ST.Ref.set sparkleSynthDepth v : MetaM Unit)
      (fun _ => JQHX O E v) R :=
  Triple.of_runs (refSet_runs _ _) fun w u w' hw h => by
    have hk := O.depthSet hA _ _ _ _ h hw.1.1
    refine ⟨⟨O.depthSetQ hA _ _ _ _ h hw.1.1, hk.2.1.trans hw.1.2.1, hk.2.2⟩, ?_⟩
    rw [hk.1]; exact hw.2

theorem tripleH_depthModifyX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    (D : Nat) (f : Nat → Nat) {R : Exception → Void IO.RealWorld → Prop} :
    Triple mctx mref cctx cref (JQHX O E D) (ST.Ref.modify sparkleSynthDepth f : MetaM Unit)
      (fun _ => JQHX O E (f D)) R :=
  Triple.of_runs (refModify_runs _ _) fun w u w' hw h => by
    have hk := O.depthModify' hA f hw.1.1 h
    have hq' : O.quiet w' := by
      obtain ⟨w1, hg, hs⟩ := modify_split sparkleSynthDepth f h
      have hq1 := O.frameQ hA _ FramedA.depthGet w hw.1.1
      rw [endW_of_runs hg] at hq1
      exact O.depthSetQ hA _ _ _ _ hs hq1
    refine ⟨⟨hq', hk.2.1.trans hw.1.2.1, ?_⟩, ?_⟩
    · rw [hk.2.2, hw.1.2.2]
    · rw [hk.1]; exact hw.2

theorem jqh_insert_runsX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    {D : Nat} {n : Name} {r : Res} {w : Void IO.RealWorld} {u : Unit} {w' : Void IO.RealWorld}
    (hw : JQHX O E D w) (hr : RealChildEX O E n r)
    (h : RunsTo (sparkleChildCache.modify (fun m : Std.HashMap Name Res => m.insert n r) :
      MetaM Unit) mctx mref cctx cref w u w') :
    JQHX O E D w' := by
  have hk := O.cacheModify' hA (fun m : Std.HashMap Name Res => m.insert n r) hw.1.1 h
  have hq' : O.quiet w' := by
    obtain ⟨w1, hg, hs⟩ := modify_split sparkleChildCache
      (fun m : Std.HashMap Name Res => m.insert n r) h
    have hq1 := O.frameQ hA _ FramedA.cacheGet w hw.1.1
    rw [endW_of_runs hg] at hq1
    exact O.cacheSetQ hA _ _ _ _ hs hq1
  refine ⟨⟨hq', hk.2.1.trans hw.1.2.1, hk.2.2.trans hw.1.2.2⟩, ?_⟩
  rw [hk.1]; exact cacheE_insertX hw.2 hr

theorem synthesizeChild_tripleHX (O : RefLawsAOpsX MkRefd mref cref) {E : StartEv}
    (hA : O.adm mctx cctx) {D : Nat} (hD : 1 ≤ D) (hmiss : MissEX O E) {n : Name}
    (hentryT : Triple mctx mref cctx cref (JQHX O E D) (synthesizeCombinational n)
      (fun _ => JQHX O E D) (EQHX O E D)) :
    Triple mctx mref cctx cref (JQHX O E D) (synthesizeChild n)
      (fun r w => RealChildEX O E n r ∧ JQHX O E D w) (EQHX O E D) := by
  unfold synthesizeChild
  refine Triple.bind (tripleH_cacheGetX O hA D) ?_
  intro m
  cases hc : m.get? n with
  | some r =>
    try dsimp only
    exact Triple.pure fun w hw => ⟨by rw [hw.2] at hc; exact hw.1.2 n r hc, hw.1⟩
  | none =>
    try dsimp only
    refine Triple.conseq (P := fun w => JQHX O E D w ∧ (cv w).get? n = none) ?_
      (fun _ hw => ⟨hw.1, by rw [← hw.2]; exact hc⟩) (fun _ _ h => h) (fun _ _ h => h)
    refine Triple.bind (triple_withRun
      (Triple.conseq (P' := fun w => JQHX O E D w ∧ (cv w).get? n = none) hentryT (fun _ hw => hw.1) (fun _ _ h => h) (fun _ _ h => h))) ?_
    intro r
    refine Triple.bind (Q := fun _ w => JQHX O E D w ∧ RealChildEX O E n r) ?_
      (fun _ => Triple.pure fun w hw => ⟨hw.2, hw.1⟩)
    refine Triple.of_runs (refModify_runs _ _) fun w u w' hw h => ?_
    obtain ⟨hw2, w1, hw1, hrun⟩ := hw
    have hr : RealChildEX O E n r :=
      RealChildEX.run mctx cctx w1 _ hA hw1.1.2 hw1.1.1.2.1 hw1.1.1.1 hrun (hmiss mctx cctx hA D hD n w1 hw1.1 hw1.2)
    exact ⟨jqh_insert_runsX O hA hw2 hr h, hr⟩

macro "hsetX " O:term:max hA:term:max E:term:max D:term:max : tactic => `(tactic|
  (refine Triple.bind (keeps_iff.mp (keepsA_framedX $O $hA (stableA_JQHX $O $E $D)
      (FramedA.sideSet _ ?s))) ?_
   case s => constructor
   intro _))
macro "hgetX " O:term:max hA:term:max E:term:max D:term:max : tactic => `(tactic|
  (refine Triple.bind (keeps_iff.mp (keepsA_framedX $O $hA (stableA_JQHX $O $E $D)
      (FramedA.sideGet ?s))) ?_
   case s => constructor
   intro _))
macro "hpureX " O:term:max E:term:max D:term:max : tactic => `(tactic|
  (refine Triple.bind (Triple.pure (Q := fun _ => JQHX $O $E $D) (fun w hw => hw)) ?_; intro _))

theorem finHX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv} (d : Nat)
    (m1 : Std.HashMap Lean.Name Lean.Expr) (m2 : Std.HashMap String Nat)
    (m3 m4 m5 : Std.HashMap String String) (m6 : Std.HashMap (UInt64 × String) String)
    (m7 : Std.HashMap String String) :
    Triple mctx mref cctx cref (JQHX O E (d + 1))
      (do
        ST.Ref.modify sparkleSynthDepth fun x => x - 1
        if (d != 0) = true then do
            ST.Ref.set sparkleFvarValueMap m1
            ST.Ref.set sparkleWireWidthCache m2
            ST.Ref.set sparkleLetWireCache m3
            ST.Ref.set sparkleLoopWireCache m4
            ST.Ref.set sparkleWireCanon m5
            ST.Ref.set sparkleSubInstanceOutputs m6
            ST.Ref.set sparkleSingleOutInstanceCache m7
          else pure () : MetaM Unit)
      (fun _ => JQHX O E d) (EQHX O E d) := by
  refine Triple.bind (Triple.conseq (tripleH_depthModifyX O hA (d + 1) (fun x => x - 1))
    (fun _ h => h) (Q' := fun _ => JQHX O E d)
    (fun _ w h => by show JQHX O E d w; have h' : JQHX O E (d + 1 - 1) w := h
                     rw [Nat.add_sub_cancel] at h'; exact h')
    (fun _ _ h => h)) ?_
  intro _
  refine Triple.ite (fun _ => ?_) (fun _ => Triple.pure fun w hw => hw)
  hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d
  exact keeps_iff.mp (keepsA_framedX O hA (stableA_JQHX O E d) (FramedA.sideSet _ .singleOut))

theorem core_tripleAHX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    (D : Nat) (declName : Name)
    (hbodyH : ∀ {tenv : Lean.Environment}, D < sparkleSynthDepthLimit → ∀ (b : Bool) ci isInst,
      Keeps mctx mref cctx cref (JQHX O E (D + 1))
        (synthesizeFromConst (fun e h t n => translateExprToWire tenv e h t n) (profLogIO b)
          declName [] false true ci isInst)) :
    Triple mctx mref cctx cref (JQHX O E D) (synthesizeCombinationalCore declName [] false)
      (fun _ => JQHX O E D) (EQHX O E D) := by
  unfold synthesizeCombinationalCore synthesizeCombinationalCoreWith
  simp only [Bool.false_eq_true, ↓reduceIte]
  refine Triple.bind (keeps_iff.mp (keepsA_framedX O hA (stableA_JQHX O E D) (FramedA.ioEnv _))) ?_
  intro prof
  refine Triple.bind (keeps_iff.mp (keepsA_diagX O hA (stableA_JQHX O E D)
    (Diag.profLog prof.isSome _))) ?_
  intro _
  refine Triple.bindQ (φ := fun d => d = D)
    (Triple.conseq (tripleA_depthGetX O hA (stableA_JQHX O E D)) (fun _ h => h)
      (Q' := fun d w => JQHX O E D w ∧ d = D)
      (fun _ _ h => ⟨h.1, h.2.trans h.1.1.2.2⟩) (fun _ _ h => h)) ?_
  intro d hd
  subst hd  -- guess: K2
  refine Triple.ite (fun _ => ?_) (fun hlt => ?_)
  · -- at the limit: the entry throws before touching the depth
    refine Triple.bind (Q := fun _ _ => False)
      (tripleA_throwErrX O hA (stableA_JQHX O E d) _ (by first | exact .str _ | exact .fmt _)) ?_
    intro _ w hf
    exact hf.elim
  · have hlt : d < sparkleSynthDepthLimit := Nat.lt_of_not_ge hlt
    have body : ∀ (m1 : Std.HashMap Lean.Name Lean.Expr) (m2 : Std.HashMap String Nat)
        (m3 m4 m5 : Std.HashMap String String) (m6 : Std.HashMap (UInt64 × String) String)
        (m7 : Std.HashMap String String),
        Triple mctx mref cctx cref (JQHX O E (d + 1))
          (_root_.tryFinally
            (do
              let constInfo ← getConstInfo declName
              let env ← getEnv
              if (entryInlinerError? env true false [] constInfo (instancePredicate env)).isSome then
                throwError (stringToMessageData s!"{declName}: {(entryInlinerError? env true false []
                  constInfo (instancePredicate env)).getD ""}")
              else
              synthesizeFromConst (fun e h t n => translateExprToWire env e h t n)
                (profLogIO prof.isSome) declName [] false true
                (entryConst true false [] constInfo (instancePredicate env) (userInliner env)
                  (structEnv env))
                (instancePredicate env))
            (do
              ST.Ref.modify sparkleSynthDepth fun x => x - 1
              if (d != 0) = true then do
                  ST.Ref.set sparkleFvarValueMap m1
                  ST.Ref.set sparkleWireWidthCache m2
                  ST.Ref.set sparkleLetWireCache m3
                  ST.Ref.set sparkleLoopWireCache m4
                  ST.Ref.set sparkleWireCanon m5
                  ST.Ref.set sparkleSubInstanceOutputs m6
                  ST.Ref.set sparkleSingleOutInstanceCache m7
                else pure () : MetaM Unit))
          (fun _ => JQHX O E d) (EQHX O E d) := by
      intro m1 m2 m3 m4 m5 m6 m7
      refine Triple.tryFinally (M := JQHX O E (d + 1)) (E := OkExc) ?_
        (finHX O hA d m1 m2 m3 m4 m5 m6 m7)
      refine Triple.bind (keeps_iff.mp (keepsA_framedX O hA (stableA_JQHX O E (d + 1))
        (FramedA.constInfo _))) ?_
      intro ci
      refine Triple.bind (keeps_iff.mp (keepsA_framedX O hA (stableA_JQHX O E (d + 1))
        FramedA.env)) ?_
      intro env
      refine Triple.ite (fun _ => ?_) (fun _ => ?_)
      · exact tripleA_throwErrX O hA (stableA_JQHX O E (d + 1)) _ (by first | exact .str _ | exact .fmt _)
      · exact keeps_iff.mp (hbodyH hlt prof.isSome _ _)
    by_cases h0 : (d == 0) = true
    · -- outermost: the cache is cleared, the cache half re-established
      simp only [h0, ↓reduceIte]
      hpureX O E d; hpureX O E d; hpureX O E d; hpureX O E d; hpureX O E d; hpureX O E d; hpureX O E d
      hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d
      refine Triple.bind (tripleH_clear'X O hA d) ?_
      intro _
      hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d
      refine Triple.bind (tripleH_depthSetX O hA d (d + 1)) ?_
      intro _
      exact body _ _ _ _ _ _ _  -- guess: K4
    · -- nested: the parent's maps are read (and restored in the `finally`), no clear
      simp only [h0, Bool.false_eq_true, ↓reduceIte]  -- guess: K3
      hgetX O hA E d; hgetX O hA E d; hgetX O hA E d; hgetX O hA E d; hgetX O hA E d; hgetX O hA E d; hgetX O hA E d
      hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d; hsetX O hA E d
      refine Triple.bind (tripleH_depthSetX O hA d (d + 1)) ?_
      intro _
      exact body _ _ _ _ _ _ _

theorem full_tripleAHX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    {D : Nat} {declName : Name}
    (hcore : Triple mctx mref cctx cref (JQHX O E D) (synthesizeCombinationalCore declName [] false)
      (fun _ => JQHX O E D) (EQHX O E D)) :
    Triple mctx mref cctx cref (JQHX O E D) (synthesizeCombinational declName)
      (fun _ => JQHX O E D) (EQHX O E D) := by
  unfold synthesizeCombinational synthesizeCombinationalWith
  refine Triple.bind hcore ?_
  rintro ⟨m, dd⟩
  dsimp only
  refine Triple.bind (keeps_iff.mp (keepsA_framedX O hA (stableA_JQHX O E D) (FramedA.ioEnv _))) ?_
  intro x
  exact Triple.ite (fun _ => Triple.pure fun w hw => hw) (fun _ => Triple.pure fun w hw => hw)


theorem hentryT_of_bodyHX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx) {E : StartEv}
    {D : Nat} {c : Name}
    (hbodyH : ∀ {tenv : Lean.Environment}, D < sparkleSynthDepthLimit → ∀ (b : Bool) ci isInst,
      Keeps mctx mref cctx cref (JQHX O E (D + 1))
        (synthesizeFromConst (fun e h t n => translateExprToWire tenv e h t n) (profLogIO b)
          c [] false true ci isInst)) :
    Triple mctx mref cctx cref (JQHX O E D) (synthesizeCombinational c)
      (fun _ => JQHX O E D) (EQHX O E D) :=
  full_tripleAHX O hA (core_tripleAHX O hA D c @hbodyH)

theorem synthesizeChild_tripleH'X (O : RefLawsAOpsX MkRefd mref cref) {E : StartEv}
    (hA : O.adm mctx cctx) {D : Nat} (hD : 1 ≤ D) (hmiss : MissEX O E) {n : Name}
    (hbodyH : ∀ {tenv : Lean.Environment}, D < sparkleSynthDepthLimit → ∀ (b : Bool) ci isInst,
      Keeps mctx mref cctx cref (JQHX O E (D + 1))
        (synthesizeFromConst (fun e h t n => translateExprToWire tenv e h t n) (profLogIO b)
          n [] false true ci isInst)) :
    Triple mctx mref cctx cref (JQHX O E D) (synthesizeChild n)
      (fun r w => RealChildEX O E n r ∧ JQHX O E D w) (EQHX O E D) :=
  synthesizeChild_tripleHX O hA hD hmiss (hentryT_of_bodyHX O hA @hbodyH)

theorem synthesizeChild_realH'X (O : RefLawsAOpsX MkRefd mref cref) {E : StartEv}
    (hA : O.adm mctx cctx) {D : Nat} (hD : 1 ≤ D) (hmiss : MissEX O E) {n : Name}
    (hbodyH : ∀ {tenv : Lean.Environment}, D < sparkleSynthDepthLimit → ∀ (b : Bool) ci isInst,
      Keeps mctx mref cctx cref (JQHX O E (D + 1))
        (synthesizeFromConst (fun e h t n => translateExprToWire tenv e h t n) (profLogIO b)
          n [] false true ci isInst))
    {w w' : Void IO.RealWorld} {y : Res} (hw : JQHX O E D w)
    (h : RunsTo (synthesizeChild n) mctx mref cctx cref w y w') :
    RealChildEX O E n y ∧ JQHX O E D w' :=
  runs_of_triple (synthesizeChild_tripleH'X O hA hD hmiss @hbodyH) hw h

