import Tools.ShippingFGCircuitS2zGenTables
import Tools.ShippingFGCircuitS2gGates
set_option autoImplicit false
-- FG circuit pilot S3a: UNTRUSTED generator of `Sparkle/Compiler/PilotKidTables.lean` (the closed type/value/inlined value of the two callees as Lean source).
-- Nothing here is trusted: the equality of the generated terms with `httpType`/`httpValue`/`httpInlValue`/`tlp…` is a kernel-checked theorem (`Tools.ShippingFGCircuitS3aKids`). No sorry/axiom/native_decide/TRUSTED/law.
set_option maxHeartbeats 0
set_option maxRecDepth 1000000
namespace Tools.ShippingFGCircuitS3aGenKids
open Lean Tools.ShippingFGCircuitS2zGenTables Tools.ShippingFGCircuitS2gGates

def genSource : String := Id.run do
  let terms : List (String × Expr) := [("httpT", httpType), ("httpV", httpValue), ("httpVi", httpInlValue),
                                       ("tlpT", tlpType), ("tlpV", tlpValue), ("tlpVi", tlpInlValue)]
  let act : G (Array (String × Nat) × String × String) := do
    let mut rows := #[]
    for (n, e) in terms do rows := rows.push (n, ← internE e)
    let h ← nameSrc Tools.ShippingFGCircuitS1kStmt.hftHttp
    let t ← nameSrc Tools.ShippingFGCircuitS1kStmt.hftTlp
    pure (rows, h, t)
  let ((rows, hN, tN), st) := act.run {}
  let mut cnt : Array Nat := Array.replicate st.nodes.size 0
  for n in st.nodes do
    for k in kids n do cnt := cnt.modify k (· + 1)
  for (_, v) in rows do cnt := cnt.modify v (· + 1)
  let isShared (i : Nat) : Bool := cnt[i]! ≥ 2 && !(match st.nodes[i]! with | .leaf _ => true | _ => false)
  let rec ref (i : Nat) (fuel : Nat) : String :=
    match fuel with
    | 0 => "(panic! \"fuel\")"
    | fuel + 1 => if isShared i then s!"ex{i}" else s!"({body (fun j => ref j fuel) st.nodes[i]!})"
  let mut out := "import Lean\nimport Sparkle.Compiler.KidFactsCheck\nimport Sparkle.Compiler.PilotEnvTables\n\n"
  out := out ++ "/-! # The pilot's callee terms (GENERATED, untrusted)\n\n"
  out := out ++ "Generated by `Tools/ShippingFGCircuitS3aGenKids.lean` from `httpType`/`httpValue`/`httpInlValue` and `tlpType`/`tlpValue`/`tlpInlValue` (`Tools.ShippingFGCircuitS2gGates`).\n"
  out := out ++ "Their equality with those terms is a kernel-checked theorem in `Tools/ShippingFGCircuitS3aKids.lean`; nothing here is trusted. -/\n"
  out := out ++ "namespace Sparkle.Compiler.PilotKidTables\nopen Lean Sparkle.Compiler.EnvTableCheck Sparkle.Compiler.KidFactsCheck Sparkle.Compiler.PilotEnvTables\nset_option maxRecDepth 100000\n\n"
  for (id, b) in st.nameOrder do out := out ++ s!"def {id} : Name := {b}\n"
  out := out ++ "\n"
  let mut i := 0
  for n in st.nodes do
    if isShared i then out := out ++ s!"def ex{i} : Expr := {body (fun j => ref j 100000) n}\n"
    i := i + 1
  out := out ++ "\n"
  for (n, v) in rows do out := out ++ s!"def {n} : Expr := {ref v 100000}\n"
  out := out ++ s!"\ndef hftHttpName : Name := {hN}\ndef hftTlpName : Name := {tN}\n"
  out := out ++ "\n/-- the finite facts about the two callees at `env`, asked of the compiler's own `inl`/`ip`/`peel` -/\n"
  out := out ++ "def kidsOkB (env : Environment) (inl : Expr → Expr) (ip : Expr → Bool) (peel : Expr → Expr) : Bool :=\n"
  out := out ++ "  kidRowOkB env inl ip peel hftHttpName httpT httpV httpVi && kidRowOkB env inl ip peel hftTlpName tlpT tlpV tlpVi\n"
  out := out ++ "\n/-- the second check of the Off entry: for the pilot root the callee facts must hold at the start environment; every other declaration is unconstrained -/\n"
  out := out ++ "def startKidsOk (declName : Name) (env : Environment) (inl : Expr → Expr) (ip : Expr → Bool) (peel : Expr → Expr) : Bool :=\n"
  out := out ++ "  if declName == hftRootName then kidsOkB env inl ip peel else true\n"
  out := out ++ "\nend Sparkle.Compiler.PilotKidTables\n"
  return out

end Tools.ShippingFGCircuitS3aGenKids
