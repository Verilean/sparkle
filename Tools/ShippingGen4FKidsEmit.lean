variable {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
  {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State}

set_option hygiene false in
macro "karmK" : tactic => `(tactic| swalkN [makeWirePS M hA hS, emitAssignPS, addInputPS M hA hS, bindSourceVariablePS,
  lookupVarPS, emitRegisterStmtPS, emitRegisterPS M hA hS, emitMemoryPS M hA hS, freshNamePS, emitInstancePS,
  addModuleToDesignA,
  keepsK_framedNM M hA hS (FramedNM.freshFVar (Fresh := MkRefd))])

/-! ## The result emitters -/

section Emit
variable {O : RefLawsAOps MkRefd mref cref} (M : MemoFamily O) (hA : AdmCtx O.quiet mctx cctx)
  {I : Void IO.RealWorld → Prop} (hS : StableK O.quiet I)
include M hA hS

theorem emitBoolResultKS (rhs : Sparkle.IR.AST.Expr) (hint : String) (named : Bool) :
    KeepsCS mctx mref cctx cref I (emitBoolResult rhs hint named) := by
  unfold emitBoolResult
  karmK

theorem emitCompareResultKS (le : SignalCompareKind) (a b hint : String) (named : Bool) :
    KeepsCS mctx mref cctx cref I (emitCompareResult le a b hint named) := by
  unfold emitCompareResult
  exact emitBoolResultKS M hA hS _ _ _

theorem emitBoolLiteralKS (value : Bool) (hint : String) (named : Bool) :
    KeepsCS mctx mref cctx cref I (emitBoolLiteral value hint named) := by
  unfold emitBoolLiteral
  exact emitBoolResultKS M hA hS _ _ _

theorem emitCastResultKS (rhs : Sparkle.IR.AST.Expr) (wt : Nat) (hint : String) (named : Bool) :
    KeepsCS mctx mref cctx cref I (emitCastResult rhs wt hint named) := by
  unfold emitCastResult
  karmK

theorem emitSliceResultKS (rhs : Sparkle.IR.AST.Expr) (len : Nat) (hint : String) (named : Bool) :
    KeepsCS mctx mref cctx cref I (emitSliceResult rhs len hint named) := by
  unfold emitSliceResult
  karmK

theorem emitMuxResultKS (c t el hint : String) (named : Bool) (ty : Sparkle.IR.Type.HWType) :
    KeepsCS mctx mref cctx cref I (emitMuxResult c t el hint named ty) := by
  unfold emitMuxResult
  karmK

theorem emitConcatConstKS (k v : Nat) :
    KeepsCS mctx mref cctx cref I (emitConcatConst k v) := by
  unfold emitConcatConst
  exact emitCastResultKS M hA hS _ _ _ _

theorem translateConcatActsKS (w : Nat) (hiAct loAct : CompilerM String)
    (hhi : KeepsCS mctx mref cctx cref I hiAct) (hlo : KeepsCS mctx mref cctx cref I loAct)
    (hint : String) (named : Bool) :
    KeepsCS mctx mref cctx cref I (translateConcatActs w hiAct loAct hint named) := by
  unfold translateConcatActs
  refine KeepsCS.bind (makeWirePS M hA hS _ _ _) (fun _ => ?_)
  refine KeepsCS.bind hhi (fun _ => ?_)
  refine KeepsCS.bind hlo (fun _ => ?_)
  refine KeepsCS.bind (emitAssignPS _ _) (fun _ => ?_)
  exact KeepsCS.pure _

end Emit

/-! ## The arms (given the recursive argument at this context) -/

section Arms
variable {O : RefLawsAOps MkRefd mref cref} (M : MemoFamily O) (hA : AdmCtx O.quiet mctx cctx)
  {I : Void IO.RealWorld → Prop} (hS : StableK O.quiet I) (rec : TranslateFn)
  (hrec : ∀ e hint top named, KeepsCS mctx mref cctx cref I (rec e hint top named))
include M hA hS hrec

theorem translateMuxWithKS (resultType : CompilerM Sparkle.IR.Type.HWType)
    (hres : KeepsCS mctx mref cctx cref I resultType) (c t el : Lean.Expr) (hint : String)
    (named : Bool) :
    KeepsCS mctx mref cctx cref I (translateMuxWith rec resultType c t el hint named) := by
  unfold translateMuxWith
  refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
  refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
  refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
  refine KeepsCS.bind hres (fun _ => ?_)
  exact emitMuxResultKS M hA hS _ _ _ _ _ _

theorem translateBoolBinaryKS (kind : SignalBoolBinKind) (a b : Lean.Expr) (hint : String)
    (named : Bool) :
    KeepsCS mctx mref cctx cref I (translateBoolBinary rec kind a b hint named) := by
  unfold translateBoolBinary
  refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
  refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
  exact emitBoolResultKS M hA hS _ _ _

