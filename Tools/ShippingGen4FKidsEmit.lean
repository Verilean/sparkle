theorem translateAppBool2KS (f : AppBool2) (a b : Lean.Expr) (hint : String) (named : Bool) :
    KeepsCS mctx mref cctx cref I (translateAppBool2 rec f a b hint named) := by
  unfold translateAppBool2
  refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
  refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
  refine KeepsCS.bind (emitBoolResultKS M hA hS _ _ _) (fun _ => ?_)
  exact emitBoolResultKS M hA hS _ _ _

theorem translateAppBoolKS (op : AppBoolOp) (a b : Lean.Expr) (hint : String) (named : Bool) :
    KeepsCS mctx mref cctx cref I (translateAppBool rec op a b hint named) := by
  unfold translateAppBool
  split
  · exact translateAppCompareKS M hA hS rec hrec _ _ _ _ _
  · exact translateAppBoolBinaryKS M hA hS rec hrec _ _ _ _ _
  · exact translateAppBool2KS M hA hS rec hrec _ _ _ _ _

/-- **The Bool-control arm**: literals, compares, Bool binary operators, the Bool
mux, complement, applicative Bool ops — and, for any other shape, the legacy
handler handed in (`hleg`). -/
theorem translateBoolUncachedWithKS (legacy : TranslateFn)
    (hleg : ∀ e hint top named, KeepsCS mctx mref cctx cref I (legacy e hint top named))
    (e : Lean.Expr) (hint : String) (top named : Bool) :
    KeepsCS mctx mref cctx cref I (translateBoolUncachedWith rec legacy e hint top named) := by
  unfold translateBoolUncachedWith
  try dsimp only
  swalkN [hleg _ _ _ _, emitBoolLiteralKS M hA hS _ _ _, translateSignalCompareKS M hA hS rec hrec _ _ _ _ _, translateBoolBinaryKS M hA hS rec hrec _ _ _ _ _, translateMuxWithKS M hA hS rec hrec _ (KeepsCS.pure _) _ _ _ _ _, translateAppBoolKS M hA hS rec hrec _ _ _ _ _]  -- guess: F3

theorem translateVectorMuxUncachedWithKS (n : Nat) (e : Lean.Expr) (hint : String)
    (top named : Bool) :
    KeepsCS mctx mref cctx cref I (translateVectorMuxUncachedWith rec n e hint top named) := by
  unfold translateVectorMuxUncachedWith
  exact translateMuxWithKS M hA hS rec hrec _ (KeepsCS.pure _) _ _ _ _ _

