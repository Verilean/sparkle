/-- One recursive translation per instance operand. -/
theorem instArgsKS :
    ∀ (rest : List (Sparkle.IR.AST.Port × Lean.Expr)) (acc : List (String × Sparkle.IR.AST.Expr))
      (i : Nat), KeepsCS mctx mref cctx cref I (instArgs rec acc rest i)
  | [], acc, i => by unfold instArgs; exact KeepsCS.pure _
  | (p, a) :: rest, acc, i => by
    have ih := fun acc i => instArgsKS rest acc i
    unfold instArgs
    refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
    exact ih _ _

end Arms

