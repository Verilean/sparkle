variable {mref : ST.Ref IO.RealWorld Meta.State} {cref : ST.Ref IO.RealWorld Core.State}

/-- `Rec.translateExprToWireImpl` (the legacy translator's main body). HYPOTHESIS of `translateFallbackKS`. -/
def LegacyImplKS (O : RefLawsAOps MkRefd mref cref) (I : Void IO.RealWorld → Prop) : Prop :=
  ∀ rec, RecKS O I rec →
    RecKS O I (fun e h t n => Rec.translateExprToWireImpl (fun e h t n => rec e h t n) e h t n)

/-- `Rec.translateExprToWireCached` (its cache wrapper). HYPOTHESIS of `translateFallbackKS`. -/
def LegacyCachedKS (O : RefLawsAOps MkRefd mref cref) (I : Void IO.RealWorld → Prop) : Prop :=
  ∀ rec, RecKS O I rec →
    RecKS O I (fun e h t n => Rec.translateExprToWireCached (fun e h t n => rec e h t n) e h t n)

/-- `childSynthEntry` (the child recursion). HYPOTHESIS of `translateFallbackKS`. -/
def ChildEntryKS (O : RefLawsAOps MkRefd mref cref) (I : Void IO.RealWorld → Prop) : Prop :=
  ∀ (mctx : Meta.Context) (cctx : Core.Context), AdmCtx O.quiet mctx cctx →
    ∀ c, Triple mctx mref cctx cref I (childSynthEntry c)
      (fun r w => I w ∧ PairPF r) (fun e w => I w ∧ OkExc e)

/-- **The fallback, one arm per `fallbackKind`**, for `StableK`. -/
theorem translateFallbackKS {O : RefLawsAOps MkRefd mref cref} (M : MemoFamily O)
    {I : Void IO.RealWorld → Prop} (hS : StableK O.quiet I) (tenv : Lean.Environment)
    (hImpl : LegacyImplKS O I) (hCached : LegacyCachedKS O I) (hchild : ChildEntryKS O I)
    (rec : TranslateFn) (hrec : RecKS O I rec) : RecKS O I (translateFallback tenv rec) := by
  intro mctx cctx hA e hint top named
  have hr := hrec mctx cctx hA
  have hI := hImpl rec hrec mctx cctx hA
  have hC := hCached rec hrec mctx cctx hA
  unfold translateFallback
  try dsimp only
  split
  all_goals swalkN [translateControlCachedWithKS M hA hS,
    (translateBoolUncachedWithKS M hA hS rec hr _ (fun e h t n => hI e h t n)),
    translateVectorMuxUncachedWithKS M hA hS rec hr, translateSetWidthUncachedWithKS M hA hS rec hr,
    translateRegisterUncachedWithKS M hA hS rec hr,
    translateRegisterEnableUncachedWithKS M hA hS rec hr,
    translateLoopRegisterUncachedWithKS M hA hS rec hr,
    translateCircuitDoUncachedWithKS M hA hS rec hr,
    translateCircuitDo2UncachedWithKS M hA hS rec hr,
    translateMemoryUncachedWithKS M hA hS rec hr, translateSliceUncachedWithKS M hA hS rec hr,
    translateConcatUncachedWithKS M hA hS rec hr, translateConcatLitUncachedWithKS M hA hS rec hr,
    translateSliceFUncachedWithKS M hA hS rec hr,
    (translateInstanceOrFallbackKS M hA hS rec hr tenv (hchild mctx cctx hA)
      (fun n s => projFieldNameKS M hA hS n s) (fun a => canonHardwareKeyKS M hA hS a)
      (fun e h t n => hC e h t n))]

/-- **The shipping translator keeps a `StableK` invariant**, in every admissible context and every
`CtxOk` compiler context, given exactly `LegacyImplKS`, `LegacyCachedKS`, `ChildEntryKS`. -/
theorem translate_keepsKS {O : RefLawsAOps MkRefd mref cref} (M : MemoFamily O)
    {I : Void IO.RealWorld → Prop} (hS : StableK O.quiet I) (tenv : Lean.Environment)
    (hImpl : LegacyImplKS O I) (hCached : LegacyCachedKS O I) (hchild : ChildEntryKS O I) :
    RecKS O I (fun e h t n => translateExprToWire tenv e h t n) :=
  translateK_of_fallbackS M hS tenv
    (fun rec hrec => translateFallbackKS M hS tenv hImpl hCached hchild rec hrec)

end Tools.ShippingGen4FKidsFallback

