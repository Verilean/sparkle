/-! ## The `JQCX` analogues of DepthA's definitions -/

/-- **The memoised child entry at depth `D`** keeps `JQCX` in every admissible context. -/
def ChildKeepsCX (O : RefLawsAOpsX MkRefd mref cref) (D : Nat) : Prop :=
  ∀ (mctx : Meta.Context) (cctx : Core.Context), O.adm mctx cctx →
    ∀ c, Keeps mctx mref cctx cref (JQCX O D) (synthesizeChild c)

/-- The body at depth `D` keeps `JQCX` (every admissible context, declaration and constant). -/
def BodyKeepsCX (O : RefLawsAOpsX MkRefd mref cref) (D : Nat) : Prop :=
  ∀ (mctx : Meta.Context) (cctx : Core.Context), O.adm mctx cctx →
    ∀ (declName : Name) (tenv : Lean.Environment) (b : Bool) (ci : ConstantInfo)
      (isInst : Lean.Expr → Bool),
    Keeps mctx mref cctx cref (JQCX O D)
      (synthesizeFromConst (fun e h t n => translateExprToWire tenv e h t n) (profLogIO b)
        declName [] false true ci isInst)

/-- **The remaining lemma at `JQCX`** (PREMISE): at every depth `D ≥ 1` the body keeps `JQCX`
given the child entry does at `D`. -/
def BodyStepCX (O : RefLawsAOpsX MkRefd mref cref) : Prop :=
  ∀ D, 1 ≤ D → ChildKeepsCX O D → BodyKeepsCX O D

/-! ## The depth induction -/

/-- One step: the child entry at `D` from the body at `D + 1`. -/
theorem childKeepsC_of_bodyX (O : RefLawsAOpsX MkRefd mref cref) (D : Nat)
    (hB : D < sparkleSynthDepthLimit → BodyKeepsCX O (D + 1)) : ChildKeepsCX O D := by
  intro mctx cctx hA c
  rw [keeps_iff]
  refine Triple.conseq (synthesizeChild_tripleC'X O hA (D := D) (n := c) ?_)
    (fun _ h => h) (fun _ _ h => h.2) (fun _ _ h => h)
  intro tenv hl b ci isInst
  exact hB hl mctx cctx hA c tenv b ci isInst

/-- **The depth induction at `JQCX`** (on `sparkleSynthDepthLimit - D`). -/
theorem childKeepsC_allX (O : RefLawsAOpsX MkRefd mref cref) (hB : BodyStepCX O) :
    ∀ D, 1 ≤ D → ChildKeepsCX O D := by
  have key : ∀ k D, sparkleSynthDepthLimit - D = k → 1 ≤ D → ChildKeepsCX O D := by
    intro k
    induction k with
    | zero =>
      intro D hk hD
      exact childKeepsC_of_bodyX O D (fun hl => absurd hl (by omega))
    | succ k ih =>
      intro D hk hD
      exact childKeepsC_of_bodyX O D
        (fun _ => hB (D + 1) (by omega) (ih (D + 1) (by omega) (by omega)))
  intro D hD
  exact key _ D rfl hD

/-- The synthesis ref's read under `JQCX`: it returns `some synthesizeChild`. -/
theorem tripleC_synthReadX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    (D : Nat) :
    Triple mctx mref cctx cref (JQCX O D) (sparkleChildSynth.get : MetaM _)
      (fun s w => JQCX O D w ∧ s = some synthesizeChild)
      (fun e w => JQCX O D w ∧ OkExc e) := by
  intro w hw
  have hK := keeps_iff.mp (keepsA_framedX O hA (stableA_JQCX O D) FramedA.synthGet) w hw
  cases hm : (sparkleChildSynth.get : MetaM _) mctx mref cctx cref w with
  | ok a w1 =>
    rw [hm] at hK
    exact ⟨hK, (runsTo_get_readOf _ hm).trans hw.1.2.1⟩  -- guess: E3
  | error e w1 => rw [hm] at hK; exact hK

/-- **`ChildEntryAX` at `JQCX O D` from `ChildKeepsCX O D`.** -/
theorem childEntryA_of_childKeepsCX (O : RefLawsAOpsX MkRefd mref cref) (D : Nat)
    (hC : ChildKeepsCX O D) : ChildEntryAX O (JQCX O D) := by
  intro mctx cctx hA c
  rw [keeps_iff]
  unfold childSynthEntry
  refine Triple.bindQ (tripleC_synthReadX O hA D) ?_
  intro s hs
  subst hs
  exact keeps_iff.mp (hC mctx cctx hA c)

/-! ## The outermost entry: `JQ` in, `JQCX` after the clear -/

/-- **The outermost core entry from `JQ`** (depth `D = 0`, stated with `hD0` so the proof can
copy CoreC's walk): exceptions are `EQ` — raised before the clear, with no `CacheInvAX` — or weakened
from `EQCX` after it. -/
theorem core0_tripleAC_auxX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    (D : Nat) (hD0 : D = 0) (declName : Name)
    (hbodyC : ∀ {tenv : Lean.Environment}, D < sparkleSynthDepthLimit → ∀ (b : Bool) ci isInst,
      Keeps mctx mref cctx cref (JQCX O (D + 1))
        (synthesizeFromConst (fun e h t n => translateExprToWire tenv e h t n) (profLogIO b)
          declName [] false true ci isInst)) :
    Triple mctx mref cctx cref (JQ O.quiet D) (synthesizeCombinationalCore declName [] false)
      (fun _ => JQCX O D) (EQ O.quiet D) := by
  unfold synthesizeCombinationalCore synthesizeCombinationalCoreWith
  simp only [Bool.false_eq_true, ↓reduceIte]
  refine Triple.bind (keeps_iff.mp (keepsA_framedX O hA (stableA_JQ _ D) (FramedA.ioEnv _))) ?_
  intro prof
  refine Triple.bind (keeps_iff.mp (keepsA_diagX O hA (stableA_JQ _ D)
    (Diag.profLog prof.isSome _))) ?_
  intro _
  refine Triple.bindQ (φ := fun d => d = D)
    (Triple.conseq (tripleA_depthGetX O hA (stableA_JQ _ D)) (fun _ h => h)
      (Q' := fun d w => JQ O.quiet D w ∧ d = D)
      (fun _ _ h => ⟨h.1, h.2.trans h.1.2.2⟩) (fun _ _ h => h)) ?_
  intro d hd
  subst hd  -- guess: E2
  refine Triple.ite (fun _ => ?_) (fun hlt => ?_)
  · refine Triple.bind (Q := fun _ _ => False)
      (tripleA_throwErrX O hA (stableA_JQ _ d) _ (by first | exact .str _ | exact .fmt _)) ?_
    intro _ w hf
    exact hf.elim
  · have hlt : d < sparkleSynthDepthLimit := Nat.lt_of_not_ge hlt
    have body : ∀ (m1 : Std.HashMap Lean.Name Lean.Expr) (m2 : Std.HashMap String Nat)
        (m3 m4 m5 : Std.HashMap String String) (m6 : Std.HashMap (UInt64 × String) String)
        (m7 : Std.HashMap String String),
        Triple mctx mref cctx cref (JQCX O (d + 1))
          (_root_.tryFinally
            (do
              let constInfo ← getConstInfo declName
              let env ← getEnv
              if (entryInlinerError? env true false [] constInfo (instancePredicate env)).isSome then
                throwError (stringToMessageData s!"{declName}: {(entryInlinerError? env true false []
                  constInfo (instancePredicate env)).getD ""}")
              else
              synthesizeFromConst (fun e h t n => translateExprToWire env e h t n)
                (profLogIO prof.isSome) declName [] false true
                (entryConst true false [] constInfo (instancePredicate env) (userInliner env)
                  (structEnv env))
                (instancePredicate env))
            (do
              ST.Ref.modify sparkleSynthDepth fun x => x - 1
              if (d != 0) = true then do
                  ST.Ref.set sparkleFvarValueMap m1
                  ST.Ref.set sparkleWireWidthCache m2
                  ST.Ref.set sparkleLetWireCache m3
                  ST.Ref.set sparkleLoopWireCache m4
                  ST.Ref.set sparkleWireCanon m5
                  ST.Ref.set sparkleSubInstanceOutputs m6
                  ST.Ref.set sparkleSingleOutInstanceCache m7
                else pure () : MetaM Unit))
          (fun _ => JQCX O d) (EQCX O d) := by
      intro m1 m2 m3 m4 m5 m6 m7
      refine Triple.tryFinally (M := JQCX O (d + 1)) (E := OkExc) ?_
        (finCX O hA d m1 m2 m3 m4 m5 m6 m7)
      refine Triple.bind (keeps_iff.mp (keepsA_framedX O hA (stableA_JQCX O (d + 1))
        (FramedA.constInfo _))) ?_
      intro ci
      refine Triple.bind (keeps_iff.mp (keepsA_framedX O hA (stableA_JQCX O (d + 1))
        FramedA.env)) ?_
      intro env
      refine Triple.ite (fun _ => ?_) (fun _ => ?_)
      · exact tripleA_throwErrX O hA (stableA_JQCX O (d + 1)) _ (by first | exact .str _ | exact .fmt _)
      exact keeps_iff.mp (hbodyC hlt prof.isSome _ _)
    have h0 : (d == 0) = true := by simp [hD0]
    simp only [h0, ↓reduceIte]
    -- before the clear there is no cache half: `JQ`, exceptions `EQ`
    apure O.quiet d; apure O.quiet d; apure O.quiet d; apure O.quiet d; apure O.quiet d
    apure O.quiet d; apure O.quiet d
    asetX O hA d; asetX O hA d; asetX O hA d; asetX O hA d
    refine Triple.bind (tripleC_clearX O hA d (R := EQ O.quiet d)) ?_
    intro _
    refine Triple.conseq (P := JQCX O d) (R := EQCX O d) ?_ (fun _ h => h) (fun _ _ h => h)
      (fun _ _ h => ⟨h.1.1, h.2⟩)
    csetX O hA d; csetX O hA d; csetX O hA d; csetX O hA d; csetX O hA d; csetX O hA d; csetX O hA d
    refine Triple.bind (tripleC_depthSetX O hA d (d + 1)) ?_
    intro _
    exact body _ _ _ _ _ _ _

/-- **The outermost core entry from `JQ O.quiet 0`** (= `OutQ`): success `JQCX O 0`, exceptions
`EQ O.quiet 0`. The only premise: `hbodyC` (the body at depth 1 under `JQCX`). -/
theorem core0_tripleACX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    (declName : Name)
    (hbodyC : ∀ {tenv : Lean.Environment}, 0 < sparkleSynthDepthLimit → ∀ (b : Bool) ci isInst,
      Keeps mctx mref cctx cref (JQCX O 1)
        (synthesizeFromConst (fun e h t n => translateExprToWire tenv e h t n) (profLogIO b)
          declName [] false true ci isInst)) :
    Triple mctx mref cctx cref (JQ O.quiet 0) (synthesizeCombinationalCore declName [] false)
      (fun _ => JQCX O 0) (EQ O.quiet 0) :=
  core0_tripleAC_auxX O hA 0 rfl declName @hbodyC

/-- The full outermost entry: the core, one environment read, pure post-processing. -/
theorem full0_tripleACX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    {declName : Name}
    (hcore : Triple mctx mref cctx cref (JQ O.quiet 0)
      (synthesizeCombinationalCore declName [] false) (fun _ => JQCX O 0) (EQ O.quiet 0)) :
    Triple mctx mref cctx cref (JQ O.quiet 0) (synthesizeCombinational declName)
      (fun _ => JQCX O 0) (EQ O.quiet 0) := by
  unfold synthesizeCombinational synthesizeCombinationalWith
  refine Triple.bind hcore ?_
  rintro ⟨m, dd⟩
  dsimp only
  refine Triple.bind (Triple.conseq
    (keeps_iff.mp (keepsA_framedX O hA (stableA_JQCX O 0) (FramedA.ioEnv _)))
    (fun _ h => h) (fun _ _ h => h) (fun _ _ h => ⟨h.1.1, h.2⟩)) ?_
  intro x
  exact Triple.ite (fun _ => Triple.pure fun w hw => hw) (fun _ => Triple.pure fun w hw => hw)

/-! ## Discharging `hbodyC` from `BodyStepCX` -/

/-- CoreC's `hbodyC` at depth `D`, for every declaration, from `BodyStepCX`. -/
theorem hbodyC_of_stepX (O : RefLawsAOpsX MkRefd mref cref) (hB : BodyStepCX O)
    (hA : O.adm mctx cctx) (D : Nat) (c : Name) :
    ∀ {tenv : Lean.Environment}, D < sparkleSynthDepthLimit → ∀ (b : Bool) ci isInst,
      Keeps mctx mref cctx cref (JQCX O (D + 1))
        (synthesizeFromConst (fun e h t n => translateExprToWire tenv e h t n) (profLogIO b)
          c [] false true ci isInst) :=
  fun {tenv} _ b ci isInst =>
    hB (D + 1) (by omega) (childKeepsC_allX O hB (D + 1) (by omega)) mctx cctx hA c tenv b ci isInst

/-- **The outermost core entry from `BodyStepCX` alone**: `OutQ`-state in, success `JQCX O 0`,
exceptions `EQ O.quiet 0`. -/
theorem core_tripleAC_of_bodiesX (O : RefLawsAOpsX MkRefd mref cref)
    (hA : O.adm mctx cctx) (declName : Name) (hB : BodyStepCX O) :
    Triple mctx mref cctx cref (JQ O.quiet 0) (synthesizeCombinationalCore declName [] false)
      (fun _ => JQCX O 0) (EQ O.quiet 0) :=
  core0_tripleACX O hA declName (hbodyC_of_stepX O hB hA 0 declName)

/-- **The outermost full entry from `BodyStepCX` alone.** -/
theorem full_tripleAC_of_bodiesX (O : RefLawsAOpsX MkRefd mref cref)
    (hA : O.adm mctx cctx) (declName : Name) (hB : BodyStepCX O) :
    Triple mctx mref cctx cref (JQ O.quiet 0) (synthesizeCombinational declName)
      (fun _ => JQCX O 0) (EQ O.quiet 0) :=
  full0_tripleACX O hA (core_tripleAC_of_bodiesX O hA declName hB)

/-! ## The endpoint: every returned child is a `RealChildAX` -/

/-- `synthesizeChild` under `JQCX`, cache hit included, from `BodyStepCX` alone. -/
theorem synthesizeChild_realCX (O : RefLawsAOpsX MkRefd mref cref) (hB : BodyStepCX O)
    (hA : O.adm mctx cctx) {D : Nat} {n : Name}
    {w w' : Void IO.RealWorld} {y : Res} (hw : JQCX O D w)
    (h : RunsTo (synthesizeChild n) mctx mref cctx cref w y w') :
    RealChildAX O n y ∧ JQCX O D w' :=
  synthesizeChild_realA'X O hA (hbodyC_of_stepX O hB hA D n) hw h

/-- **The one-output closing's children, cache hits included, from `BodyStepCX` alone.** -/
theorem closeInstsM_realCX (O : RefLawsAOpsX MkRefd mref cref) (hB : BodyStepCX O)
    (hA : O.adm mctx cctx) {D : Nat}
    {shape : MachineShape} {t m₀ : Sparkle.IR.AST.Module} {d₀ : Sparkle.IR.AST.Design}
    {m : Sparkle.IR.AST.Module} {d : Sparkle.IR.AST.Design} {w w' : Void IO.RealWorld}
    (hw : JQCX O D w)
    (hr : RunsTo (closeInstsM shape t m₀ d₀) mctx mref cctx cref w (some (m, d)) w') :
    ∃ children, Sparkle.IR.Machine.closeInsts (machNIn shape) shape.insts.length
        shape.layout.slots.length (t.inputs.map (·.name)) (shape.insts.map (·.2.1))
        children (m₀, d₀) = some (m, d) ∧
      children.length = shape.insts.length ∧
      (∀ k (hk : k < shape.insts.length), ∃ y, children[k]? = some y ∧
        RealChildAX O (shape.insts[k]).1 y) ∧
      JQCX O D w' :=
  closeInstsM_realA'X O hA (fun c => hbodyC_of_stepX O hB hA D c) hw hr

/-! ## The body at `JQCX`: what is proved of `BodyStepCX` -/

/-- **Certified-shape constants at `JQCX O D`**, from the generic-I `fromConst_certified_keepsAPX`
and `translate_keepsAX` (NOT the JQ-specific `fromConst_certified_of_handlersX`), given the five
handler premises at `JQCX O D`; the child entry through `ChildKeepsCX O D`. -/
theorem bodyStepC_certifiedX (O : RefLawsAOpsX MkRefd mref cref) (D : Nat)
    (hImpl : LegacyImplAX O (JQCX O D)) (hCached : LegacyCachedAX O (JQCX O D))
    (hcanon : CanonKeyAX O (JQCX O D)) (hpf : ProjFieldNameAX O (JQCX O D))
    (hC : ChildKeepsCX O D) (mctx : Meta.Context) (cctx : Core.Context)
    (hA : O.adm mctx cctx) (declName : Name) (tenv : Lean.Environment) (b : Bool)
    (ci : ConstantInfo) (isInst : Lean.Expr → Bool) {bs : List (Name × GateBinder)}
    {body : Lean.Expr} (hshape : certifiedShape? false [] ci = some (bs, body)) :
    Keeps mctx mref cctx cref (JQCX O D)
      (synthesizeFromConst (fun e h t n => translateExprToWire tenv e h t n) (profLogIO b)
        declName [] false true ci isInst) :=
  fromConst_certified_keepsAPX O hA (stableA_JQCX O D) _ b declName ci isInst hshape
    (fun e h t n => translate_keepsAX O (stableA_JQCX O D) tenv hImpl hCached hcanon hpf
      (childEntryA_of_childKeepsCX O D hC) mctx cctx hA e h t n)


