/-! ## Rows that are proved (the specs hold by construction; the env facts stay hypotheses)

`TmSpec` / `TyConSpec` of `PTcorpus` are theorems here (`rfl` on the table + `TmTele.spec`). The existing per-key theorems of `Tools.ShippingGen5RowTypedV`
(`rowTypedV_*`, `teleEv_*`) then become statements about `PTcorpus` whose only hypotheses are env facts (`EnvTypeL` / `EnvClosedPiL` / `EnvConstPi` / `¬ IsDefn`),
checked in the real environment by `Tests/Gen5/PTCorpusCheck.lean`. -/

open Tools.ShippingGen5ConstValueESoundK
open Tools.ShippingGen5ConstValueEVL
open Tools.ShippingGen5RowTypedV

theorem tys_Nat : PTcorpus.tys ``Nat [] = some (TyTele.done Nat).row := rfl
theorem tys_Int : PTcorpus.tys ``Int [] = some (TyTele.done Int).row := rfl
theorem tys_Bool : PTcorpus.tys ``Bool [] = some (TyTele.done Bool).row := rfl
theorem tys_PUnit1 : PTcorpus.tys ``PUnit [.succ .zero] = some (TyTele.done PUnit.{1}).row := rfl
theorem tys_ActiveEdge : PTcorpus.tys `Sparkle.Core.Domain.ActiveEdge [] = some (TyTele.done Sparkle.Core.Domain.ActiveEdge).row := rfl
theorem tys_DomainConfig : PTcorpus.tys `Sparkle.Core.Domain.DomainConfig [] = some (TyTele.done Sparkle.Core.Domain.DomainConfig).row := rfl
theorem tys_ResetKind : PTcorpus.tys `Sparkle.IR.Type.ResetKind [] = some (TyTele.done Sparkle.IR.Type.ResetKind).row := rfl

theorem tms_Nat_zero : PTcorpus.tms ``Nat.zero [] = some (TmTele.done Nat Nat.zero).row := rfl
theorem tms_Bool_false : PTcorpus.tms ``Bool.false [] = some (TmTele.done Bool Bool.false).row := rfl
theorem tms_Bool_true : PTcorpus.tms ``Bool.true [] = some (TmTele.done Bool Bool.true).row := rfl
theorem tms_PUnit_unit1 : PTcorpus.tms ``PUnit.unit [.succ .zero] = some (TmTele.done PUnit.{1} PUnit.unit.{1}).row := rfl
theorem tms_ActiveEdge_rising : PTcorpus.tms `Sparkle.Core.Domain.ActiveEdge.rising [] =
    some (TmTele.done Sparkle.Core.Domain.ActiveEdge Sparkle.Core.Domain.ActiveEdge.rising).row := rfl
theorem tms_ResetKind_synchronous : PTcorpus.tms `Sparkle.IR.Type.ResetKind.synchronous [] =
    some (TmTele.done Sparkle.IR.Type.ResetKind Sparkle.IR.Type.ResetKind.synchronous).row := rfl
theorem tms_Nat_succ : PTcorpus.tms ``Nat.succ [] = some (TmTele.tm Nat fun n => TmTele.done Nat (Nat.succ n)).row := rfl
theorem tms_Int_ofNat : PTcorpus.tms ``Int.ofNat [] = some (TmTele.tm Nat fun n => TmTele.done Int (Int.ofNat n)).row := rfl
theorem tms_Int_negSucc : PTcorpus.tms ``Int.negSucc [] = some (TmTele.tm Nat fun n => TmTele.done Int (Int.negSucc n)).row := rfl

theorem tyspec_Nat : TyConSpec PTcorpus ``Nat [] Nat := TyTele.spec_nullary Nat tys_Nat
theorem tyspec_Int : TyConSpec PTcorpus ``Int [] Int := TyTele.spec_nullary Int tys_Int
theorem tyspec_Bool : TyConSpec PTcorpus ``Bool [] Bool := TyTele.spec_nullary Bool tys_Bool
theorem tyspec_PUnit1 : TyConSpec PTcorpus ``PUnit [.succ .zero] PUnit.{1} := TyTele.spec_nullary _ tys_PUnit1
theorem tyspec_ActiveEdge : TyConSpec PTcorpus `Sparkle.Core.Domain.ActiveEdge [] Sparkle.Core.Domain.ActiveEdge := TyTele.spec_nullary _ tys_ActiveEdge
theorem tyspec_DomainConfig : TyConSpec PTcorpus `Sparkle.Core.Domain.DomainConfig [] Sparkle.Core.Domain.DomainConfig := TyTele.spec_nullary _ tys_DomainConfig
theorem tyspec_ResetKind : TyConSpec PTcorpus `Sparkle.IR.Type.ResetKind [] Sparkle.IR.Type.ResetKind := TyTele.spec_nullary _ tys_ResetKind

theorem spec_Nat_zero : TmSpec PTcorpus ``Nat.zero [] [] Nat := TmTele.spec (.done Nat Nat.zero) Nat rfl tms_Nat_zero
theorem spec_Bool_false : TmSpec PTcorpus ``Bool.false [] [] Bool := TmTele.spec (.done Bool Bool.false) Bool rfl tms_Bool_false
