theorem spec_PUnit_unit1 : TmSpec PTcorpus ``PUnit.unit [.succ .zero] [] PUnit.{1} := TmTele.spec (.done PUnit.{1} PUnit.unit.{1}) _ rfl tms_PUnit_unit1
