/-- Levels that are numerals. -/
def lvNat : Level → Option Nat
  | .zero => some 0
  | .succ l => (lvNat l).map (· + 1)
  | _ => none

def lvNats : List Level → Option (List Nat)
  | [] => some []
  | l :: ls => match lvNat l, lvNats ls with
    | some a, some b => some (a :: b)
    | _, _ => none

noncomputable def PTcorpus : PrimTableK where
  tys c ls :=
    match lvNats ls with
    | none => none
    | some ns => (tysTable.find? fun e => e.1 == c && e.2.1 == ns).map fun e => e.2.2.2.row
  tms c ls :=
    match lvNats ls with
    | none => none
    | some ns => (tmsTable.find? fun e => e.1 == c && e.2.1 == ns).map fun e => e.2.2.2.row

/-! ## First-argument dependent rows (`c : ∀ (x₁ : Type) …, D x₁`): `FirstArgSpec` by construction -/

open Tools.ShippingGen5RowTypedV in
theorem firstArgSpec_ty {ks' : List Bool} {k : (T : Type) → TmTele ks'} {F : Type → Type} (hres : ∀ T, (k T).ResTy (F T))
    {PT : PrimTableK} {c : Name} {ls : List Level} {D : Name} {Ls : List Level}
    (hrow : PT.tms c ls = some (TmTele.ty k).row) (htrow : PT.tys D Ls = some (TyTele.ty fun T => TyTele.done (F T)).row) :
    FirstArgSpec PT c ls false ks' D Ls :=
  ⟨_, _, hrow, rfl, htrow, rfl, fun xs d hd => by
    cases xs with
    | nil => simp [TmTele.row, TmTele.run] at hd
    | cons a xs =>
      cases a with
      | tm _ => simp [TmTele.row, TmTele.run] at hd
      | ty T =>
        have hty := TmTele.run_ty (k T) (F T) (hres T) xs d (by simpa [TmTele.row, TmTele.run] using hd)
        exact ⟨.ty T, xs, rfl, by simp [TyTele.row, TyTele.run, hty]⟩⟩

