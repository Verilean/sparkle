theorem spec_Nat_succ : TmSpec PTcorpus ``Nat.succ [] [true] Nat := TmTele.spec (.tm Nat fun n => .done Nat (Nat.succ n)) Nat (fun _ => rfl) tms_Nat_succ
theorem spec_Int_ofNat : TmSpec PTcorpus ``Int.ofNat [] [true] Int := TmTele.spec (.tm Nat fun n => .done Int (Int.ofNat n)) Int (fun _ => rfl) tms_Int_ofNat
