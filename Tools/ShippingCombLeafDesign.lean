/-! ## Pure -/

/-- `seedR` reads the input ports only. -/
theorem seedR_of_inputs {m o : Sparkle.IR.AST.Module} (h : o.inputs = m.inputs)
    (ins : Nat → String → Nat) : seedR o ins = seedR m ins := by
  unfold Tools.ShippingMachineShipsComb.seedR
  rw [h]

/-- **The general bridge for a combinational leaf, pure**: `MachineShipsComb`
of an assignments-and-registers shipped module `o` at the emitter's own width
map `wofOf o`, where `b` is the cleaned module `raw` or its checked merge —
is, for the SAME environments: the IR run of `o`; a closed run `DesignSV C 0
o` over EVERY child map and every children's state; the source on the output
ports; and the only closed run. Seeded by `seedR b` (`= seedR raw`: the
ports are kept). -/
theorem comb_design_of_ships {declName : Name} {d : MachineData}
    {raw b o : Sparkle.IR.AST.Module}
    {ι : Type} {dom : ι → DomainConfig}
    {src : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) → List (Nat → Nat)}
    (hs : o.body.all Sparkle.IR.OptCheck.seqStmtOk = true)
    (hpost : b = raw ∨ b = mergeChecked raw)
    (h : MachineShipsComb declName d raw o (Tools.ShippingDesignSV.wofOf o) dom src) :
    ∃ ids : List FVarId, ids.Nodup ∧ ids.length = d.shape.binders.length ∧
    ∃ cache : IO.Ref (ExprStructMap String),
      ∀ (i : ι) (bools : Nat → Signal (dom i) Bool)
        (bits : (j : Nat) → (n : Nat) → Signal (dom i) (BitVec n))
        (T : Nat) (ins : Nat → String → Nat) (st0 : String → Nat) (mems : MEnv),
        -- the source's inputs are the seeding's
        (∀ t st, t < T → SourceInputs declName d.bsIn ids cache
          (fun j => (bools j).val (T - 1 - t)) (fun j n => (bits j n).val (T - 1 - t))
          (seedR b ins t st)) →
        -- the inputs within the declared and the emitted widths; the state within the emitted
        (∀ t x, x ∈ b.inputs.map (·.name) → ins t x < 2 ^ declWidth b x) →
        (∀ t x, x ∈ b.inputs.map (·.name) → ins t x < 2 ^ Tools.ShippingDesignSV.weS o x) →
        Bounded (Tools.ShippingDesignSV.weS o) st0 →
        ∃ envsO,
          runModule (declWidth o) o.body (seedR b ins) T st0 mems = some envsO ∧
          (∀ (C : String → Option (Sparkle.IR.AST.Module × Sparkle.IR.Semantics.WEnv))
              (kids : String → Tools.ShippingHierStateG.KT 0),
            Tools.ShippingDesignSV.DesignSV C 0 o (seedR b ins) T ⟨st0, mems, kids⟩ envsO) ∧
          envsO.length = T ∧
          (∀ j (hj : j < envsO.length) (k : Nat) (q : OutField) (f : Nat → Nat),
            d.shape.layout.outs[k]? = some q → (src i bools bits)[k]? = some f →
            (envsO[j]'hj) q.name = f j) ∧
          ∀ (C : String → Option (Sparkle.IR.AST.Module × Sparkle.IR.Semantics.WEnv))
            (kids : String → Tools.ShippingHierStateG.KT 0)
            (envs' : List Sparkle.IR.Semantics.Env),
            Tools.ShippingDesignSV.DesignSV C 0 o (seedR b ins) T ⟨st0, mems, kids⟩ envs' →
            envs' = envsO := by
  obtain ⟨hin, hwires⟩ := Tools.ShippingLeafDesign.post_ports hpost
  have hdw : declWidth b = declWidth raw := Tools.ShippingLeafDesign.declWidth_of_wires hwires
  obtain ⟨ids, nd, len, cache, H⟩ := h
  refine ⟨ids, nd, len, cache, ?_⟩
  intro i bools bits T ins st0 mems hsrc hinsB hinsW hstB
  have e : seedR b ins = seedR raw ins := seedR_of_inputs hin ins
  rw [e] at hsrc
  rw [e]
  obtain ⟨envsO, hrun, hsv, hlen, hobs⟩ := H i bools bits T ins st0 mems hsrc
    (fun t x hx => by
      have h1 := hinsB t x (by rw [hin]; exact hx)
      rw [hdw] at h1
      exact h1)
    (fun t x hx => hinsW t x (by rw [hin]; exact hx))
    hstB
  have htext : Tools.ShippingDesignSV.TextRun o (seedR raw ins) T st0 mems envsO := hsv
  refine ⟨envsO, hrun, ?_, hlen, hobs, ?_⟩
  · intro C kids
    exact Tools.ShippingLeafEntry.designSV0_of_leaf C hs (s := ⟨st0, mems, kids⟩) htext
  · intro C kids envs' hD
    exact Tools.ShippingLeafDesign.designSV0_leaf_unique C hs htext hD

/-! ## From the run of the full entry -/

/-- **The full entry's module of a machine without calls has the layout's
output names** (from the wired trace: the core module's outputs are the
layout's, the cleanup and the checked merge keep them). -/
theorem comb_entry_outputs {declName : Name} (d : MachineData)
    {ι : Type} {dom : ι → DomainConfig}
    {src : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) → List (Nat → Nat)}
    {lsrc : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) → List (Nat → Nat)}
    (soundL : ∀ {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
      {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State} {w w' : Void IO.RealWorld}
      {m : Sparkle.IR.AST.Module} {design : Sparkle.IR.AST.Design},
      RunsTo (synthesizeCombinationalCore declName [] false) mctx mref cctx cref w
        (m, design) w' →
      MachineDefines mctx mref cctx cref declName d.shape →
      MachineCloses mctx mref cctx cref declName d.shape →
      MachineTraceL declName d m design dom src (fun _ _ bits => bits) lsrc)
    (hnoI : d.shape.insts = [])
    (houtTy : ∀ o ∈ d.shape.layout.outs, o.ty.bitWidth = o.width)
    {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
    {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State} {w w' : Void IO.RealWorld}
    {b : Sparkle.IR.AST.Module} {design : Sparkle.IR.AST.Design}
    (hr : RunsTo (synthesizeCombinational declName) mctx mref cctx cref w (b, design) w')
    (entry : MachineDefines mctx mref cctx cref declName d.shape)
    (closes : MachineCloses mctx mref cctx cref declName d.shape) :
    b.outputs.map (·.name) = d.shape.layout.outs.map (·.name) := by
  obtain ⟨raw, D, w1, hcore, hpost⟩ := synthesizeCombinational_checked hr
  have hL := soundL hcore entry closes
  obtain ⟨_, _, _, _, _, _, _, _, _, wired, _⟩ := id hL
  obtain ⟨_, _, _, _, _, _, _, houts, _, _, hclean, _⟩ := wired
  obtain ⟨⟨_, _, _, ho⟩, _⟩ := hclean hnoI houtTy
  have hbo : b.outputs = (Sparkle.IR.ZeroWidth.dropZeroWidthModule raw).outputs := by
    rcases hpost with e | e
    · rw [e]
    · rw [e]
      exact (Sparkle.IR.RefineCheck.mergeChecked_ports _).2.1
  have hnames : ∀ (L : List OutField),
      (L.map (fun o => ({ name := o.name, ty := o.ty } : Port))).map (·.name) =
        L.map (·.name) := by
    intro L
    induction L with
    | nil => rfl
    | cons q rest ih =>
      first
        | (show q.name :: _ = q.name :: _
           exact congrArg (List.cons q.name) ih)
        | simpa using ih
  rw [hbo, ho, houts]
  exact hnames d.shape.layout.outs

/-- **A slotless leaf machine with the one output `out`, as an entry, at the
design level — with the two open obligations (S1), (S2) as antecedents.**
From the wired trace theorem of the declaration (`soundL`, what
`f.machine_ships_comb` is built from), its decided data conditions
(`CombKid`), the run, the reflection and the closing. See the file header
for what is and is not proved. -/
theorem comb_entry_design0_out {declName : Name} (d : MachineData)
    {ι : Type} {dom : ι → DomainConfig}
    {src : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) → List (Nat → Nat)}
    {lsrc : (i : ι) → (Nat → Signal (dom i) Bool) →
      ((j : Nat) → (n : Nat) → Signal (dom i) (BitVec n)) → List (Nat → Nat)}
    (soundL : ∀ {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
      {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State} {w w' : Void IO.RealWorld}
      {m : Sparkle.IR.AST.Module} {design : Sparkle.IR.AST.Design},
      RunsTo (synthesizeCombinationalCore declName [] false) mctx mref cctx cref w
        (m, design) w' →
      MachineDefines mctx mref cctx cref declName d.shape →
      MachineCloses mctx mref cctx cref declName d.shape →
      MachineTraceL declName d m design dom src (fun _ _ bits => bits) lsrc)
    (K : CombKid declName d)
    {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
    {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State} {w w' : Void IO.RealWorld}
    {b : Sparkle.IR.AST.Module} {design : Sparkle.IR.AST.Design}
    (hr : RunsTo (synthesizeCombinational declName) mctx mref cctx cref w (b, design) w')
    (entry : MachineDefines mctx mref cctx cref declName d.shape)
    (closes : MachineCloses mctx mref cctx cref declName d.shape) :
    ∃ raw : Sparkle.IR.AST.Module,
      (b = Sparkle.IR.ZeroWidth.dropZeroWidthModule raw ∨
        b = mergeChecked (Sparkle.IR.ZeroWidth.dropZeroWidthModule raw)) ∧
      (Tools.ShippingChildInv.ChildBnd mref cref w →
        -- (S1) OPEN: the module is of the simple shape
        simpleBody b = true →
        -- (S2) OPEN: the shipped module is the module itself or passes the print guard
        (checkedOptimize b = b ∨
          Sparkle.IR.PrintGuard.printOk (checkedOptimize b) = true) →
        ∃ ids : List FVarId, ids.Nodup ∧ ids.length = d.shape.binders.length ∧
        ∃ cache : IO.Ref (ExprStructMap String),
          ∀ (i : ι) (bools : Nat → Signal (dom i) Bool)
            (bits : (j : Nat) → (n : Nat) → Signal (dom i) (BitVec n))
            (T : Nat) (ins : Nat → String → Nat) (st0 : String → Nat) (mems : MEnv)
            (kids : String → Tools.ShippingHierStateG.KT 0),
            -- the source's inputs are the seeding's (`rst` low)
            (∀ t st, t < T → SourceInputs declName d.bsIn ids cache
              (fun j => (bools j).val (T - 1 - t)) (fun j n => (bits j n).val (T - 1 - t))
              (seedR b ins t st)) →
            -- the inputs within the declared and the emitted widths; the state within the emitted
            (∀ t x, x ∈ b.inputs.map (·.name) → ins t x < 2 ^ declWidth b x) →
            (∀ t x, x ∈ b.inputs.map (·.name) →
              ins t x < 2 ^ Tools.ShippingDesignSV.weS (checkedOptimize b) x) →
            Bounded (Tools.ShippingDesignSV.weS (checkedOptimize b)) st0 →
            -- a closed run of the emitted text showing the source exists ...
            (∃ envsO,
              Tools.ShippingDesignSV.DesignSV (Tools.ShippingMachineLinked.childMap design.modules)
                0 (checkedOptimize b) (seedR b ins) T ⟨st0, mems, kids⟩ envsO ∧
              envsO.length = T ∧
              ∀ j (hj : j < envsO.length) (k : Nat) (q : OutField) (f : Nat → Nat),
                d.shape.layout.outs[k]? = some q → (src i bools bits)[k]? = some f →
                (envsO[j]'hj) q.name = f j)
            -- ... and EVERY closed run from the same seeding and states shows it
            ∧ ∀ envs', Tools.ShippingDesignSV.DesignSV
                  (Tools.ShippingMachineLinked.childMap design.modules)
                  0 (checkedOptimize b) (seedR b ins) T ⟨st0, mems, kids⟩ envs' →
                envs'.length = T ∧
                ∀ j (hj : j < envs'.length) (k : Nat) (q : OutField) (f : Nat → Nat),
                  d.shape.layout.outs[k]? = some q → (src i bools bits)[k]? = some f →
                  (envs'[j]'hj) q.name = f j) := by
  obtain ⟨raw, hpost, H⟩ :=
    Tools.ShippingMachineShipsComb.machine_ships_comb d @soundL K.leaf K.slots K.ss K.outTy hr
      entry closes
  refine ⟨raw, hpost, ?_⟩
  intro hbnd hsB hopt
  have hSS' : d.ss.length = d.shape.layout.slots.length := by
    rw [K.slots]
    exact K.ss
  have hbo : b.outputs.map (·.name) = ["out"] :=
    (comb_entry_outputs d @soundL K.leaf K.outTy hr entry closes).trans K.one
  have htext := comb_entry_text_out d K.ok K.body K.calls K.dom K.leaf hSS' K.outTy hbnd hr
    entry closes K.outName K.outScalar hbo
  obtain ⟨c2, c3⟩ := Tools.ShippingLeafEntry.text_shipped_of_print htext hopt
  have c2' : Tools.SVParser.EmitSem.seqCheck
      (Tools.ShippingDesignSV.wofOf (checkedOptimize b))
      (Tools.SVParser.EmitSem.weOf (Tools.ShippingDesignSV.wofOf (checkedOptimize b)))
      (checkedOptimize b).body = true := c2
  have c3' : ((seqNames (checkedOptimize b).body).all fun n =>
      declWidth (checkedOptimize b) n ==
        Tools.SVParser.EmitSem.weOf (Tools.ShippingDesignSV.wofOf (checkedOptimize b)) n) =
      true := c3
  have hS := H (Tools.ShippingDesignSV.wofOf (checkedOptimize b)) hsB c2' c3'
  have hs : (checkedOptimize b).body.all Sparkle.IR.OptCheck.seqStmtOk = true :=
    Tools.ShippingMachineShipsComb.assigns_seqOk
      (Tools.ShippingMachineShipsComb.checkedOptimize_assigns hsB)
  obtain ⟨ids, nd, len, cache, G⟩ := comb_design_of_ships hs hpost hS
  refine ⟨ids, nd, len, cache, ?_⟩
  intro i bools bits T ins st0 mems kids hsrc hinsB hinsW hstB
  obtain ⟨envsO, -, hD, hlen, hobs, huniq⟩ := G i bools bits T ins st0 mems hsrc hinsB hinsW hstB
  refine ⟨⟨envsO, hD (Tools.ShippingMachineLinked.childMap design.modules) kids, hlen, hobs⟩, ?_⟩
  intro envs' hD'
  have e := huniq (Tools.ShippingMachineLinked.childMap design.modules) kids envs' hD'
  subst e
  exact ⟨hlen, hobs⟩

end Entry

end Tools.ShippingCombLeafDesign
