variable {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
  {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State}

/-- **The decided data conditions of one slotless leaf declaration** `c`
with data `dk`: a machine without calls and without slots, with the one
output `out`. No reflection and no closing inside (they are binders of the
theorems that use it). -/
structure CombKid (c : Name) (dk : MachineData) : Prop where
  ok : dk.ok = true
  body : dk.shape.body = quote dk.dom
    (fun j => inputExpr dk.shape.binders.length (dk.bpos j))
    (fun j => inputExpr dk.shape.binders.length (dk.vpos j)) dk.packed
  calls : dk.callsOk dk.nIn = true
  dom : ∀ b ∈ dk.shape.binders.drop dk.nIn, b.2 ≠ .domain
  leaf : dk.shape.insts = []
  slots : dk.shape.layout.slots = []
  ss : dk.ss.length = 0
  outTy : ∀ o ∈ dk.shape.layout.outs, o.ty.bitWidth = o.width
  one : dk.shape.layout.outs.map (·.name) = ["out"]
  outName : ∀ o ∈ dk.shape.layout.outs, Sparkle.Backend.Verilog.sanitizeName o.name = o.name
  outScalar : ∀ o ∈ dk.shape.layout.outs, Tools.ShippingTextTyped.scalarTy o.ty = true

/-- **Conjuncts 2 and 3 of the text check of the full entry's module itself**,
for a leaf machine (with or without a register) whose module has the one
output `out`: the typed cleaned module, or its checked merge — which keeps a
typed module with the one output `out` typed
(`Tools.ShippingCombKidText.mergeChecked_text_out`). From the run and
`ChildBnd`. -/
theorem comb_entry_text_out {c : Name} (d : MachineData) (ok : d.ok = true)
    (hbody : d.shape.body = quote d.dom
      (fun j => inputExpr d.shape.binders.length (d.bpos j))
      (fun j => inputExpr d.shape.binders.length (d.vpos j)) d.packed)
    {nDecl : Nat} (hC : d.callsOk nDecl = true)
    (hdomB : ∀ b ∈ d.shape.binders.drop nDecl, b.2 ≠ .domain)
    (hno : d.shape.insts = [])
    (hSS : d.ss.length = d.shape.layout.slots.length)
    (outTy : ∀ o ∈ d.shape.layout.outs, o.ty.bitWidth = o.width)
    {w w' : Void IO.RealWorld} {b : Sparkle.IR.AST.Module} {design : Design}
    (hbnd : ChildBnd mref cref w)
    (hr : RunsTo (synthesizeCombinational c) mctx mref cctx cref w (b, design) w')
    (entry : MachineDefines mctx mref cctx cref c d.shape)
    (closesM : MachineCloses mctx mref cctx cref c d.shape)
    (hon : ∀ o ∈ d.shape.layout.outs, Sparkle.Backend.Verilog.sanitizeName o.name = o.name)
    (hoty : ∀ o ∈ d.shape.layout.outs, Tools.ShippingTextTyped.scalarTy o.ty = true)
    (hbout : b.outputs.map (·.name) = ["out"]) :
    Tools.SVParser.EmitSem.seqCheck (Tools.ShippingDesignSV.wofOf b)
        (Tools.ShippingDesignSV.weS b) b.body = true ∧
      (Tools.ShippingSeqSVSoundness.seqNames b.body).all
        (fun x => Sparkle.IR.RegDedup.declWidth b x == Tools.ShippingDesignSV.weS b x) =
          true := by
  obtain ⟨m0, hpost, hT, -, -, -, -⟩ :=
    Tools.ShippingLeafEntryBnd.leaf_run_typedIn_bnd d ok hbody hC hdomB hno hSS outTy hbnd hr
      entry closesM hon hoty
  have hm0o : m0.outputs.map (·.name) = ["out"] := by
    rcases hpost with e | e
    · rw [← e]
      exact hbout
    · rw [← (Sparkle.IR.RefineCheck.mergeChecked_ports m0).2.1, ← e]
      exact hbout
  obtain ⟨ty, hout⟩ := Tools.ShippingCombKidText.single_out hm0o
  rcases hpost with e | e
  · rw [e]
    exact hT.seqCheck
  · rw [e]
    exact Tools.ShippingCombKidText.mergeChecked_text_out hT hout

end Typed

