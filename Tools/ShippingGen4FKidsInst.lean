/-! ## The shared validated-cache wrapper -/

section Wrapper
variable {O : RefLawsAOps MkRefd mref cref} (M : MemoFamily O) (hA : AdmCtx O.quiet mctx cctx)
  {I : Void IO.RealWorld → Prop} (hS : StableK O.quiet I)
include M hA hS

theorem translateControlCachedWithKS (lower : TranslateFn)
    (hlow : ∀ e hint top named, KeepsCS mctx mref cctx cref I (lower e hint top named))
    (e : Lean.Expr) (hint : String) (top named : Bool) :
    KeepsCS mctx mref cctx cref I (translateControlCachedWith lower e hint top named) := by
  unfold translateControlCachedWith
  try dsimp only
  swalkN [hlow _ _ _ _, cacheLookupValidatedKS M hA hS _, recordTranslationKS M hA hS _ _ _]

/-! ## The instance helpers (child compile in hand) -/

theorem instArmCacheGetKS : Keeps mctx mref cctx cref I instArmCacheGet := by
  unfold instArmCacheGet
  exact keepsK_framedNM M hA hS (FramedNM.sideGet .singleOut)

theorem instArmCachePutKS (key w : String) : Keeps mctx mref cctx cref I (instArmCachePut key w) := by
  unfold instArmCachePut
  exact keepsK_framedNM M hA hS (FramedNM.sideModify _ .singleOut)

theorem instArmOutGetKS : Keeps mctx mref cctx cref I instArmOutGet := by
  unfold instArmOutGet
  exact keepsK_framedNM M hA hS (FramedNM.sideGet .subInstOut)

theorem instArmOutPutKS (key : UInt64) (out w : String) :
    Keeps mctx mref cctx cref I (instArmOutPut key out w) := by
  unfold instArmOutPut
  exact keepsK_framedNM M hA hS (FramedNM.sideModify _ .subInstOut)

/-- the modules added to the design are the child's: they must declare no parameter -/
theorem instAddModulesKS (existing : List String) :
    ∀ ms : List Sparkle.IR.AST.Module, (∀ m ∈ ms, ParamFree m) →
      KeepsCS mctx mref cctx cref I (instAddModules existing ms) := by
  intro ms
  induction ms with
  | nil => intro _; rw [instAddModules.eq_1]; exact KeepsCS.pure _
  | cons m ms ih =>
    intro hms
    have hm : ParamFree m := hms m (List.mem_cons_self ..)
    have hrest : ∀ x ∈ ms, ParamFree x := fun x hx => hms x (List.mem_cons_of_mem _ hx)
    rw [instAddModules.eq_2]
    exact KeepsCS.ite (fun _ => KeepsCS.bind (addModuleToDesignPS m hm) (fun _ => ih hrest)) (fun _ => ih hrest)

theorem instRegisterChildKS (existing : List String) (sub : Sparkle.IR.AST.Module) (hsub : ParamFree sub) :
    KeepsCS mctx mref cctx cref I (instRegisterChild existing sub) := by
  unfold instRegisterChild
  try dsimp only
  swalkN [addModuleToDesignPS sub hsub]

theorem instClkRstKS :
    ∀ (ps : List Sparkle.IR.AST.Port) (acc : List (String × Sparkle.IR.AST.Expr)),
      KeepsCS mctx mref cctx cref I (instClkRst acc ps)
  | [], acc => by unfold instClkRst; exact KeepsCS.pure _
  | p :: ps, acc => by
    have ih := fun acc => instClkRstKS ps acc
    unfold instClkRst
    try dsimp only
    swalkN [ih _, addInputPS M hA hS _ _]  -- guess: F4

theorem instOutWiresKS (callKey : UInt64) (hint : String) :
    ∀ (ps : List Sparkle.IR.AST.Port) (conns : List (String × Sparkle.IR.AST.Expr))
      (ws : List (String × String)),
      KeepsCS mctx mref cctx cref I (instOutWires callKey hint ps conns ws)
  | [], conns, ws => by unfold instOutWires; exact KeepsCS.pure _
  | outP :: rest, conns, ws => by
    have ih := fun conns ws => instOutWiresKS callKey hint rest conns ws
    unfold instOutWires
    refine KeepsCS.bind (makeWirePS M hA hS _ _ _) (fun _ => ?_)
    refine KeepsCS.bind (KeepsCS.lift (instArmOutPutKS M hA hS _ _ _)) (fun _ => ?_)
    exact ih _ _

end Wrapper

section LawFreeInst
variable {I : Void IO.RealWorld → Prop}

theorem instArityCheckKS (mn : Name) (need got : Nat) :
    KeepsCS mctx mref cctx cref I (instArityCheck mn need got) := by
  unfold instArityCheck
  refine KeepsCS.ite (fun _ => KeepsCS.throw _ (by okmsg)) (fun _ => KeepsCS.pure _)

theorem instLinkCheckKS (mn : Name) (child : Sparkle.IR.AST.Module)
    (conns : List (String × Sparkle.IR.AST.Expr)) :
    KeepsCS mctx mref cctx cref I (instLinkCheck mn child conns) := by
  unfold instLinkCheck
  unfold instLinkGuard
  swalkN []

/-- The call key: a builder-state save/restore around `canonHardwareKey`
(premise `hcanon`: not migrated). -/
theorem instCallKeyKS (hcanon : ∀ a, KeepsCS mctx mref cctx cref I (canonHardwareKey a))
    (a : Lean.Expr) : KeepsCS mctx mref cctx cref I (instCallKey a) := by
  unfold instCallKey
  swalkN [hcanon _]

end LawFreeInst

/-! ## The instance lowerings -/

section Inst
variable {O : RefLawsAOps MkRefd mref cref} (M : MemoFamily O) (hA : AdmCtx O.quiet mctx cctx)
  {I : Void IO.RealWorld → Prop} (hS : StableK O.quiet I) (rec : TranslateFn)
  (hrec : ∀ e hint top named, KeepsCS mctx mref cctx cref I (rec e hint top named))
include M hA hS hrec

/-- **The single-output instance lowering** (child compile in hand). -/
theorem translateInstanceUncachedWithKS (mn : Name) (sub : Sparkle.IR.AST.Module)
    (subD : Sparkle.IR.AST.Design) (hsub : ParamFree sub) (hsubD : ∀ m ∈ subD.modules, ParamFree m)
    (singleOut : Sparkle.IR.AST.Port)
    (e : Lean.Expr) (hint : String) (top named : Bool) :
    KeepsCS mctx mref cctx cref I
      (translateInstanceUncachedWith rec mn sub subD singleOut e hint top named) := by
  unfold translateInstanceUncachedWith
  try dsimp only  -- guess: F2
  swalkN [instArmCacheGetKS M hA hS, instArmCachePutKS M hA hS, hrec _ _ _ _, instAddModulesKS M hA hS _ _ hsubD, instRegisterChildKS M hA hS _ _ hsub, instClkRstKS M hA hS _ _, instArityCheckKS _ _ _, instArgsKS M hA hS rec hrec _ _ _, KeepsCS.lift (instArmCacheGetKS M hA hS), KeepsCS.lift (instArmCachePutKS M hA hS _ _), makeWirePS M hA hS _ _ _, freshNamePS _ _, instLinkCheckKS _ _ _, emitInstancePS _ _ _]

/-- **The multi-output projection lowering** (child compile in hand), given
the call key's `canonHardwareKey` (premise) and the legacy fall-through. -/
theorem translateProjInstanceUncachedWithKS
    (hcanon : ∀ a, KeepsCS mctx mref cctx cref I (canonHardwareKey a))
    (recName : Name) (sub : Sparkle.IR.AST.Module) (subD : Sparkle.IR.AST.Design)
    (hsub : ParamFree sub) (hsubD : ∀ m ∈ subD.modules, ParamFree m)
    (fieldName : String) (recordArg : Lean.Expr) (legacy : TranslateFn)
    (hleg : ∀ e hint top named, KeepsCS mctx mref cctx cref I (legacy e hint top named))
    (e : Lean.Expr) (hint : String) (top named : Bool) :
    KeepsCS mctx mref cctx cref I
      (translateProjInstanceUncachedWith rec recName sub subD fieldName recordArg legacy
        e hint top named) := by
  unfold translateProjInstanceUncachedWith
  try dsimp only  -- guess: F2
  swalkN [instArmOutGetKS M hA hS, hleg _ _ _ _, hrec _ _ _ _, instCallKeyKS hcanon _, KeepsCS.lift (instArmOutGetKS M hA hS), instAddModulesKS M hA hS _ _ hsubD, instRegisterChildKS M hA hS _ _ hsub, instClkRstKS M hA hS _ _, instArityCheckKS _ _ _, instArgsKS M hA hS rec hrec _ _ _, instOutWiresKS M hA hS _ _ _ _ _, freshNamePS _ _, instLinkCheckKS _ _ _, emitInstancePS _ _ _]

/-- **The instance arm** (`fallbackKind e = .other`): the dispatch on the
head, the child's synthesis (`hchild`), the two certified lowerings under the
validated cache wrapper, else the legacy translator (`hlegC`). -/
theorem translateInstanceOrFallbackKS (env : Lean.Environment)
    (hchild : ∀ c, Triple mctx mref cctx cref I (childSynthEntry c) (fun r w => I w ∧ PairPF r)
      (fun e w => I w ∧ OkExc e))
    (hpf : ∀ n s, Keeps mctx mref cctx cref I (projFieldName? n s))
    (hcanon : ∀ a, KeepsCS mctx mref cctx cref I (canonHardwareKey a))
    (hlegC : ∀ e hint top named, KeepsCS mctx mref cctx cref I
      (Rec.translateExprToWireCached (fun e h t n => rec e h t n) e hint top named))
    (e : Lean.Expr) (hint : String) (top named : Bool) :
    KeepsCS mctx mref cctx cref I (translateInstanceOrFallback env rec e hint top named) := by
  unfold translateInstanceOrFallback
  -- (integrator, after fb1-fb8 timed out on the generic walk: the elaborated term, printed by
  -- `#print` (run pr2), walked by hand)
  split
  · refine KeepsCS.ite (fun _ => ?_) (fun _ => ?_)
    · refine KeepsCS.bindLiftQ (φ := PairPF) (hchild _) (fun sub hsub => ?_)
      split
      · exact translateControlCachedWithKS M hA hS _
          (translateInstanceUncachedWithKS M hA hS rec hrec _ _ _ hsub.1 hsub.2 _) _ _ _ _
      · exact hlegC _ _ _ _
    · split
      · split
        · refine KeepsCS.ite (fun _ => ?_) (fun _ => hlegC _ _ _ _)
          refine KeepsCS.bind (KeepsCS.lift (hpf _ _)) (fun fo => ?_)
          cases fo with
          | some fieldName =>
            refine KeepsCS.bindLiftQ (φ := PairPF) (hchild _) (fun sub hsub => ?_)
            exact KeepsCS.ite
              (fun _ => translateControlCachedWithKS M hA hS _
                (translateProjInstanceUncachedWithKS M hA hS rec hrec hcanon _ _ _ hsub.1 hsub.2 _ _ _
                  (fun e h t n => hlegC e h t n)) _ _ _ _)
              (fun _ => hlegC _ _ _ _)
          | none => exact hlegC _ _ _ _
        · exact hlegC _ _ _ _
      · exact hlegC _ _ _ _
  · exact hlegC _ _ _ _

end Inst

