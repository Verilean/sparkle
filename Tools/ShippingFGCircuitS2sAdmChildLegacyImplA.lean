section Impl
variable (O : RefLawsAOpsX MkRefd mref cref) {I : Void IO.RealWorld → Prop}
  (hS : StableA O.quiet I)
include O hS

theorem toIR_keepsCP_boundX (wireS : String) (fvarId : FVarId) :
    ∀ (n : Nat) (e : Lean.Expr), sizeOf e < n →
      ∀ (mctx : Meta.Context) (cctx : Core.Context), O.adm mctx cctx →
        KeepsCP mctx mref cctx cref I (Rec.translateExprToWireImpl.toIR wireS fvarId e)
  | 0, _, h => by omega
  | n + 1, e, h => by
    intro mctx cctx hA
    have ih := fun e' (h' : sizeOf e' < n) (mctx : Meta.Context) (cctx : Core.Context)
      (hA : O.adm mctx cctx) => toIR_keepsCP_boundX wireS fvarId n e' h' mctx cctx hA
    unfold Rec.translateExprToWireImpl.toIR
    vcaX

@[keepsAX] theorem toIR_keepsCPX (wireS : String) (fvarId : FVarId) (e : Lean.Expr)
    (hA : O.adm mctx cctx) :
    KeepsCP mctx mref cctx cref I (Rec.translateExprToWireImpl.toIR wireS fvarId e) :=
  toIR_keepsCP_boundX O hS wireS fvarId (sizeOf e + 1) e (Nat.lt_succ_self _) mctx cctx hA

@[keepsAX] theorem getPrim_keepsCPX (e : Lean.Expr) (hA : O.adm mctx cctx) :
    KeepsCP mctx mref cctx cref I (Rec.getPrimitiveNameFromLambda e) := by
  induction e with
  | lam _ _ body _ _ ih => unfold Rec.getPrimitiveNameFromLambda; exact ih
  | _ => unfold Rec.getPrimitiveNameFromLambda; vcaX

end Impl

section Main
variable (O : RefLawsAOpsX MkRefd mref cref) {I : Void IO.RealWorld → Prop}
  (hS : StableA O.quiet I)
  (TL : LocalDeclLawAX O.quiet O.adm mref cref) (TLet : LetDeclLawAX O.quiet O.adm mref cref)
  (TF : ForallTelescopeLawAX O.quiet O.adm mref cref)
  (hcanon : ∀ (mctx : Meta.Context) (cctx : Core.Context), O.adm mctx cctx →
    ∀ a, KeepsCP mctx mref cctx cref I (canonHardwareKey a))
  (hchild : ∀ (mctx : Meta.Context) (cctx : Core.Context), O.adm mctx cctx →
    ∀ c, Keeps mctx mref cctx cref I (childSynthEntry c))
include O hS TL TLet TF hcanon hchild

theorem legacyImplA_coreX : LegacyImplAX O I := by
  intro rec hrec mctx cctx hA e hint top named
  have hr : ∀ (mctx : Meta.Context) (cctx : Core.Context), O.adm mctx cctx →
      ∀ e hint top named, KeepsCP mctx mref cctx cref I (rec e hint top named) := hrec
  show KeepsCP mctx mref cctx cref I
    (Rec.translateExprToWireImpl (fun e h t n => rec e h t n) e hint top named)
  unfold Rec.translateExprToWireImpl
  vcaX

end Main

theorem legacyImplA_of_handlersX (O : RefLawsAOpsX MkRefd mref cref) {I : Void IO.RealWorld → Prop}
    (hS : StableA O.quiet I)
    (TL : LocalDeclLawAX O.quiet O.adm mref cref) (TLet : LetDeclLawAX O.quiet O.adm mref cref)
    (TF : ForallTelescopeLawAX O.quiet O.adm mref cref)
    (hcanon : CanonKeyAX O I) (hchild : ChildEntryAX O I) : LegacyImplAX O I :=
  legacyImplA_coreX O hS TL TLet TF hcanon hchild

theorem legacyImplA_of_teleX (O : RefLawsAOpsX MkRefd mref cref) {I : Void IO.RealWorld → Prop}
    (hS : StableA O.quiet I) (T : RefLawsATeleX O.quiet O.adm mref cref)
    (hcanon : CanonKeyAX O I) (hchild : ChildEntryAX O I) : LegacyImplAX O I :=
  legacyImplA_of_handlersX O hS (Tools.ShippingChildWalkA.RefLawsATeleX.localDeclLaw T)
    (Tools.ShippingChildWalkA.RefLawsATeleX.letDeclLaw T)
    (Tools.ShippingChildWalkA.RefLawsATeleX.forallTelescopeLaw T) hcanon hchild

