set_option autoImplicit false
-- FG circuit pilot S1, step 3: the three Signal roots. No `sorry`, no `axiom`, no `native_decide`, no TRUSTED.

/-! # The three Signal roots of `Tests.SignalLoopTest` through the applied-unit denotation and the existing reader/genData endpoint

For each root `X` (`counterLoop`, `shift4Loop`, `counterEnableLoop`):

* `X.machine_sound` is generated by the EXISTING `#machine_endpoint` (the reader/genData route; every fact is an `Eq.refl` the kernel checks):
  a run of the real synthesis entry returns a module `m` with `MachineTrace X X.machineData m dom X.machineSource`.
* `X.machineSource` is the declaration's OWN observation (`fun i bools bits => [fun t => (X …).val t |>.toNat]`), not read off the IR.
* `X_denotes` (below): the source value `Expr` of `X` is denoted by `CD` (Signal/BitVec core, no unfolding of `Signal.*`) and the denoted value is
  `X` itself (`rfl`); `X_obs` is `X.machineSource = monoObs sh X` (`rfl`).
* `X_root` combines them: the conclusion form of `FGCircuit` with the artifact side given by the endpoint's `MachineTrace`.

Named conditions (hypotheses of each `X_root`, none hidden): `RootInEnv` (the environment of the run contains `X` with the quoted type and value —
checked against the actual environment by the meta check in `Tests/Gen5/FGCircuitPilotCheck.lean`, not by the kernel), the run itself, and
`MachineDefines` / `MachineCloses` of the endpoint (`closes` is derivable from the data for these roots: `X.machine_closes` exists; supplying it is S2). -/
namespace Tools.ShippingFGCircuitRoots
open Lean Sparkle.Core Sparkle.Core.Domain Sparkle.Core.Signal Tools.ShippingGen5DeclConnect Tools.ShippingGen5ConstValueE
open Tools.ShippingFGCircuit Sparkle.Tests.SignalLoopTest
open Tools.ShippingEntrySoundness (RunsTo)

/-! ## quoted source (built with the same constructors the elaborator uses; equality with the real values is the meta check) -/

def eDom : Expr := .const ``Sparkle.Core.Domain.defaultDomain []
def eNat (n : Nat) : Expr := appN ``OfNat.ofNat [.zero] [.const ``Nat [], .lit (.natVal n), appN ``instOfNatNat [] [.lit (.natVal n)]]
def eBV (w : Nat) : Expr := appN ``BitVec [] [eNat w]
def eSig (t : Expr) : Expr := appN ``Signal [.zero] [eDom, t]
def eBVLit (w n : Nat) : Expr := appN ``BitVec.ofNat [] [eNat w, eNat n]
def eAdd8 (a b : Expr) : Expr :=
  appN ``HAdd.hAdd [.zero, .zero, .zero]
    [eSig (eBV 8), eSig (eBV 8), eSig (eBV 8), appN ``Sparkle.Core.Signal.instHAddSignalBitVec [] [eDom, eNat 8], a, b]
def eReg8 (i s : Expr) : Expr := appN ``Signal.register [.zero] [eDom, eBV 8, i, s]
def eLoop8 (f : Expr) : Expr := appN ``Signal.loop [] [eDom, eBV 8, appN ``BitVec.instInhabited [] [eNat 8], f]

def counterLoopType : Expr := eSig (eBV 8)
def counterLoopValue : Expr :=
  eLoop8 (.lam `count (eSig (eBV 8)) (eReg8 (eBVLit 8 0) (eAdd8 (.bvar 0) (appN ``Signal.pure [.zero] [eDom, eBV 8, eBVLit 8 1]))) .default)

def shift4LoopType : Expr := .forallE `input (eSig (eBV 8)) (eSig (eBV 8)) .default
def shift4LoopValue : Expr :=
  .lam `input (eSig (eBV 8))
    (eReg8 (eBVLit 8 0) (eReg8 (eBVLit 8 0) (eReg8 (eBVLit 8 0) (eReg8 (eBVLit 8 0) (.bvar 0))))) .default

def counterEnableLoopType : Expr := .forallE `en (eSig (.const ``Bool [])) (eSig (eBV 8)) .default
def counterEnableLoopValue : Expr :=
  .lam `en (eSig (.const ``Bool []))
    (eLoop8 (.lam `count (eSig (eBV 8))
      (eReg8 (eBVLit 8 0)
        (appN ``Signal.mux [.zero] [eDom, eBV 8, .bvar 1,
          eAdd8 (.bvar 0) (appN ``Signal.pure [.zero] [eDom, eBV 8, eBVLit 8 1]), .bvar 0])) .default)) .default

/-- the environment condition: `X` is, in `env`, the level-monomorphic definition with this type and value -/
def RootInEnv (env : Environment) (X : Name) (ty val : Expr) (d : DefinitionVal) : Prop :=
  env.find? X = some (.defnInfo d) ∧ d.levelParams = [] ∧ d.type = ty ∧ d.value = val

/-! ## the shapes -/
def shCounter : SigShape := { args := [], res := .one (.bits 8) }
def shShift4 : SigShape := { args := [.bits 8], res := .one (.bits 8) }
def shEnable : SigShape := { args := [.bool], res := .one (.bits 8) }

/-! ## `CD` derivations (kernel-checked terms; closed subterms are valuation-independent) -/

private theorem dDom {ρ : Val} : CD ρ eDom DomainConfig defaultDomain := CD.domDefault rfl
private theorem dN {ρ : Val} (n : Nat) : CD ρ (eNat n) Nat n := CD.natLit rfl
private theorem tBV8 {ρ : Val} : TD ρ (eBV 8) (BitVec 8) := TD.bitvec rfl (dN 8)
private theorem tBool {ρ : Val} : TD ρ (.const ``Bool []) Bool := TD.bool rfl
private theorem tSig8 {ρ : Val} : TD ρ (eSig (eBV 8)) (Signal defaultDomain (BitVec 8)) := TD.signal rfl dDom tBV8
private theorem tSigBool {ρ : Val} : TD ρ (eSig (.const ``Bool [])) (Signal defaultDomain Bool) := TD.signal rfl dDom tBool
private theorem dBVLit {ρ : Val} (n : Nat) : CD ρ (eBVLit 8 n) (BitVec 8) (BitVec.ofNat 8 n) := CD.bvOfNat rfl (dN 8) (dN n)
private theorem dPure1 {ρ : Val} :
    CD ρ (appN ``Signal.pure [.zero] [eDom, eBV 8, eBVLit 8 1]) (Signal defaultDomain (BitVec 8)) (Signal.pure (BitVec.ofNat 8 1)) :=
  CD.sigPure rfl dDom tBV8 (dBVLit 1)
private theorem dReg8 {ρ : Val} {s : Expr} {n : Nat} {sv : Signal defaultDomain (BitVec 8)}
    (hs : CD ρ s (Signal defaultDomain (BitVec 8)) sv) :
    CD ρ (eReg8 (eBVLit 8 n) s) (Signal defaultDomain (BitVec 8)) (Signal.register (BitVec.ofNat 8 n) sv) :=
  CD.sigRegister rfl dDom tBV8 (dBVLit n) hs
private theorem dAdd8 {ρ : Val} {a b : Expr} {av bv : Signal defaultDomain (BitVec 8)}
    (ha : CD ρ a (Signal defaultDomain (BitVec 8)) av) (hb : CD ρ b (Signal defaultDomain (BitVec 8)) bv) :
    CD ρ (eAdd8 a b) (Signal defaultDomain (BitVec 8)) (@HAdd.hAdd _ _ _ (@Sparkle.Core.Signal.instHAddSignalBitVec defaultDomain 8) av bv) :=
  CD.sigAddBV rfl dDom (dN 8) ha hb
private theorem dLoop8 {ρ : Val} {f : Expr} {g : Signal defaultDomain (BitVec 8) → Signal defaultDomain (BitVec 8)}
    (hf : CD ρ f (Signal defaultDomain (BitVec 8) → Signal defaultDomain (BitVec 8)) g) :
    CD ρ (eLoop8 f) (Signal defaultDomain (BitVec 8)) (@Signal.loop defaultDomain (BitVec 8) inferInstance g) :=
  CD.sigLoop rfl dDom tBV8 (CD.bvInhabited rfl (dN 8)) hf

private theorem dVar0 {A : Expr} {T : Type} {a : T} {rest : Val} : CD (⟨A, ⟨T, a⟩⟩ :: rest) (.bvar 0) T a :=
  CD.bvar rfl
private theorem dVar1 {A B : Expr} {T U : Type} {a : T} {b : U} {rest : Val} :
    CD (⟨A, ⟨T, a⟩⟩ :: ⟨B, ⟨U, b⟩⟩ :: rest) (.bvar 1) U b :=
  CD.bvar rfl

/-- the quoted value of `counterLoop` is denoted, and the denoted value is `counterLoop` itself -/
theorem counterLoop_cd : CD [] counterLoopValue (Signal defaultDomain (BitVec 8)) counterLoop :=
  dLoop8 (CD.lam rfl tSig8 fun a =>
    dReg8 (dAdd8 (dVar0) dPure1))

theorem shift4Loop_cd : CD [] shift4LoopValue (Signal defaultDomain (BitVec 8) → Signal defaultDomain (BitVec 8)) shift4Loop :=
  CD.lam rfl tSig8 fun a => dReg8 (dReg8 (dReg8 (dReg8 (dVar0))))

theorem counterEnableLoop_cd :
    CD [] counterEnableLoopValue (Signal defaultDomain Bool → Signal defaultDomain (BitVec 8)) counterEnableLoop :=
  CD.lam rfl tSigBool fun en =>
    dLoop8 (CD.lam rfl tSig8 fun a =>
      dReg8 (CD.sigMux rfl dDom tBV8 dVar1 (dAdd8 dVar0 dPure1) dVar0))

end Tools.ShippingFGCircuitRoots

