variable {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
  {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State}

/-- **The restricted translator at `JQCX O D` from `ChildKeepsCX O D` and `T`** (the chain used inside
each step: D2 bridge → B `legacyImplA_of_teleX` with A `canonKeyAX` → A `legacyCachedA_of_implX` →
C `projFieldNameAX` → `translate_keepsAX`). -/
theorem translate_keepsC_of_teleX (O : RefLawsAOpsX MkRefd mref cref)
    (T : RefLawsATeleX O.quiet O.adm mref cref) (D : Nat) (hC : ChildKeepsCX O D) (tenv : Lean.Environment) :
    RecAX O (JQCX O D) (fun e h t n => translateExprToWire tenv e h t n) :=
  have hS := stableA_JQCX O D
  have hchild : ChildEntryAX O (JQCX O D) := childEntryA_JQC_of_childSynthAX O D hC
  have hcanon : CanonKeyAX O (JQCX O D) := Tools.ShippingChildCanonKeyA.canonKeyAX O hS
  have hImpl : LegacyImplAX O (JQCX O D) :=
    Tools.ShippingChildLegacyImplA.legacyImplA_of_teleX O hS T hcanon hchild
  translate_keepsAX O hS tenv hImpl
    (Tools.ShippingChildLegacyCachedA.legacyCachedA_of_implX O hS hImpl) hcanon
    (Tools.ShippingChildProjFieldA.projFieldNameAX O T hS) hchild

/-- **One depth step at `JQCX` with the handlers discharged locally** (from `ChildKeepsCX O D`). -/
theorem bodyKeepsC_of_teleX (O : RefLawsAOpsX MkRefd mref cref) (T : RefLawsATeleX O.quiet O.adm mref cref)
    (D : Nat) (hC : ChildKeepsCX O D) : BodyKeepsCX O D :=
  have hS := stableA_JQCX O D
  have hchild : ChildEntryAX O (JQCX O D) := childEntryA_JQC_of_childSynthAX O D hC
  have hcanon : CanonKeyAX O (JQCX O D) := Tools.ShippingChildCanonKeyA.canonKeyAX O hS
  have hImpl : LegacyImplAX O (JQCX O D) :=
    Tools.ShippingChildLegacyImplA.legacyImplA_of_teleX O hS T hcanon hchild
  fun mctx cctx hA declName tenv b ci isInst =>
    fromConst_frontends_of_handlersX O hA hS hImpl
      (Tools.ShippingChildLegacyCachedA.legacyCachedA_of_implX O hS hImpl) hcanon
      (Tools.ShippingChildProjFieldA.projFieldNameAX O T hS) hC (fun _ h => h.1.2.1)
      tenv b declName ci isInst
      (fun _ _ => Tools.ShippingChildLegacyTailA.legacyTailA_genericX O T hS hA _
        (translate_keepsC_of_teleX O T D hC tenv) b declName ci isInst)

/-- **`BodyStepCX` from `T` alone** (handlers and legacy tail built inside each step). -/
theorem bodyStepC_of_teleX (O : RefLawsAOpsX MkRefd mref cref) (T : RefLawsATeleX O.quiet O.adm mref cref)
    : BodyStepCX O :=
  fun D _ hC => bodyKeepsC_of_teleX O T D hC

/-- **The child entry at `JQCX` at every depth `D ≥ 1`.** -/
theorem childKeepsC_all_of_teleX (O : RefLawsAOpsX MkRefd mref cref)
    (T : RefLawsATeleX O.quiet O.adm mref cref) :
    ∀ D, 1 ≤ D → ChildKeepsCX O D :=
  childKeepsC_allX O (bodyStepC_of_teleX O T)

/-- **Outermost core entry** (JQ in; success `JQCX O 0` after the clear; exceptions `EQ`). -/
theorem core_tripleAC_of_teleX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    (T : RefLawsATeleX O.quiet O.adm mref cref) (declName : Name) :
    Triple mctx mref cctx cref (JQ O.quiet 0) (synthesizeCombinationalCore declName [] false)
      (fun _ => JQCX O 0) (EQ O.quiet 0) :=
  core_tripleAC_of_bodiesX O hA declName (bodyStepC_of_teleX O T)

/-- **Outermost full entry.** -/
theorem full_tripleAC_of_teleX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    (T : RefLawsATeleX O.quiet O.adm mref cref) (declName : Name) :
    Triple mctx mref cctx cref (JQ O.quiet 0) (synthesizeCombinational declName)
      (fun _ => JQCX O 0) (EQ O.quiet 0) :=
  full_tripleAC_of_bodiesX O hA declName (bodyStepC_of_teleX O T)

