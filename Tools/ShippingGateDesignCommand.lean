import Lean.Elab.Command
import Tools.ShippingGateDesign
import Tools.ShippingGateChildCommand
import Tools.ShippingLeafDesignCommand
import Tools.ShippingFinalGoalCommand
import Tools.ShippingShipsFreeCommand

/-! # `#gate_design0 f` and `#gate_design_sweep f`: a GATE-route declaration as an entry at the design level (round par/b-35)

WRITTEN, NOT BUILT.

## What is generated

For a combinational declaration `f` the certified unified gate compiles
(the scope of `#gate_child`; its data `f.gateValue`, `f.gateBinders`,
`f.gate_old`, `f.gate_peel`, `f.gate_wf`, `f.machineSource` are generated by
`#gate_child` when missing):

    f.gate_design0 :
      ∀ {mctx mref cctx cref w w' b design}
        (hr : RunsTo (synthesizeCombinational f) … (b, design) w')
        (entry : EntryDefines mctx mref cctx cref f f.gateValue),
        ∃ raw, (b = dropZeroWidthModule raw ∨ b = mergeChecked (dropZeroWidthModule raw)) ∧
          ∃ outP, b.outputs = [outP] ∧
            ∀ T ins st0 mems kids,
              (∀ t < T, InRange ((argPorts b).map fun p => ins t p.name) (f.gateBinders.filter …)) →
              (inputs within the declared widths) → (… the emitted widths) → Bounded … st0 →
              (∃ envsO, DesignSV (childMap design.modules) 0 (checkedOptimize b) (seedR b ins) T
                  ⟨st0, mems, kids⟩ envsO ∧ envsO.length = T ∧
                ∀ j hj, envsO[j] outP.name =
                  childValue f.machineSource f.gateBinders i0 ((argPorts b).map fun p => ins (T-1-j) p.name))
              ∧ ∀ envs', DesignSV … envs' → (the same about envs')

    := Tools.ShippingGateDesign.gate_entry_design0 hr entry f.gate_old f.gate_peel f.gate_wf
         (bool_positions (by decide)) (bits_positions (by decide)) (fun _ _ => rfl)

The proof term is `f.gate_child`'s own (BUILT for `pick`, `pickD`, `rcH`,
`keccakRcHW`) with `gate_entry_design0` in the place of `gate_child_full`:
the same premises, the same per-declaration kernel work (two `decide` on the
binder positions and one `rfl` "the source function at constant inputs is
the term's value"). Nothing about the run's module is decided.

## The statement check (`checkStatement`)

Exactly two proposition binders: the run (`RunsTo`) and `EntryDefines … f
f.gateValue`; one existential in front of the conjunction (`raw`); the
antecedents under it all ALLOWED by `Tools.ShippingFinalGoalCommand.allowed`
(there are NONE: this endpoint has no `ChildBnd`); the remainder mentions
`DesignSV` and `childMap`; none of
`Tools.ShippingLeafDesignCommand.forbiddenAll` (`simpleBody`, `seqCheck`,
`seqNames`, `MachineCloses`, `InvW`, `printOk`, `isAssign`, the parents'
seven checkers) nor `forwardCheck` anywhere in the statement. A statement
that fails is an error and the sweep reports FAILED.

The differences from `f.machine_design_comb0` (the reflection is
`EntryDefines`; no `ChildBnd`; the source per cycle on values, with
`InRange` in the place of `SourceInputs`; the output port under `∃ outP`)
are in the header of `Tools/ShippingGateDesign.lean`. The register leaves'
check (`checkStatementWith`) is NOT used: it requires a `MachineDefines`
binder and exactly one `ChildBnd` antecedent.

## Sweep

`#gate_design_sweep f` logs a START line (also on stderr), runs the
generator, the audit (the stored statement checked again; standard axioms of
the endpoint and of the general theorems) and the gap tool, and is an error
in no case. `#gate_design_sweep_summary` is an error only on an
inconsistency of what the file measured. `#gate_design_sweep_expect f
"CLASS"` asserts the class of `f` in this file.

Classes: `GENERATED` (added here), `EXISTS` (the endpoint was in the
environment: audited, not rebuilt), `REFUSED` (not in the gate's scope: the
reason is `#gate_child`'s), `FAILED`, `UNRESOLVED`.

SCOPE of a GENERATED row: ONE declaration as an entry, depth 0, no call, no
register, one output; the run and the reflection `EntryDefines f
f.gateValue` stay premises; `DesignSV` of the module list over the returned
design's child map — not the SV string, not `#sim`; seeding `seedR` (`rst`
low); the source per cycle on values (`childValue f.machineSource`). -/
namespace Tools.ShippingGateDesignCommand
open Lean Meta Elab Command
open Tools.ShippingShipsFreeCommand (checkMade)

private def has (s sub : String) : Bool := (s.splitOn sub).length > 1

private def clip (s : String) (n : Nat) : String :=
  if s.length ≤ n then s else String.ofList (s.toList.take n) ++ " …"

/-- What the statement of a gate design endpoint must not mention besides
the leaf endpoints' list. -/
def extraForbidden : List Name := [``Tools.ShippingSVBridge.forwardCheck]

/-- The statement checks of `f.gate_design0` (file header); the log lines.
Throws on a violation. -/
def checkStatement (tag : String) (f leaf : Name) (type : Lean.Expr) :
    MetaM (Array String) := do
  for c in Tools.ShippingLeafDesignCommand.forbiddenAll ++ extraForbidden do
    if (type.find? (·.isConstOf c)).isSome then
      throwError "{leaf}: the statement mentions {c}"
  let gv : Name := f ++ `gateValue
  let report ← forallTelescope type fun xs body => do
    let mut lines : Array String := #[]
    let mut bad : Nat := 0
    let mut runs : Nat := 0
    let mut defs : Nat := 0
    let mut props : Nat := 0
    for x in xs do
      let t0 ← inferType x
      let t ← instantiateMVars t0
      let isP ← isProp t
      if isP then
        props := props + 1
        let pp ← ppExpr t
        let nm ← x.fvarId!.getUserName
        if t.isAppOf ``Tools.ShippingEntrySoundness.RunsTo then runs := runs + 1
        if t.isAppOfArity ``Tools.ShippingInlineSoundness.EntryDefines 6 then
          let same ← isDefEq (t.getArg! 4) (toExpr f)
          if same && (t.getArg! 5).isConstOf gv then defs := defs + 1
        if Tools.ShippingFinalGoalCommand.allowed t then
          lines := lines.push s!"{tag} PREMISE {leaf}: ALLOWED     binder {nm} : {pp}"
        else
          bad := bad + 1
          lines := lines.push s!"{tag} PREMISE {leaf}: NOT ALLOWED binder {nm} : {pp}"
    let inn ← Tools.ShippingLeafDesignCommand.inner body 0
    for a in inn.antes do
      if a.ok then
        lines := lines.push
          s!"{tag} PREMISE {leaf}: ALLOWED     antecedent under the existential : {a.text}"
      else
        bad := bad + 1
        lines := lines.push
          s!"{tag} PREMISE {leaf}: NOT ALLOWED antecedent under the existential : {a.text}"
    lines := lines.push s!"{tag} CONCLUSION {leaf}: {inn.concl}"
    let counts : List Nat := [bad, runs, defs, props, inn.antes.size, inn.nEx]
    return (lines, counts, inn.hasDesign && inn.hasChildMap)
  let lines : Array String := report.1
  let counts : List Nat := report.2.1
  let concl : Bool := report.2.2
  let bad : Nat := counts.getD 0 0
  let runs : Nat := counts.getD 1 0
  let defs : Nat := counts.getD 2 0
  let props : Nat := counts.getD 3 0
  let nEx : Nat := counts.getD 5 0
  unless bad == 0 do
    throwError "{leaf}: {bad} NOT ALLOWED premises, expected 0: {lines}"
  unless props == 2 && runs == 1 && defs == 1 do
    throwError "{leaf}: {props} proposition binders (RunsTo {runs}, EntryDefines {f} {gv} {defs}), expected exactly one of each and no other"
  unless nEx == 1 do
    throwError "{leaf}: {nEx} existentials in front of the conjunction, expected 1 (raw)"
  unless concl do
    throwError "{leaf}: the statement under the existential does not mention DesignSV over childMap"
  return lines

/-- The gate data `#gate_child` leaves, required by the endpoint's proof. -/
def dataNames : List String :=
  ["gateValue", "gateBinders", "gate_old", "gate_peel", "gate_wf", "machineSource"]

/-- The reasons `#gate_child` gives for a declaration outside the gate's
scope (the sweep reports REFUSED, not FAILED, on these). -/
def scopeReasons : List String :=
  ["the first combinational gate takes it", "the unified gate does not take its entry constant",
   "no value", "the gate's peel", "the body is not read as a term",
   "the term does not quote back to the body", "no Signal in the body"]

/-- `f.gate_design0`, added (file header). Throws when the data is not
derivable, a generated proof fails or the statement check fails. Returns the
premise lines. -/
def gateDesign0Core (f : Name) : CommandElabM (Array String) := do
  let name := f ++ `gate_design0
  unless (← getEnv).contains (f ++ `gate_child) do
    discard <| Tools.ShippingGateChildCommand.generateGateChild f
  for s in dataNames do
    let d := f ++ Name.mkSimple s
    unless (← getEnv).contains d do
      throwError "{f}: {d} is not in the environment after #gate_child"
  let n (s : String) : Ident := mkIdent (`_root_ ++ f ++ Name.mkSimple s)
  let cq : Lean.Term := Lean.Quote.quote f
  let srcT ← liftTermElabM do inferType (mkConst (f ++ `machineSource))
  let i0 : Lean.Term ← if srcT.bindingDomain!.isConstOf ``Unit then `(Unit.unit)
    else `(Sparkle.Core.Domain.defaultDomain)
  let before := (← get).messages.toList.length
  let cmd ← `(command|
    theorem $(n "gate_design0") {mctx : Lean.Meta.Context}
        {mref : ST.Ref IO.RealWorld Lean.Meta.State}
        {cctx : Lean.Core.Context} {cref : ST.Ref IO.RealWorld Lean.Core.State}
        {w w' : Void IO.RealWorld} {b : Sparkle.IR.AST.Module} {design : Sparkle.IR.AST.Design}
        (hr : Tools.ShippingEntrySoundness.RunsTo
          (Sparkle.Compiler.Elab.synthesizeCombinational $cq) mctx mref cctx cref w (b, design) w')
        (entry : Tools.ShippingInlineSoundness.EntryDefines mctx mref cctx cref $cq
          $(n "gateValue")) :
        ∃ raw : Sparkle.IR.AST.Module,
          (b = Sparkle.IR.ZeroWidth.dropZeroWidthModule raw ∨
            b = Sparkle.IR.RefineCheck.mergeChecked
              (Sparkle.IR.ZeroWidth.dropZeroWidthModule raw)) ∧
          ∃ outP : Sparkle.IR.AST.Port, b.outputs = [outP] ∧
            ∀ (T : Nat) (ins : Nat → String → Nat) (st0 : String → Nat)
              (mems : Sparkle.IR.Semantics.MEnv)
              (kids : String → Tools.ShippingHierStateG.KT 0),
              (∀ t, t < T → Tools.ShippingMachineChild.InRange
                ((Tools.ShippingMachineCompose.argPorts b).map fun p => ins t p.name)
                ($(n "gateBinders").filter fun x => x.2 != .domain)) →
              (∀ t x, x ∈ b.inputs.map (fun q => q.name) →
                ins t x < 2 ^ Sparkle.IR.RegDedup.declWidth b x) →
              (∀ t x, x ∈ b.inputs.map (fun q => q.name) →
                ins t x < 2 ^ Tools.ShippingDesignSV.weS (Sparkle.IR.OptCheck.checkedOptimize b) x) →
              Sparkle.IR.Semantics.Bounded
                (Tools.ShippingDesignSV.weS (Sparkle.IR.OptCheck.checkedOptimize b)) st0 →
              (∃ envsO,
                Tools.ShippingDesignSV.DesignSV
                  (Tools.ShippingMachineLinked.childMap design.modules)
                  0 (Sparkle.IR.OptCheck.checkedOptimize b)
                  (Tools.ShippingMachineShipsComb.seedR b ins) T ⟨st0, mems, kids⟩ envsO ∧
                envsO.length = T ∧
                ∀ (j : Nat) (hj : j < envsO.length),
                  (envsO[j]'hj) outP.name =
                    Tools.ShippingMachineChild.childValue $(n "machineSource") $(n "gateBinders") $i0
                      ((Tools.ShippingMachineCompose.argPorts b).map
                        fun p => ins (T - 1 - j) p.name))
              ∧ ∀ envs', Tools.ShippingDesignSV.DesignSV
                    (Tools.ShippingMachineLinked.childMap design.modules)
                    0 (Sparkle.IR.OptCheck.checkedOptimize b)
                    (Tools.ShippingMachineShipsComb.seedR b ins) T ⟨st0, mems, kids⟩ envs' →
                  envs'.length = T ∧
                  ∀ (j : Nat) (hj : j < envs'.length),
                    (envs'[j]'hj) outP.name =
                      Tools.ShippingMachineChild.childValue $(n "machineSource") $(n "gateBinders")
                        $i0
                        ((Tools.ShippingMachineCompose.argPorts b).map
                          fun p => ins (T - 1 - j) p.name) :=
      Tools.ShippingGateDesign.gate_entry_design0
        (F := Tools.ShippingMachineChild.childValue $(n "machineSource") $(n "gateBinders") $i0)
        hr entry $(n "gate_old") $(n "gate_peel") $(n "gate_wf")
        (Tools.ShippingGateChild.bool_positions (by decide))
        (Tools.ShippingGateChild.bits_positions (by decide))
        (fun _ _ => rfl))
  withScope (fun s => { s with opts := maxRecDepth.set (Lean.Elab.async.set s.opts false) 100000 })
    (elabCommand cmd)
  checkMade name before
  liftTermElabM do
    let ci ← getConstInfo name
    checkStatement "GATEDESIGN0" f name ci.type

/-- The outcome of the generator on one declaration. -/
structure Outcome where
  /-- `GENERATED`, `EXISTS`, `REFUSED` or `FAILED` -/
  tag : String
  note : String
  lines : Array String

/-- The generator on `f`: never throws; on REFUSED / FAILED the environment
and the message log are put back. -/
def gateDesign0 (f : Name) : CommandElabM Outcome := do
  let name := f ++ `gate_design0
  if (← getEnv).contains name then
    return { tag := "EXISTS",
             note := s!"{name} is in the environment already: audited, not rebuilt",
             lines := #[] }
  let savedEnv ← getEnv
  let savedMsgs := (← get).messages
  try
    let lines ← gateDesign0Core f
    return { tag := "GENERATED",
             note := s!"GENERATED {name}. Tools.ShippingGateDesign.gate_entry_design0 at {f}'s gate data ({f}.gate_old, {f}.gate_peel, {f}.gate_wf; two decide on the binder positions, one rfl for the source function at constant inputs — the proof term of {f}.gate_child with the design-level theorem). Premises: the run and EntryDefines {f} {f}.gateValue (binders) — no antecedent under ∃ raw, no ChildBnd, no check constant",
             lines }
  catch ex =>
    let msg ← ex.toMessageData.toString
    let newMsgs := (← get).messages.toList.drop savedMsgs.toList.length
    let errs ← (newMsgs.filter (·.severity == .error)).mapM fun m => m.data.toString
    setEnv savedEnv
    modify fun st => { st with messages := savedMsgs }
    let refused : Bool := scopeReasons.any fun r => has msg r
    let tag : String := if refused then "REFUSED" else "FAILED"
    return { tag,
             note := s!"{msg} — errors logged by the generated theorems: {errs.take 2}",
             lines := #[] }

/-- `#gate_design0 f`: an error where it is refused or fails. -/
elab "#gate_design0 " d:ident : command => do
  let f ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo d
  let o ← gateDesign0 f
  for l in o.lines do logInfo m!"{l}"
  if o.tag == "REFUSED" || o.tag == "FAILED" then
    throwError "GATEDESIGN0 {o.tag} {f}: {o.note}"
  else
    logInfo m!"GATEDESIGN0 {o.tag} {f}: {o.note}"

/-- The general theorems under a gate design endpoint. -/
def generalTheorems : List Name :=
  [``Tools.ShippingGateDesign.gate_entry_design0,
   ``Tools.ShippingGateDesign.gate_entry_text,
   ``Tools.ShippingGateDesign.gate_design_of_childFn,
   ``Tools.ShippingGateDesign.runModule_assigns_total,
   ``Tools.ShippingGateChild.gate_child_full,
   ``Tools.ShippingMixedForwardSoundness.checked_forwardCheck]

/-- The audit of an existing `f.gate_design0` (throws on a violation): the
statement check on the STORED statement; standard axioms of the endpoint,
of the gate data theorems and of the general theorems. Returns the premise
lines. -/
def audit (f : Name) : MetaM (Array String) := do
  let leaf := f ++ `gate_design0
  let info ← getConstInfo leaf
  let lines ← checkStatement "GATEDESIGN0 AUDIT" f leaf info.type
  for n in [leaf, f ++ `gate_old, f ++ `gate_peel, f ++ `gate_wf] ++ generalTheorems do
    for ax in ← Lean.collectAxioms n do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "{n} uses a non-standard axiom: {ax}"
  return lines

/-- One swept declaration. -/
structure Row where
  decl : String
  tag : String
  note : String
  audit : String
  gap : String
  listed : Nat
  bad : Nat
  left : Bool
  ms : Nat

/-- The rows of the file being elaborated. -/
initialize rows : IO.Ref (Array Row) ← IO.mkRef #[]

/-- `#gate_design_sweep f`: the generator, its audit and the gap tool;
LOGGED, never an error. -/
elab "#gate_design_sweep " d:ident : command => do
  let shown : String := toString d.getId
  IO.eprintln s!"GATEDESIGN START {shown}"
  logInfo m!"GATEDESIGN START {shown}"
  let t0 ← IO.monoMsNow
  let f? : Option Name ← try
      let n ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo d
      pure (some n)
    catch _ => pure none
  match f? with
  | none =>
    logInfo m!"GATEDESIGN RESULT {shown}: UNRESOLVED — the identifier is not a constant of the imports"
    rows.modify fun a => a.push
      { decl := shown, tag := "UNRESOLVED", note := "the identifier does not resolve", audit := "-",
        gap := "-", listed := 0, bad := 0, left := false, ms := 0 }
  | some f =>
    let savedEnv ← getEnv
    let savedMsgs := (← get).messages
    let o : Outcome ← try
        gateDesign0 f
      catch ex =>
        let msg ← ex.toMessageData.toString
        setEnv savedEnv
        modify fun st => { st with messages := savedMsgs }
        pure { tag := "FAILED", note := s!"the generator threw outside its own handler: {msg}",
               lines := #[] }
    for l in o.lines do logInfo m!"{l}"
    logInfo m!"GATEDESIGN0 {o.tag} {f}: {o.note}"
    let made : Bool := o.tag == "GENERATED" || o.tag == "EXISTS"
    let leaf := f ++ `gate_design0
    let envA ← getEnv
    let auditR : String × Array String ← try
        if made then
          let ls ← liftTermElabM (audit f)
          for l in ls do logInfo m!"{l}"
          pure ("OK", ls)
        else
          pure ("-", #[])
      catch ex =>
        let msg ← ex.toMessageData.toString
        setEnv envA
        pure (s!"FAILED: {msg}", #[])
    let auditS : String := auditR.1
    let prem := auditR.2.filter fun l => has l " PREMISE "
    let bad := (prem.filter fun l => has l "NOT ALLOWED").size
    let gapName : Name := f ++ `gate_design0_gap
    let envG ← getEnv
    let msgsG := (← get).messages
    let gapS : String ← try
        if !made then
          pure "-"
        else if envG.contains gapName then
          pure "not run: the gap theorem exists already"
        else
          let report ← liftTermElabM (Tools.ShippingFinalGoalCommand.gapOf leaf gapName)
          logInfo m!"GOALGAP {gapName} from {leaf}\n{String.intercalate "\n" report.toList}"
          let hyps ← liftTermElabM do
            let ci ← getConstInfo gapName
            forallTelescope ci.type fun xs _ => do
              let mut out : List String := []
              for x in xs do
                let nm := (← x.fvarId!.getUserName).toString
                if nm.startsWith "gap_" then out := out ++ [nm]
              return out
          pure s!"gap hypotheses {hyps}"
      catch ex =>
        let msg ← ex.toMessageData.toString
        setEnv envG
        modify fun st => { st with messages := msgsG }
        pure s!"gap tool FAILED: {msg}"
    let left : Bool := (← getEnv).contains leaf
    let ms := (← IO.monoMsNow) - t0
    if made then
      logInfo m!"GATEDESIGN RESULT {f}: {o.tag}; premise lines listed by the audit {prem.size}, NOT ALLOWED {bad}; audit {clip auditS 400}; {clip gapS 400}; {leaf} in the environment: {left}; {ms} ms. SCOPE of this line: ONE gate-route declaration as an entry, depth 0, no call, no register, one output; the run and EntryDefines {f} {f}.gateValue stay premises; the source per cycle on values (childValue {f}.machineSource), inputs InRange; DesignSV of the module list over the returned design's child map — not the SV string, not #sim"
    else
      logInfo m!"GATEDESIGN RESULT {f}: {o.tag} — {clip o.note 600}; {leaf} in the environment: {left}; {ms} ms"
    rows.modify fun a => a.push
      { decl := toString f, tag := o.tag, note := o.note, audit := auditS, gap := gapS,
        listed := prem.size, bad, left, ms }

/-- `#gate_design_sweep_summary`: the rows and the counts; an error only on
an inconsistency of what this file measured. -/
elab "#gate_design_sweep_summary" : command => do
  let rs ← rows.get
  let mut lines : Array String := #[]
  let mut problems : Array String := #[]
  for r in rs do
    let made : Bool := r.tag == "GENERATED" || r.tag == "EXISTS"
    if made then
      lines := lines.push s!"GATEDESIGN ROW {r.decl}: {r.tag}; listed {r.listed}, NOT ALLOWED {r.bad}; audit {clip r.audit 160}; {clip r.gap 160}; {r.ms} ms"
      unless r.audit == "OK" do
        problems := problems.push s!"{r.decl}: {r.tag} but its audit did not pass ({clip r.audit 300})"
      unless r.bad == 0 do
        problems := problems.push s!"{r.decl}: {r.tag} with {r.bad} NOT ALLOWED lines in the audit's listing"
      unless r.left do
        problems := problems.push s!"{r.decl}: {r.tag} but gate_design0 is not in the environment"
    else
      lines := lines.push s!"GATEDESIGN ROW {r.decl}: {r.tag} — {clip r.note 240}; {r.ms} ms"
      if r.left then
        problems := problems.push s!"{r.decl}: {r.tag} but gate_design0 is in the environment"
  let count (t : String) : Nat := (rs.filter fun r => r.tag == t).size
  let namesOf (t : String) : List String := (rs.filter fun r => r.tag == t).toList.map (·.decl)
  logInfo m!"{String.intercalate "\n" lines.toList}"
  logInfo m!"GATEDESIGN SUMMARY of {rs.size}: GENERATED {count "GENERATED"} {namesOf "GENERATED"}; EXISTS {count "EXISTS"} {namesOf "EXISTS"}; REFUSED {count "REFUSED"} {namesOf "REFUSED"}; FAILED {count "FAILED"} {namesOf "FAILED"}; UNRESOLVED {count "UNRESOLVED"} {namesOf "UNRESOLVED"}. Each GENERATED / EXISTS row: its audit passed and its listing has 0 NOT ALLOWED (asserted below). No class and no count was expected by this command. A GENERATED row is about ONE gate-route declaration as an entry at depth 0 — DesignSV of the module list, with the run and the reflection as premises, the source per cycle on values; not the SV string, not #sim, not any other declaration."
  if rs.isEmpty then
    throwError "GATEDESIGN: nothing was swept in this file"
  unless problems.isEmpty do
    throwError "GATEDESIGN: {problems.size} inconsistencies in what was measured:\n{String.intercalate "\n" problems.toList}"

/-- `#gate_design_sweep_expect f "CLASS" ["reason"]`: the class of `f` in
this file is `CLASS` (and its note contains the reason, when given). -/
elab "#gate_design_sweep_expect " d:ident e:str r:(str)? : command => do
  let f ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo d
  let want : String := e.getString
  let rs ← rows.get
  let mine := (rs.filter fun x => x.decl == toString f).toList.reverse
  let row ← match mine with
    | x :: _ => pure x
    | [] => throwError "GATEDESIGN EXPECT {f}: not swept in this file (no #gate_design_sweep {f} before this line)"
  unless row.tag == want do
    throwError "GATEDESIGN EXPECT {f}: expected {want}, now {row.tag} — {row.note}"
  if want == "GENERATED" || want == "EXISTS" then
    unless row.audit == "OK" do
      throwError "GATEDESIGN EXPECT {f}: {row.tag}, but its audit did not pass: {row.audit}"
    unless row.bad == 0 do
      throwError "GATEDESIGN EXPECT {f}: {row.tag}, with {row.bad} NOT ALLOWED lines"
    unless (← getEnv).contains (f ++ `gate_design0) do
      throwError "GATEDESIGN EXPECT {f}: {row.tag}, but {f ++ `gate_design0} is not in the environment"
  match r with
  | some s =>
    let sub : String := s.getString
    unless (row.note.splitOn sub).length > 1 do
      throwError "GATEDESIGN EXPECT {f}: {row.tag}, but its reason does not contain \"{sub}\": {row.note}"
  | none => pure ()
  logInfo m!"GATEDESIGN EXPECT {f}: {row.tag}, as expected"

end Tools.ShippingGateDesignCommand
