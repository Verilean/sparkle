variable {mctx : Meta.Context} {mref : ST.Ref IO.RealWorld Meta.State}
  {cctx : Core.Context} {cref : ST.Ref IO.RealWorld Core.State}

section Core
variable {O : RefLawsAOps MkRefd mref cref} (M : MemoFamily O) (hA : AdmCtx O.quiet mctx cctx)
  {I : Void IO.RealWorld → Prop} (hS : StableK O.quiet I)
include M hA hS

theorem translateSignalPureLiteralKS (args : Array Lean.Expr) (hint : String) (named : Bool) :
    KeepsCS mctx mref cctx cref I (translateSignalPureLiteral? args hint named) := by
  unfold translateSignalPureLiteral?
  split
  · refine KeepsCS.bind (makeWirePS M hA hS _ _ _) (fun _ => ?_)
    refine KeepsCS.bind (emitAssignPS _ _) (fun _ => ?_)
    exact KeepsCS.pure _
  · exact KeepsCS.pure _

theorem translateCanonicalSignalBinaryKS (rec : TranslateFn)
    (hrec : ∀ e hint top named, KeepsCS mctx mref cctx cref I (rec e hint top named))
    (e : Lean.Expr) (op : Sparkle.IR.AST.Operator) (args : Array Lean.Expr) (hint : String)
    (named : Bool) (n : Nat) (hw : canonicalSignalBitVecWidth args = some n) :
    KeepsCS mctx mref cctx cref I
      (translateCanonicalSignalBinary rec e op args true true hint named) := by
  unfold translateCanonicalSignalBinary
  first | rw [hw] | simp only [hw]
  refine KeepsCS.bind (KeepsCS.pure _) (fun _ => ?_)
  refine KeepsCS.bind (makeWirePS M hA hS _ _ _) (fun _ => ?_)
  first
    | refine KeepsCS.bind (KeepsCS.ite (fun _ => hrec _ _ _ _) (fun h => (h rfl).elim))
        (fun _ => ?_)
    | refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
  first
    | refine KeepsCS.bind (KeepsCS.ite (fun _ => hrec _ _ _ _) (fun h => (h rfl).elim))
        (fun _ => ?_)
    | refine KeepsCS.bind (hrec _ _ _ _) (fun _ => ?_)
  refine KeepsCS.bind (emitAssignPS _ _) (fun _ => ?_)
  exact KeepsCS.pure _

theorem translateCoreKS (rec : TranslateFn)
    (hrec : ∀ e hint top named, KeepsCS mctx mref cctx cref I (rec e hint top named))
    (e : Lean.Expr) (hint : String) (top named : Bool) :
    KeepsCS mctx mref cctx cref I (translateCore rec e hint top named) := by
  unfold translateCore
  split
  · exact lookupVarPS _
  · split
    · refine KeepsCS.ite (fun _ => translateSignalPureLiteralKS M hA hS _ _ _) (fun _ => ?_)
      split
      · refine KeepsCS.bind
          (translateCanonicalSignalBinaryKS M hA hS rec hrec _ _ _ _ _ _ (by assumption))
          (fun _ => ?_)
        exact KeepsCS.pure _
      · exact KeepsCS.pure _
    · exact KeepsCS.pure _

theorem translateStepWithKS (fallback : TranslateFn → TranslateFn) (rec : TranslateFn)
    (hrec : ∀ e hint top named, KeepsCS mctx mref cctx cref I (rec e hint top named))
    (hfb : ∀ e hint top named, KeepsCS mctx mref cctx cref I (fallback rec e hint top named))
    (e : Lean.Expr) (hint : String) (top named : Bool) :
    KeepsCS mctx mref cctx cref I (translateStepWith fallback rec e hint top named) := by
  unfold translateStepWith
  dsimp only
  refine KeepsCS.ite (fun _ => ?_) (fun _ => ?_)
  · refine KeepsCS.bind (cacheLookupValidatedKS M hA hS _) (fun x => ?_)
    cases x with
    | some w => exact KeepsCS.pure _
    | none =>
      refine KeepsCS.bind (translateCoreKS M hA hS rec hrec _ _ _ _) (fun y => ?_)
      cases y with
      | some w =>
        exact KeepsCS.ite (fun _ => KeepsCS.pure _)
          (fun _ => KeepsCS.bind (recordTranslationKS M hA hS _ _ _) (fun _ => KeepsCS.pure _))
      | none => exact hfb _ _ _ _
  · refine KeepsCS.bind (translateCoreKS M hA hS rec hrec _ _ _ _) (fun y => ?_)
    cases y with
    | some w =>
      exact KeepsCS.ite (fun _ => KeepsCS.pure _)
        (fun _ => KeepsCS.bind (recordTranslationKS M hA hS _ _ _) (fun _ => KeepsCS.pure _))
    | none => exact hfb _ _ _ _

end Core

/-! ## The fuel induction (`fuelFix_of` is generic: reused from TranslateA) -/

/-- The translator handed in as `rec` keeps `I` in every ADMISSIBLE context. -/
def RecKS (O : RefLawsAOps MkRefd mref cref) (I : Void IO.RealWorld → Prop) (rec : TranslateFn) :
    Prop :=
  ∀ (mctx : Meta.Context) (cctx : Core.Context), AdmCtx O.quiet mctx cctx →
    ∀ e hint top named, KeepsCS mctx mref cctx cref I (rec e hint top named)

theorem fuelZeroKS (O : RefLawsAOps MkRefd mref cref) (I : Void IO.RealWorld → Prop)
    (step : TranslateFn → TranslateFn) : RecKS O I (translateFuelFix step 0) := by
  intro mctx cctx _ e hint top named
  unfold translateFuelFix
  exact KeepsCS.throw (Exception.error .missing "translation fuel exhausted") (by okmsg)

/-- **The translator from its fallback**, K version: if the fallback keeps `I` whenever its recursive
argument does (`RecKS`), the shipping translator does. -/
theorem translateK_of_fallbackS {O : RefLawsAOps MkRefd mref cref} (M : MemoFamily O)
    {I : Void IO.RealWorld → Prop} (hS : StableK O.quiet I) (tenv : Lean.Environment)
    (hF : ∀ rec, RecKS O I rec → RecKS O I (translateFallback tenv rec)) :
    RecKS O I (fun e h t n => translateExprToWire tenv e h t n) := by
  have hfix : RecKS O I (translateFuelFix (translateStep tenv) translateFuelLimit) := by
    refine fuelFix_of (P := RecKS O I) (translateStep tenv) (fuelZeroKS O I _) ?_ _
    intro rec hrec mctx cctx hA e hint top named
    unfold translateStep
    exact translateStepWithKS M hA hS (translateFallback tenv) rec (hrec mctx cctx hA)
      (hF rec hrec mctx cctx hA) e hint top named
  intro mctx cctx hA e hint top named
  first
    | exact hfix mctx cctx hA e hint top named
    | (unfold translateExprToWire; exact hfix mctx cctx hA e hint top named)

end Tools.ShippingGen4FKidsTranslate

