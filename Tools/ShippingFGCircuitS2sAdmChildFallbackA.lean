theorem translateFallbackAX (O : RefLawsAOpsX MkRefd mref cref) {I : Void IO.RealWorld → Prop}
    (hS : StableA O.quiet I) (tenv : Lean.Environment)
    (hImpl : LegacyImplAX O I) (hCached : LegacyCachedAX O I) (hcanon : CanonKeyAX O I)
    (hpf : ProjFieldNameAX O I) (hchild : ChildEntryAX O I)
    (rec : TranslateFn) (hrec : RecAX O I rec) : RecAX O I (translateFallback tenv rec) := by
  intro mctx cctx hA e hint top named
  have hr := hrec mctx cctx hA
  have hI := hImpl rec hrec mctx cctx hA
  have hC := hCached rec hrec mctx cctx hA
  unfold translateFallback
  try dsimp only
  -- (integrator, after fb1-fb8: one `kwalkX` over the 15 arms, each chosen by its head)
  split
  all_goals kwalkX [translateControlCachedWithAX O hA hS,
    (translateBoolUncachedWithAX O hA hS rec hr _ (fun e h t n => hI e h t n)),
    translateVectorMuxUncachedWithAX O hA hS rec hr, translateSetWidthUncachedWithAX O hA hS rec hr,
    translateRegisterUncachedWithAX O hA hS rec hr,
    translateRegisterEnableUncachedWithAX O hA hS rec hr,
    translateLoopRegisterUncachedWithAX O hA hS rec hr,
    translateCircuitDoUncachedWithAX O hA hS rec hr,
    translateCircuitDo2UncachedWithAX O hA hS rec hr,
    translateMemoryUncachedWithAX O hA hS rec hr, translateSliceUncachedWithAX O hA hS rec hr,
    translateConcatUncachedWithAX O hA hS rec hr, translateConcatLitUncachedWithAX O hA hS rec hr,
    translateSliceFUncachedWithAX O hA hS rec hr,
    (translateInstanceOrFallbackAX O hA hS rec hr tenv (hchild mctx cctx hA)
      (hpf mctx cctx hA) (hcanon mctx cctx hA) (fun e h t n => hC e h t n))]

theorem translate_keepsAX (O : RefLawsAOpsX MkRefd mref cref) {I : Void IO.RealWorld → Prop}
    (hS : StableA O.quiet I) (tenv : Lean.Environment)
    (hImpl : LegacyImplAX O I) (hCached : LegacyCachedAX O I) (hcanon : CanonKeyAX O I)
    (hpf : ProjFieldNameAX O I) (hchild : ChildEntryAX O I) :
    RecAX O I (fun e h t n => translateExprToWire tenv e h t n) :=
  translateA_of_fallbackX O hS tenv
    (fun rec hrec => translateFallbackAX O hS tenv hImpl hCached hcanon hpf hchild rec hrec)

theorem tripleA_synthReadX (O : RefLawsAOpsX MkRefd mref cref) (hA : O.adm mctx cctx)
    (D : Nat) :
    Triple mctx mref cctx cref (JQ O.quiet D) (sparkleChildSynth.get : MetaM _)
      (fun s w => JQ O.quiet D w ∧ s = some synthesizeChild)
      (fun e w => JQ O.quiet D w ∧ OkExc e) := by
  intro w hw
  have hK := keeps_iff.mp (keepsA_framedX O hA (stableA_JQ _ D) FramedA.synthGet) w hw
  cases hm : (sparkleChildSynth.get : MetaM _) mctx mref cctx cref w with
  | ok a w1 =>
    rw [hm] at hK
    exact ⟨hK, (runsTo_get_readOf _ hm).trans hw.2.1⟩
  | error e w1 => rw [hm] at hK; exact hK

theorem childEntryA_of_childKeepsX (O : RefLawsAOpsX MkRefd mref cref) (D : Nat)
    (hC : ChildKeepsAX O D) : ChildEntryAX O (JQ O.quiet D) := by
  intro mctx cctx hA c
  rw [keeps_iff]
  unfold childSynthEntry
  refine Triple.bindQ (tripleA_synthReadX O hA D) ?_  -- guess: F8
  intro s hs
  subst hs
  exact keeps_iff.mp (hC mctx cctx hA c)

theorem translate_keepsJQX (O : RefLawsAOpsX MkRefd mref cref) (D : Nat) (tenv : Lean.Environment)
    (hImpl : LegacyImplAX O (JQ O.quiet D)) (hCached : LegacyCachedAX O (JQ O.quiet D))
    (hcanon : CanonKeyAX O (JQ O.quiet D)) (hpf : ProjFieldNameAX O (JQ O.quiet D))
    (hC : ChildKeepsAX O D) :
    RecAX O (JQ O.quiet D) (fun e h t n => translateExprToWire tenv e h t n) :=
  translate_keepsAX O (stableA_JQ _ D) tenv hImpl hCached hcanon hpf
    (childEntryA_of_childKeepsX O D hC)

end Tools.ShippingChildFallbackA

