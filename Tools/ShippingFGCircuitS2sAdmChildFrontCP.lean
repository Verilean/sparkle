theorem bindMixedCertifiedInputsAPX {α : Type} (k : CompilerM α)
    (hk : KeepsCP mctx mref cctx cref I k) :
    ∀ l : List ((Name × MixedGateBinder) × FVarId),
      KeepsCP mctx mref cctx cref I (bindMixedCertifiedInputs k l)
  | [] => by unfold bindMixedCertifiedInputs; exact hk
  | ((_, .domain), _) :: rest => by
    unfold bindMixedCertifiedInputs
    exact bindMixedCertifiedInputsAPX k hk rest
  | ((_, .bool), _) :: rest => by
    unfold bindMixedCertifiedInputs
    exact bindInputPortAPX O hA hS _ _ _ _ (bindMixedCertifiedInputsAPX k hk rest)
  | ((_, .bits _), _) :: rest => by
    unfold bindMixedCertifiedInputs
    exact bindInputPortAPX O hA hS _ _ _ _ (bindMixedCertifiedInputsAPX k hk rest)

theorem mixed_keepsAPX (translate : TranslateFn) (b : Bool) (declName : Name)
    (bs : List (Name × MixedGateBinder)) (body : Lean.Expr)
    (htr : ∀ e hint top named, KeepsCP mctx mref cctx cref I (translate e hint top named)) :
    Keeps mctx mref cctx cref I
      (synthesizeMixedCertified translate (profLogIO b) declName bs body) := by
  rw [keeps_iff]
  unfold synthesizeMixedCertified
  refine Triple.bind
    (Triple.mapM _ (fun _ => keeps_iff.mp (keepsA_framedX O hA hS FramedA.freshFVar)) _) ?_
  intro ids
  split
  · dsimp only
    refine Triple.bindQ (φ := MkRefd _) (tripleA_mkExprCacheX O hA hS _) ?_
    intro cacheRef hr
    refine Triple.bind
      (keeps_iff.mp (bindMixedCertifiedInputsAPX O hA hS _
        (emitLeavesAPX O hA hS translate b cacheRef hr htr _ _ _) _ _ _
        (ctxOk_entry false hr))) ?_  -- guess: R2
    rintro ⟨_, fs⟩
    exact finishSynthA declName fs
  · exact Triple.throw _ fun _ hw => ⟨hw, by okmsg⟩

theorem machineCert_keepsAPX (translate : TranslateFn) (b : Bool) (declName : Name)
    (htr : ∀ e hint top named, KeepsCP mctx mref cctx cref I (translate e hint top named))
    (hchild : ∀ c, Keeps mctx mref cctx cref I (synthesizeChild c))
    (hsv : ∀ w, I w → sv w = some synthesizeChild) (shape : MachineShape) :
    Keeps mctx mref cctx cref I
      (synthesizeMachineCertified translate (profLogIO b) declName shape) := by
  rw [keeps_iff]
  unfold synthesizeMachineCertified
  refine Triple.bind
    (keeps_iff.mp (mixed_keepsAPX O hA hS translate b declName shape.binders shape.body htr)) ?_
  rintro ⟨t, d⟩
  dsimp only
  split
  · split
    · exact Triple.pure fun _ hw => hw
    · split
      · exact keeps_iff.mp (closeInstsM_keepsAX O hA hS hsv hchild _ _ _ _)
      · exact keeps_iff.mp (closeInstsGM_keepsAX O hA hS hsv hchild _ _ _ _)
  · exact Triple.pure fun _ hw => hw

theorem fromConst_mixed_keepsAPX (translate : TranslateFn) (b : Bool) (declName : Name)
    (constInfo : ConstantInfo) (isInst : Lean.Expr → Bool) {bs : List (Name × MixedGateBinder)}
    {body : Lean.Expr}
    (hc : certifiedShape? false [] constInfo = none)
    (hm : mixedCertifiedShape? false [] constInfo isInst = some (bs, body))
    (htr : ∀ e hint top named, KeepsCP mctx mref cctx cref I (translate e hint top named)) :
    Keeps mctx mref cctx cref I
      (synthesizeFromConst translate (profLogIO b) declName [] false true constInfo isInst) := by
  have hd1 : (if true = true then certifiedShape? false [] constInfo else none) = none := by
    first
      | exact (if_pos rfl).trans hc
      | (rw [if_pos rfl]; exact hc)
      | simpa using hc
  have hd2 : (if true = true then mixedCertifiedShape? false [] constInfo isInst else none) =
      some (bs, body) := by
    first
      | exact (if_pos rfl).trans hm
      | (rw [if_pos rfl]; exact hm)
      | simpa using hm
  first | delta synthesizeFromConst | unfold synthesizeFromConst
  rw [hd1, hd2]
  first
    | refine Keeps.bind (keepsA_diagX O hA hS (Diag.profLog b _)) ?_
    | (dsimp only; refine Keeps.bind (keepsA_diagX O hA hS (Diag.profLog b _)) ?_)
  intro _
  refine Keeps.bind (mixed_keepsAPX O hA hS translate b declName bs body htr) ?_
  intro result
  refine Keeps.bind (keepsA_framedX O hA hS (FramedA.sideModify _ .subModule)) ?_
  intro _
  exact Keeps.pure _

theorem fromConst_machine_keepsAPX (translate : TranslateFn) (b : Bool) (declName : Name)
    (constInfo : ConstantInfo) (isInst : Lean.Expr → Bool)
    (hc : certifiedShape? false [] constInfo = none)
    (hm : mixedCertifiedShape? false [] constInfo isInst = none)
    (htr : ∀ e hint top named, KeepsCP mctx mref cctx cref I (translate e hint top named))
    (hchild : ∀ c, Keeps mctx mref cctx cref I (synthesizeChild c))
    (hsv : ∀ w, I w → sv w = some synthesizeChild)
    (hlegacy : Keeps mctx mref cctx cref I
      (synthesizeFromConst translate (profLogIO b) declName [] false false constInfo isInst)) :
    Keeps mctx mref cctx cref I
      (synthesizeFromConst translate (profLogIO b) declName [] false true constInfo isInst) := by
  have hd1 : (if true = true then certifiedShape? false [] constInfo else none) = none := by
    first
      | exact (if_pos rfl).trans hc
      | (rw [if_pos rfl]; exact hc)
      | simpa using hc
  have hd2 : (if true = true then mixedCertifiedShape? false [] constInfo isInst else none) =
      none := by
    first
      | exact (if_pos rfl).trans hm
      | (rw [if_pos rfl]; exact hm)
      | simpa using hm
  have h := hlegacy
  first | delta synthesizeFromConst | unfold synthesizeFromConst
  first | delta synthesizeFromConst at h | unfold synthesizeFromConst at h
  rw [hd1, hd2]
  simp only [Bool.false_eq_true, ↓reduceIte, Bool.not_false, Bool.and_true,
    List.isEmpty_nil] at h ⊢
  refine Keeps.bind (keepsA_framedX O hA hS FramedA.env) (fun env => ?_)
  generalize machineShape? false [] constInfo (structEnv env) = m
  cases m with
  | none =>
    first
      | exact h
      | exact keeps_pure_bind_of h
  | some shape =>
    refine keeps_pure_bind_of ?_
    refine Keeps.bind (machineCert_keepsAPX O hA hS translate b declName htr hchild hsv shape) ?_
    intro r
    cases r with
    | some result =>
      refine Keeps.bind (keepsA_diagX O hA hS (Diag.profLog b _)) ?_
      intro _
      refine Keeps.bind (keepsA_framedX O hA hS (FramedA.sideModify _ .subModule)) ?_
      intro _
      exact Keeps.pure _
    | none => exact h

theorem fromConst_frontends_keepsCP'X (translate : TranslateFn) (b : Bool) (declName : Name)
    (constInfo : ConstantInfo) (isInst : Lean.Expr → Bool)
    (htr : ∀ e hint top named, KeepsCP mctx mref cctx cref I (translate e hint top named))
    (hchild : ∀ c, Keeps mctx mref cctx cref I (synthesizeChild c))
    (hsv : ∀ w, I w → sv w = some synthesizeChild)
    (hlegacy : certifiedShape? false [] constInfo = none →
      mixedCertifiedShape? false [] constInfo isInst = none →
      Keeps mctx mref cctx cref I
        (synthesizeFromConst translate (profLogIO b) declName [] false false constInfo isInst)) :
    Keeps mctx mref cctx cref I
      (synthesizeFromConst translate (profLogIO b) declName [] false true constInfo isInst) := by
  cases hc : certifiedShape? false [] constInfo with
  | some p =>
    obtain ⟨bs, body⟩ := p
    exact fromConst_certified_keepsAPX O hA hS translate b declName constInfo isInst hc htr
  | none =>
    cases hm : mixedCertifiedShape? false [] constInfo isInst with
    | some p =>
      obtain ⟨bs, body⟩ := p
      exact fromConst_mixed_keepsAPX O hA hS translate b declName constInfo isInst hc hm htr
    | none =>
      exact fromConst_machine_keepsAPX O hA hS translate b declName constInfo isInst hc hm htr
        hchild hsv (hlegacy hc hm)

